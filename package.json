    "opentype.js": "^2.0.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3",
    "yaml": "^2.9.1"
  }
