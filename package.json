{
  "name": "birchdesignlab",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build/clean-dist.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "npm run test && npm run check && npm run build && npm run test:dist",
    "test": "vitest run",
    "trace": "node scripts/trace-to-strokes.mjs",
    "types": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "dev:worker": "npm run build && wrangler dev",
    "og": "tsx scripts/og/generate.ts",
    "prebuild": "npm run og",
    "test:dist": "vitest run --config vitest.dist.config.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/cormorant": "^5.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/league-spartan": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/cormorant-sc": "^5.3.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "astro": "^7.3.4",
    "svelte": "^5.57.1",
    "three": "^0.186.0",
    "zod": "^4.6.5"
