---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import Services from '../themes/quiet/pages/Services.astro';
import { buildService } from '../lib/seo/organization';
import { getCopy } from '../lib/copy';

// The body is the quiet school's (src/themes/quiet/), shared with
// /t/quiet/services/. Structured data stays here: only root pages declare the
// business (schools are noindexed copies, F041).
const service = buildService(Astro.site!);
const copy = await getCopy('services');
const chrome = await getCopy('chrome');
---
<BaseLayout title={copy.title} description={copy.description}>
  <JsonLd slot="head" data={service} />
  <Services copy={copy} chrome={chrome} />
</BaseLayout>
