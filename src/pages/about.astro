---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../themes/quiet/pages/About.astro';
import { getCopy } from '../lib/copy';

// The body is the quiet school's (src/themes/quiet/), shared with /t/quiet/about/.
const copy = await getCopy('about');
const chrome = await getCopy('chrome');
---
<BaseLayout title={copy.title} description={copy.description}>
  <About copy={copy} chrome={chrome} />
</BaseLayout>
