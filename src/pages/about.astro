---
import BaseLayout from '../layouts/BaseLayout.astro';
import BarkField from '../components/BarkField.astro';
---
<BaseLayout
  title="About · Birch Design Lab"
  description="The name, the oldest paper of the north, and the man behind Birch Design Lab."
>
  <header class="hero">
    <BarkField density={170} lockAspect />
    <h1>The shining tree</h1>
  </header>
  <!-- <section class="wrap preprose">
    <h2>The shining tree</h2>
  </section> -->
  <section class="wrap prose">
    <!-- provisional copy throughout -->
    <article class="epic">
      <p class="etym">
        <em>Birch</em>: Old English <em>beorc</em>, from an ancient root that
        meant <strong>to shine</strong>. The same syllable survives in
        <em>bright</em>. The birch is literally "the shining tree,"
        named for the way its white bark stands out amongst the dark woods.
      </p>
      <p>
        The word is old enough to have kept its own letter. Back when English was still Old and
        being written in runes, the rune for B was <em>beorc</em>: the
        birch rune. A tree so familiar it stood for a sound. Most business names
        get invented in an afternoon. This one has been earning its
        keep for a few thousand years.
      </p>
    </article>

    <article class="myth">
      <h2>The strongest, oldest paper of the North</h2>
      <p>
        The city of Novgorod, Russia was founded in 859 CE and was a major trade hub for centuries.
        Many Medieval writings have been excavated in the surrounding area.
        These shopping lists, love notes, and children's
        homework were resurrected whole after eight hundred years in the mud.
        They were scrawled into bark of the birch tree.
      </p>
      <p>
        The shining tree was a carrier of everyday people's communications.
        And they survive nearly a millenium in the mud.
      </p>
    </article>

    <article class="founder">
      <h2>The founder</h2>
      <p>
        Birch Design Lab is one man much like the birch tree.
      </p>
      <p>
        Tall, pale, and shining amongst the darkness. Also possibly better suited to the North than to the Gulf Coast he currently calls home.
      </p>
      <p>
        Over a decade of experience designing and constructing digital solutions has taught him that the best work is done by a single pair of hands.
      </p>
      <p>
        Every project is designed, constructed, and can be cared for by the same pair of hands you shake.
      </p>
    </article>
  </section>

  <section class="loud" data-reveal>
    <div class="wrap loud-inner">
      <p class="manifesto">
        Everything here is one person's work. That is not a limitation; it is the guarantee.
      </p>
      <p class="signature smallcaps">Birch Design Lab</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Bark hero — Home's construction at half height: a full-bleed field with the
     H1 overlaid. This is About's material difference from Services. The short
     band only works because the field opts into `lockAspect`; without it the
     engine maps normalized dash width to canvas width and the lenticels smear
     into horizontal streaks. */
  .hero {
    position: relative; min-height: 44vh;
    display: grid; place-items: center;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    padding-inline: var(--space-4);
  }
  .hero h1 {
    position: relative;
    font-size: var(--text-3xl);
    text-align: center;
    /* billboard color (distinct from the bark's --mark hue) so the H1 keeps
       contrast over the brightest lenticels, not just over the field */
    color: var(--billboard-color);
  }

  /* "The shining tree" aligns with the etym paragraph below; the epic's
     top border is the seam between this heading and the prose. */
  /*.preprose { padding-block: var(--space-4); }*/

  /*.prose { display: grid; gap: var(--space-4); padding-block: var(--space-5) var(--space-4); }*/
  .prose { display: grid; gap: var(--space-4); padding-block: 0 var(--space-4); }
  .epic, .myth, .founder { border-top: 1px solid var(--line); padding-top: var(--space-5); max-width: 60ch; }
  .etym { font-family: var(--font-display); font-size: var(--text-xl); line-height: 1.4; }
  .epic p + p, .myth p, .founder p { color: var(--mark-muted); margin-top: var(--space-3); }

  /* Loud moment — manifesto pull-quote, NO CTA (shared .loud pattern). */
  .loud {
    background: var(--green-field); color: var(--gf-mark);
    border-top: 1px solid var(--line);
    --accent: var(--gf-accent); --on-accent: var(--gf-on-accent);
    --link: var(--gf-link); --mark: var(--gf-mark);
  }
  .loud-inner { padding-block: var(--space-7); }
  .manifesto {
    font-family: var(--font-display); font-size: var(--text-3xl);
    line-height: 1.15; max-width: 20ch;
  }
  .signature { display: block; color: var(--accent); margin-top: var(--space-5); }
</style>
