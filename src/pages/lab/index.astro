---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpecimenCatalog from '../../components/SpecimenCatalog.astro';
import LabWall from '../../components/LabWall.astro';

// Noindexed entries are instruments: reachable by direct URL, never listed.
const entries = (await getCollection('lab', ({ data }) => !data.noindex)).sort((a, b) =>
  b.data.designation.localeCompare(a.data.designation),
);
---
<BaseLayout
  title="The Lab · Birch Design Lab"
  description="Numbered experiments and client studies in design and web engineering. A specimen catalog."
  zone="lab"
>
  {/* Which view this visitor gets, decided before first paint so the page never
      flashes the other one. It repeats readView in src/lib/lab-wall/model.ts
      (an inline script cannot import): the remembered 'lab-view', else the wall; and the wall for a link to
      a piece (/lab/#bdl-007) whatever was remembered, so the list never flashes first (boot.ts settles it).
      Without script the attribute never exists and the page is the catalog list. */}
  <script slot="head" is:inline>
    (function () {
      var view = 'wall', lamp = 'on';
      try { if (localStorage.getItem('lab-view') === 'list') view = 'list'; } catch (e) { /* storage blocked */ }
      if (/^#bdl-/i.test(location.hash)) view = 'wall';
      try { if (localStorage.getItem('lab-lamp') === 'off') lamp = 'off'; } catch (e) { /* storage blocked */ }
      document.documentElement.setAttribute('data-lab-view', view);
      document.documentElement.setAttribute('data-lab-lamp', lamp);
    })();
  </script>
  {/* The lamp's bulb sits in the site header, just left of the light/dark switch. It is on the page
      always and shown by lab-wall.css only where the lamp runs (the wall view; in light, a fine
      pointer at desktop layout), so without script, in the list, or on a phone in light there is no
      dead button. src/lib/lab-wall/boot.ts wires it. */}
  <button slot="header-controls" class="lw-bulb" type="button" data-lw="bulb" aria-pressed="true" aria-label="Lamp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.3 1 2.2h5.2c0-.9.4-1.7 1-2.2A6 6 0 0 0 12 3z"/></svg>
  </button>
  <section class="wrap lab-page">
    <header class="intro">
      <h1 class="lw-h1">The Lab</h1>
      <p>Websites and software, designed and built on the Mississippi Gulf Coast.</p>
    </header>
    <SpecimenCatalog entries={entries} filterable />
    <LabWall entries={entries} />
  </section>
</BaseLayout>

<style>
  .intro { padding-block: var(--space-6) var(--space-5); max-width: var(--measure); }
  .intro p { color: var(--mark-muted); margin-top: var(--space-3); }
</style>
