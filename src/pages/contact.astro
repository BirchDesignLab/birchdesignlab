---
import BaseLayout from '../layouts/BaseLayout.astro';
const email = 'hello@birchdesignlab.com';
---
<BaseLayout
  title="Contact · Birch Design Lab"
  description="Start a conversation with Birch Design Lab about your software or website project."
>
  <section class="wrap">
    <header class="intro">
      <!-- provisional copy -->
      <p class="smallcaps kicker">Contact</p>
      <h1>Start a conversation</h1>
      <p class="subline">No forms, no intake funnel. An email arrives, a person reads it.</p>
    </header>
  </section>

  <section class="loud" data-reveal>
    <div class="wrap loud-inner">
      <!-- provisional copy -->
      <p class="invite">Tell us what you're trying to build, fix, or grow. Plain English is the house language.</p>
      <a class="mail" href={`mailto:${email}`}>{email}</a>
      <p class="fine">No preparation required.</p>
    </div>
    <!-- Renovation slot: contact form lands with the Pages-to-Workers migration (docs/lab-backlog.md). -->
  </section>
</BaseLayout>

<style>
  .intro { padding-block: var(--space-6) var(--space-5); max-width: var(--measure-wide); }
  .kicker { color: var(--accent); }
  .intro h1 { font-size: var(--text-3xl); margin-top: var(--space-2); }
  .subline { font-size: var(--text-lg); color: var(--mark-muted); margin-top: var(--space-3); }

  /* Loud moment — the CTA (.loud primitive in base.css). */
  .invite {
    font-family: var(--font-display); font-size: var(--text-2xl);
    line-height: 1.2; max-width: 34ch;
  }
  .mail {
    display: inline-block; margin-top: var(--space-4);
    font-family: var(--font-display);
    /* long address must survive narrow phones */
    font-size: clamp(1.3rem, 5.5vw, var(--text-2xl));
    overflow-wrap: anywhere;
  }
  .fine { color: var(--accent); font-size: var(--text-sm); margin-top: var(--space-4); }
</style>
