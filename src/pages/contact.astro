---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../themes/quiet/pages/Contact.astro';
import { getCopy } from '../lib/copy';

// The body is the quiet school's (src/themes/quiet/), shared with
// /t/quiet/contact/. Trust line copy is provisional; founder finalises the
// wording + reply promise live (src/content/copy/contact.yaml).
const copy = await getCopy('contact');
const chrome = await getCopy('chrome');
---
<BaseLayout title={copy.title} description={copy.description}>
  <Contact copy={copy} chrome={chrome} />
</BaseLayout>
