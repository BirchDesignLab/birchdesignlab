---
// Confirmation target for the contact form's 303 redirect. Static page so it
// works without JavaScript; noindexed because it is meaningless as an entry.
// The body is the quiet school's, shared with /t/quiet/contact/sent/.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sent from '../../themes/quiet/pages/Sent.astro';
import { getCopy } from '../../lib/copy';

const copy = await getCopy('sent');
const chrome = await getCopy('chrome');
---
<BaseLayout title={copy.title} description={copy.description} noindex>
  <Sent copy={copy} chrome={chrome} />
</BaseLayout>
