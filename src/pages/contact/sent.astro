---
// Confirmation target for the contact form's 303 redirect. Static page so it
// works without JavaScript; noindexed because it is meaningless as an entry.
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Message sent · Birch Design Lab"
  description="Your message is on its way to Birch Design Lab."
  noindex
>
  <section class="wrap">
    <header class="intro">
      <!-- first-draft copy -->
      <p class="smallcaps kicker">Contact</p>
      <h1>Sent.</h1>
      <p class="subline">
        Your message landed in the right inbox. A person reads it, the same one
        who would build your project, and you'll hear back soon.
      </p>
      <p class="back"><a class="more-link" href="/">Back to the front page</a></p>
    </header>
  </section>
</BaseLayout>

<style>
  .intro { padding-block: var(--space-6) var(--space-7); max-width: var(--measure); }
  .kicker { color: var(--accent); }
  .intro h1 { font-size: var(--text-3xl); margin-top: var(--space-2); }
  .subline { font-size: var(--text-lg); color: var(--mark-muted); margin-top: var(--space-3); }
  .back { margin-top: var(--space-5); }
</style>
