---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import Home from '../themes/quiet/pages/Home.astro';
import { getCopy } from '../lib/copy';

// The body is the quiet school's (src/themes/quiet/), shared with /t/quiet/.
// Home meta is the shared brand blurb verbatim (SITE_DESCRIPTION, injected by
// getCopy), matching both the opener copy and the ProfessionalService schema.
const copy = await getCopy('home');
const chrome = await getCopy('chrome');
---
<BaseLayout title={copy.title} description={copy.description}>
  <StructuredData slot="head" />
  <Home copy={copy} chrome={chrome} />
</BaseLayout>

<script>
  // BDL-006 rides the flagship at /?tune only. The import is dynamic, so the
  // instrument is a separate chunk that ordinary visitors never fetch; what
  // ships to everyone else is this check.
  if (location.search.includes('tune')) {
    const { mountRegulator } = await import('../experiments/bdl-006/mount');
    mountRegulator('overlay');
  }
</script>
