---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BarkField from '../components/BarkField.astro';
import SpecimenCard from '../components/SpecimenCard.astro';

const featured = (await getCollection('lab', ({ data }) => data.featured && data.status === 'live'))
  .sort((a, b) => b.data.designation.localeCompare(a.data.designation))
  .slice(0, 3);
---
<BaseLayout
  title="Birch Design Lab · Custom software and websites"
  description="A design lab building custom software and custom websites for businesses that want to grow. Quiet, fast, built to last."
>
  <section class="hero">
    <BarkField density={170} live />
    <h1 class="billboard">
      <span>Birch</span> <span>Design</span> <span>Lab</span>
    </h1>
  </section>

  <section class="wrap opener">
    <!-- provisional copy: founder may replace -->
    <p class="tagline" data-reveal>A design lab, not an agency.</p>
    <p class="lede" data-reveal>
      Custom software and websites for businesses that want to grow and thrive. 
      Concocted in a lab where the person who builds your site also answers your emails.
    </p>
    <a class="cta" href="/contact" data-reveal>Start a conversation</a>
  </section>

  <section class="wrap teaser">
    <h2 data-reveal>What we build</h2>
    <div class="cols">
      <!-- provisional copy -->
      <article data-reveal>
        <h3>Software</h3>
        <p>
          The tool your business has been hoping for. The spreadsheet that has grown into
          a monster, the process that you dread every week that eats into your weekends? 
          We can design, build, and maintain what fixes it.
        </p>
      </article>
      <article data-reveal>
        <h3>Websites</h3>
        <p>
          A site that loads instantly, reads clearly, and presents your business
          as the only one to even consider calling. No templates, no builders, no bloat. 
          Every site designed and constructed by hand.
        </p>
      </article>
    </div>
    <a class="more" href="/services" data-reveal>How we work &rarr;</a>
  </section>

  {featured.length > 0 && (
    <section class="wrap featured">
      <h2 data-reveal>From the Lab</h2>
      <div>
        {featured.map((entry) => <SpecimenCard entry={entry} />)}
      </div>
      <a class="more" href="/lab" data-reveal>The full catalog &rarr;</a>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    position: relative; min-height: 88vh;
    display: grid; place-items: center;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    padding-inline: var(--space-4);
  }
  .billboard {
    position: relative;
    color: var(--billboard-color);
    font-family: var(--font-billboard);
    font-weight: var(--billboard-weight);
    font-size: clamp(2.8rem, 9vw, 6.5rem);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-align: center;
    line-height: 1.1;
  }
  @media (max-width: 640px) {
    .billboard span { display: block; }
  }
  .opener { padding-block: var(--space-6) 0; }
  .tagline {
    font-family: var(--font-display); font-size: var(--text-xl);
    color: var(--mark-muted); max-width: 30ch;
  }
  .lede { margin-top: var(--space-4); max-width: 44ch; }
  .cta {
    display: inline-block; margin-top: var(--space-5);
    color: var(--accent); border: 1px solid var(--accent);
    border-radius: 999px; padding: var(--space-2) var(--space-5);
    text-decoration: none;
    transition: all var(--dur-1) var(--ease-weighted);
  }
  .cta:hover { background: var(--accent); color: var(--field); }
  .teaser, .featured { padding-block: var(--space-7) 0; }
  .cols {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-5); margin-top: var(--space-4);
  }
  .cols p { color: var(--mark-muted); margin-top: var(--space-2); max-width: 44ch; }
  .more { display: inline-block; margin-top: var(--space-4); }
  .featured > div { margin-top: var(--space-4); border-bottom: 1px solid var(--line); }
</style>
