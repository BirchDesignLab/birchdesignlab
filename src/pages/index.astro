---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BarkField from '../components/BarkField.astro';

// Keep the 3a6a0d1 auto-feature logic; the loud moment renders TWO newest live
// specimens as lightweight lines (not SpecimenCard — that's gallery furniture).
const featured = (await getCollection('lab', ({ data }) => data.status === 'live'))
  .sort((a, b) => b.data.designation.localeCompare(a.data.designation))
  .slice(0, 2);
---
<BaseLayout
  title="Birch Design Lab · Custom software and websites"
  description="A design lab building custom software and custom websites for businesses that want to grow. Quiet, fast, built to last."
>
  <section class="hero">
    <BarkField density={170} live />
    <h1 class="billboard">
      <span>Birch</span> <span>Design</span> <span>Lab</span>
    </h1>
  </section>

  <section class="wrap opener">
    <!-- provisional copy: founder may replace -->
    <p class="opener-lead">A design lab, not an agency.</p>
    <p class="subline">
      Custom software and websites for businesses that want to grow and thrive.
      Concocted in a lab where the person who builds your site also answers your emails.
    </p>
  </section>

  <section class="wrap doors">
    <h2>What we build</h2>
    <div class="door-grid">
      <!-- provisional copy -->
      <article class="door">
        <h3>Software</h3>
        <p>
          The tool your business has been hoping for. The spreadsheet that has grown into
          a monster, the process that you dread every week that eats into your weekends?
          We can design, build, and maintain what fixes it.
        </p>
        <a class="more-link" href="/services">How we build software <span class="arw" aria-hidden="true">&rarr;</span></a>
      </article>
      <article class="door">
        <h3>Websites</h3>
        <p>
          A site that loads instantly, reads clearly, and presents your business
          as the only one to even consider calling. No templates, no builders, no bloat.
          Every site designed and constructed by hand.
        </p>
        <a class="more-link" href="/services">How we build websites <span class="arw" aria-hidden="true">&rarr;</span></a>
      </article>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="loud" data-reveal>
      <div class="wrap loud-inner">
        <p class="smallcaps kicker">From the lab</p>
        <p class="pull">Everything we sell, we practice in the open.</p>
        <ul class="specimens" role="list">
          {featured.map((entry) => (
            <li class="specimen">
              <span class="designation smallcaps">{entry.data.designation}</span>
              <span class="sep" aria-hidden="true">&middot;</span>
              <span class="spec-summary">{entry.data.summary}</span>
            </li>
          ))}
        </ul>
        <a class="more-link" href="/lab">Visit the lab <span class="arw" aria-hidden="true">&rarr;</span></a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    position: relative; min-height: 88vh;
    display: grid; place-items: center;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    padding-inline: var(--space-4);
  }
  .billboard {
    position: relative;
    color: var(--billboard-color);
    font-family: var(--font-billboard);
    /* Home renders Marcellus, which ships 400 only; --billboard-weight (500)
       stays for styleguide/bdl-002 faces that really have a 500. Override here
       so the largest type on the site isn't faux-bolded. */
    font-weight: 400;
    font-size: clamp(2.8rem, 9vw, 6.5rem);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-align: center;
    line-height: 1.1;
  }
  @media (max-width: 640px) {
    .billboard span { display: block; }
  }

  /* Opener — the interior display moment. */
  .opener { padding-block: var(--space-7); }
  .opener-lead {
    font-family: var(--font-display); font-size: var(--text-3xl);
    line-height: 1.15; max-width: 22ch;
  }
  .subline {
    margin-top: var(--space-4); font-size: var(--text-lg);
    color: var(--mark-muted); max-width: 44ch;
  }

  /* Two doors. */
  .doors { padding-block: 0 var(--space-7); }
  .door-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6); margin-top: var(--space-4);
  }
  .door { display: flex; flex-direction: column; gap: var(--space-2); }
  .door p { color: var(--mark-muted); max-width: 44ch; }
  .door .more-link { align-self: start; margin-top: var(--space-2); }

  /* Loud moment — green Lab preview (shared .loud pattern). */
  .loud {
    background: var(--green-field); color: var(--gf-mark);
    border-top: 1px solid var(--line);
    --accent: var(--gf-accent); --on-accent: var(--gf-on-accent);
    --link: var(--gf-link); --mark: var(--gf-mark);
  }
  .loud-inner { padding-block: var(--space-7); }
  .kicker { color: var(--accent); }
  .pull {
    font-family: var(--font-display); font-size: var(--text-2xl);
    line-height: 1.2; max-width: 24ch; margin-top: var(--space-3);
  }
  .specimens {
    list-style: none; padding: 0; margin-top: var(--space-5);
    display: flex; flex-direction: column; gap: var(--space-2);
  }
  .designation { color: var(--accent); }
  .sep { margin-inline: 0.4em; opacity: 0.6; }
  .loud .more-link { display: inline-block; margin-top: var(--space-5); }
</style>
