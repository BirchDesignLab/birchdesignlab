---
/**
 * BDL-013, The Drawing Set. bdlBase, the web framework we built, drawn as one
 * engineering sheet: each line of a business's file, tied to the part of the
 * website it causes. Sheet 1 is the whole picture; three numbered details open
 * as their own sheets. Plain says it in everyday words, Under the hood in
 * engineering terms. Day is ink on cream, Night is the cyanotype.
 *
 * Everything static is rendered here from data.ts (every word, and the FACTS
 * behind every number). stage.ts wires the switches, the sheet sequence, the
 * leader hover, the margin zone grid and the fit.
 *
 * Source of truth for look and behaviour: docs/bdl-013/mockups/o7-drawing-set.html.
 *
 * Styles are global and nested under .ds (BDL-012's pattern) because stage.ts
 * builds part of the sheet (the zone grid) where Astro's scoped attributes
 * never reach. State lives on the .ds root, not on <body>: hood, og, used,
 * hovering, data-detail, data-scheme.
 */
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/spectral/500.css';
import PH from './PH.astro';
import {
  BRACES, BUBBLES, CONTROLS, D1, D2, D3, HEADS, LEGEND, NAV_TEXT, NOTES, ROWS, SHEET_NAMES, STRIP,
  ONWARD, SWITCH_NOTE, TB, TB_CTA, TITLE_BLOCK,
} from './data';

const t0 = TB[0];
---
{/* The wall label is fixed over the bottom-left corner and the stage keeps the
    corner clear (stage.ts fit). Below 1760px there is no gutter beside the
    drawing for the open label, so it starts folded. Same rule as BDL-012. */}
<script is:inline>
  if (window.innerWidth < 1760) {
    var dsLabel = document.querySelector('details.label');
    if (dsLabel) dsLabel.removeAttribute('open');
  }
</script>

<div class="ds" id="ds" data-detail="0">
  {/* Read the share switches before first paint, on the stage root only. The
      scheme is never written to <html> or to storage, so leaving the page
      leaves the site's own theme as the visitor had it. */}
  <script is:inline>
    (function () {
      var r = document.currentScript.parentElement, q = new URLSearchParams(location.search);
      var s = q.get('scheme');
      if (s === 'dark' || s === 'light') r.setAttribute('data-scheme', s);
      if (q.get('hood') === '1') r.classList.add('hood');
      var d = parseInt(q.get('detail') || (location.hash.match(/detail-(\d)/) || [])[1] || '0', 10) || 0;
      if (d >= 1 && d <= 3) r.setAttribute('data-detail', String(d));
      if (q.get('og') === '1') { r.classList.add('og'); document.documentElement.classList.add('ds-og'); }
    })();
  </script>

  <div id="stage">
    <div class="frame" aria-hidden="true"></div>
    <div id="ctrl">
      <div class="seg" id="mode">{CONTROLS.mode.map((c, i) => <button type="button" data-v={c.v} class={i === 0 ? 'on' : undefined}>{c.label}</button>)}</div>
      <div class="seg" id="scheme">{CONTROLS.scheme.map((c) => <button type="button" data-v={c.v}>{c.label}</button>)}</div>
    </div>

    {/* title block: first read. The Plain title stands alone. */}
    <div id="tb">
      <div class="name" id="tbName">{TITLE_BLOCK.name}</div>
      <div class="ttl" id="tbTitle">{t0.t.map((line, i) => <>{i > 0 && <br />}{line}</>)}</div>
      <div class="sheet" id="tbSheet">{t0.s}</div>
      <div class="sent"><span id="tbP" class="p">{t0.p}</span><span id="tbH" class="h">{t0.h}</span><span class="cta" id="tbC"> <span class="p">{TB_CTA.p}</span><span class="h">{TB_CTA.h}</span></span></div>
      <div class="cell c1"><b>{TITLE_BLOCK.subject.label}</b> {TITLE_BLOCK.subject.value}</div>
      <div class="cell c2"><b>{TITLE_BLOCK.source.label}</b> {TITLE_BLOCK.source.value}</div>
    </div>

    {/* ================= SHEET 1 ================= */}
    <div class="mainsheet">
      <div id="elev">
        <div class="eh" style="grid-column:1;grid-row:1"><PH t={HEADS.file} /></div>
        <div class="eh ec" style="grid-column:3;grid-row:1"><PH t={HEADS.site} /></div>
        <div class="eh ed" style="grid-column:5;grid-row:1"><PH t={HEADS.details} /></div>

        <div class="hint" style="grid-row:1"><PH t={HEADS.hint} /></div>
        <div class="bracket" aria-hidden="true"></div>

        <div class="fl nolead br brace" style={`grid-row:${BRACES.open.row}`}>{BRACES.open.text}</div>

        {ROWS.map((r) => (
          <>
            <div class:list={['fl', 'row', { br: r.fl.indent, ghost: r.fl.ghost }]} data-r={r.id} style={`grid-row:${r.row}`}>
              {r.fl.bal && <span class="bn" style={r.fl.pull ? 'margin-left:-32px' : undefined}><span class:list={['bal', { dash: r.fl.dashBal }]}>{r.fl.bal}</span></span>}
              <span class="tk code">{r.fl.wide ? <><span class="dk">{r.fl.code}</span><span class="wf">{r.fl.wide}</span></> : r.fl.code}</span>
            </div>
            <div class:list={['ld', 'row', { dash: r.dashed }]} data-r={r.id} style={`grid-row:${r.row}`}><i></i><span class="lb"><PH t={r.lead} /></span></div>
            {r.slab.kind === 'sub' ? (
              <div class:list={['sl', 'sub', 'row', { first3: r.slab.first3 }]} data-r={r.id} style={`grid-row:${r.row}`}>
                <span class="tab">{r.slab.tab && <span class="bal">{r.slab.tab}</span>}</span>
                <span class="sb"><b><PH t={r.slab.b!} /></b><span><PH t={r.slab.sub!} wbr={r.slab.wbr} /></span></span>
              </div>
            ) : (
              <div class:list={['sl', 'row', { first: r.slab.first, ghostsl: r.slab.kind === 'ghost' }]} data-r={r.id} style={`grid-row:${r.row}`}>
                <span class="tab"><span class="bal">{r.slab.tab}</span></span>
                <span class="nm">{r.slab.name}</span>
                <span class="tx"><PH t={r.slab.tx!} wbr={r.slab.wbr} /></span>
              </div>
            )}
          </>
        ))}

        <div class="fl nolead br brace" style={`grid-row:${BRACES.close.row}`}>{BRACES.close.text}</div>
        <div class="sl sub note" style={`grid-row:${BRACES.close.row}`}><span class="tab"></span><span class="sb"><b><PH t={SWITCH_NOTE.b} /></b><span><PH t={SWITCH_NOTE.sub} /></span></span></div>

        {/* legend, and the forks to the three detail bubbles */}
        <div class="legend" style="grid-row:3/5">
          {LEGEND.map((l) => (
            <div>
              <svg width="46" height="12" aria-hidden="true"><path d="M0 6H40" stroke="var(--lead)" stroke-width="2" stroke-dasharray={l.dashed ? '5 4' : undefined} fill="none"/><polygon points="46,6 38,1.5 38,10.5" fill="var(--lead)"/></svg><PH t={l.t} />
            </div>
          ))}
        </div>
        <svg class="fork" aria-hidden="true" style="grid-row:5/9;width:58px;height:200px" viewBox="0 0 58 200">
          <path d="M0 75H24V50H52M24 75V150H52"/><polygon points="58,50 49,45 49,55"/><polygon points="58,150 49,145 49,155"/>
        </svg>
        <svg class="fork" aria-hidden="true" style="grid-row:10/12;width:58px;height:100px" viewBox="0 0 58 100">
          <path d="M0 75H24V50H52"/><polygon points="58,50 49,45 49,55"/>
        </svg>
        {BUBBLES.map((b) => (
          <button class={`bub ${b.cls}`} data-detail={b.detail} style={`grid-row:${b.rows}`} type="button">
            <span class="bal">{b.n}</span>
            <span class="bt"><b><PH t={b.title} /></b><span><PH t={b.sub} /></span></span>
            <span class="open">{NAV_TEXT.open} →</span>
          </button>
        ))}
      </div>

      <div id="nt">
        <ol class="p">{NOTES.p.map((n, i) => <li><i>{i + 1}.</i><span>{n}</span></li>)}</ol>
        <ol class="h">{NOTES.h.map((n, i) => <li><i>{i + 1}.</i><span>{n}</span></li>)}</ol>
      </div>
    </div>

    {/* ================= DETAIL 1: Off is gone ================= */}
    <section class="detail d1" id="d1" aria-label={D1.aria}>
      <div class="dhead"><span class="bal">{D1.head.bal}</span><h2><PH t={D1.head.title} /></h2>
        <p class="p">{D1.head.lede.p}</p>
        <p class="h">{D1.head.lede.h}</p></div>
      <div class="cols">
        <figure class="tree nodim" style="margin:0">
          <div class="th"><b><PH t={D1.restaurant.th.b} /></b><span><PH t={D1.restaurant.th.sub} /></span></div>
          {D1.restaurant.rows.map((r) => <div class:list={['tr', r.l ? `l${r.l}` : '', r.s === 'on' && 'on', r.s === 'gone' && 'gone', 'code']}>{r.t}</div>)}
        </figure>
        <figure class="tree" style="margin:0">
          <div class="th"><b><a href={D1.salon.href}><PH t={D1.salon.th.b} /></a></b><span><PH t={D1.salon.th.sub} /></span></div>
          {D1.salon.rows.map((r) => <div class:list={['tr', r.l ? `l${r.l}` : '', r.s === 'on' && 'on', r.s === 'gone' && 'gone', 'code']}>{r.t}</div>)}
          {D1.salon.dims.map((d) => <div class="dim" style={`--a:${d.a};--b:${d.b}`}><span class="dl"><PH t={d.label} /></span></div>)}
        </figure>
        <div class="zero">
          <div class="n">{D1.zero.n}</div>
          <b><PH t={D1.zero.b} /></b>
          <p><PH t={D1.zero.p} /></p>
        </div>
      </div>
    </section>

    {/* ================= DETAIL 2: ordering parts list ================= */}
    <section class="detail d2" id="d2" aria-label={D2.aria}>
      <div class="dhead"><span class="bal">{D2.head.bal}</span><h2><PH t={D2.head.title} /></h2>
        <p class="p">{D2.head.lede.p}</p>
        <p class="h">{D2.head.lede.h}</p></div>
      <div class="cols">
        <svg viewBox="0 0 360 470" role="img" aria-label={D2.svg.label}>
          <g fill="none" stroke="currentColor" stroke-width="2" style="color:var(--ink)">
            <rect x="70" y="8" width="220" height="56" fill="var(--tile)"/>
            <rect x="20" y="134" width="320" height="218" fill="var(--slab)"/>
            <rect x="26" y="140" width="308" height="206" stroke-width="1"/>
            <rect x="20" y="394" width="150" height="64" fill="var(--tile)"/>
            <rect x="190" y="394" width="150" height="64" fill="var(--tile)"/>
            <rect x="244" y="150" width="76" height="34" stroke-width="1.5"/>
          </g>
          <g fill="none" stroke="var(--lead)" stroke-width="2">
            <path d="M180 134V70"/><path d="M180 70l-6 10M180 70l6 10" />
            <path d="M95 352V394"/><path d="M265 352V394"/>
          </g>
          <g>
            <circle cx="180" cy="102" r="14" fill="var(--field)" stroke="var(--lead)" stroke-width="1.5"/>
          </g>
          <g font-family="Marcellus,serif" text-anchor="middle" fill="currentColor" style="color:var(--ink)">
            <text x="180" y="43" font-size="26">{D2.svg.menu}</text>
            <text x="44" y="178" font-size="30" text-anchor="start">{D2.svg.ordering}</text>
            <text class="p" x="95" y="432" font-size="18" font-family="Spectral,serif">{D2.svg.serverCode.p}</text>
            <text class="p" x="265" y="432" font-size="18" font-family="Spectral,serif">{D2.svg.liveStorage.p}</text>
            <text class="h" x="95" y="432" font-size="14" font-family="IBM Plex Mono,monospace">{D2.svg.serverCode.h}</text>
            <text class="h" x="265" y="432" font-size="14" font-family="IBM Plex Mono,monospace">{D2.svg.liveStorage.h}</text>
          </g>
          <g font-family="Marcellus,serif" text-anchor="middle" font-size="18">
            <text x="180" y="107" fill="currentColor" style="color:var(--ink)">{D2.svg.menuCount}</text>
          </g>
          <g font-family="IBM Plex Mono,monospace" font-size="15" fill="currentColor" style="color:var(--ink)">
            {D2.svg.routes.map((r, i) => <text x="44" y={216 + i * 26}>{r}</text>)}
            <text x="44" y="340" fill-opacity=".6">{D2.svg.more}</text>
            <text x="95" y="452" text-anchor="middle" font-size="14">{D2.svg.className}</text>
            <text x="265" y="452" text-anchor="middle" font-size="14">{D2.svg.binding}</text>
            <text x="282" y="172" text-anchor="middle" font-size="15">{D2.svg.navTag}</text>
          </g>
          <g font-family="Spectral,serif" font-size="18" fill="currentColor" style="color:var(--muted)">
            <text class="p" x="214" y="104" text-anchor="start">{D2.svg.needs.p}</text>
            <text class="h" x="214" y="104" text-anchor="start" font-family="IBM Plex Mono,monospace" font-size="13">{D2.svg.needs.h}</text>
          </g>
          <g font-family="Marcellus,serif" font-size="18" text-anchor="middle">
            <circle cx="26" cy="190" r="14" fill="var(--field)" stroke="var(--lead)" stroke-width="1.5"/><text x="26" y="196" fill="currentColor" style="color:var(--ink)">1</text>
            <circle cx="228" cy="167" r="14" fill="var(--field)" stroke="var(--lead)" stroke-width="1.5"/><text x="228" y="173" fill="currentColor" style="color:var(--ink)">2</text>
            <circle cx="95" cy="373" r="14" fill="var(--field)" stroke="var(--lead)" stroke-width="1.5"/><text x="95" y="379" fill="currentColor" style="color:var(--ink)">4</text>
            <circle cx="265" cy="373" r="14" fill="var(--field)" stroke="var(--lead)" stroke-width="1.5"/><text x="265" y="379" fill="currentColor" style="color:var(--ink)">5</text>
          </g>
        </svg>
        <div class="bom">
          <div class="bh"><span>{D2.bomHead.n}</span><span><PH t={D2.bomHead.part} /></span><span><PH t={D2.bomHead.what} /></span></div>
          {D2.bom.map((r) => (
            <div class="br"><span class="bal">{r.bal}</span><b><PH t={r.name} /></b>
              <div class="w"><span class="p">{r.w.p}{r.more && <> <span class="more">{r.more}</span></>}</span><span class="h">{r.w.h}</span></div></div>
          ))}
        </div>
      </div>
    </section>

    {/* ================= DETAIL 3: notes + revision ================= */}
    <section class="detail d3" id="d3" aria-label={D3.aria}>
      <div class="dhead"><span class="bal">{D3.head.bal}</span><h2><PH t={D3.head.title} /></h2>
        <p class="p">{D3.head.lede.p}</p>
        <p class="h">{D3.head.lede.h}</p></div>
      <div class="cols">
        <div>
          <h3><span class="p">{D3.ratings.h3.t.p}<small>{D3.ratings.h3.small.p}</small></span><span class="h">{D3.ratings.h3.t.h}<small>{D3.ratings.h3.small.h}</small></span></h3>
          {D3.ratings.items.map((r) => (
            <div class="rate"><span class="bal">{r.bal}</span><div><b><PH t={r.b} /></b><span><PH t={r.s} /></span></div></div>
          ))}
        </div>
        <div>
          <h3><span class="p">{D3.gates.h3.t.p}<small>{D3.gates.h3.small.p}</small></span><span class="h">{D3.gates.h3.t.h}<small>{D3.gates.h3.small.h}</small></span></h3>
          {D3.gates.items.map((g) => <div class:list={['gate', { last: g.last }]}><span><PH t={g.name} /></span></div>)}
          <div class="lh">
            {D3.gates.lighthouse.map((l) => <div><PH t={l.name} /><b><span class="p">{l.vp}</span><span class="h">{l.v}</span></b></div>)}
          </div>
          <p class="pay"><PH t={D3.gates.pay} /></p>
        </div>
        <div>
          <h3><span class="p">{D3.revision.h3.t.p}<small>{D3.revision.h3.small.p}</small></span><span class="h">{D3.revision.h3.t.h}<small>{D3.revision.h3.small.h}</small></span></h3>
          <div class="rev">
            <div class="rh"><span><PH t={D3.revision.head[0]} /></span><span><PH t={D3.revision.head[1]} /></span></div>
            {D3.revision.rows.map((r) => (
              <div class:list={['rr', { nv: r.never }]}><b><PH t={r.name} /></b><div><PH t={r.w} /></div></div>
            ))}
          </div>
          <p class="rev-note"><PH t={D3.revision.note} /></p>
        </div>
      </div>
    </section>

    {/* The sheet sequence. Last in the stage so that on a phone, where it is
        sticky to the bottom of the stage, it leaves with the stage and never
        covers the specimen plate below. Over the drawing it is absolute. */}
    <nav id="nav" aria-label="Sheet sequence">
      <div class="strip">
        {STRIP.map((m, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true">·</span>}
            <button class="mk" type="button" data-go={m.go} aria-label={m.aria}><span class="mi">{m.mi}</span>{m.ml && <span class="ml">{m.ml}</span>}</button>
          </>
        ))}
      </div>
      <div class="acts">
        <button class="go alt" id="prev" type="button" hidden>← <span class="long">{NAV_TEXT.backLong}</span><span class="short">{NAV_TEXT.backShort}</span></button>
        <span class="cue" id="cue"><span>{NAV_TEXT.cue}</span>
          <svg class="ah" width="46" height="14" viewBox="0 0 46 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 7H43"/><path d="M37 2l7 5-7 5"/></svg>
          <svg class="av" width="26" height="22" viewBox="0 0 26 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M24 1L4 19"/><path d="M4 11v8h8"/></svg></span>
        <button class="go" id="next" type="button"><span class="long">{NAV_TEXT.next}{SHEET_NAMES[1]}</span><span class="short">{NAV_TEXT.nextShort}</span> →</button>
        <a class="go" id="onward" href={ONWARD.href} hidden><span class="long">{ONWARD.long}</span><span class="short">{ONWARD.short}</span> →</a>
      </div>
    </nav>
  </div>
</div>

<script>
  import { mount } from './stage';
  mount();
</script>

<style is:global>
  /* ---- the stage's own faces. Defined on .ds so nothing leaks to the site. ----
     Default is the visitor's site scheme (html[data-scheme], set by
     ThemeBootstrap); .ds[data-scheme] overrides it for the stage alone. */
  .ds {
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --field: #f5f1e8; --ink: #1f1b15; --muted: #4a4337; --lead: #2b4a37; --warm: #a8743f;
    --slab: #e8e8dc; --tile: #efe9dc; --mark: #1f1b15; --accent: #2b4a37; --accent-strong: #4a3a2c;
    --line: color-mix(in srgb, var(--ink) 30%, transparent);
    --faint: color-mix(in srgb, var(--ink) 15%, transparent);
  }
  .ds[data-scheme="dark"] {
    --field: #0d2744; --ink: #e8f2fc; --muted: #b4cce2; --lead: #8fd3ff; --warm: #ffd08a;
    --slab: #143357; --tile: #12304f; --mark: #e8f2fc; --accent: #8fd3ff; --accent-strong: #e0b27a;
  }
  html[data-scheme="dark"] .ds:not([data-scheme]) {
    --field: #0d2744; --ink: #e8f2fc; --muted: #b4cce2; --lead: #8fd3ff; --warm: #ffd08a;
    --slab: #143357; --tile: #12304f; --mark: #e8f2fc; --accent: #8fd3ff; --accent-strong: #e0b27a;
  }

  /* ---- the Lab chrome wears the stage's face ----
     The pill, the wall label and the specimen plate are site components on
     site tokens, so beside the navy or cream sheet they showed a seam in the
     site's own brown. stage.ts stamps the stage's face on <html> as
     data-ds-face (never data-scheme, so the visitor's site theme is untouched
     and nothing is stored), and these three borrow the sheet's colours. */
  html[data-ds-face] .hatch, html[data-ds-face] details.label, html[data-ds-face] details.plate {
    --field: #f5f1e8; --mark: #1f1b15; --mark-muted: #4a4337; --accent: #2b4a37; --link: #2b4a37;
    --line: color-mix(in srgb, #1f1b15 22%, transparent);
    --line-accent: color-mix(in srgb, #2b4a37 45%, transparent);
  }
  html[data-ds-face="dark"] .hatch, html[data-ds-face="dark"] details.label, html[data-ds-face="dark"] details.plate {
    --field: #0d2744; --mark: #e8f2fc; --mark-muted: #b4cce2; --accent: #8fd3ff; --link: #8fd3ff;
    --line: color-mix(in srgb, #e8f2fc 22%, transparent);
    --line-accent: color-mix(in srgb, #8fd3ff 45%, transparent);
  }

  /* ---- the box: one viewport tall, the drawing scales inside it ---- */
  .ds {
    position: relative; height: 100svh; min-height: 520px; overflow: hidden;
    background: var(--field); color: var(--ink);
    font-family: 'Spectral', Georgia, serif; font-size: 16px; line-height: normal;
    font-variant-numeric: lining-nums;
  }
  .ds *, .ds *::before, .ds *::after { box-sizing: border-box; border-radius: 0; }
  .ds button { font: inherit; color: inherit; cursor: pointer; background: none; border: 0; padding: 0; text-align: left; }
  .ds button:focus-visible { outline: 2px solid var(--lead); outline-offset: 3px; }
  .ds a { color: inherit; }
  .ds:not(.hood) .h { display: none !important; }
  .ds.hood .p { display: none !important; }
  .ds .code { font-family: 'IBM Plex Mono', monospace; }

  .ds #stage { position: absolute; left: 0; top: 0; width: 1440px; height: 900px; transform-origin: 0 0; overflow: hidden; background: var(--field); animation: ds-ink .9s var(--ease) both; }
  .ds.og #stage { width: 1200px; height: 630px; }
  @keyframes ds-ink { from { opacity: .18 } to { opacity: 1 } }

  /* frame and zone grid */
  .ds .frame { position: absolute; inset: 14px; border: 2px solid var(--ink); pointer-events: none; }
  .ds .frame::before { content: ""; position: absolute; inset: 24px; border: 1px solid var(--ink); }
  .ds .zone { position: absolute; font: 400 11px 'IBM Plex Mono', monospace; color: var(--muted); width: 20px; text-align: center; }
  .ds .tick { position: absolute; background: var(--ink); opacity: .6; }

  /* top bar: the two view switches, top right (the Lab pill owns top left) */
  .ds #ctrl { position: absolute; right: 64px; top: 44px; display: flex; gap: 10px; z-index: 3; }
  .ds .seg { display: flex; border: 1.5px solid var(--ink); }
  .ds .seg button { font: 500 14px 'IBM Plex Mono', monospace; padding: 9px 14px; color: var(--muted); }
  .ds .seg button.on { background: var(--tile); color: var(--ink); box-shadow: inset 0 -2px 0 var(--ink); }
  .ds .mainsheet { display: block; }
  .ds:not([data-detail="0"]) .mainsheet { display: none; }

  /* balloon */
  .ds .bal { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border: 1.5px solid var(--lead); border-radius: 50% !important; font: 500 16px/1 'Spectral', serif; color: var(--ink); background: var(--field); flex: none; }
  .ds .bal.dash { border-style: dashed; }

  /* ---- main elevation grid ---- */
  .ds #elev { position: absolute; left: 64px; top: 86px; display: grid;
    grid-template-columns: 356px 168px 430px 58px 300px;
    grid-template-rows: 40px 28px repeat(9, 50px); }
  .ds .eh { align-self: center; font: 400 19px/1.1 'Marcellus', serif; white-space: nowrap; }
  .ds .eh small { display: block; font: 400 16px 'Spectral', serif; color: var(--muted); }
  .ds.hood .eh { font: 500 14px 'IBM Plex Mono', monospace; }

  /* file lines */
  .ds .fl { grid-column: 1; display: flex; align-items: center; gap: 6px; font: 400 14px/1 'IBM Plex Mono', monospace; white-space: pre; position: relative; color: var(--muted); }
  .ds .fl .bn { width: 26px; flex: none; display: flex; justify-content: center; }
  .ds .fl .tk { padding: 6px 7px; outline: 1.5px solid var(--lead); background: color-mix(in srgb, var(--lead) 11%, transparent); color: var(--ink); }
  .ds .fl.ghost .tk { outline-style: dashed; background: none; color: var(--muted); }
  .ds .fl::after { content: ""; flex: 1; min-width: 0; border-top: 1.5px dotted var(--lead); margin-left: 2px; }
  .ds .fl.nolead::after { display: none; }
  .ds .fl.br { padding-left: 32px; }

  .ds .bracket { grid-column: 1; grid-row: 3/12; margin: 0 0 0 -16px; width: 10px; border: 1.5px solid var(--lead); border-right: 0; pointer-events: none; align-self: stretch; margin-top: 12px; margin-bottom: 25px; }

  /* leaders */
  .ds .ld { grid-column: 2; position: relative; }
  .ds .ld::before { content: ""; position: absolute; left: 0; right: 11px; top: 50%; margin-top: -1px; border-top: 2px solid var(--lead); }
  .ds .ld::after { content: ""; position: absolute; right: 0; top: 50%; margin-top: -6px; border: 6px solid transparent; border-left: 12px solid var(--lead); border-right: 0; }
  .ds .ld i { position: absolute; left: -5px; top: 50%; width: 10px; height: 10px; margin-top: -5px; background: var(--lead); border-radius: 50% !important; }
  .ds .ld.dash::before { border-top-style: dashed; }
  .ds .ld.dash i { background: var(--field); border: 2px solid var(--lead); }
  .ds .ld .lb { position: absolute; left: 12px; right: 16px; bottom: calc(50% + 5px); text-align: center; font: italic 400 16px/1.1 'Spectral', serif; color: var(--ink); white-space: nowrap; }
  .ds.hood .ld .lb { font: 400 13px/1.1 'IBM Plex Mono', monospace; font-style: normal; }

  /* slabs */
  .ds .sl { grid-column: 3; display: grid; grid-template-columns: 52px 132px 1fr; align-items: center; border: 2px solid var(--ink); border-top: 0; background: var(--slab); position: relative; min-width: 0; }
  .ds .sl.first { border-top: 2px solid var(--ink); }
  .ds .sl .tab { align-self: stretch; display: flex; align-items: center; justify-content: center; border-right: 1.5px solid var(--ink); background: repeating-linear-gradient(135deg, var(--faint) 0 2px, transparent 2px 7px); }
  .ds .sl .nm { font: 400 21px/1 'Marcellus', serif; padding-left: 12px; }
  .ds .sl .tx { font: 400 16px/1.2 'Spectral', serif; padding: 0 10px 0 0; min-width: 0; }
  .ds.hood .sl .tx { font: 400 13px/1.25 'IBM Plex Mono', monospace; }
  .ds .sl.sub { grid-template-columns: 52px 1fr; }
  .ds .sl.sub .tab { border-right: 1.5px solid var(--ink); }
  .ds .sl.sub .sb { padding: 0 10px 0 14px; min-width: 0; }
  .ds .sl.sub .sb b { display: block; font: 400 18px/1.15 'Marcellus', serif; }
  .ds .sl.sub .sb > span { display: block; font: 400 16px/1.2 'Spectral', serif; color: var(--muted); }
  .ds .sl.sub .sb b span { font: inherit; color: inherit; }
  .ds.hood .sl.sub .sb b { font: 500 14px/1.2 'IBM Plex Mono', monospace; }
  .ds.hood .sl.sub .sb > span { font: 400 13px/1.2 'IBM Plex Mono', monospace; }
  .ds .sl.sub:not(.first):not(.lead3) { border-top: 0; }
  .ds .sl.sub.dv { border-top: 0; }
  .ds .sl.note, .ds .sl.sub.note { background: none; border: 0; }
  .ds .sl.note .tab { background: none; border-right: 0; }
  .ds .sl.ghostsl { border: 2px dashed var(--ink); background: color-mix(in srgb, var(--field) 55%, var(--slab)); }
  .ds .sl.ghostsl .nm { color: var(--muted); }
  .ds .sl.note .sb { color: var(--muted); }
  .ds .sl.note .sb span { font-style: italic; }
  .ds .row.hl.sl { background: color-mix(in srgb, var(--lead) 22%, var(--slab)); }
  .ds .row.hl .tk { background: color-mix(in srgb, var(--lead) 26%, transparent); }
  .ds .row.hl.ld::before { border-top-width: 3px; margin-top: -1.5px; }
  .ds.hovering .row:not(.hl) { opacity: .5; }
  .ds .row { transition: opacity .3s var(--ease), background .3s var(--ease); }

  /* bubble cards and forks */
  .ds .bub { grid-column: 5; display: flex; gap: 12px; align-items: center; border: 1.5px solid var(--ink); padding: 10px 14px; opacity: .8; transition: opacity .3s var(--ease), background .3s, transform .3s var(--ease), box-shadow .3s; margin: 3px 0; background: none; position: relative; cursor: pointer; }
  .ds .bub:hover, .ds .bub:focus-visible { opacity: 1; background: var(--tile); border-color: var(--ink); box-shadow: inset 0 0 0 .5px var(--ink), 0 3px 0 var(--ink); transform: translateY(-2px); }
  .ds .bub .bal { width: 36px; height: 36px; font-size: 20px; border-color: var(--ink); margin: 0; }
  .ds .bub b { display: block; font: 400 20px/1.1 'Marcellus', serif; }
  .ds .bub b span { font: inherit; }
  .ds .bub .bt > span { display: block; margin-top: 3px; font: 400 16px/1.2 'Spectral', serif; color: var(--muted); }
  .ds.hood .bub b { font: 500 14px/1.2 'IBM Plex Mono', monospace; }
  .ds.hood .bub .bt > span { font: 400 13px/1.2 'IBM Plex Mono', monospace; }
  .ds .fork { grid-column: 4; overflow: visible; opacity: .55; }
  .ds .fork path { fill: none; stroke: var(--lead); stroke-width: 1.5; }
  .ds .fork polygon { fill: var(--lead); }
  .ds .hint, .ds .fl .dk { display: none; }
  .ds .legend { grid-column: 5; align-self: center; }
  .ds .legend div { display: flex; align-items: center; gap: 10px; font: 400 16px/1.2 'Spectral', serif; color: var(--muted); margin-top: 8px; }
  .ds.hood .legend div { font: 400 13px 'IBM Plex Mono', monospace; }
  .ds.og .legend { display: none; }

  /* title block and notes */
  .ds #tb { position: absolute; left: 700px; top: 610px; width: 676px; height: 184px; border: 2px solid var(--ink); display: grid; grid-template-columns: 190px 1fr 150px; grid-template-rows: 76px 1fr 30px; background: var(--field); }
  .ds #tb > div { border: 1px solid var(--ink); padding: 8px 12px; display: flex; flex-direction: column; justify-content: center; min-width: 0; }
  .ds #tb .name { font: 400 44px/1 'Marcellus', serif; }
  .ds #tb .ttl { font: 400 30px/1.08 'Marcellus', serif; }
  .ds #tb .sheet { font: 500 16px/1.2 'IBM Plex Mono', monospace; padding: 8px; white-space: nowrap; }
  .ds #tb .sent { grid-column: 1/-1; font: 400 16px/1.3 'Spectral', serif; justify-content: center; padding: 4px 12px; }
  .ds.hood #tb .sent { font: 400 13px/1.45 'IBM Plex Mono', monospace; }
  .ds #tb .cell { font: 400 16px/1.1 'Spectral', serif; color: var(--muted); flex-direction: row; align-items: center; justify-content: flex-start; white-space: nowrap; }
  .ds #tb .cell b { font-weight: 500; color: var(--ink); margin-right: 6px; }
  .ds #tb .c1 { grid-column: 1/3; }
  .ds #tb .c2 { grid-column: 3; }
  .ds #nt { position: absolute; left: 64px; top: 622px; width: 616px; height: 80px; padding: 0; }
  .ds #nt ol { margin: 0; padding: 0; list-style: none; font: 400 16px/1.3 'Spectral', serif; color: var(--muted); }
  .ds #nt li { display: flex; gap: 10px; margin-top: 4px; }
  .ds #nt li i { font: 500 16px/1.3 'IBM Plex Mono', monospace; font-style: normal; color: var(--lead); width: 22px; flex: none; }
  .ds.hood #nt ol { font: 400 13px/1.4 'IBM Plex Mono', monospace; }

  /* ---- SHARED "TRY IT" PATTERN: filled action, cue, progress strip ---- */
  .ds a.go { text-decoration: none; }
  .ds .bub b { text-wrap: balance; }
  .ds .go { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 12px 18px; background: var(--mark); color: var(--field); font: 500 15px/1.2 'IBM Plex Mono', monospace; border: 2px solid var(--mark); text-align: left; transition: background .25s var(--ease), border-color .25s var(--ease); }
  .ds .go:hover, .ds .go:focus-visible { background: var(--accent); border-color: var(--accent); }
  .ds .go:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .ds .go.alt { background: var(--field); color: var(--ink); border-color: var(--ink); }
  .ds .go.alt:hover, .ds .go.alt:focus-visible { background: var(--tile); border-color: var(--ink); }
  .ds #nav { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .ds #nav > * { pointer-events: auto; }
  .ds .strip { position: absolute; left: 64px; top: 804px; width: 616px; display: flex; align-items: stretch; border: 1.5px solid var(--ink); height: 52px; }
  .ds .mk { display: flex; align-items: center; gap: 7px; padding: 0 12px; font: 400 16px/1 'Spectral', serif; color: var(--muted); border-bottom: 3px solid transparent; white-space: nowrap; text-align: left; }
  .ds .mk .mi { font: 500 15px/1 'IBM Plex Mono', monospace; }
  .ds .mk:hover { color: var(--ink); }
  .ds .mk[aria-current="step"] { color: var(--ink); font-weight: 500; background: var(--tile); border-bottom-color: var(--ink); }
  .ds .sep { align-self: center; color: var(--muted); font-size: 16px; }
  .ds .acts { position: absolute; left: 700px; top: 804px; width: 676px; display: flex; align-items: center; gap: 12px; min-height: 52px; }
  .ds .acts .go { font-size: 17px; min-height: 52px; padding: 14px 24px; }
  .ds .cue { display: flex; align-items: center; gap: 8px; font: 500 15px/1 'Spectral', serif; font-variant: small-caps; letter-spacing: .12em; color: var(--accent-strong); white-space: nowrap; }
  .ds .cue svg { display: block; }
  .ds .cue .av { display: none; }
  .ds .go .short { display: none; }
  .ds.used .cue, .ds:not([data-detail="0"]) .cue { display: none; }
  .ds #nav [hidden] { display: none !important; }
  .ds .bub .open { position: absolute; right: 10px; bottom: 9px; background: var(--ink); color: var(--field); font: 500 15px/1 'IBM Plex Mono', monospace; padding: 7px 10px; transition: background .25s; }
  .ds .bub:hover .open, .ds .bub:focus-visible .open { background: var(--lead); color: var(--field); }
  .ds.og #nav { display: none; }

  /* ---- detail sheets ---- */
  .ds .detail { position: absolute; left: 64px; top: 96px; width: 1312px; height: 504px; display: none; animation: ds-ink .6s var(--ease) both; }
  .ds[data-detail="1"] #d1, .ds[data-detail="2"] #d2, .ds[data-detail="3"] #d3 { display: block; }
  .ds .dhead { display: flex; align-items: center; gap: 16px; height: 52px; border-bottom: 2px solid var(--ink); margin-bottom: 14px; }
  .ds .dhead h2 { margin: 0; font: 400 32px/1 'Marcellus', serif; white-space: nowrap; }
  .ds.hood .dhead h2 { font: 500 22px/1 'IBM Plex Mono', monospace; }
  .ds .dhead p { margin: 0 0 0 12px; font: 400 17px/1.25 'Spectral', serif; color: var(--muted); }
  .ds.hood .dhead p { font: 400 13px/1.35 'IBM Plex Mono', monospace; }
  .ds .dhead .bal { width: 38px; height: 38px; font-size: 22px; border-color: var(--ink); margin: 0; }

  /* detail 1 */
  .ds .d1 .cols { display: grid; grid-template-columns: 500px 500px 1fr; gap: 34px; height: 438px; }
  .ds .tree { position: relative; --rw: 26px; --hdr: 62px; }
  .ds .tree .th { height: var(--hdr); border-bottom: 1.5px solid var(--ink); margin-bottom: 6px; padding-bottom: 6px; }
  .ds .tree .th b { display: block; font: 400 24px/1.1 'Marcellus', serif; }
  .ds .tree .th b span { font: inherit; }
  .ds .tree .th > span { display: block; font: 400 16px/1.25 'Spectral', serif; color: var(--muted); }
  .ds.hood .tree .th b { font: 500 17px 'IBM Plex Mono', monospace; }
  .ds.hood .tree .th > span { font: 400 13px 'IBM Plex Mono', monospace; }
  /* The one link out: the salon tree's heading goes to its own page (BDL-008). */
  .ds .tree .th b a { color: var(--ink); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .22em; text-decoration-color: color-mix(in srgb, var(--ink) 55%, transparent); transition: color .25s var(--ease), text-decoration-color .25s var(--ease); }
  .ds .tree .th b a:hover, .ds .tree .th b a:focus-visible { color: var(--lead); text-decoration-color: var(--lead); }
  .ds .tree .th b a:focus-visible { outline: 2px solid var(--lead); outline-offset: 3px; }
  .ds .tr { height: var(--rw); display: flex; align-items: center; font: 400 14px 'IBM Plex Mono', monospace; white-space: pre; width: 330px; padding-left: 8px; margin: 0; }
  .ds .tr.l1 { padding-left: 28px; }
  .ds .tr.l2 { padding-left: 48px; }
  .ds .tr.on { border-left: 3px solid var(--lead); background: color-mix(in srgb, var(--lead) 8%, transparent); }
  .ds .tr.gone { outline: 1px dashed var(--ghostc, var(--muted)); outline-offset: -3px; color: var(--muted); opacity: .7; }
  .ds .dim { position: absolute; left: 350px; top: calc(var(--hdr) + 6px + var(--a) * var(--rw) + 3px); height: calc((var(--b) - var(--a) + 1) * var(--rw) - 6px); width: 22px;
    background: linear-gradient(var(--lead), var(--lead)) center/1.5px 100% no-repeat, linear-gradient(var(--lead), var(--lead)) top/22px 1.5px no-repeat, linear-gradient(var(--lead), var(--lead)) bottom/22px 1.5px no-repeat; }
  .ds .dim::before, .ds .dim::after { content: ""; position: absolute; left: 50%; margin-left: -5px; border: 5px solid transparent; }
  .ds .dim::before { top: 1px; border-bottom: 10px solid var(--lead); border-top: 0; }
  .ds .dim::after { bottom: 1px; border-top: 10px solid var(--lead); border-bottom: 0; }
  .ds .dim .dl { position: absolute; left: 32px; top: 50%; transform: translateY(-50%); width: 118px; font: italic 400 17px/1.15 'Spectral', serif; color: var(--ink); }
  .ds.hood .dim .dl { font: 400 13px/1.3 'IBM Plex Mono', monospace; font-style: normal; }
  .ds .zero { border: 2px solid var(--ink); padding: 16px 16px 14px; align-self: start; background: var(--tile); }
  .ds .zero .n { font: 500 120px/.95 'IBM Plex Mono', monospace; color: var(--lead); }
  .ds .zero b { display: block; margin-top: 6px; font: 400 22px/1.1 'Marcellus', serif; }
  .ds .zero p { margin: 10px 0 0; font: 400 16px/1.3 'Spectral', serif; color: var(--muted); }
  .ds.hood .zero b { font: 500 15px/1.3 'IBM Plex Mono', monospace; }
  .ds.hood .zero p { font: 400 12.5px/1.4 'IBM Plex Mono', monospace; }

  /* detail 2 */
  .ds .d2 .cols { display: grid; grid-template-columns: 330px 1fr; gap: 40px; height: 438px; }
  .ds .d2 svg { width: auto; height: 430px; display: block; overflow: visible; }
  .ds .d2 svg text { fill: var(--ink); }
  .ds .bom { border: 2px solid var(--ink); align-self: start; }
  .ds .bom .bh, .ds .bom .br { display: grid; grid-template-columns: 50px 270px 1fr; align-items: center; border-top: 1.5px solid var(--ink); min-height: 62px; }
  .ds .bom .bh { border-top: 0; min-height: 38px; background: var(--tile); font: 500 16px 'IBM Plex Mono', monospace; color: var(--muted); }
  .ds .bom .bh > span, .ds .bom .br > * { padding: 6px 12px; }
  .ds .bom .br b { font: 400 20px/1.15 'Marcellus', serif; }
  .ds .bom .br .w { font: 400 16px/1.25 'Spectral', serif; }
  .ds .bom .br .bal { margin: 0 0 0 11px; padding: 0; }
  .ds .bom .rt { font: 400 15px/1.5 'IBM Plex Mono', monospace; display: block; white-space: pre-wrap; }
  .ds.hood .bom .br b { font: 500 14px/1.3 'IBM Plex Mono', monospace; }
  .ds.hood .bom .br .w { font: 400 13px/1.45 'IBM Plex Mono', monospace; }
  .ds .more { font-style: italic; color: var(--muted); }

  /* detail 3 */
  .ds .d3 .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; height: 438px; }
  .ds .d3 h3 { margin: 0 0 8px; font: 400 22px/1.1 'Marcellus', serif; padding-bottom: 6px; border-bottom: 1.5px solid var(--ink); }
  .ds .d3 h3 small { display: block; margin-top: 3px; font: 400 16px 'Spectral', serif; color: var(--muted); }
  .ds.hood .d3 h3 { font: 500 15px 'IBM Plex Mono', monospace; }
  .ds.hood .d3 h3 small { font: 400 12.5px 'IBM Plex Mono', monospace; }
  .ds .rate { display: flex; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--faint); }
  .ds .rate .bal { margin-top: 2px; }
  .ds .rate b { display: block; font: 400 20px/1.2 'Marcellus', serif; }
  .ds .rate b span { font: inherit; color: inherit; margin: 0; }
  .ds .rate > div > span { display: block; font: 400 17px/1.3 'Spectral', serif; color: var(--muted); margin-top: 3px; }
  .ds.hood .rate b { font: 500 13.5px/1.3 'IBM Plex Mono', monospace; }
  .ds.hood .rate > div > span { font: 400 12.5px/1.4 'IBM Plex Mono', monospace; }
  .ds .gate { display: flex; justify-content: space-between; gap: 10px; align-items: baseline; padding: 6px 0; border-bottom: 1px solid var(--faint); font: 400 18px/1.2 'Spectral', serif; }
  .ds .gate i { font: 400 13px 'IBM Plex Mono', monospace; font-style: normal; color: var(--muted); white-space: nowrap; }
  .ds.hood .gate { font: 500 13.5px 'IBM Plex Mono', monospace; }
  .ds .gate.last { border-bottom: 2px solid var(--ink); font-weight: 500; }
  .ds .lh { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin-top: 10px; border: 1.5px solid var(--ink); }
  .ds .lh div { padding: 10px 10px; border: .5px solid var(--ink); font: 400 16px/1.2 'Spectral', serif; display: flex; justify-content: space-between; gap: 8px; }
  .ds .lh div b { font: 500 17px 'IBM Plex Mono', monospace; }
  .ds.hood .lh div { font: 400 12.5px 'IBM Plex Mono', monospace; }
  .ds.hood .lh div b { font: 500 13px 'IBM Plex Mono', monospace; }
  .ds .pay { margin: 9px 0 0; font: italic 400 16px/1.3 'Spectral', serif; color: var(--muted); }
  .ds.hood .pay { font: 400 12.5px/1.4 'IBM Plex Mono', monospace; font-style: normal; }
  .ds .rev { border: 2px solid var(--ink); }
  .ds .rev .rh, .ds .rev .rr { display: grid; grid-template-columns: 104px 1fr; border-top: 1.5px solid var(--ink); }
  .ds .rev .rh { border-top: 0; background: var(--tile); font: 500 16px 'IBM Plex Mono', monospace; color: var(--muted); }
  .ds .rev .rh > span { padding: 6px 10px; }
  .ds .rev .rr > b { font: 400 20px/1.15 'Marcellus', serif; padding: 12px 10px; border-right: 1.5px solid var(--ink); display: block; }
  .ds .rev .rr > div { padding: 12px 11px; font: 400 17px/1.3 'Spectral', serif; }
  .ds.hood .rev .rr > b { font: 500 13px/1.3 'IBM Plex Mono', monospace; }
  .ds.hood .rev .rr > div { font: 400 12px/1.45 'IBM Plex Mono', monospace; }
  .ds .rev .rr.nv { background: repeating-linear-gradient(135deg, var(--faint) 0 2px, transparent 2px 9px); }
  .ds .rev .rr.nv > div, .ds .rev .rr.nv > b { background: var(--field); }
  .ds .rev .rr.nv > b { border-right: 1.5px solid var(--ink); }
  .ds .rev-note { margin: 9px 0 0; font: italic 400 16px/1.3 'Spectral', serif; color: var(--muted); }
  .ds.hood .rev-note { font: 400 12.5px/1.4 'IBM Plex Mono', monospace; font-style: normal; }

  /* ---------- OG frame: 1200x630, title block plus elevation ----------
     ?og=1 only. The Lab pill, wall label and specimen plate step aside so the
     capture is the sheet and nothing else. */
  html.ds-og, html.ds-og body { height: 100%; overflow: hidden; }
  html.ds-og .hatch, html.ds-og .label, html.ds-og details.plate, html.ds-og .skip { display: none; }
  html.ds-og #main { padding-top: 0; }
  .ds.og #ctrl, .ds.og #nt, .ds.og .bub, .ds.og .fork, .ds.og .eh, .ds.og .tr, .ds.og .sl .tx, .ds.og .sl.sub .sb > span, .ds.og .sl.note, .ds.og .cta, .ds.og .brace, .ds.og .zone, .ds.og .tick, .ds.og .ld .lb { display: none !important; }
  .ds.og .frame { inset: 12px; }
  .ds.og .frame::before { inset: 20px; }
  .ds.og #elev { left: 530px; top: 115px; grid-template-columns: 372px 40px 208px; grid-template-rows: 0 0 repeat(5, 50px) 0 repeat(3, 50px); }
  .ds.og .fl { font-size: 15px; }
  .ds.og .ld::before { border-top-width: 3px; margin-top: -1.5px; }
