---
/**
 * The game night miniature: host phone on the left, venue TV on the right,
 * real cards from the Plant deck. Behaviour is in tv.ts.
 *
 * Self-contained on purpose. It carries its own palette and resets under
 * .tvd, so it renders the same inside the data map's stage (BDL-012) and on
 * the light or dark page of the case study (BDL-005). One per page: the ids
 * are what tv.ts and the review scripts hold on to.
 */
import { TV_DECK } from './data';

interface Props { note?: string }
const { note = 'A working miniature of the Live Event App, with real cards from the Plant deck. Tap Call next to take the phone.' } = Astro.props;
---
<div class="tvd">
  <div class="demo">
    <div class="host">
      <div class="h-bar"></div>
      <div class="h-title">{TV_DECK.name}</div>
      <div class="h-tv"><i></i>TV connected</div>
      <div class="h-tabs" aria-hidden="true"><span>Welcome</span><span class="on">Caller</span><span>Board</span><span>Trivia</span><span>Break</span><span>Closing</span></div>
      <button type="button" class="h-btn" id="dm-call">Call next</button>
      <div class="h-count"><b id="dm-n-called">{TV_DECK.called}</b> called, <b id="dm-n-left">{TV_DECK.size - TV_DECK.called}</b> left</div>
      <button type="button" class="h-btn alt" id="dm-fact">Reveal fun fact</button>
    </div>
    <div class="relay-hint" aria-hidden="true">
      <svg width="70" height="16" viewBox="0 0 70 16"><path d="M2 8 H62" stroke="currentColor" stroke-width="2" stroke-dasharray="2 6" fill="none"><animate attributeName="stroke-dashoffset" from="0" to="-16" dur=".8s" repeatCount="indefinite"/></path><path d="M60 3 L68 8 L60 13 z" fill="currentColor"/></svg>
      instantly
    </div>
    <div class="tv">
      <div class="screen" id="dm-screen" aria-live="off"></div>
      <div class="stand"></div>
    </div>
    <p class="demo-note" id="dm-demo-note">{note}</p>
  </div>
</div>

<script>
  import { mountTv } from './tv';
  mountTv();
</script>

<style is:global>
  @keyframes tvd-ripple { to { transform: scale(16); opacity: 0; } }

  .tvd {
    --tv-deep: #151310;
    --tv-mark: #f4f0e6;
    --tv-muted: #a89f8f;
    --tv-moss: #a3bd8f;
    --tv-fern: #6f9678;
    --tv-live: #8db9cf;
    --tv-line: color-mix(in srgb, #f4f0e6 16%, transparent);
    --tv-line-soft: color-mix(in srgb, #f4f0e6 8%, transparent);
    --tv-display: var(--font-display);
    color: var(--tv-mark);
    font-family: var(--font-body);
    line-height: 1.45;

    * { box-sizing: border-box; margin: 0; padding: 0; }
    button { font: inherit; color: inherit; }
    :focus-visible { outline: 2px solid var(--tv-moss); outline-offset: 3px; }

    .demo { margin-top: 30px; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 30px clamp(18px, 3vw, 40px); padding: 34px 20px 26px; border-radius: 18px; background: radial-gradient(ellipse at 60% 40%, color-mix(in srgb, var(--tv-live) 10%, var(--tv-deep)), var(--tv-deep) 70%); border: 1px solid var(--tv-line-soft); }
    .host { width: 236px; flex: none; border-radius: 34px; border: 2px solid #3a362e; background: #12110f; padding: 14px 12px 18px; box-shadow: 0 20px 50px rgba(0,0,0,.45); font-size: 13px; }
    .host .h-bar { width: 70px; height: 5px; border-radius: 3px; background: #3a362e; margin: 0 auto 14px; }
    .host .h-title { font-family: var(--tv-display); font-size: 15px; }
    .host .h-tv { font-size: 11.5px; color: var(--tv-muted); display: flex; align-items: center; gap: 6px; margin-top: 2px; }
    .host .h-tv i { width: 7px; height: 7px; border-radius: 50%; background: #8fd18a; box-shadow: 0 0 8px #8fd18a; display: block; }
    .host .h-tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; margin-top: 12px; }
    .host .h-tabs span { text-align: center; font-size: 11px; padding: 5px 0; border-radius: 7px; border: 1px solid var(--tv-line); color: var(--tv-muted); }
    .host .h-tabs span.on { border-color: var(--tv-live); color: var(--tv-mark); background: color-mix(in srgb, var(--tv-live) 16%, transparent); }
    .host .h-btn { display: block; width: 100%; cursor: pointer; border: 0; position: relative; overflow: hidden; margin-top: 14px; border-radius: 14px; padding: 15px 0; text-align: center; font-family: var(--tv-display); font-size: 18px; letter-spacing: .04em; background: var(--tv-fern); color: #10140f; transition: transform .12s; }
    .host .h-btn:active { transform: scale(.97); }
    .host .h-btn.alt { background: transparent; border: 1px solid var(--tv-line); color: var(--tv-mark); font-size: 14px; padding: 9px 0; margin-top: 8px; }
    .host .h-count { text-align: center; margin-top: 8px; color: var(--tv-muted); font-variant-numeric: lining-nums tabular-nums; }
    .host .h-count b { color: var(--tv-mark); font-weight: 600; }
    .ripple { position: absolute; left: 50%; top: 50%; width: 16px; height: 16px; margin: -8px; border-radius: 50%; background: rgba(255,255,255,.55); pointer-events: none; animation: tvd-ripple .7s ease-out forwards; }
    .relay-hint { display: flex; flex-direction: column; align-items: center; gap: 6px; color: var(--tv-live); font-size: 13.5px; font-style: italic; }
    .tv { flex: 1 1 400px; max-width: 600px; min-width: 0; }
    .tv .screen { aspect-ratio: 16 / 9; border-radius: 10px; border: 10px solid #0d0c0b; outline: 1px solid #3a362e; background: #1a1916; overflow: hidden; position: relative; box-shadow: 0 30px 70px rgba(0,0,0,.55), 0 0 80px color-mix(in srgb, var(--tv-live) 10%, transparent); }
    .tv .stand { width: 26%; height: 14px; margin: 0 auto; background: linear-gradient(#24221d, #12110f); border-radius: 0 0 8px 8px; }
    .card-tv { position: absolute; inset: 0; display: grid; grid-template-columns: 44% 1fr; gap: 5%; padding: 6% 6% 5%; align-items: center; transition: opacity .5s, transform .5s; }
    .card-tv.out { opacity: 0; transform: scale(.97); }
    .card-tv img { width: 100%; max-width: none; height: auto; aspect-ratio: 1; object-fit: contain; border-radius: 6%; }
    .card-tv .k { font-family: var(--tv-display); font-size: 12px; letter-spacing: .26em; text-transform: uppercase; color: var(--tv-moss); }
    .card-tv .nm { font-family: var(--tv-display); font-size: 34px; line-height: 1.05; margin-top: 4px; }
    .card-tv .fact { margin-top: 14px; font-size: 13px; line-height: 1.4; color: #d9d2c3; border-left: 2px solid var(--tv-moss); padding-left: 10px; transition: opacity .6s, transform .6s; }
    .card-tv .fact b { display: block; font-family: var(--tv-display); font-weight: 400; color: var(--tv-moss); letter-spacing: .08em; margin-bottom: 2px; }
    .card-tv .fact.hide { opacity: 0; transform: translateY(6px); }
    .card-tv .prev { margin-top: 14px; font-size: 11.5px; color: var(--tv-muted); }
    @media (max-width: 640px) { .card-tv .prev { display: none; } }
    .demo-note { flex-basis: 100%; text-align: center; font-size: 14.5px; color: var(--tv-muted); font-style: italic; }

    @media (max-width: 759px) {
      .demo { padding: 24px 14px 18px; gap: 18px; }
      .relay-hint { flex-basis: 100%; gap: 4px; }
      .relay-hint svg { display: none; }
      .relay-hint::before { content: ""; width: 2px; height: 30px; background: repeating-linear-gradient(var(--tv-live) 0 4px, transparent 4px 9px); }
      .tv { flex-basis: 100%; }
      .tv .screen { aspect-ratio: auto; display: grid; border-width: 8px; }
      .card-tv { position: relative; inset: auto; grid-area: 1 / 1; grid-template-columns: 38% 1fr; gap: 14px; padding: 18px 16px; }
      .card-tv .nm { font-size: 24px; }
      .card-tv .fact { font-size: 13px; margin-top: 8px; }
      .card-tv .k { font-size: 10px; }
    }
  }
</style>
