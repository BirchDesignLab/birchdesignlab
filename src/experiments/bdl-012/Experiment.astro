---
/**
 * BDL-012, The Data Map. One picture of every place a small events business
 * keeps its information, where it travels and where it shows up: Sanity,
 * Ticket Tailor, Cloudflare, Resend, the website, search engines and the Live
 * Event App. First drawn for the owners of Cheer and Chatter Social Club
 * (BDL-005) so they could see their own system; this is the public version.
 *
 * Everything static is rendered here from data.ts. stage.ts mounts the node
 * maps, the wall, the ticket desk and the TV demo on top. The rules for what
 * may and may not be said on this page are at the top of data.ts.
 *
 * Styles are global and nested under .dm because most of the stage is built
 * in script, where Astro's scoped attributes never reach.
 */
import {
  BEHIND, CALLOUTS, DRAWERS, FEATS, FEEDS, GOOGLE, LANES, LOCKS, PAGES, SEO, SIM, STATS, STEPS,
  THEMES, TIERS, ART_THEME,
} from './data';
import { STRIP } from './art';
import TvDemo from './TvDemo.astro';
import { Image } from 'astro:assets';
import mapStill from './map-still.png';

const fmt = (n: number) => n.toLocaleString('en-US');
const maxC = Math.max(...THEMES.map((t) => t[1]));
const totals = THEMES.map((t) => t[2].reduce((a, b) => a + b, 0));
const maxT = Math.max(...totals);
const tierVar = ['--t1', '--t2', '--t3', '--t4'];
---
{/* The stage is one face, the Birch night face, whatever the visitor chose
    elsewhere. Stamped before first paint and never stored, so it leaves with
    the page and the rest of the site keeps their choice. */}
<script is:inline>
  document.documentElement.setAttribute('data-scheme', 'dark');
  // The wall label is fixed over the bottom-left corner. Most stages are one
  // screen of canvas and can spare the corner; this one is a page of reading,
  // so the label starts folded unless the window is wide enough to give it
  // the gutter beside the column (1200px column + the label's 30ch + air).
  if (window.innerWidth < 1760) {
    var dmLabel = document.querySelector('details.label');
    if (dmLabel) dmLabel.removeAttribute('open');
  }
</script>

<div class="dm" id="dm">
  <header class="hero">
    {/* The map itself is the opening picture: the whole system, already
        running, with the club's caller cards flying into the content library.
        Decorative here (the real, operable map is the next section), so it is
        hidden from assistive tech and takes no pointer. */}
    <div class="hero-map" id="dm-hero" aria-hidden="true">
      <div class="map-fit"><div class="map-size"><div class="canvas" id="dm-map-hero"></div></div></div>
      <div class="hero-cards" id="dm-hero-cards"></div>
    </div>
    <div class="hero-inner">
      <div class="letterhead">
        <span>The Data Map</span>
        <span class="for">Drawn for Cheer and Chatter Social Club</span>
      </div>
      <p class="eyebrow">How it all connects</p>
      <h2 class="title">Everything that makes a night run</h2>
      <p class="lede">Cheer and Chatter Social Club runs themed game nights on the Mississippi Gulf Coast. When the owners hit Publish, sell a ticket or start a game, a lot happens out of sight.</p>
      <p class="lede">We drew them this map so they could see their own system: every place their information lives, where it travels, and where it shows up. Then we liked it enough to hang it in the Lab.</p>
      <p class="wall-note"><i></i>Flying into the library: watercolor caller cards from the club’s Plant deck.</p>
    </div>
  </header>

  <div class="page">
    <div class="stats">
      {STATS.map(([n, suffix, what]) => (
        <div class="stat"><div class="big" data-to={n} data-suffix={suffix}>{fmt(n)}{suffix}</div><div class="what">{what}</div></div>
      ))}
    </div>
    <p class="stats-note">Counts read from the live content library in October 2026. It has grown since.</p>

    {/* ============ THE WHOLE MAP ============ */}
    <section id="dm-map-section">
      <div class="sec-head"><span class="kick">The whole map</span></div>
      <p class="sec-intro">Read it left to right. On the left is everything that feeds the system: the owners, their game files, Ticket Tailor and their guests. In the middle is where it is kept and where the work happens. On the right is everything people actually see. The moving lights are information travelling.</p>
      <div class="tour-bar" id="dm-tour-bar">
        <div class="tour" id="dm-tour"><span class="t-label">Watch it happen</span></div>
        <div class="caption" id="dm-caption" aria-live="polite"><div class="c-step">✦</div><div class="c-text">Pick a moment above to watch it travel across the map, step by step.<small>Or tap any box to see what it connects to.</small></div></div>
      </div>
      <div class="map-tools">
        <div class="legend">
          {Object.values(LANES).map((l) => (
            <span style={`color:var(${l.v})`}><i style={`background:var(${l.v})`}></i><em>{l.name}</em></span>
          ))}
        </div>
        <div class="mode" role="group" aria-label="How the boxes are labelled">
          <button type="button" data-mode="plain" aria-pressed="true">Plain English</button>
          <button type="button" data-mode="tech" aria-pressed="false">Under the hood</button>
        </div>
      </div>
      {/* Without JavaScript nothing below can be built, so the map arrives as
          a picture (scripts/lab/capture-bdl-012-still.mjs) and everything
          that only works with script steps aside. is:inline keeps the style
          inside the noscript; Astro would otherwise hoist it to the head,
          where it would hide these for everyone. */}
      <noscript>
        <style is:inline>
          .dm .tour-bar, .dm .map-tools .mode, .dm .map-hint, .dm .skip-map, .dm .hero-map, .dm .map-fit,
          .dm .sub-h.mob-only, .dm .desk, .dm .tvd, .dm .wall-note { display: none !important; }
          .dm .map-still { display: block; width: 100%; height: auto; margin-top: 22px; border-radius: 12px; }
        </style>
        <Image class="map-still" src={mapStill} alt="The whole map as a still picture. On the left, the owners in Sanity Studio, their game decks, Ticket Tailor and their guests. In the middle, the Sanity content library and the Ticket Tailor box office feed four pieces on Cloudflare: the site builder, the sold-out watcher, the game relay and the forms desk, with Resend below. On the right, the website, Google and Facebook, the host console, the venue TV, and the owners’ and guests’ inboxes and mailing lists. Coloured lines join them: content, tickets, game night and email." widths={[768, 1104, 1656]} sizes="(max-width: 1200px) 100vw, 1104px" />
        <p class="note">This is a still. With JavaScript on, the map moves, plays four journeys and opens every box.</p>
      </noscript>
      <a class="skip-map" href="#dm-after-map">Skip past the map’s boxes</a>
      <div class="map-fit"><div class="map-size" id="dm-view"><div class="canvas map-main" id="dm-map-main"></div></div></div>
      <div class="map-hint mob-only"><span>Pinch or double-tap to zoom, drag to move around. Tap a box to open it, or a line to see what travels on it.</span><button type="button" id="dm-zoom">Zoom in</button></div>
      <p class="map-hint desk-only"><span>Click a box to open it. Hover a line to see what travels on it.</span></p>
      <span id="dm-after-map" tabindex="-1"></span>
      <h3 class="sub-h mob-only">Four moments, step by step<small>Each one plays as you reach it.</small></h3>
      <div class="chains mob-only" id="dm-chains"></div>
    </section>

    {/* ============ CONTENT LIBRARY ============ */}
    <section>
      <div class="sec-head"><span class="kick">Part 1</span><h2>The content library</h2></div>
      <p class="sec-intro">Sanity holds every word and photo on the website and every card and question in the game app. It has twelve kinds of records. Each one feeds the website, game night, or both.</p>
      <div class="drawers">
        {DRAWERS.map(([name, n, what, feeds]) => (
          <div class="drawer">
            <div class="d-top"><div class="d-name">{name}</div>{n && <div class="d-n">{n}</div>}</div>
            <div class="d-what">{what}</div>
            <div class="d-feeds">{feeds.map((f) => <span class={`chip ${f}`}>{FEEDS[f]}</span>)}</div>
          </div>
        ))}
      </div>

      <h3 class="sub-h">How one night ties everything together<small>Only the venue is picked from a list. Everything else finds its night by matching: same theme, same series number.</small></h3>
      <div class="map-fit desk-only"><div class="map-size"><div class="canvas" id="dm-map-night"></div></div></div>
      <div class="mob-only" id="dm-night-m"></div>

      <h3 class="sub-h">What each theme can play<small>Caller cards and trivia questions in the library, October 2026. Bars are drawn to scale.</small></h3>
      <div class="matrix" id="dm-matrix">
        <div class="m-row head"><div>Theme</div><div>Bingo caller cards</div><div>Trivia questions, by difficulty</div></div>
        {THEMES.map(([name, c, t], row) => (
          <div class="m-row">
            <div>
              <div class="m-theme">{name}</div>
              {name === ART_THEME && <div class="strip">{STRIP.map((s) => <img alt="" src={s} loading="lazy" />)}</div>}
            </div>
            <div class="bar">
              {c
                ? <Fragment><div class="track"><i style={`width:${(c / maxC) * 100}%;background:var(--fern);animation-delay:${row * 70}ms`}></i></div><span class="v">{c}</span></Fragment>
                : <span class="v none">Trivia only</span>}
            </div>
            <div class="bar">
              {totals[row]
                ? <Fragment><div class="track" role="img" aria-label={t.map((n, i) => n > 0 ? `${TIERS[i]} ${n}` : '').filter(Boolean).join(', ')}>{t.map((n, i) => n > 0 && <i style={`width:${(n / maxT) * 100}%;background:var(${tierVar[i]});animation-delay:${row * 70 + 120}ms`} title={`${TIERS[i]}: ${n}`}></i>)}</div><span class="v">{totals[row]}</span></Fragment>
                : <span class="v none">Bingo only</span>}
            </div>
          </div>
        ))}
      </div>
      <div class="tiers">
        {TIERS.map((t, i) => <span><i style={`background:var(${tierVar[i]})`}></i>{t}</span>)}
        <span>Bingo bars run to {maxC} cards, trivia bars to {maxT} questions.</span>
      </div>
      <p class="note">A Content readiness tab in the Studio keeps this same count and tells the owners, theme by theme, whether a deck can fill a standard 5×5 card or suits a smaller one.</p>
    </section>

    {/* ============ TICKETS ============ */}
    <section>
      <div class="sec-head"><span class="kick">Part 2</span><h2>Selling a ticket, start to finish</h2></div>
      <p class="sec-intro">Ticket Tailor handles the money. The website and Ticket Tailor talk to each other constantly so the two never disagree about what’s on sale.</p>
      <div class="steps" id="dm-steps">
        {STEPS.map(([h, p], i) => (
          <div class={`step${i === STEPS.length - 1 ? ' final' : ''}`}><div class="s-n">{i + 1}</div><h3>{h}</h3><p>{p}</p></div>
        ))}
      </div>

      <div class="desk fresh" id="dm-desk">
        <div class="desk-page">
          <div class="dp-bar" aria-hidden="true"><i></i><i></i><i></i><span>An event page</span></div>
          <div class="dp-body">
            <div class="dp-kick">Plant Night <span id="dm-state">On sale</span></div>
            <div class="dp-title">Plant Bingo</div>
            <div class="dp-meta">A Wednesday, 6:00 p.m.</div>
            <div class="dp-meter"><i id="dm-meter" style={`width:${(SIM.sold / SIM.capacity) * 100}%`}></i></div>
            <div class="dp-count"><b id="dm-sold">{SIM.sold}</b> of {SIM.capacity} tickets sold</div>
            <div class="dp-cta" id="dm-cta">Get tickets</div>
          </div>
        </div>
        <div class="desk-side">
          <h3>Try it: sell the last ticket</h3>
          <p>A working miniature with made-up numbers. Sell one and watch the six steps answer. The first sale changes nothing, on purpose. The last one flips the page, and the search listing further down.</p>
          <div class="desk-btns">
            <button type="button" id="dm-sell">Sell a ticket</button>
            <button type="button" id="dm-refund" class="alt">Refund one</button>
          </div>
          <ol class="desk-log" id="dm-log" aria-live="polite"><li>Two seats left. Nothing has happened yet.</li></ol>
        </div>
        {/* The same sale, drawn on the lines of the big map. Built by stage.ts
            from DESK (wide) or DESK_M (phone). */}
        <div class="desk-map" aria-hidden="true">
          <div class="dk-label">The same sale, on the map</div>
          <div class="map-fit"><div class="map-size"><div class="canvas" id="dm-map-desk"></div></div></div>
        </div>
      </div>

      <div class="callout">
        {CALLOUTS.map(([h, p]) => <div><b>{h}</b>{p}</div>)}
      </div>
    </section>

    {/* ============ WEBSITE + SEARCH ============ */}
    <section>
      <div class="sec-head"><span class="kick">Part 3</span><h2>The website, and how Google reads it</h2></div>
      <p class="sec-intro">Every page is built ahead of time from the library, so it loads fast and never waits on a database. Alongside what people see, each page carries a second layer written for Google, Facebook and text-message previews.</p>
      <div class="two">
        <div class="pages">
          <div class="p-row head"><div>Page</div><div>Built from</div></div>
          {PAGES.map(([pg, small, src, many]) => (
            <div class={`p-row${many ? ' many' : ''}`}><div class="pg">{pg}{small && <small>{small}</small>}</div><div class="src">{src}</div></div>
          ))}
        </div>
        <div class="gcard">
          <div class="g-head">
            <div class="k">What Google receives for one night</div>
            <div class="t">Plant Bingo</div>
            <div class="crumb">Home › Events › Plant Bingo</div>
          </div>
          <dl>
            {GOOGLE.map(([dt, dd, aside]) => (
              <Fragment><dt>{dt}</dt><dd><span id={dt === 'Available' ? 'dm-g-avail' : undefined}>{dd}</span>{aside && <em> ({aside})</em>}</dd></Fragment>
            ))}
          </dl>
        </div>
      </div>
      <div class="share-row">
        <div>
          <div class="phone-msg" aria-hidden="true">
            <div class="pm-top">iMessage · Today 2:14 PM</div>
            <div class="pm-in">Are we doing this one?</div>
            <div class="pm-card">
              <div class="pm-art">{STRIP.slice(0, 3).map((s) => <img alt="" src={s} loading="lazy" />)}<span>Plant Bingo</span></div>
              <div><b>Plant Bingo · Cheer and Chatter Social Club</b><span>cheerandchatter.com</span></div>
            </div>
          </div>
          <p class="note">An example text. The title on the link is what the event page hands to the phone. The picture here is a stand-in for the night’s own photo.</p>
        </div>
        <div class="seo-grid">
          {SEO.map(([h, p]) => <div class="seo"><h4>{h}</h4><p>{p}</p></div>)}
        </div>
      </div>
    </section>

    {/* ============ GAME NIGHT ============ */}
    <section>
      <div class="sec-head"><span class="kick">Part 4</span><h2>Game night</h2></div>
      <p class="sec-intro">The Live Event App reads the same library as the website, but only ever reads. Nothing that happens at a venue can change the website.</p>
      <TvDemo />
      <h3 class="sub-h">How the phone reaches the TV</h3>
      <div class="map-fit desk-only"><div class="map-size"><div class="canvas" id="dm-map-live"></div></div></div>
      <div class="mob-only" id="dm-live-m"></div>
      <div class="feats">
        {FEATS.map(([h, p]) => <div class="feat"><h4>{h}</h4><p>{p}</p></div>)}
      </div>
    </section>

    {/* ============ FORMS + EMAIL ============ */}
    <section>
      <div class="sec-head"><span class="kick">Part 5</span><h2>Forms and email</h2></div>
      <p class="sec-intro">Four forms on the website, one path for all of them. Nothing is kept in a database: a lead lives in the owners’ inbox and mailing lists, and nowhere else.</p>
      <div class="map-fit desk-only"><div class="map-size"><div class="canvas" id="dm-map-forms"></div></div></div>
      <div class="mob-only" id="dm-forms-m"></div>
    </section>

    {/* ============ SAFETY ============ */}
    <section>
      <div class="sec-head"><span class="kick">Part 6</span><h2>Locks and safety nets</h2></div>
      <p class="sec-intro">The parts nobody sees until the day they matter.</p>
      <div class="locks">
        {LOCKS.map(([h, p]) => (
          <div class="lock">
            <h4><svg width="16" height="18" viewBox="0 0 16 18" aria-hidden="true"><rect x="1.5" y="7.5" width="13" height="9.5" rx="2" style="fill:none;stroke:var(--moss);stroke-width:1.5"/><path d="M4.5 7.5V5a3.5 3.5 0 0 1 7 0v2.5" style="fill:none;stroke:var(--moss);stroke-width:1.5"/></svg>{h}</h4>
            <p>{p}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="close">
      <h2>Four services, one system</h2>
      <p>Sanity keeps the content. Ticket Tailor sells the tickets. Cloudflare runs the website, the watcher, the forms and the game relay. Resend delivers the mail. On their own, none of them knows the others exist. Every line on this map is something we built so they work as one business.</p>
      <p>The owners publish once, and it reaches their website, Google, Facebook, the venue TV and their guests’ inboxes by itself.</p>
      <div class="behind">
        {BEHIND.map(([n, label, what]) => (
          <div><b data-to={n || undefined}>{label}</b>{what}</div>
        ))}
      </div>
      <div class="next">
        <a class="primary" href="/lab/bdl-005/">Read the full case study, BDL-005</a>
        <a href="/contact">Want a map of your own business? Start a conversation</a>
      </div>
    </div>
  </div>

  {/* A box's drawer: both voices, what travels on its lines, and for five
      boxes the reasoning and the failure modes. A side panel on a wide
      screen, a bottom sheet on a phone. Filled by stage.ts. */}
  <aside class="box-drawer" id="dm-drawer" aria-labelledby="dm-drawer-title">
    <button type="button" class="dr-close" id="dm-drawer-close" aria-label="Close">×</button>
    <div class="dr-body" id="dm-drawer-body"></div>
  </aside>
</div>

<script>
  import { mount } from './stage';
  mount();
</script>

<style is:global>
  @keyframes dm-drift { to { transform: translateY(-50%); } }
  @keyframes dm-flow { to { stroke-dashoffset: -29; } }
  @keyframes dm-grow { from { transform: scaleX(0); } }
  @keyframes dm-chdot { 0% { top: 0; opacity: 0; } 8% { opacity: 1; } 92% { opacity: 1; } 100% { top: 100%; opacity: 0; } }
  @keyframes dm-nudge { 0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--l-tickets) 55%, transparent); } 60% { box-shadow: 0 0 0 12px transparent; } }

  /* The wall label, on this page only. Folded, it normally floats over the
     bottom-left corner of the stage; here that corner is body copy for the
     whole length of the page. So while folded it docks inside the specimen
     plate's strip, where there is nothing to cover, and steps back out above
     the strip when opened. Phones are untouched: the label is in flow there. */
  @media (min-width: 721px) {
    html:has(.dm) details.label { left: auto; right: var(--space-4); z-index: 21; }
    html:has(.dm) details.label:not([open]) { bottom: 0.4rem; right: 3.75rem; }
    html:has(.dm) details.label:not([open]) summary { padding-block: 0.45rem; }
  }

  .dm {
    /* The map's own palette. Same values as the site's night face; declared
       here so the stage does not move if the site tokens ever do. */
    --field: #1c1a17;
    --field-raised: #272319;
    --field-deep: #151310;
    --pine: #22322a;
    --mark: #f4f0e6;
    --muted: #a89f8f;
    --moss: #a3bd8f;
    --fern: #6f9678;
    --caramel: #bf9468;
    --line: color-mix(in srgb, #f4f0e6 16%, transparent);
    --line-soft: color-mix(in srgb, #f4f0e6 8%, transparent);
    --l-content: #a3bd8f;
    --l-tickets: #d9a46c;
    --l-live: #8db9cf;
    --l-mail: #d6948a;
    --t1: #d5e3c9;
    --t2: #a3bd8f;
    --t3: #6f9678;
    --t4: #3f6249;
    --display: var(--font-display);
    --body: var(--font-body);
    /* How far the sticky journey bar sits below the top edge: clear of the
       fixed "back to Lab" pill wherever the pill overlaps the column. */
    --stick: 3.5rem;

    background: var(--field);
    color: var(--mark);
    font-family: var(--body);
    font-size: 18px;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
    padding-bottom: 5rem; /* clear of the specimen plate strip */

    @media (min-width: 1520px) { --stick: 0px; }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    button { font: inherit; color: inherit; }
    :focus-visible { outline: 2px solid var(--moss); outline-offset: 3px; }
    h2, h3, h4 { font-weight: 400; }

    .page { max-width: 1200px; margin: 0 auto; padding-inline: 48px; }
    @media (max-width: 700px) { .page { padding-inline: 16px; } }

    /* ---------- hero: a wall of the club's own cards ---------- */
    .hero { position: relative; overflow: hidden; isolation: isolate; }
    /* The hero map. Wide: behind the title, bleeding off the right edge,
       under the veil below. Phone: its own band under the text (the flex
       order further down), where there is no room to read a title over it. */
    .hero-map { position: absolute; inset: 0; z-index: -2; pointer-events: none; overflow: hidden; }
    .hero-map .map-fit { position: absolute; top: 132px; right: -56px; margin: 0; overflow: visible; opacity: .9; }
    .hero-map .node { transition: none; }
    .hero-cards { position: absolute; inset: 0; }
    .hero-cards img { position: absolute; left: 0; top: 0; width: 86px; height: 86px; max-width: none; border-radius: 12px; object-fit: cover; opacity: 0; box-shadow: 0 10px 30px rgba(0,0,0,.45); }
    .hero-cards img.rest { opacity: .8; }
    @media (max-width: 759px) {
      .hero { display: flex; flex-direction: column; }
      .hero-inner { order: 1; width: 100%; }
      .hero-map { order: 2; position: relative; inset: auto; z-index: 0; height: 300px;
        -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 16%, #000 80%, transparent 100%);
        mask-image: linear-gradient(180deg, transparent 0, #000 16%, #000 80%, transparent 100%); }
      .hero-map .map-fit { top: 0; right: auto; left: -118px; opacity: .9; }
      .hero-cards img { width: 58px; height: 58px; border-radius: 9px; }
      .hero::before { display: none; }
    }
    .hero::before { content: ""; position: absolute; inset: 0; z-index: -1;
      background:
        linear-gradient(90deg, var(--field) 0%, color-mix(in srgb, var(--field) 97%, transparent) 50%, color-mix(in srgb, var(--field) 80%, transparent) 58%, color-mix(in srgb, var(--field) 26%, transparent) 70%, color-mix(in srgb, var(--field) 10%, transparent) 100%),
        linear-gradient(0deg, var(--field) 0%, transparent 28%),
        linear-gradient(180deg, color-mix(in srgb, var(--field) 92%, transparent) 0%, transparent 24%); }
    @media (max-width: 759px) { .hero::before { background: linear-gradient(0deg, var(--field) 0%, color-mix(in srgb, var(--field) 82%, transparent) 40%, color-mix(in srgb, var(--field) 70%, transparent) 100%); } }
    .hero-inner { max-width: 1200px; margin: 0 auto; padding-inline: 48px; padding-block: 84px 70px; }
    @media (max-width: 700px) { .hero-inner { padding-inline: 16px; padding-block: 28px 14px; } }
    .letterhead { display: flex; align-items: baseline; justify-content: space-between; gap: 8px 20px; flex-wrap: wrap; padding-bottom: 18px; border-bottom: 1px solid var(--line); font-family: var(--display); font-size: 14px; letter-spacing: .26em; text-transform: uppercase; color: var(--mark); }
    .letterhead .for { font-family: var(--body); font-size: 15px; letter-spacing: .04em; text-transform: none; color: var(--muted); }
    .eyebrow { font-family: var(--display); font-size: 14px; letter-spacing: .3em; text-transform: uppercase; color: var(--moss); margin-top: 64px; }
    .title { font-family: var(--display); font-size: clamp(42px, 7vw, 76px); line-height: 1.02; margin: 12px 0 22px; text-wrap: balance; max-width: 13ch; }
    .lede { font-size: 21px; max-width: 46ch; }
    .lede + .lede { margin-top: 12px; }
    .wall-note { margin-top: 30px; font-size: 15px; color: var(--muted); font-style: italic; display: flex; align-items: center; gap: 10px; }
    .wall-note i { width: 26px; height: 1px; background: var(--muted); display: block; flex: none; }

    /* ---------- headline numbers ---------- */
    .stats { margin-top: 8px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
    .stat { border: 1px solid var(--line); border-radius: 14px; background: var(--field-raised); padding: 20px 20px 18px; position: relative; overflow: hidden; }
    .stat::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: linear-gradient(90deg, var(--moss), transparent); opacity: .5; }
    .stat .big { font-weight: 600; font-variant-numeric: lining-nums tabular-nums; font-size: 44px; line-height: 1; color: var(--moss); }
    .stat .what { margin-top: 8px; font-size: 15.5px; color: var(--muted); line-height: 1.35; }
    @media (max-width: 900px) { .stats { grid-template-columns: repeat(2, 1fr); } }
    .stats-note { margin-top: 12px; font-size: 15px; color: var(--muted); font-style: italic; }

    /* ---------- sections ---------- */
    section { margin-top: 84px; }
    .sec-head { display: flex; align-items: baseline; gap: 18px; border-bottom: 1px solid var(--line); padding-bottom: 14px; flex-wrap: wrap; }
    .sec-head .kick { font-family: var(--display); font-size: 14px; letter-spacing: .28em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
    h2 { font-family: var(--display); font-size: 36px; line-height: 1.12; text-wrap: balance; }
    .sec-intro { margin-top: 16px; max-width: 64ch; font-size: 18px; }
    .note { margin-top: 14px; font-size: 15.5px; color: var(--muted); font-style: italic; max-width: 70ch; }
    .sub-h { margin-top: 48px; font-family: var(--display); font-size: 23px; }
    .sub-h small { display: block; font-family: var(--body); font-size: 16px; color: var(--muted); margin-top: 4px; }

    /* ---------- journeys ---------- */
    .tour-bar { position: sticky; top: var(--stick); z-index: 15; background: var(--field); padding-block: 4px 12px; border-bottom: 1px solid transparent; transition: border-color .3s; }
    /* While stuck, a slab of field colour fills the gap above the bar, so the
       page does not scroll through the strip beside the pill. */
    .tour-bar::before { content: ""; position: absolute; left: -50vw; right: -50vw; bottom: 100%; height: var(--stick); background: var(--field); opacity: 0; pointer-events: none; }
    .tour-bar.stuck { border-bottom-color: var(--line); box-shadow: 0 14px 24px -18px rgba(0,0,0,.8); }
    .tour-bar.stuck::before { opacity: 1; }
    .tour { margin-top: 22px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
    .tour .t-label { font-family: var(--display); font-size: 13px; letter-spacing: .24em; text-transform: uppercase; color: var(--muted); margin-right: 6px; }
    .tour button { cursor: pointer; border: 1px solid var(--line); background: var(--field-raised); border-radius: 999px; padding: 8px 16px 8px 12px; font-size: 16px; display: inline-flex; align-items: center; gap: 9px; transition: border-color .2s, background .2s; }
    .tour button i { width: 10px; height: 10px; border-radius: 50%; display: block; background: var(--c); box-shadow: 0 0 10px var(--c); }
    .tour button:hover, .tour button[aria-pressed="true"] { border-color: var(--c); background: color-mix(in srgb, var(--c) 14%, var(--field-raised)); }
    .tour button.reset { --c: var(--muted); }
    .caption { margin-top: 14px; min-height: 64px; border: 1px solid var(--line); border-radius: 12px; background: var(--field-deep); padding: 12px 18px; display: flex; align-items: center; gap: 16px; }
    .caption .c-step { flex: none; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; border: 2px solid var(--c, var(--line)); color: var(--c, var(--muted)); font-weight: 600; font-variant-numeric: lining-nums tabular-nums; font-size: 15px; }
    .caption .c-text { font-size: 18px; line-height: 1.35; }
    .caption .c-text small { display: block; font-size: 14px; color: var(--muted); }

    /* ---------- legend and the label switch ---------- */
    .map-tools { margin-top: 18px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 26px; }
    .legend { display: flex; flex-wrap: wrap; gap: 10px 26px; font-size: 15.5px; }
    .legend span { display: inline-flex; align-items: center; gap: 9px; }
    .legend i { width: 30px; height: 3px; border-radius: 2px; display: block; box-shadow: 0 0 8px currentColor; }
    .legend em { color: var(--muted); font-style: normal; }
    /* When the legend wraps the row, the switch keeps to the right edge. */
    @media (min-width: 760px) { .mode { margin-left: auto; } }
    .mode { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; padding: 3px; background: var(--field-deep); }
    .mode button { cursor: pointer; border: 0; background: transparent; border-radius: 999px; padding: 7px 15px; font-size: 15px; color: var(--muted); transition: background .25s, color .25s; }
    .mode button:hover { color: var(--mark); }
    .mode button[aria-pressed="true"] { background: var(--caramel); color: #1c1a17; }
    .mode button[data-mode="plain"][aria-pressed="true"] { background: var(--moss); }

    /* ---------- node maps ---------- */
    .map-fit { margin-top: 22px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .map-size { position: relative; overflow: hidden; overflow: clip; }
    .canvas { position: absolute; top: 0; left: 0; width: 1104px; transform-origin: 0 0; }
    .canvas svg.edges { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; overflow: visible; z-index: 1; pointer-events: none; }
    .node { position: absolute; z-index: 2; background: var(--field-raised); border: 1px solid var(--line); border-radius: 12px; padding: 13px 15px 14px; transition: opacity .35s, border-color .35s, box-shadow .35s; }
    .node.hub { background: var(--pine); border-color: color-mix(in srgb, var(--moss) 35%, transparent); }
    .node.quiet { background: var(--field-deep); }
    .node.dim { opacity: .28; }
    .node.lit { border-color: var(--lc, var(--moss)); box-shadow: 0 0 0 1px var(--lc, var(--moss)), 0 0 28px color-mix(in srgb, var(--lc, var(--moss)) 35%, transparent); }
    .node .lanes { display: flex; gap: 5px; margin-bottom: 8px; }
    .node .lanes i { width: 18px; height: 3px; border-radius: 2px; display: block; }
    .node .n-kick { font-family: var(--display); font-size: 11.5px; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); margin-bottom: 3px; }
    .node .n-title { font-family: var(--display); font-size: 19px; line-height: 1.18; }
    .node .n-sub { overflow-wrap: anywhere; margin-top: 5px; font-size: 14.5px; line-height: 1.38; color: var(--muted); }
    /* Under the hood: the same line in engineering terms, marked with a rule. */
    .n-sub.is-tech, .ch-node .s.is-tech { color: color-mix(in srgb, var(--mark) 84%, transparent); border-left: 2px solid var(--caramel); padding-left: 9px; margin-top: 8px; }
    .node .n-list { margin-top: 9px; display: grid; gap: 3px; font-size: 14.5px; line-height: 1.3; }
    .node .n-list div { display: flex; justify-content: space-between; gap: 10px; border-top: 1px solid var(--line-soft); padding-top: 4px; }
    .node .n-list b { font-weight: 600; font-variant-numeric: lining-nums tabular-nums; color: var(--moss); }
    .node .n-big { font-weight: 600; font-variant-numeric: lining-nums tabular-nums; font-size: 30px; color: var(--moss); line-height: 1.05; margin-top: 8px; }
    .node .n-big small { font-size: 15px; color: var(--muted); font-weight: 400; }
    .n-thumbs { display: flex; margin-top: 10px; }
    .n-thumbs img { width: 30px; height: 30px; border-radius: 7px; object-fit: cover; background: var(--field-deep); border: 2px solid var(--pine); margin-left: -8px; }
    .n-thumbs img:first-child { margin-left: 0; }
    .node:not(.hub) .n-thumbs img { border-color: var(--field-raised); }
    /* A box reached with Tab scrolls itself clear of the sticky journey bar. */
    .map-main .node[role="button"] { cursor: pointer; scroll-margin-top: 15rem; }
    .colhead { position: absolute; z-index: 2; font-family: var(--display); font-size: 13px; letter-spacing: .26em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--line); padding-bottom: 8px; }
    .group { position: absolute; z-index: 0; border: 1.5px dashed color-mix(in srgb, var(--mark) 22%, transparent); border-radius: 18px; background: color-mix(in srgb, var(--mark) 2.5%, transparent); transition: opacity .35s; }
    .group .g-label { position: absolute; top: 10px; left: 16px; font-family: var(--display); font-size: 13px; letter-spacing: .24em; text-transform: uppercase; color: var(--mark); }
    .edge-label { position: absolute; z-index: 3; transform: translate(-50%, -50%); background: var(--field); padding: 2px 8px; border-radius: 6px; border: 1px solid var(--line-soft); white-space: nowrap; font-size: 13.5px; font-style: italic; }
    g.edge { transition: opacity .35s; }
    g.edge.dim { opacity: .07; }
    g.edge path.base { fill: none; stroke-width: 1.8; opacity: .55; transition: stroke-width .3s, opacity .3s; }
    g.edge.hot path.base { stroke-width: 3; opacity: 1; }
    g.edge path.flow { fill: none; stroke-width: 2.4; stroke-linecap: round; stroke-dasharray: 1.5 13; animation: dm-flow 1.6s linear infinite; }
    svg.live g.edge path.flow { display: none; }
    .tiny g.edge path.base { stroke-width: 4.5; opacity: .7; }
    .tiny g.edge.hot path.base { stroke-width: 7; }
    @media (prefers-reduced-motion: reduce) { g.edge path.flow { animation: none; } .wall .col { animation: none; } }

    /* ---------- the camera (engine.ts) ---------- */
    /* At the fitted view a finger scrolls the page straight past the map.
       Zoomed in, the map takes the finger: that is the only way to pan it. */
    .map-size.cam { touch-action: pan-y; }
    .map-size.cam.zoomed { touch-action: none; cursor: grab; }
    .map-size.cam.dragging { cursor: grabbing; user-select: none; }
    .canvas.fly { transition: transform .8s cubic-bezier(.3,.05,.2,1); }
    @media (prefers-reduced-motion: reduce) { .canvas.fly { transition: none; } }
    @media (max-width: 759px) {
      .map-size.cam { border: 1px solid var(--line); border-radius: 14px; background: radial-gradient(circle, color-mix(in srgb, var(--mark) 9%, transparent) 1px, transparent 1.5px) 0 0 / 18px 18px, var(--field-deep); }
    }
    /* A line is a thin target. This fat invisible stroke over it is what the
       pointer actually meets; --hit grows as the map shrinks on screen. */
    g.edge path.hit { fill: none; stroke: transparent; stroke-width: var(--hit, 22px); pointer-events: stroke; cursor: help; }
    .edge-tip { position: absolute; z-index: 4; transform: translate(-50%, -50%); pointer-events: none; background: var(--field-deep); border: 1px solid var(--c, var(--line)); color: var(--mark); padding: 5px 11px; border-radius: 8px; white-space: nowrap; font-size: 14.5px; box-shadow: 0 8px 24px rgba(0,0,0,.5); }
    .tiny .edge-tip { font-size: 34px; padding: 12px 22px; border-radius: 16px; border-width: 2px; }
    /* Camera controls follow the camera, not the phone breakpoint. */
    &.is-cam .map-hint.mob-only { display: flex !important; }
    &.is-cam .map-hint.desk-only { display: none !important; }
    .skip-map { position: absolute; left: -9999px; }
    .skip-map:focus { position: static; display: inline-block; margin-top: 14px; color: var(--moss); font-size: 15px; }

    /* ---------- small boxes with a state pill (the ticket desk's map) ---------- */
    .node.compact { padding: 10px 12px 11px; }
    .node.compact .n-title { font-size: 16.5px; }
    .node .n-chip { margin-top: 7px; display: inline-block; font-size: 12.5px; line-height: 1; padding: 4px 9px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); font-variant-numeric: lining-nums tabular-nums; transition: color .4s, border-color .4s, background .4s; }
    .node .n-chip:empty { display: none; }
    .node .n-chip.busy { color: var(--l-tickets); border-color: var(--l-tickets); }
    .node .n-chip.on { color: #1c1a17; background: var(--l-tickets); border-color: var(--l-tickets); }
    /* The big map's own boxes remember a sold-out night with a flag, which
       sits on the corner and so never changes a box's measured height. */
    .node .n-flag { position: absolute; top: -11px; right: 10px; font-size: 12px; line-height: 1; padding: 4px 9px; border-radius: 999px; background: var(--l-tickets); color: #1c1a17; box-shadow: 0 4px 14px rgba(0,0,0,.4); white-space: nowrap; }
    svg.still g.edge path.flow { display: none; }

    /* ---------- a box's drawer ---------- */
    /* .box-drawer, never .drawer: that name belongs to the twelve cards of
       the content library further down, and a shared class hid all of them. */
    .box-drawer { position: fixed; z-index: 40; top: 0; right: 0; bottom: 0; width: min(430px, 100vw); background: var(--field-raised); border-left: 1px solid var(--line); box-shadow: -30px 0 70px rgba(0,0,0,.55); padding: 24px 26px 5rem; overflow-y: auto; overscroll-behavior: contain; visibility: hidden; transform: translateX(104%); transition: transform .34s cubic-bezier(.2,.7,.2,1), visibility 0s .34s; }
    .box-drawer.open { visibility: visible; transform: none; transition: transform .34s cubic-bezier(.2,.7,.2,1), visibility 0s; }
    @media (prefers-reduced-motion: reduce) { .box-drawer, .box-drawer.open { transition: none; } }
    @media (max-width: 759px) {
      .box-drawer { top: auto; left: 0; width: auto; max-height: 66vh; border-left: 0; border-top: 1px solid var(--line); border-radius: 18px 18px 0 0; box-shadow: 0 -24px 60px rgba(0,0,0,.6); padding: 18px 18px 2.2rem; transform: translateY(104%); }
    }
    .dr-close { position: sticky; top: 0; display: block; width: 38px; height: 38px; margin: -4px -6px -34px auto; border-radius: 50%; border: 1px solid var(--line); background: var(--field-deep); cursor: pointer; font-size: 21px; line-height: 1; z-index: 1; }
    .dr-close:hover { border-color: var(--mark); }
    .dr-lanes { display: flex; gap: 5px; margin-bottom: 10px; }
    .dr-lanes i { width: 22px; height: 3px; border-radius: 2px; display: block; }
    .dr-kick { font-family: var(--display); font-size: 12px; letter-spacing: .24em; text-transform: uppercase; color: var(--muted); }
    .dr-title { font-family: var(--display); font-size: 29px; line-height: 1.12; margin-top: 3px; }
    .dr-sec { margin-top: 22px; }
    .dr-sec h4 { font-family: var(--display); font-size: 12px; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); margin-bottom: 7px; }
    .dr-sec p { font-size: 15.5px; line-height: 1.48; }
    .dr-sec.tech p { border-left: 2px solid var(--caramel); padding-left: 11px; }
    .dr-sec.deep { border-top: 1px solid var(--line-soft); padding-top: 18px; }
    .dr-lines { list-style: none; display: grid; gap: 9px; }
    .dr-lines li { display: grid; grid-template-columns: 12px 1fr; gap: 10px; align-items: start; font-size: 15px; line-height: 1.35; }
    .dr-lines li i { width: 10px; height: 10px; border-radius: 50%; margin-top: 5px; background: var(--c); box-shadow: 0 0 8px var(--c); display: block; }
    .dr-lines button { background: none; border: 0; cursor: pointer; text-align: left; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--mark) 35%, transparent); text-underline-offset: 3px; }
    .dr-lines button:hover { text-decoration-color: var(--mark); }
    .dr-lines small { display: block; color: var(--muted); font-size: 14px; margin-top: 1px; }
    .dr-lines small.w { color: color-mix(in srgb, var(--caramel) 80%, var(--mark)); }
    .dr-sketch { font-family: ui-monospace, 'Cascadia Code', Consolas, Menlo, monospace; font-size: 12.5px; line-height: 1.65; background: var(--field-deep); border: 1px solid var(--line-soft); border-radius: 10px; padding: 12px 14px; overflow-x: auto; white-space: pre; color: color-mix(in srgb, var(--mark) 86%, transparent); }
    .dr-note { margin-top: 7px; font-size: 13px; color: var(--muted); font-style: italic; }

    /* ---------- content library ---------- */
    .drawers { margin-top: 26px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    .drawer { border: 1px solid var(--line); border-radius: 12px; background: var(--field-raised); padding: 14px 16px 15px; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .drawer .d-top { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
    .drawer .d-name { font-family: var(--display); font-size: 18.5px; line-height: 1.2; }
    .drawer .d-n { font-weight: 600; font-variant-numeric: lining-nums tabular-nums; font-size: 24px; color: var(--moss); line-height: 1; }
    .drawer .d-what { font-size: 14.5px; color: var(--muted); line-height: 1.38; }
    .drawer .d-feeds { margin-top: auto; padding-top: 8px; display: flex; gap: 6px; flex-wrap: wrap; }
    .chip { font-size: 12.5px; letter-spacing: .04em; padding: 2px 9px; border-radius: 999px; border: 1px solid; white-space: nowrap; }
    .chip.site { color: var(--l-content); border-color: color-mix(in srgb, var(--l-content) 45%, transparent); }
    .chip.live { color: var(--l-live); border-color: color-mix(in srgb, var(--l-live) 45%, transparent); }
    .chip.g { color: var(--l-tickets); border-color: color-mix(in srgb, var(--l-tickets) 45%, transparent); }
    @media (max-width: 900px) { .drawers { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 520px) { .drawers { grid-template-columns: 1fr; } }

    .matrix { margin-top: 20px; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
    .m-row { display: grid; grid-template-columns: 230px 1fr 1.5fr; gap: 22px; align-items: center; padding: 12px 20px; border-bottom: 1px solid var(--line-soft); }
    .m-row:last-child { border-bottom: 0; }
    .m-row.head { background: var(--field-raised); padding-block: 10px; }
    .m-row.head div { font-size: 12.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
    .m-theme { font-family: var(--display); font-size: 18px; }
    .strip { display: flex; margin-top: 6px; }
    .strip img { width: 30px; height: 30px; border-radius: 7px; object-fit: cover; background: var(--field-deep); border: 2px solid var(--field); margin-left: -7px; transition: transform .25s; }
    .strip img:first-child { margin-left: 0; }
    .m-row:hover .strip img { transform: translateY(-3px); }
    .bar { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .bar .track { flex: 1; height: 16px; display: flex; border-radius: 3px; overflow: hidden; background: var(--line-soft); }
    .bar .track i { display: block; height: 100%; transform-origin: left; }
    .bar .track i + i { border-left: 1.5px solid var(--field); }
    .pre .bar .track i { transform: scaleX(0); }
    .grow .bar .track i { animation: dm-grow 1.1s cubic-bezier(.2,.7,.2,1) both; }
    .bar .v { font-weight: 600; font-variant-numeric: lining-nums tabular-nums; font-size: 16px; width: 3ch; text-align: right; }
    .bar .v.none { color: var(--muted); font-weight: 400; font-style: italic; width: auto; font-size: 14px; }
    .tiers { display: flex; gap: 18px; flex-wrap: wrap; font-size: 14px; color: var(--muted); margin-top: 12px; }
    .tiers span { display: inline-flex; align-items: center; gap: 7px; }
    .tiers i { width: 13px; height: 13px; border-radius: 3px; display: block; }
    @media (max-width: 700px) { .m-row { grid-template-columns: 1fr; gap: 6px; } .m-row.head { display: none; } }

    /* ---------- tickets ---------- */
    .steps { margin-top: 26px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .step { position: relative; border: 1px solid var(--line); border-radius: 14px; background: var(--field-raised); padding: 18px 20px; transition: border-color .5s, box-shadow .5s, background .5s; }
    .step.lit { border-color: var(--l-tickets); box-shadow: 0 0 30px color-mix(in srgb, var(--l-tickets) 22%, transparent); background: color-mix(in srgb, var(--l-tickets) 7%, var(--field-raised)); }
    .step .s-n { width: 36px; height: 36px; border-radius: 50%; border: 2px solid var(--l-tickets); color: var(--l-tickets); display: grid; place-items: center; font-weight: 600; font-variant-numeric: lining-nums; font-size: 17px; background: color-mix(in srgb, var(--l-tickets) 10%, transparent); }
    .step h3 { font-family: var(--display); font-size: 19px; line-height: 1.2; margin: 12px 0 6px; }
    .step p { font-size: 15.5px; color: var(--muted); line-height: 1.42; }
    .step.final { background: var(--pine); }
    .step.final p { color: var(--mark); }
    @media (max-width: 900px) { .steps { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }

    /* The ticket desk: a made-up night you can sell out. */
    .desk { margin-top: 16px; display: grid; grid-template-columns: 300px 1fr; gap: 26px; align-items: center; padding: 22px; border-radius: 18px; border: 1px solid color-mix(in srgb, var(--l-tickets) 34%, transparent); background: radial-gradient(ellipse at 20% 30%, color-mix(in srgb, var(--l-tickets) 9%, var(--field-deep)), var(--field-deep) 70%); }
