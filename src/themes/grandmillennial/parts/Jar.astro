---
/** A lidded ginger jar in blue and white, drawn for this school: shoulder
    and foot bands, and a peony spray on the belly. With `kangxi` it is the
    other kind: a cobalt belly cut with cracked ice, and a prunus branch
    reserved in white (the blossoms are the unpainted glaze). `uid` keeps the
    clip's id unique when two jars share a page. */
interface Props { class?: string; kangxi?: boolean; uid?: string }
const { class: cls, kangxi = false, uid = 'a' } = Astro.props;
const PETAL = 'M0 0C-6-5-7-14 0-17 7-14 6-5 0 0Z';
const petals = Array.from({ length: 8 }, (_, i) => i * 45);
const BELLY = 'M33 31C12 38 5 62 9 84 13 104 27 118 36 122H64C73 118 87 104 91 84 95 62 88 38 67 31Z';

/* Cracked ice: a jittered lattice, edges drawn between neighbours, the same
   every build (a hash of the cell, not a random number). */
const h = (a: number, b: number) => { const s = Math.sin(a * 127.1 + b * 311.7) * 43758.5453; return s - Math.floor(s); };
const cols = 9, rows = 9, x0 = -2, y0 = 30, dx = 13, dy = 11;
const P = (i: number, j: number): [number, number] => [x0 + i * dx + (h(i, j) - 0.5) * 9, y0 + j * dy + (h(j, i + 7) - 0.5) * 8];
let ice = '';
for (let j = 0; j < rows; j++) for (let i = 0; i < cols; i++) {
  const [x, y] = P(i, j);
  if (i + 1 < cols && h(i + 3, j) > 0.12) { const [a, b] = P(i + 1, j); ice += `M${x.toFixed(1)} ${y.toFixed(1)}L${a.toFixed(1)} ${b.toFixed(1)}`; }
  if (j + 1 < rows && h(i, j + 5) > 0.12) { const [a, b] = P(i, j + 1); ice += `M${x.toFixed(1)} ${y.toFixed(1)}L${a.toFixed(1)} ${b.toFixed(1)}`; }
  if (i + 1 < cols && j + 1 < rows && h(i + 9, j + 2) > 0.7) { const [a, b] = P(i + 1, j + 1); ice += `M${x.toFixed(1)} ${y.toFixed(1)}L${a.toFixed(1)} ${b.toFixed(1)}`; }
}
const blossoms: [number, number, number][] = [[30, 100, 0.95], [44, 86, 1.15], [60, 74, 1.2], [76, 58, 1], [66, 92, 0.8], [38, 66, 0.8]];
---
<svg class:list={['gm-jar', cls]} viewBox="0 0 100 132" aria-hidden="true" focusable="false">
  <circle class="body" cx="50" cy="9" r="5.5" />
  <path class="body" d="M28 27C28 15 72 15 72 27Z" />
  <rect class="body" x="26" y="25" width="48" height="6" rx="2" />
  <path class="body" d={BELLY} />
  <rect class="body" x="35" y="121" width="30" height="6" rx="1.5" />
  {kangxi && <>
    <clipPath id={`gm-jar-belly-${uid}`}><path d={BELLY} /></clipPath>
    <g clip-path={`url(#gm-jar-belly-${uid})`}>
      <rect class="cobalt" x="0" y="30" width="100" height="95" />
      <path class="ice" d={ice} />
      <path class="branch" d="M22 112C30 100 40 92 50 82 58 74 64 68 78 52M44 88C46 80 44 74 40 66M60 74C64 80 70 84 74 84M30 102C26 98 24 94 24 90" />
      {blossoms.map(([x, y, s]) => (
        <g transform={`translate(${x} ${y}) scale(${s})`}>
          {[0, 72, 144, 216, 288].map((a) => <circle class="bloom" cx="0" cy="-3.6" r="2.7" transform={`rotate(${a + x})`} />)}
          <circle class="eye" r="1.1" />
        </g>
      ))}
    </g>
  </>}
  <g class="ink-line">
    <circle cx="50" cy="9" r="5.5" />
    <path d="M28 27C28 15 72 15 72 27" />
    <rect x="26" y="25" width="48" height="6" rx="2" />
    <path d={BELLY} />
    <rect x="35" y="121" width="30" height="6" rx="1.5" />
  </g>
  <path class="band" d="M20 42C38 35 62 35 80 42" style={kangxi ? 'display:none' : undefined} />
  <path class="band" d="M24 111C40 116 60 116 76 111" style={kangxi ? 'display:none' : undefined} />
  <path class="ink" d="M36 20C42 17 58 17 64 20 58 22 42 22 36 20Z" />
  {!kangxi && <>
    <g transform="translate(50 76)">
      <path class="ink" d="M-6 8C-18 14-28 12-32 4-22 2-12 4-6 8Z" />
      <path class="ink" d="M6-8C18-16 28-14 32-6 22-4 12-4 6-8Z" />
      <path class="ink-line" d="M-30 18C-18 14-6 10 0 0M0 0C8-10 18-14 30-20" />
      {petals.map((a) => <path class="ink" transform={`rotate(${a})`} d={PETAL} />)}
      {petals.map((a) => <path class="petal-in" transform={`rotate(${a + 22.5}) scale(0.6)`} d={PETAL} />)}
      <circle class="ink" r="3.4" />
    </g>
    <circle class="ink" cx="24" cy="58" r="2.6" /><circle class="ink" cx="78" cy="96" r="2.6" />
    <circle class="ink" cx="76" cy="54" r="1.8" /><circle class="ink" cx="22" cy="96" r="1.8" />
  </>}
</svg>

<style>
  .gm-jar { overflow: visible; filter: drop-shadow(0 6px 6px rgb(0 0 0 / 0.25)); }
  .body { fill: var(--plate); }
  .ink { fill: var(--plate-ink); }
  .petal-in { fill: var(--plate); stroke: var(--plate-ink); stroke-width: 1.2; }
  .ink-line, .ink-line * { fill: none; stroke: var(--plate-ink); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .band { fill: none; stroke: var(--plate-ink); stroke-width: 4; stroke-dasharray: 2 2.2; }
  /* The kangxi belly: cobalt ground, ice in glaze white, prunus reserved. */
  .cobalt { fill: var(--plate-ink); }
  .ice { fill: none; stroke: var(--plate); stroke-width: 0.9; stroke-opacity: 0.6; stroke-linecap: round; }
  .branch { fill: none; stroke: var(--plate); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .bloom { fill: var(--plate); }
  .eye { fill: var(--plate-ink); }
</style>
