<style is:global>
  /* Unprefixed: the leaves and catkins are <use> clones (see ChinoiserieShapes.astro). */
  .gm-birch { overflow: visible; width: 100%; height: 100%; --bb-paper: #f7f3ea; --bb-shade: #ddd3bb; --bb-line: #3a3225; --bb-dark: #2b2a26; --bb-limb: #6b4a2e; }
  html[data-scheme='dark'] .gm-birch { --bb-paper: #d8cfb6; --bb-shade: #a69c82; --bb-line: #e0cf98; --bb-dark: #1d1b15; --bb-limb: #8a6a46; }
  .bb-ln { fill: none; stroke: var(--bb-line); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .bb-ln2 { fill: none; stroke: var(--bb-line); stroke-width: 0.8; stroke-linecap: round; stroke-linejoin: round; }
  .bb-trunk { fill: var(--bb-paper); }
  .bb-shade { fill: var(--bb-shade); opacity: 0.85; }
  .bb-lent { fill: none; stroke: var(--bb-dark); stroke-width: 2.1; stroke-linecap: round; }
  .bb-curl { fill: var(--bb-paper); stroke: var(--bb-line); stroke-width: 0.6; stroke-linejoin: round; }
  .bb-limb { fill: var(--bb-limb); stroke: var(--bb-line); stroke-width: 0.6; stroke-linejoin: round; }
  .bb-eye { fill: var(--bb-dark); }
  .bb-twig { fill: none; stroke: var(--bb-limb); stroke-width: 1.1; stroke-linecap: round; }
  .bb-lf { fill: var(--c-leaf); stroke: var(--bb-line); stroke-width: 0.5; stroke-linejoin: round; }
  .bb-lf2 { fill: var(--c-leaf-lt); stroke: var(--bb-line); stroke-width: 0.5; stroke-linejoin: round; }
  .bb-vein { fill: none; stroke: var(--bb-line); stroke-width: 0.4; opacity: 0.55; stroke-linecap: round; }
  .bb-cat { fill: var(--catkin); stroke: var(--bb-line); stroke-width: 0.5; }
  .bb-ground { fill: none; stroke: var(--bb-line); stroke-width: 1; stroke-linecap: round; opacity: 0.5; }
  .bb-grass { fill: none; stroke: var(--bb-line); stroke-width: 0.9; stroke-linecap: round; opacity: 0.55; }
  .bb-stone { fill: var(--bb-shade); stroke: var(--bb-line); stroke-width: 0.7; opacity: 0.8; }
</style>
