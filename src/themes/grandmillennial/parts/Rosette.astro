---
/** A ribbon rosette, drawn for this school: nine broad pleats round a large
    covered button, two short notched tails hanging under it, all in the bow's
    oxblood. Each pleat is a fan folded down its middle (one half lit, one
    half in shade) with a soft rounded edge, so the ring reads as gathered
    ribbon and not as a starburst (B1 fix call 8: the first pass drew sixty
    knife pleats) or a dahlia (11-17-26, call 2: eighteen two-tone pleats round
    a small button, no tails; now one ring of nine, a button about a third of
    the rosette across and the two tails of a prize rosette). It takes the
    ribbon bow's place on Services' ask (B1 task 4, decision C: Home's and
    Sent's bows stay, this one is trimmed). */
interface Props { class?: string }
const { class: cls } = Astro.props;
const t = (n: number) => String(Math.round(n * 10) / 10);
/** One pleat pointing up from the centre: [lit half, shaded half, fold line]. */
function pleat(r0: number, r1: number, w: number) {
  const half = (s: number) =>
    `M0 ${t(-r0)}L${t(s * w * 0.3)} ${t(-r0)}C${t(s * w * 0.8)} ${t(-r1 * 0.5)} ${t(s * w)} ${t(-r1 * 0.82)} ${t(s * w * 0.62)} ${t(-r1 * 0.96)}Q${t(s * w * 0.3)} ${t(-r1 * 1.03)} 0 ${t(-r1)}Z`;
  return { lit: half(-1), shade: half(1), fold: `M0 ${t(-r0)}L0 ${t(-r1 * 0.94)}` };
}
/** Nine broad pleats, each wide enough to lie a third over its neighbour. */
const ring = Array.from({ length: 9 }, (_, i) => ({ a: (i * 360) / 9, ...pleat(9, 37, 14.5) }));
/** A tail: a ribbon hanging from the centre, its end cut in a swallow-tail. About 95
    units long (the pleats reach 37, so about 58 hang clear below the ring), 6 either side
    of the centre at the button widening to 8.5 at the cut, the notch 8 deep (GM1, Stage 6 w2
    task 14: the 45-unit tails of Stage 5 left about 10px under the pleats and read as stubs). */
const tail = (len: number) => `M-6 0L6 0L8.5 ${len}L0 ${len - 8.2}L-8.5 ${len}Z`;
const TAIL_A = tail(95);
/** The other tail about 7 units shorter, so the pair looks tied by hand and not stamped. */
const TAIL_B = tail(88);
---
<svg class:list={['gm-rosette', cls]} viewBox="-42 -42 84 145" aria-hidden="true" focusable="false">
  <g transform="rotate(17)"><path class="tail" d={TAIL_A} /><path class="tail-fold" d="M0 4L0 86" /></g>
  <g transform="rotate(-17)"><path class="tail" d={TAIL_B} /><path class="tail-fold" d="M0 4L0 79" /></g>
  <circle class="disc" r="26" />
  {ring.map((p) => (
    <g transform={`rotate(${p.a})`}>
      <path class="lit" d={p.lit} />
      <path class="shade" d={p.shade} />
      <path class="fold" d={p.fold} />
    </g>
  ))}
  <circle class="button" r="12.5" />
  <circle class="gather-ring" r="9.4" />
  <path class="gather" d="M-8.4 -4.2Q0 -9 8.4 -4.2M-9.6 1.4Q0 -4.2 9.6 1.4M-8 6.6Q0 2 8 6.6" />
  <circle class="shine" cx="-3.6" cy="-4.4" r="2.8" />
</svg>

<style>
  .gm-rosette { overflow: visible; filter: drop-shadow(0 3px 3px rgb(40 10 10 / 0.25)); }
  .disc { fill: var(--bow-deep); }
  .lit { fill: var(--bow); }
  .shade { fill: color-mix(in srgb, var(--bow), var(--bow-deep) 55%); }
  .lit, .shade { stroke: var(--bow-deep); stroke-width: 0.6; stroke-linejoin: round; }
  .fold { fill: none; stroke: var(--bow-deep); stroke-width: 0.5; stroke-linecap: round; opacity: 0.7; }
  .tail { fill: color-mix(in srgb, var(--bow), var(--bow-deep) 40%); stroke: var(--bow-deep); stroke-width: 0.6; stroke-linejoin: round; }
  .tail-fold { fill: none; stroke: var(--bow-deep); stroke-width: 0.5; stroke-linecap: round; opacity: 0.55; }
  .button { fill: var(--bow); stroke: var(--bow-deep); stroke-width: 1; }
  .gather-ring { fill: none; stroke: var(--bow-deep); stroke-width: 0.4; opacity: 0.45; }
  .gather { fill: none; stroke: var(--bow-deep); stroke-width: 0.5; stroke-linecap: round; opacity: 0.55; }
  .shine { fill: rgb(255 235 235 / 0.5); }
</style>
