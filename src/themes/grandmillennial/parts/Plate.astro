---
/** A blue-and-white plate for the plate wall, drawn for this school: a
    scalloped rim, a lotus border and a painted well. Three wells so a hung
    group never repeats: the peony, a bamboo and prunus spray, and a
    star-lattice medallion with a crane's-foot flower. Each is brushed with
    two inks, a pale wash laid first and the dark line over it, the way
    underglaze cobalt pools and thins.

    The drawing lives once in parts/PlateDefs.astro (Stage 6 w2 task 15): this is
    the svg that stacks one rim (by lotus count: 12, 16 or 20) and one well, the
    well turned by `turn`, with <use>. The page that hangs plates mounts PlateDefs. */
interface Props { class?: string; turn?: number; well?: 'peony' | 'bamboo' | 'medallion'; lotus?: 12 | 16 | 20 }
const { class: cls, turn = 0, well = 'peony', lotus = 16 } = Astro.props;
---
<svg class:list={['gm-plate', cls]} viewBox="-52 -52 104 104" aria-hidden="true" focusable="false">
  <use href={`#gm-pl-rim-${lotus}`} />
  <g transform={`rotate(${turn})`}><use href={`#gm-pl-well-${well}`} /></g>
</svg>

<style>
  /* The plate swings when brushed or tapped (parts/plates.ts), and only where it is painted: the svg's
     square box takes no pointer, its <use> rim and well do, so the round plate is the hit area. */
  .gm-plate { overflow: visible; filter: drop-shadow(0 4px 5px rgb(0 0 0 / 0.22)); pointer-events: none; }
  .gm-plate use { pointer-events: visiblePainted; }
</style>
