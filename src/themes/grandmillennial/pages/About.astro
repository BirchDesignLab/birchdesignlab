---
/** Grandmillennial about. The shining tree sits for its portrait in a gilt
    oval beside the etymology, hung on a picture wire against a hand-painted
    chinoiserie wall of birches and long-tailed birds (one of them is alive);
    the founder's letter is framed in a hunter lacquer room; the manifesto is
    worked as a counted cross-stitch sampler: a Greek-key border, an alphabet
    band and the heart between two flowers. */
import { rich, type CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';
import Chintz from '../parts/Chintz.astro';
import ChinoiserieShapes from '../parts/ChinoiserieShapes.astro';
import Framed from '../parts/Framed.astro';
import Frame2 from '../parts/Frame2.astro';
import WallBird from '../parts/WallBird.astro';

interface Props { copy: CopyData<'about'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;

/* The wall's one live bird: a perched bird on a branch of the painting and a
   second branch for it to fly to. [x, y, scale, facing] in the wall's 1600 x
   1300 drawing; the wall file carries no bird at either point. The wide wall
   (anchored to the top centre) and the phone's (anchored to the left) are the
   same drawing cropped differently, so each has its own pair. */
const BIRD_WIDE = { home: [575, 119, 1.05, -1], away: [644, 89, 1.0, 1] } as const;
const BIRD_PHONE = { home: [336, 217, 0.5, -1], away: [357, 204, 0.5, 1] } as const;

/* The sampler's cross-stitch border motif: a heart between two flowers, one
   cross per cell. r = the stitch thread, g = leaf green. */
const motif = [
  '..r.r.....rrr.rrr.....r.r..',
  '.rrrrr...rrrrrrrrr...rrrrr.',
  '..rrr...rrrrrrrrrrr...rrr..',
  '...g.....rrrrrrrrr.....g...',
  '.gg.g.....rrrrrrr.....g.gg.',
  '...gg......rrrrr......gg...',
  '...g........rrr........g...',
  '...g.........r.........g...',
];
const cell = 8;
const stitches = motif.flatMap((row, y) =>
  [...row].flatMap((ch, x) => (ch === '.' ? [] : [{ x: x * cell, y: y * cell, kind: ch }])),
);

/* The sampler's alphabet, counted: a 5 x 7 grid per letter, a column between,
   two rows of thirteen. Drawn as a mask of filled cells over a field of crosses
   (a pattern), so it is one small SVG and no text node. */
const FONT: Record<string, string> = {
  A: '.XXX.X...XX...XXXXXXX...XX...XX...X', B: 'XXXX.X...XX...XXXXX.X...XX...XXXXX.',
  C: '.XXXXX....X....X....X....X.....XXXX', D: 'XXXX.X...XX...XX...XX...XX...XXXXX.',
  E: 'XXXXXX....X....XXXX.X....X....XXXXX', F: 'XXXXXX....X....XXXX.X....X....X....',
  G: '.XXXXX....X....X..XXX...XX...X.XXXX', H: 'X...XX...XX...XXXXXXX...XX...XX...X',
  I: 'XXXXX..X....X....X....X....X..XXXXX', J: '..XXX...X....X....X....X.X..X..XX..',
  K: 'X...XX..X.X.X..XX...X.X..X..X.X...X', L: 'X....X....X....X....X....X....XXXXX',
  M: 'X...XXX.XXX.X.XX.X.XX...XX...XX...X', N: 'X...XXX..XX.X.XX..XXX...XX...XX...X',
  O: '.XXX.X...XX...XX...XX...XX...X.XXX.', P: 'XXXX.X...XX...XXXXX.X....X....X....',
  Q: '.XXX.X...XX...XX...XX.X.XX..X..XX.X', R: 'XXXX.X...XX...XXXXX.X.X..X..X.X...X',
  S: '.XXXXX....X.....XXX.....X....XXXXX.', T: 'XXXXX..X....X....X....X....X....X..',
  U: 'X...XX...XX...XX...XX...XX...X.XXX.', V: 'X...XX...XX...XX...XX...X.X.X...X..',
  W: 'X...XX...XX...XX.X.XX.X.XXX.XXX...X', X: 'X...XX...X.X.X...X...X.X.X...XX...X',
  Y: 'X...XX...X.X.X...X....X....X....X..', Z: 'XXXXX....X...X...X...X...X....XXXXX',
};
const ABC_CELL = 3;
/** The filled cells of the letters laid out in the given rows, and the size of the sheet. */
function abcLayout(rows: string[]) {
  let d = '';
  rows.forEach((letters, r) => {
    [...letters].forEach((ch, i) => {
      const g = FONT[ch];
      for (let y = 0; y < 7; y++) {
        let x = 0;
        while (x < 5) {
          if (g[y * 5 + x] !== 'X') { x++; continue; }
          let run = x;
          while (run < 5 && g[y * 5 + run] === 'X') run++;
          d += `M${(i * 6 + x) * ABC_CELL} ${(r * 9 + y) * ABC_CELL}h${(run - x) * ABC_CELL}v${ABC_CELL}h${-(run - x) * ABC_CELL}z`;
          x = run;
        }
      }
    });
  });
  const cols = Math.max(...rows.map((letters) => letters.length));
  // the last letter has no trailing column, the last row no trailing gap
  return { d, w: (cols * 6 - 1) * ABC_CELL, h: (rows.length * 9 - 2) * ABC_CELL };
}
/* Two rows of thirteen on a wide sampler; four rows of seven on a phone, so each stitch is still a
   visible X at the narrow width (B1 fix call 2). Only one of the two is ever shown. */
const abcWide = abcLayout(['ABCDEFGHIJKLM', 'NOPQRSTUVWXYZ']);
const abcNarrow = abcLayout(['ABCDEFG', 'HIJKLMN', 'OPQRSTU', 'VWXYZ']);
const abcSheets = [
  { cls: 'abc wide', id: 'w', ...abcWide },
  { cls: 'abc narrow', id: 'n', ...abcNarrow },
];

/* The Greek key: a hook between two rails, one cross per cell, as a repeating
   mask. The top and foot of the sampler take the tile across; the sides take it
   turned a quarter. The colour is the thread (--stitch), so it follows the
   scheme. */
const KEY = [
  'XXXXXXXX',
  'X.......',
  'X.XXXXX.',
  'X.X...X.',
  'X.X.X.X.',
  'X.X.XXX.',
  'X.X.....',
  'XXXXXXXX',
];
const turned = KEY.map((_, r) => [...KEY].reverse().map((row) => row[r]).join(''));
const tile = (rows: string[]) => {
  const cross = rows.flatMap((row, y) =>
    [...row].flatMap((ch, x) => (ch === 'X' ? [`M${x + 0.14} ${y + 0.14}l.72 .72m0 -.72l-.72 .72`] : [])),
  ).join('');
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'><path d='${cross}' fill='none' stroke='#000' stroke-width='.36' stroke-linecap='round'/></svg>`;
  return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
};
/* The corner stone where the runs turn: concentric squares, worked in the same crosses (B1 fix:
   the runs end in whole motifs and turn the four corners). */
const CORNER = [
  'XXXXXXXX',
  'X......X',
  'X.XXXX.X',
  'X.X..X.X',
  'X.X..X.X',
  'X.XXXX.X',
  'X......X',
  'XXXXXXXX',
];
const keyStyle = `--key-h:${tile(KEY)};--key-v:${tile(turned)};--key-c:${tile(CORNER)}`;
---
<ChinoiserieShapes />

<div class="gm-wall gm-wall--scene">
  <div class="gm-wall-band" aria-hidden="true"></div>

  <div class="scene-part a">
    <div class="scene-art" aria-hidden="true"></div>
    <WallBird class="wide" colour="B" home={[...BIRD_WIDE.home]} away={[...BIRD_WIDE.away]} par="xMidYMin slice" />
    <WallBird class="phone" home={[...BIRD_PHONE.home]} away={[...BIRD_PHONE.away]} par="xMinYMin slice" />
    <section class="intro gm-wrap">
      <figure class="sitter" aria-hidden="true">
        <svg class="wire" viewBox="0 0 100 44" focusable="false">
          <path d="M18 43.5L50 8L82 43.5" />
          <circle class="eyelet" cx="18" cy="43.5" r="1.7" />
          <circle class="eyelet" cx="82" cy="43.5" r="1.7" />
          <circle class="nail" cx="50" cy="8" r="3.1" />
        </svg>
        <div class="gilt-oval">
          <div class="ring">
            <Chintz />
            <div class="oval"><div class="birch-box"><span class="birch"></span></div></div>
          </div>
        </div>
        <Frame2 />
      </figure>
      <div class="story wall-card">
        <h1>{copy.heading}</h1>
        {copy.etymology.map((para) => <p set:html={rich(para)} />)}
      </div>
    </section>
  </div>

  <div class="gm-wall-band mid" aria-hidden="true"></div>

  <div class="scene-part b">
    <div class="scene-art" aria-hidden="true"></div>
    <section class="founder">
      <div class="gm-wrap">
        <Framed tag="article" tone="raised" border="chintz" class="letter">
          <h2>{copy.founder.heading}</h2>
          {copy.founder.body.map((para) => <p>{para}</p>)}
        </Framed>
      </div>
    </section>
  </div>

  <div class="gm-wall-band" aria-hidden="true"></div>
</div>

<section class="sampler-row gm-wrap">
  <div class="sampler" style={keyStyle}>
    <span class="key side l" aria-hidden="true"></span>
    <span class="key side r" aria-hidden="true"></span>
    <span class="key corner tl" aria-hidden="true"></span>
    <span class="key corner tr" aria-hidden="true"></span>
    <span class="key corner bl" aria-hidden="true"></span>
    <span class="key corner br" aria-hidden="true"></span>
    {abcSheets.map((a) => (
      <svg class={a.cls} viewBox={`0 0 ${a.w} ${a.h}`} aria-hidden="true" focusable="false">
        <defs>
          <pattern id={`gm-abc-x-${a.id}`} width={ABC_CELL} height={ABC_CELL} patternUnits="userSpaceOnUse">
            <path d="M.4 .4l2.2 2.2m0 -2.2l-2.2 2.2" />
          </pattern>
          <mask id={`gm-abc-m-${a.id}`}><path d={a.d} fill="#fff" /></mask>
        </defs>
        <rect width={a.w} height={a.h} fill={`url(#gm-abc-x-${a.id})`} mask={`url(#gm-abc-m-${a.id})`} />
      </svg>
    ))}
    <svg class="stitchwork" viewBox={`-2 -2 ${motif[0].length * cell + 4} ${motif.length * cell + 4}`} aria-hidden="true" focusable="false">
      {stitches.map(({ x, y, kind }) => (
        <path class={kind === 'g' ? 'st g' : 'st'} d={`M${x + 1} ${y + 1}l6 6m0-6l-6 6`} />
      ))}
    </svg>
    <p class="manifesto">{copy.manifesto}</p>
  </div>
  <a class="gm-btn" href={hrefFor('contact', theme)}>{copy.cta}</a>
</section>

<style>
  /* ---------- The chinoiserie wall ---------- */

  /* Two rooms on one wall, a chair rail between them: the day parlour (the
     story and the portrait) and the lacquer room that holds the letter. Each
     room is the painting cropped to its own part, a file the browser caches
     (assets/chinoiserie-*.svg, built by scripts/themes/grandmillennial/
     build-chinoiserie.mjs), under the cards: no text sits on the painting. */
  .gm-wall--scene { background: none; }
  .scene-part { position: relative; isolation: isolate; }
  .scene-part.a { background-color: var(--sc-ground); }
  .scene-part.b { background-color: var(--sc-room); }
  .scene-art {
    position: absolute; inset: 0; z-index: -1;
    background-repeat: no-repeat;
    background-size: cover;
  }
  .a .scene-art { background-image: url('../assets/chinoiserie-light.svg'); background-position: 50% 0; }
  .b .scene-art { background-image: url('../assets/chinoiserie-hunter.svg'); background-position: 50% 100%; }
  :global(html[data-scheme='dark']) .a .scene-art { background-image: url('../assets/chinoiserie-dark.svg'); }
  /* The founder's room in the lacquered scheme is a deeper, richer green than the hero wall (B1 fix call 3). */
  :global(html[data-scheme='dark']) .b .scene-art { background-image: url('../assets/chinoiserie-darkroom.svg'); }
  :global(.gm-wall-band.mid) { box-shadow: 0 5px 9px -5px rgb(0 0 0 / 0.38), 0 -5px 9px -5px rgb(0 0 0 / 0.38); }

  .scene-part :global(.wall-bird-layer.phone) { display: none; }

  /* ---------- The sitter and the story ---------- */
  /* Above the live bird's layer (z 0): the oval, its wire and the story lie over the wall bird,
     never under it. The grid's own box lets pointers through to the bird; its children take them. */
  .intro {
    position: relative; z-index: 1; pointer-events: none;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  .intro > * { pointer-events: auto; }
  /* Hung a little off true: left of its column and lifted, the small second
     frame lower right. The picture wire runs from the gilt to a nail. */
  /* Decorative and inert (aria-hidden): it lets pointers through to the live bird's tap target under
     it, so the sitter never covers the target (B1 fix: the phone bird's tap rect was half under the
     oval). The story card still takes its own pointer events. Spelled .intro > .sitter to outrank the
     rule above, which Astro scopes to .intro > *[data-astro-cid]. */
  .intro > .sitter { pointer-events: none; }
  .sitter {
    position: relative; margin: 0;
    justify-self: start;
    margin-left: clamp(0rem, 1.5vw, 1.5rem);
    translate: 0 -1.25rem;
    width: min(100%, 20rem);
  }
  .wire {
    position: absolute; left: 0; top: 0;
    width: 100%; height: auto;
    translate: 0 -63.6%;
    overflow: visible;
  }
  .wire path { fill: none; stroke: var(--ornament-deep); stroke-width: 1.3px; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .wire .eyelet { fill: var(--ornament-deep); }
  .wire .nail {
    fill: var(--ornament); stroke: var(--ornament-deep); stroke-width: 1px; vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 1px 1.5px rgb(30 16 6 / 0.5));
  }
  .gilt-oval {
    padding: 14px;
    border-radius: 50%;
    background: var(--gilt);
    box-shadow:
      inset 0 0 0 1px rgb(255 245 210 / 0.6),
      inset 0 0 0 5px rgb(122 90 28 / 0.3),
      0 22px 38px -16px rgb(40 22 8 / 0.5);
  }
  .ring {
    position: relative;
    display: grid;
    aspect-ratio: 3 / 4;
    border-radius: 50%;
    padding: 9%;
    overflow: hidden;
    box-shadow: inset 0 2px 8px rgb(0 0 0 / 0.35);
  }
  .oval {
    position: relative;
    display: grid; place-items: center;
    border-radius: 50%;
    padding: 10% 12%;
    overflow: hidden;
    background: radial-gradient(closest-side, var(--oval), color-mix(in srgb, var(--oval), var(--ornament) 14%));
    box-shadow: 0 0 0 3px var(--ornament), 0 0 0 5px var(--oval), 0 0 0 6px var(--ornament), 0 4px 14px 5px rgb(0 0 0 / 0.25);
  }
  /* The botanical birch is a cached file per scheme (assets/birch-*.svg, inks baked), not inline
     markup. Its viewBox is the drawing plus 60 units on every side (the trunk runs past the drawing
     and the oval ends it), so the span is 150% x 140% of the box the old inline svg filled: same
     scale, same centre (scripts/themes/grandmillennial/build-chinoiserie.mjs). */
  .birch-box { position: relative; width: 100%; height: 100%; }
  .birch {
    position: absolute; left: -25%; right: -25%; top: -20%; bottom: -20%;
    background: url('../assets/birch-light.svg') center / contain no-repeat;
  }
  :global(html[data-scheme='dark']) .birch { background-image: url('../assets/birch-dark.svg'); }
  /* The story lies on the wall as a card, so no text sits on the painting. */
  .story {
    position: relative;
    background: var(--field-raised);
    border: 1px solid var(--rule);
    outline: 1px solid var(--rule);
    outline-offset: 6px;
    margin: 7px;
    padding: clamp(1.75rem, 4vw, 3rem);
  }
  .story h1 {
    font-style: italic;
    font-size: clamp(2.8rem, 6vw, 4.6rem);
    color: var(--mark);
    margin-bottom: 1.75rem;
  }
  .story h1::after {
    content: '';
    display: block;
    width: 5rem; height: 7px;
    margin-top: 1.25rem;
    background:
      linear-gradient(var(--rule), var(--rule)) center / 100% 1px no-repeat,
      radial-gradient(circle, var(--rule) 2.6px, transparent 3.2px) right center / 7px 7px no-repeat;
  }
  .story p { max-width: var(--measure); font-size: 1.3rem; }
  .story p + p { margin-top: 1.1rem; }
  .story p:first-of-type::first-letter {
    float: left;
    font-family: var(--font-display);
    font-size: 4.4em;
    line-height: 0.8;
    padding: 0.08em 0.1em 0 0;
    color: var(--accent);
  }

  /* ---------- The founder's letter, in its lacquer room ---------- */
  .founder { padding-block: clamp(3.5rem, 8vw, 6rem); }
  .founder :global(.letter) {
    /* The chintz strip lies outside the card: keep it inside the column. */
    width: min(100% - 2 * (var(--strip) + 4px), 44rem);
    margin-inline: auto;
  }
  /* The heading sits on its text's axis (B1 item 8): left, with the same short
     gold rule as "The shining tree". */
  .founder h2 {
    font-style: italic;
    font-size: clamp(2rem, 4vw, 2.8rem);
    text-align: left;
    margin-bottom: 1.5rem;
    color: var(--accent);
  }
  .founder h2::after {
    content: '';
    display: block;
    width: 5rem; height: 7px;
    margin-top: 1rem;
    background:
      linear-gradient(var(--rule), var(--rule)) center / 100% 1px no-repeat,
      radial-gradient(circle, var(--rule) 2.6px, transparent 3.2px) right center / 7px 7px no-repeat;
  }
  .founder p + p { margin-top: 1rem; }

  /* ---------- The sampler ---------- */
  .sampler-row {
    display: grid; justify-items: center; gap: 2.5rem;
    padding-top: clamp(4rem, 8vw, 6rem);
  }
  .sampler {
    position: relative;
    display: grid; justify-items: center; gap: 1.75rem;
    width: min(100%, 40rem);
    padding: calc(54px + clamp(0.75rem, 3vw, 1.75rem)) calc(54px + clamp(0.25rem, 2vw, 1.25rem));
    text-align: center;
    background:
      repeating-linear-gradient(0deg, rgb(120 100 60 / 0.06) 0 1px, transparent 1px 4px),
      repeating-linear-gradient(90deg, rgb(120 100 60 / 0.06) 0 1px, transparent 1px 4px),
      var(--field-raised);
    border: 2px dashed var(--stitch);
    outline: 2px dashed var(--stitch);
    outline-offset: 7px;
    margin: 9px;
    box-shadow: 0 0 0 18px var(--field), 0 0 0 20px var(--rule);
  }
  /* The Greek key round the card, 24px of counted stitches 14px in from the
     hem: the top and foot are ::before and ::after, the sides two spans. */
  .sampler::before, .sampler::after, .key {
    content: ''; position: absolute;
    background: var(--stitch);
    pointer-events: none;
  }
  /* Whole motifs only: each run lies between the corner stones and its tile repeats `round`, so the
     run is a whole number of hooks (each a hair over or under 24px), and the four corners turn on a
     stone of their own. */
  .sampler::before, .sampler::after {
    left: 38px; right: 38px; height: 24px;
    -webkit-mask: var(--key-h) center / 24px 24px round no-repeat;
    mask: var(--key-h) center / 24px 24px round no-repeat;
  }
  .sampler::before { top: 14px; }
  .sampler::after { bottom: 14px; }
  .key.side {
    top: 38px; bottom: 38px; width: 24px;
    -webkit-mask: var(--key-v) center / 24px 24px no-repeat round;
    mask: var(--key-v) center / 24px 24px no-repeat round;
  }
  .key.l { left: 14px; }
  .key.r { right: 14px; }
  .key.corner {
    width: 24px; height: 24px;
    -webkit-mask: var(--key-c) center / 24px 24px no-repeat;
    mask: var(--key-c) center / 24px 24px no-repeat;
  }
  .key.tl { left: 14px; top: 14px; }
  .key.tr { right: 14px; top: 14px; }
  .key.bl { left: 14px; bottom: 14px; }
  .key.br { right: 14px; bottom: 14px; }
  /* Oxblood thread, each cross a visible X on the counted grid (B1 fix call 2): large, so a cell is
     about 6px at 1440 and 5px on a phone. */
  .abc { width: min(100%, 30rem); height: auto; }
  .abc.narrow { display: none; width: min(100%, 17rem); }
  .abc pattern path { fill: none; stroke: var(--thread); stroke-width: 0.8px; stroke-linecap: round; }
  .stitchwork { width: min(100%, 13rem); overflow: visible; }
  .st { fill: none; stroke: var(--stitch); stroke-width: 1.7; stroke-linecap: round; }
  .st.g { stroke: var(--c-leaf); }
  .manifesto {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.3;
    text-wrap: balance;
  }

  @media (max-width: 600px) {
    .abc.wide { display: none; }
    .abc.narrow { display: block; }
  }

  @media (max-width: 820px) {
    .intro { grid-template-columns: 1fr; }
    .sitter { justify-self: center; margin-left: 0; translate: -4% 0; width: min(68%, 15rem); }
    /* Stacked, the story is a centred block under the oval, about 32em wide, its
       heading and rule centred on the oval; the drop cap stays (B1 item 8). */
    .story { width: min(100% - 14px, 32em); justify-self: center; }
    .story h1 { text-align: center; }
    .story h1::after { margin-inline: auto; }
    .a .scene-art { background-position: 0 0; }
    .scene-part :global(.wall-bird-layer.wide) { display: none; }
    .scene-part :global(.wall-bird-layer.phone) { display: block; }
    .sampler { box-shadow: 0 0 0 12px var(--field), 0 0 0 14px var(--rule); }
  }
</style>
