---
/** Grandmillennial services, laid out like a sample book: each offering
    beside a pinked fabric swatch (chintz, then porcelain trellis), the
    process as four cameos on trellis wallpaper, and the ask tied with a bow. */
import type { CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';
import Bow from '../parts/Bow.astro';
import Chintz from '../parts/Chintz.astro';
import Toile from '../parts/Toile.astro';

interface Props { copy: CopyData<'services'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI'];
---
<section class="intro gm-wrap">
  <p class="gm-kicker ruled">{copy.kicker}</p>
  <h1>{copy.heading}</h1>
  <div class="sublines">
    {copy.sublines.map((line, i) => <p class={i === 0 ? 'lede' : undefined}>{line}</p>)}
  </div>
</section>

<div class="gm-wall gm-wall--toile">
<div class="gm-wall-band ticking" aria-hidden="true"></div>
<div class="gm-wall-room">
{copy.offerings.map((offering, i) => (
  <section class:list={['offering', 'wall-card', 'gm-wrap', { flip: i % 2 === 1 }]}>
    <div class="swatch-hang" aria-hidden="true">
      <div class:list={['swatch', i % 2 ? 'porcelain' : 'floral']}>
        {i % 2 === 0 ? <Chintz swatch /> : <Toile />}
      </div>
      <span class="tag">No. {i + 1}</span>
    </div>
    <div class="offer-text">
      <h2>{offering.heading}</h2>
      {offering.body.map((para) => <p>{para}</p>)}
    </div>
  </section>
))}
</div>
<div class="gm-wall-band ticking" aria-hidden="true"></div>
</div>

<section class="process gm-trellis">
  <div class="gm-wrap">
    <h2 class="gm-kicker ruled">{copy.process.heading}</h2>
    <ol class="steps" role="list">
      {copy.process.steps.map((step, i) => (
        <li>
          <span class="cameo" aria-hidden="true"><span>{roman[i]}</span></span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="ask gm-wrap">
  <Bow class="ask-bow" />
  <p class="pull">{copy.pull}</p>
  <a class="gm-btn" href={hrefFor('contact', theme)}>{copy.cta}</a>
</section>

<style>
  .intro {
    display: grid; justify-items: center; text-align: center;
    /* The gap to the first offering is about 30% tighter than it was (B1 item 8). */
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2.1rem, 4.2vw, 3.15rem);
  }
  .intro h1 {
    font-style: italic;
    font-size: clamp(2.8rem, 7vw, 5.2rem);
    margin-top: 1.25rem;
    max-width: 12em;
  }
  .sublines {
    display: grid; gap: 0.9rem;
    margin-top: 1.75rem;
    max-width: 36em;
    font-size: 1.35rem;
    color: var(--mark-muted);
  }
  /* The first sentence is the lede: Playfair italic in the full mark colour. */
  .sublines .lede {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.6rem;
    line-height: 1.3;
    color: var(--mark);
    text-wrap: balance;
  }

  /* ---------- Sample-book spreads ---------- */
  /* Cuttings laid on a table (B1 item 13): the swatch is about a third of the
     row (34%, counting the part that hangs past the card), turned a couple of
     degrees and overhanging the card's edge onto the wall; the heading's cap
     height sits on the swatch's top edge. */
  .offering {
    --pad: clamp(1.5rem, 4vw, 3.5rem);
    --hang: calc(var(--pad) + 1.25rem);
    display: grid;
    grid-template-columns: calc(34% - 0.32 * var(--pad) - 1.25rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    padding: clamp(2.5rem, 5vw, 3.5rem) var(--pad);
    /* Text sits on paper, never on the toile: each offering is a card on the wall. */
    background: var(--field-raised);
    border: 1px solid var(--rule);
  }
  .offering + .offering { margin-top: clamp(2.25rem, 5vw, 3.5rem); }
  .offering.flip { grid-template-columns: minmax(0, 1fr) calc(34% - 0.32 * var(--pad) - 1.25rem); }
  .offering.flip .swatch-hang { order: 2; margin-left: 0; margin-right: calc(-1 * var(--hang)); rotate: 1.8deg; }
  /* The shadow is a drop-shadow on the hanger so it follows the pinked cut. */
  .swatch-hang {
    position: relative;
    width: calc(100% + var(--hang));
    margin-left: calc(-1 * var(--hang));
    rotate: -2deg;
    filter: drop-shadow(0 10px 12px rgb(40 22 8 / 0.28));
  }
  /* Pinking shears: both long edges zigzag, cut with two intersected
     conic masks (one tooth every 18px). */
  .swatch {
    position: relative;
    aspect-ratio: 1;
    -webkit-mask:
      conic-gradient(from -135deg at right, #0000, #000 1deg 89deg, #0000 90deg) 50% / 100% 18px,
      conic-gradient(from 45deg at left, #0000, #000 1deg 89deg, #0000 90deg) 50% / 100% 18px;
    -webkit-mask-composite: source-in;
    mask:
      conic-gradient(from -135deg at right, #0000, #000 1deg 89deg, #0000 90deg) 50% / 100% 18px,
      conic-gradient(from 45deg at left, #0000, #000 1deg 89deg, #0000 90deg) 50% / 100% 18px;
    mask-composite: intersect;
    overflow: hidden;
  }
  /* The toile's cloth: cream by day, hunter in the lacquered room (the ink is in the file). */
  .swatch.porcelain { background: var(--toile-ground); }
  .tag {
    position: absolute; left: 50%; bottom: -1.1rem;
    translate: -50% 0;
    padding: 0.2rem 1.1rem 0.35rem;
    background: var(--field-raised);
    border: 1px solid var(--rule);
    font-family: var(--font-script);
    font-size: 1.6rem;
    line-height: 1.2;
    color: var(--mark);
    white-space: nowrap;
  }
  .offer-text h2 {
    font-size: clamp(2.2rem, 4.4vw, 3.2rem);
    font-style: italic;
    color: var(--accent);
    margin-bottom: 1.4rem;
    /* The first line's cap height, not its leading, is what meets the swatch's top. */
    text-box-trim: trim-start;
    text-box-edge: cap alphabetic;
  }
  .offer-text p { max-width: var(--measure); }
  .offer-text p + p { margin-top: 1rem; }

  /* ---------- Four cameos ---------- */
  .process {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-block: clamp(3.5rem, 7vw, 5rem);
    border-block: 1px solid var(--rule);
    /* The page's one saturated surface in the day room: buttery lacquer yellow,
       hunter text (the trellis lies over it). */
    background-color: var(--lacquer-yellow);
  }
  /* One axis per step (B1 item 8): the medallion, the title and the text all hang
     from the left. Each step is three rows of a shared grid (subgrid), so the
     paragraph tops line up across the four columns whatever the titles do. */
  .steps {
    list-style: none; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: clamp(1.75rem, 3vw, 2.75rem); row-gap: 0;
    margin-top: 3rem;
  }
  .steps li {
    display: grid; grid-row: span 3; grid-template-rows: subgrid;
    justify-items: start; align-content: start; text-align: left; row-gap: 0.75rem;
  }
  .cameo {
    display: grid; place-items: center;
    width: 4.6rem; height: 5.8rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--porcelain), var(--porcelain-deep));
    box-shadow: 0 0 0 3px var(--plate), 0 0 0 4px var(--ornament), 0 0 0 8px var(--field), 0 0 0 9px var(--ornament), 0 8px 14px 6px rgb(0 0 0 / 0.12);
    margin-bottom: 0.75rem;
  }
  .cameo span {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.7rem;
    color: var(--plate);
  }
  .steps h3 { font-size: 1.6rem; font-style: italic; }
  .steps p { text-wrap: pretty; max-width: 17em; font-size: 1.2rem; }

  /* ---------- The ask ---------- */
  .ask {
    display: grid; justify-items: center; gap: 1.75rem;
    text-align: center;
    padding-top: clamp(4rem, 8vw, 6rem);
  }
  .ask :global(.ask-bow) { width: 7rem; }
  .pull {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.15;
    max-width: 18em;
    text-wrap: balance;
  }

  @media (max-width: 980px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .steps li:nth-child(-n + 2) { padding-bottom: 3rem; }
  }
  @media (max-width: 720px) {
    .offering, .offering.flip { grid-template-columns: 1fr; gap: 2.75rem; }
    .offering .swatch-hang, .offering.flip .swatch-hang { order: 0; width: 100%; margin: 0; rotate: -1.2deg; }
    .offering.flip .swatch-hang { rotate: 1.2deg; }
    .swatch { aspect-ratio: 16 / 9; }
    .steps { grid-template-columns: 1fr; row-gap: 2.5rem; }
    .steps li { grid-row: auto; grid-template-rows: none; }
    .steps li:nth-child(-n + 2) { padding-bottom: 0; }
  }
</style>
