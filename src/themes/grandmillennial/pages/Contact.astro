---
/** Grandmillennial contact: correspondence. The form is monogrammed
    stationery in a gilt frame, the message box is ruled writing paper, and
    the email address comes on an envelope under a wax seal. */
import ContactHidden from '../../portal/ContactHidden.astro';
import type { CopyData } from '../../../lib/copy';
import Framed from '../parts/Framed.astro';
import Seal from '../parts/Seal.astro';

interface Props { copy: CopyData<'contact'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
---
<section class="intro gm-wrap">
  <p class="gm-kicker ruled">{copy.kicker}</p>
  <h1>{copy.heading}</h1>
  <p class="subline">{copy.subline}</p>
</section>

<div class="desk gm-wrap">
  <section class="write">
    <Framed tone="raised" class="stationery">
      <span class="letterhead" aria-hidden="true">B</span>
      <form method="post" action="/api/contact" data-astro-reload>
        <div class="pair">
          <div class="field">
            <label for="cf-name">{copy.labels.name}</label>
            <input id="cf-name" name="name" type="text" required maxlength="200" autocomplete="name" />
          </div>
          <div class="field">
            <label for="cf-email">{copy.labels.email}</label>
            <input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" />
          </div>
        </div>
        <div class="field">
          <label for="cf-message">{copy.labels.message}</label>
          <textarea id="cf-message" name="message" required maxlength="5000" rows="7"></textarea>
        </div>
        <ContactHidden theme={theme} label={copy.labels.honeypot} />
        <button class="gm-btn" type="submit">{copy.submit}</button>
      </form>
    </Framed>
  </section>

  <section class="envelope">
    <div class="flap" aria-hidden="true"><Seal class="seal" /></div>
    <div class="note">
      <p class="invite">{copy.invite}</p>
      <a class="mail" href={`mailto:${copy.email}`}>{copy.email}</a>
      <p class="fine">{copy.fine}</p>
    </div>
  </section>

  <p class="trust">{copy.trust.map((part, i) => <>{i > 0 && <> <span class="sep" aria-hidden="true">&#10086;</span> </>}{part}</>)}</p>
</div>

<style>
  .intro {
    display: grid; justify-items: center; text-align: center;
    padding-block: clamp(3.5rem, 8vw, 5.5rem) clamp(2.5rem, 5vw, 3.5rem);
  }
  .intro h1 {
    font-style: italic;
    font-size: clamp(2.8rem, 7vw, 5rem);
    margin-top: 1.25rem;
  }
  .subline {
    margin-top: 1.25rem;
    max-width: 30em;
    font-size: 1.35rem;
    color: var(--mark-muted);
  }

  .desk {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  /* ---------- Stationery ---------- */
  .letterhead {
    display: block;
    width: fit-content;
    margin: -0.5rem auto 1.5rem;
    padding: 0 0.9rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-script);
    font-size: 3.2rem;
    line-height: 1.15;
    color: var(--accent);
  }
  form { display: grid; gap: 1.6rem; }
  .pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.6rem; }
  .field { display: grid; gap: 0.35rem; }
  label {
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }
  input, textarea {
    width: 100%;
    font: inherit;
    font-size: 1.3rem;
    color: var(--mark);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--mark-muted);
    border-radius: 0;
    padding: 0.3rem 0.1rem;
  }
  /* Writing paper: the message box is ruled, one line per line of text. */
  textarea {
    --line: 2.05rem;
    line-height: var(--line);
    padding: 0 0.4rem;
    border: 1px solid color-mix(in srgb, var(--mark-muted), transparent 40%);
    background:
      linear-gradient(90deg, transparent 2.2rem, color-mix(in srgb, var(--accent), transparent 65%) 2.2rem calc(2.2rem + 1px), transparent 0),
      repeating-linear-gradient(to bottom, transparent 0 calc(var(--line) - 1px), color-mix(in srgb, var(--link), transparent 72%) calc(var(--line) - 1px) var(--line)),
      var(--field-raised);
    background-attachment: local;
    padding-left: 2.8rem;
    resize: vertical;
  }
  input:focus-visible, textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-color: var(--accent);
  }
  button { justify-self: center; margin-top: 0.5rem; }
  .trust {
    grid-column: 1 / -1;
    margin-top: 0.5rem;
    text-align: center;
    font-style: italic;
    color: var(--mark-muted);
  }
  .sep { font-style: normal; color: var(--rule); padding-inline: 0.35rem; }

  /* ---------- The envelope ---------- */
  .envelope {
    position: relative;
    margin-top: 1rem;
    background: var(--field-raised);
    border: 1px solid var(--rule);
    box-shadow: 0 18px 30px -18px rgb(40 22 8 / 0.45);
  }
  .flap {
    position: relative;
    height: 7.5rem;
    background:
      linear-gradient(to bottom left, transparent calc(50% - 2px), color-mix(in srgb, var(--rule), transparent 40%) calc(50% - 2px) 50%, transparent 50%) left / 50% 100% no-repeat,
      linear-gradient(to bottom right, transparent calc(50% - 2px), color-mix(in srgb, var(--rule), transparent 40%) calc(50% - 2px) 50%, transparent 50%) right / 50% 100% no-repeat;
  }
  .flap::before {
    content: '';
    position: absolute; inset: 0;
    background: var(--flap);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    filter: drop-shadow(0 3px 4px rgb(0 0 0 / 0.2));
  }
  .flap :global(.seal) {
    position: absolute; left: 50%; bottom: 0;
    width: 4.6rem;
    translate: -50% 45%;
  }
  .note {
    display: grid; gap: 0.9rem; justify-items: center; text-align: center;
    padding: 3.25rem clamp(1.5rem, 3vw, 2.25rem) 2.25rem;
  }
  .invite { font-family: var(--font-display); font-style: italic; font-size: 1.45rem; line-height: 1.25; }
  .mail { font-size: 1.3rem; font-weight: 600; overflow-wrap: anywhere; }
  .fine { font-size: 1.1rem; color: var(--mark-muted); }

  @media (max-width: 860px) {
    .desk { grid-template-columns: 1fr; }
    .envelope { width: min(100%, 28rem); justify-self: center; }
  }
  @media (max-width: 560px) {
    .pair { grid-template-columns: 1fr; }
  }
</style>
