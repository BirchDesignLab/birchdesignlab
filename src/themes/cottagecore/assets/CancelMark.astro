---
/**
 * One fresh cancel mark (Stage 6 w3 task 23): the same ring and the same date
 * as the postmark (Postmark.astro), without the waves. It lies blank; the
 * date stamp's press (toys.ts) sets its angle, ink and place and shows it.
 * Decorative, aria-hidden. `arcId` must be unique on the page.
 */
interface Props { arcId: string }
const { arcId } = Astro.props;
---
<svg class="cm" viewBox="0 0 70 70" aria-hidden="true" focusable="false">
  <defs><path id={arcId} d="M8 35A27 27 0 0 1 62 35" /></defs>
  <circle class="cm-ring" cx="35" cy="35" r="33" />
  <circle class="cm-ring" cx="35" cy="35" r="24.5" />
  <path class="cm-ring cm-dots" d="M13 47.5l.1.1M20 54.6l.1.1M35 58l.1.1M50 54.6l.1.1M57 47.5l.1.1" />
  <path class="cm-ring cm-rule" d="M17 29.6h36M17 42.4h36" />
  <text class="cm-arc"><textPath href={`#${arcId}`} startOffset="50%" text-anchor="middle">GULF COAST MS</textPath></text>
  <text class="cm-date" x="35" y="38" text-anchor="middle">SEP 23 2026</text>
</svg>

<style>
  /* The ink is the postmark's: the muted mark colour, and by lamplight most of it (the static postmark keeps half; a fresh mark has to be seen). The place is the
     pad's (the page sets --cm, the size) and the press's (toys.ts sets --dx, --dy and --rot). */
  .cm {
    --cm-ink: var(--mark-muted);
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--cm, 4.3rem);
    aspect-ratio: 1;
    translate: calc(-50% + var(--dx, 0px)) calc(-50% + var(--dy, 0px));
    rotate: var(--rot, 0deg);
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
    fill: none;
    stroke: var(--cm-ink);
    stroke-width: 1.5;
  }
  :global([data-theme='cottagecore'][data-scheme='dark']) .cm { --cm-ink: color-mix(in srgb, var(--mark-muted) 85%, transparent); }
  .cm-dots { stroke-width: 2.2; }
  .cm-rule { stroke-width: 0.8; }
  .cm-arc, .cm-date {
    fill: var(--cm-ink); stroke: none;
    font-family: var(--font-body); font-weight: 700; text-transform: uppercase;
  }
  .cm-arc { font-size: 7.4px; letter-spacing: 1.3px; }
  .cm-date { font-size: 6.6px; letter-spacing: 0.35px; }
</style>
