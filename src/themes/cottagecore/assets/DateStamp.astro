---
/**
 * A wooden-handled date stamp (Stage 6 w3 task 23, brief item 2): a turned knob,
 * a stem, a block with a paper date band and a rubber face. Pressing it
 * (toys.ts) thunks it down and lays a fresh cancel mark on the stamp it is
 * for (`pad`, the selector of that stamp's CancelMark layer). Inert:
 * aria-hidden, not focusable, no words. The page places and sizes it.
 */
interface Props { class?: string; pad: string }
const { class: cls, pad } = Astro.props;
---
<div class:list={['date-stamp', cls]} data-cc-toy="stamp" data-pad={pad} aria-hidden="true">
  <svg viewBox="0 0 60 84" focusable="false">
    <ellipse class="ds-shadow" cx="30" cy="77" rx="22" ry="3.2" />
    <g class="ds-body">
      <path class="ds-wood" d="M30 5c8 0 14 5.4 14 12.6 0 5.2-3.4 8.6-7.6 10.6-1.2.6-1.8 1.4-1.8 2.6v2.4H25.4v-2.4c0-1.2-.6-2-1.8-2.6C19.4 26.2 16 22.8 16 17.6 16 10.4 22 5 30 5Z" />
      <path class="ds-wood" d="M25.2 33.6h9.6l1.8 25H23.4Z" />
      <path class="ds-grain" d="M23.6 14.4c3.2 2.2 9.6 2.2 12.8 0M22.2 20.2c4.2 2.8 11.4 2.8 15.6 0M27.4 36v21M32.6 36v21" />
      <path class="ds-hl" d="M21.4 13.2c1.4-3.2 4.6-5.2 8.4-5.2" />
      <rect class="ds-block" x="9" y="58.4" width="42" height="13" rx="2.6" />
      <rect class="ds-band" x="12.6" y="61.4" width="34.8" height="7" rx="1" />
      <path class="ds-ticks" d="M16.4 63.4v3M20.6 63.4v3M24.8 63.4v3M29 63.4v3M33.2 63.4v3M37.4 63.4v3M41.6 63.4v3" />
      <rect class="ds-rubber" x="11" y="71.4" width="38" height="4.2" rx="1.2" />
    </g>
  </svg>
</div>

<style>
  .date-stamp {
    position: relative;
    width: 3.9rem;
    aspect-ratio: 60 / 84;
    rotate: -5deg;
    pointer-events: auto;
    /* A press on it is the toy; a vertical swipe still scrolls (toys.ts reads the release). */
    touch-action: manipulation;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  .date-stamp::before { content: ''; position: absolute; inset: -0.5rem; }
  .date-stamp svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .ds-shadow { fill: rgba(var(--shadow), 0.3); transform-origin: 30px 77px; }
  .ds-body { transform-origin: 30px 77px; transition: translate 0.18s ease-out; }
  .ds-wood { fill: var(--wood); stroke: var(--wood-dark); stroke-width: 0.8; stroke-linejoin: round; }
  .ds-block { fill: var(--wood-dark); stroke: rgba(var(--shadow), 0.4); stroke-width: 0.6; }
  .ds-grain { fill: none; stroke: var(--wood-dark); stroke-width: 0.7; stroke-linecap: round; opacity: 0.55; }
  .ds-hl { fill: none; stroke: #fff6e4; stroke-width: 1.3; stroke-linecap: round; opacity: 0.45; }
  .ds-band { fill: #f3e7cd; }
  .ds-ticks { fill: none; stroke: #6b5242; stroke-width: 0.7; stroke-linecap: round; opacity: 0.7; }
  .ds-rubber { fill: #2c2018; }
  :global([data-theme='cottagecore'][data-scheme='dark']) .ds-band { fill: #cdbb98; }
  :global([data-theme='cottagecore'][data-scheme='dark']) .ds-rubber { fill: #120d09; }
  /* Once, when it first scrolls into view: a small lift and set-down, so a visitor who has not met it finds it moves. */
  .date-stamp[data-nudge] .ds-body { animation: ds-nudge 1.1s ease-in-out 1; }
  @keyframes ds-nudge {
    0%, 100% { translate: 0 0; }
    30% { translate: 0 -4px; }
    52% { translate: 0 0.8px; }
    70% { translate: 0 -1.4px; }
  }
  @media (hover: hover) and (pointer: fine) {
    .date-stamp { cursor: pointer; }
    .date-stamp:hover .ds-body { translate: 0 -2.5px; }
  }
</style>
