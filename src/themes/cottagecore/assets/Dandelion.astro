---
/**
 * A dried dandelion clock lying on the cloth (Stage 6 w3 task 23, brief
 * item 1): a round head of seeds on a stem. Each seed is one hairline path (a
 * stalk and the fan of its pappus), drawn at build time from a seeded
 * generator, so the head is the same drawing on every load. A tap or a long
 * press (toys.ts) blows six to ten of them off into the seed canvas (fx.ts)
 * and leaves a bald patch that refills over about 20 s. Inert: aria-hidden,
 * not focusable, no words. The page places and sizes it.
 */
interface Props { class?: string }
const { class: cls } = Astro.props;

/** The head is a circle of radius R about (CX, CY) in a 100 x 130 box. */
const CX = 50;
const CY = 46;
const R = 33;
const N = 26;
let s = 23;
const rnd = () => {
  s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
  return s / 4294967296;
};
const n1 = (v: number) => Math.round(v * 10) / 10;

const seeds = Array.from({ length: N }, (_, i) => {
  // Evenly round the head, a little loose, so no two stalks line up.
  const a = (i / N) * Math.PI * 2 + (rnd() - 0.5) * 0.14;
  const len = R * (0.7 + rnd() * 0.3);
  const cos = Math.cos(a);
  const sin = Math.sin(a);
  // The stalk runs from the core to where its fan opens; the fan is seven
  // hairlines splayed about the stalk's own direction.
  const beak = len * 0.6;
  const px = CX + cos * beak;
  const py = CY + sin * beak;
  const reach = len - beak + 3.4;
  let d = `M${n1(CX + cos * 3)} ${n1(CY + sin * 3)}L${n1(px)} ${n1(py)}`;
  for (let k = 0; k < 7; k++) {
    const u = k / 6 - 0.5;
    const b = a + u * 1.9 + (rnd() - 0.5) * 0.12;
    const l = reach * (0.82 + Math.cos(u * Math.PI) * 0.2 + (rnd() - 0.5) * 0.14);
    d += `M${n1(px)} ${n1(py)}L${n1(px + Math.cos(b) * l)} ${n1(py + Math.sin(b) * l)}`;
  }
  return { a, d, px: n1(px), py: n1(py) };
});
---
<div class:list={['dandelion', cls]} data-cc-toy="dandelion" aria-hidden="true">
  <svg viewBox="0 0 100 130" focusable="false">
    <path class="dc-stem" d="M50 48C47 72 54 98 48.6 128" />
    <path class="dc-leaf" d="M48.8 112c-6-3.4-12-3.6-18-.6 5.6 6.2 12.4 6.6 18 .6Z" />
    <g class="dc-head">
      {seeds.map(({ a, d, px, py }) => <path class="sd" d={d} data-a={a.toFixed(3)} data-px={px} data-py={py} />)}
      <circle class="dc-core" cx={CX} cy={CY} r="3.3" />
    </g>
  </svg>
</div>

<style>
  .dandelion {
    position: relative;
    width: 5.6rem;
    aspect-ratio: 100 / 130;
    pointer-events: auto;
    /* A press on it is the toy; a vertical swipe still scrolls (toys.ts reads the release). */
    touch-action: manipulation;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  /* A touch is a finger: the press zone reaches past the drawing. */
  .dandelion::before { content: ''; position: absolute; inset: -0.5rem; }
  .dandelion svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .dc-stem { fill: none; stroke: var(--cc-stem); stroke-width: 1.5; stroke-linecap: round; }
  .dc-leaf { fill: var(--cc-leaf); stroke: var(--cc-leaf-edge); stroke-width: 0.6; stroke-linejoin: round; }
  .dc-head { transform-origin: 50px 46px; transition: rotate 0.5s ease-out, filter 0.9s ease-out; }
  .sd {
    fill: none;
    stroke: var(--mark);
    stroke-width: 0.5;
    stroke-linecap: round;
    stroke-opacity: 0.7;
    transform-origin: 50px 46px;
  }
  .dc-core { fill: var(--mark-muted); }
  /* By lamplight the head is the unlit one: the same drawing, dimmed, with a warm halo while a mote rises from it. */
  :global([data-theme='cottagecore'][data-scheme='dark']) .sd { stroke-opacity: 0.5; }
  :global([data-theme='cottagecore'][data-scheme='dark']) .dc-leaf { opacity: 0.7; }
  .dandelion[data-lit] .dc-head { filter: drop-shadow(0 0 6px rgba(255, 200, 120, 0.32)); }
  /* Once, when it first scrolls into view: a little sway, so a visitor who has not met it finds it moves. */
  .dandelion[data-nudge] .dc-head { animation: dc-nudge 1.5s ease-in-out 1; }
  @keyframes dc-nudge {
    0%, 100% { rotate: 0deg; }
    22% { rotate: 4.5deg; }
    48% { rotate: -3.5deg; }
    74% { rotate: 2deg; }
  }
  @media (hover: hover) and (pointer: fine) {
    .dandelion { cursor: pointer; }
    .dandelion:hover .dc-head { rotate: 3.5deg; }
  }
</style>
