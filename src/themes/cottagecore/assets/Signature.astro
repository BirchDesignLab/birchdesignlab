---
/** The maker's line on the hoop: "B.D.L. 9.23.26" as a freehand running-stitch
    script (founder call 8, 11-17-26: the first was skewed block capitals in a
    dashed stroke, more dashed type than stitched writing). Each glyph is one
    flowing pen path with rounded, looped forms, slanted like a hand, every
    point moved by a seeded wobble so no two letters repeat; a swash runs under
    the line as a signature's does; one thread of short stitches follows the
    lot. Not counted lettering and no alphabet (S5). Decorative; the rules are
    global in theme.css (the markup is set as HTML). */
interface Props { class?: string; seed?: number }
const { class: cls, seed = 923 } = Astro.props;

function rng(s: number) {
  let a = (s * 2654435761) >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(seed);

/* One absolute pen path per glyph in a box 16 units tall, the baseline at 14.
   Looped and rounded, entering and leaving low and to the right so the next
   glyph picks up where this one let go. */
const GLYPHS: Record<string, { d: string; w: number }> = {
  B: { d: 'M2.5 15C3.5 10 4 4 5 1.5C7 -1 11 0 10 3.5C9.4 5.6 6 6.4 4.5 6.5C9.5 5.5 13 9.5 10.5 12.5C8.8 14.6 5 14.4 2 12.6', w: 14 },
  D: { d: 'M5 1C3.5 5.5 2.8 10 3 14.4C8 15.4 13 12.8 12.6 7.6C12.2 3 8 0.6 3 4.4', w: 14.5 },
  L: { d: 'M7 0.8C3.5 0.4 2.2 4.4 3.8 8.6C4.8 11.4 4.4 13.6 3.2 14.2C6.4 15.8 10.4 15 13 12.4', w: 13.5 },
  '9': { d: 'M10 5C10.4 0.8 4.4 -0.4 3.4 3.6C2.6 7 8 8 10 5C10.6 9.6 9.2 13.4 4.6 15.4C3 16 2 15.4 1.8 14.2', w: 11.5 },
  '2': { d: 'M3 4.6C3 -0.8 10.6 -0.8 10 3.8C9.4 7 4 10.4 2.6 14.4C5.6 13.4 9 15.2 12.6 13.6', w: 12 },
  '3': { d: 'M3 2.6C6.4 -1 11 1.4 9.4 4.6C8.4 6.4 6.4 6.6 5.2 6.5C10.4 6.8 11 12.8 6.2 14.6C4 15.4 2.2 14.4 1.6 12.6', w: 12 },
  '6': { d: 'M10 1.4C4.6 0 3 6.4 3.4 10.2C3.8 15.8 10.6 15.6 10 10.6C9.6 6.8 4.6 6.8 3.4 10.2', w: 12 },
};
const LINE = ['B', '.', 'D', '.', 'L', '.', ' ', '9', '.', '2', '3', '.', '2', '6'];
const SLANT = Math.tan((-14 * Math.PI) / 180);
const r1 = (v: number) => Math.round(v * 10) / 10;
let x = 0;
let strokes = '';
let dots = '';
for (const ch of LINE) {
  if (ch === ' ') { x += 5; continue; }
  if (ch === '.') { dots += `M${r1(x + 0.8)} 14.6l.1 0`; x += 3.4; continue; }
  const g = GLYPHS[ch];
  // The wobble: every coordinate of the pen path moves a little; the slant
  // leans each point by its height above the baseline.
  const nums = g.d.match(/-?\d*\.?\d+/g)!.map(Number);
  const pts: number[] = [];
  for (let i = 0; i < nums.length; i += 2) {
    const px = nums[i] + (rand() * 2 - 1) * 0.5;
    const py = nums[i + 1] + (rand() * 2 - 1) * 0.5;
    pts.push(r1(px + x + (14 - py) * -SLANT), r1(py));
  }
  let k = 0;
  strokes += g.d.replace(/-?\d*\.?\d+/g, () => String(pts[k++]));
  x += g.w;
}
const width = Math.ceil(x + 3);
// The swash under the line: one long low stroke that rises a little at its end.
const swash = `M1 19.4C${r1(width * 0.25)} 17.6 ${r1(width * 0.5)} 20.4 ${r1(width * 0.72)} 18.6S${r1(width * 0.94)} 17 ${r1(width - 1)} 15.8`;
const markup = `<path class="sig-run" d="${strokes}"/><path class="sig-dot" d="${dots}"/><path class="sig-run sig-swash" d="${swash}"/>`;
---
<svg class:list={['cc-signature', cls]} viewBox={`0 -2 ${width} 23`} aria-hidden="true" focusable="false" set:html={markup} />
