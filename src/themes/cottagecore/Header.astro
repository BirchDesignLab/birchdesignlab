---
/** Cottagecore header: a gingham café-curtain valance with a scalloped hem,
    then the wordmark written like a jar label (a set serif name, the rest in
    handwriting) and a nav whose current page is stitched underneath. It also
    carries the fireflies canvas, which only shows by lamplight (fx.ts). */
import { hrefFor, isCurrent } from '../paths';
import type { CopyData } from '../../lib/copy';
import Pressed from './assets/Pressed.astro';

interface Props { chrome: CopyData<'chrome'>; theme: string }
const { chrome, theme } = Astro.props;
const [first, ...rest] = chrome.wordmark;
---
<header class="cc-header">
  <a class="skip" href="#main">{chrome.skip}</a>
  {/* The curtain and the header row, named cottagecore-header between two
      cottagecore pages so they hold still (theme.css, "page change"). A plain
      block: at rest it adds no space and no stacking context, so the
      fireflies still drift over the valance and under the bar. */}
  <div class="cc-chrome">
    <div class="valance cc-gingham" aria-hidden="true"></div>
    <div class="cc-wrap bar">
      <a class="wordmark" href={hrefFor('home', theme)} transition:name="wordmark">
        <Pressed kind="daisy" seed={11} class="wm-daisy" />
        <span class="wm-name">{first}</span>{rest.map((part) => <> <span class="wm-hand">{part}</span></>)}
      </a>
      <nav aria-label="Main">
        {chrome.nav.map(({ to, label }) => (
          <a
            href={hrefFor(to, theme)}
            aria-current={isCurrent(to, Astro.url.pathname) ? 'page' : undefined}
            data-astro-reload={to === 'lab' ? '' : undefined}
          >{label}</a>
        ))}
      </nav>
    </div>
  </div>
  <canvas class="cc-motes" data-cc-motes aria-hidden="true"></canvas>
</header>

<script>
  import { mountFireflies } from './fx';

  mountFireflies();
</script>

<style>
  .cc-header { position: relative; z-index: 1; }
  /* The café curtain: gingham with a scalloped hem cut by a radial mask. */
  .valance {
    height: 2.6rem;
    --scallop: 0.7rem;
    -webkit-mask:
      radial-gradient(var(--scallop) at 50% calc(100% - var(--scallop)), #000 97%, #0000) 50% 100% / calc(2 * var(--scallop)) 100% repeat-x,
      linear-gradient(#000 0 0) top / 100% calc(100% - var(--scallop)) no-repeat;
    mask:
      radial-gradient(var(--scallop) at 50% calc(100% - var(--scallop)), #000 97%, #0000) 50% 100% / calc(2 * var(--scallop)) 100% repeat-x,
      linear-gradient(#000 0 0) top / 100% calc(100% - var(--scallop)) no-repeat;
  }
  .bar {
    position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem 2rem; flex-wrap: wrap;
    padding-block: 1.1rem 0.6rem;
  }
  .wordmark {
    display: inline-flex; align-items: baseline; gap: 0.35rem;
    color: var(--mark); text-decoration: none;
    white-space: nowrap;
  }
  .wordmark:hover { text-decoration: none; }
  .wordmark :global(.wm-daisy) {
    width: 1.7rem; height: auto; align-self: center;
    margin-right: 0.2rem;
    rotate: -12deg;
  }
  .wm-name {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 1.9rem;
    line-height: 1;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    letter-spacing: -0.01em;
  }
  .wm-hand {
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--accent);
    rotate: -4deg;
    translate: 0 -0.2rem;
    display: inline-block;
  }
  nav { display: flex; gap: 0.4rem 1.6rem; flex-wrap: wrap; }
  nav a {
    position: relative;
    color: var(--mark);
    text-decoration: none;
    font-size: 1rem;
    letter-spacing: 0.03em;
    padding-block: 0.3rem;
  }
  nav a:hover { color: var(--accent); text-decoration: none; }
  /* Current page: a running stitch in rose, sewn just under the word. */
  nav a[aria-current='page']::after {
    content: '';
    position: absolute; left: -2px; right: -2px; bottom: 0;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--stitch-rose) 0 6px, transparent 6px 10px);
  }
  @media (max-width: 640px) {
    .valance { height: 1.9rem; --scallop: 0.55rem; }
    .bar { padding-block: 0.9rem 0.9rem; }
    .wm-name { font-size: 1.7rem; }
    .wm-hand { font-size: 1.45rem; }
    /* The nav gets its own stitched seam and handwritten links at phone
       width, rather than falling back to a plain wrapped row. */
    nav {
      width: 100%;
      margin-top: 0.7rem;
      padding-top: 0.7rem;
      gap: 0.2rem 1.4rem;
      background:
        repeating-linear-gradient(90deg, var(--stitch) 0 9px, transparent 9px 15px) top left / 100% 2px no-repeat;
    }
    nav a {
      font-family: var(--font-hand);
      font-weight: 600;
      font-size: 1.45rem;
      line-height: 1;
      padding-block: 0.6rem;
    }
  }
</style>
