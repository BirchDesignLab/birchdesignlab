---
/** Cottagecore services: set out like a family recipe book. A posy of Gulf Coast
    flowers tied with twine beside the heading, each offering on its own recipe card, the
    process as the method on a torn sheet, and a sewn label to start. */
import type { CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';
import Pressed from '../assets/Pressed.astro';

interface Props { copy: CopyData<'services'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
---
<section class="intro cc-wrap">
  <div class="intro-text">
    <p class="cc-hand kicker"><span class="cc-scribble">{copy.kicker}</span></p>
    <h1>{copy.heading}</h1>
    <div class="sublines">
      {copy.sublines.map((line) => <p>{line}</p>)}
    </div>
  </div>
  <div class="posy cc-lamp" aria-hidden="true">
    <Pressed kind="magnolia" seed={71} class="py-mag" />
    <Pressed kind="passion" seed={72} class="py-pas" />
    <svg class="twine" viewBox="0 0 90 76" focusable="false">
      <path class="twine-cord" d="M6 20C26 12 58 14 84 22M5 27C28 19 60 21 85 30M7 34C28 27 58 28 83 36" />
      <path class="twine-cord" d="M44 22C37 30 38 40 44 44C52 40 52 30 44 22Z" />
      <path class="twine-cord" d="M43 42C36 52 30 62 33 73M45 42C50 52 58 60 60 72" />
      <path class="twine-fibre" d="M6 20C26 12 58 14 84 22M5 27C28 19 60 21 85 30M7 34C28 27 58 28 83 36M43 42C36 52 30 62 33 73M45 42C50 52 58 60 60 72" />
    </svg>
  </div>
</section>

<section class="offerings cc-wrap">
  {copy.offerings.map((offering, i) => (
    <article class="recipe cc-paper">
      <span class:list={['cc-tape', i % 2 === 1 ? 'cc-tape--rose cc-tape--ragged' : 'cc-tape--cut']} aria-hidden="true"></span>
      <p class="no" aria-hidden="true">&#8470; {i + 1}</p>
      <h2>{offering.heading}</h2>
      <div class="card-rule" aria-hidden="true"></div>
      <div class="body cc-ruled">
        {offering.body.map((para) => <p>{para}</p>)}
      </div>
      <Pressed kind={i % 2 ? 'daisy' : 'lavender'} seed={80 + i} class="corner" />
    </article>
  ))}
</section>

<section class="method cc-wrap">
  <div class="method-lift cc-torn-lift">
    <div class="method-sheet cc-torn">
      <h2>{copy.process.heading}</h2>
      <ol class="steps" role="list">
        {copy.process.steps.map((step, i) => (
          <li>
            <span class="num" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <span class="cc-tape cc-tape--butter cc-tape--half method-tape" aria-hidden="true"></span>
</section>

<section class="ask cc-wrap cc-lamp">
  <Pressed kind="fern" seed={91} class="a-left" />
  <p class="pull">{copy.pull}</p>
  <a class="cc-label" href={hrefFor('contact', theme)}>{copy.cta}</a>
</section>

<style>
  /* ---- intro and the tied posy ---- */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    gap: 2rem 3rem;
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2.5rem, 5vw, 4rem);
  }
  .kicker { font-size: clamp(2.2rem, 3.4vw, 2.75rem); }
  h1 { font-size: clamp(3rem, 7vw, 5.6rem); line-height: 0.96; margin-top: 0.8rem; max-width: 12ch; }
  .sublines { display: grid; gap: 1rem; margin-top: 1.8rem; max-width: 38rem; }
  .sublines p { font-size: 1.16rem; line-height: 1.7; color: var(--mark-muted); }
  .sublines p:first-child { color: var(--mark); }
  .posy { position: relative; height: 26rem; width: 100%; max-width: 20rem; justify-self: center; --lamp-inset: -10% -30%; }
  .posy :global(.pressed) { position: absolute; bottom: 12%; transform-origin: 50% 100%; }
  .posy :global(.py-mag) { width: 68%; left: 6%; rotate: -9deg; }
  .posy :global(.py-pas) { width: 50%; left: 24%; rotate: 15deg; bottom: 13%; }
  /* Garden twine, not ribbon: cords wound round the stems and a plain knot
     with two loose ends, in the specimens' ink-brown. */
  .twine { position: absolute; width: 34%; left: 27%; bottom: 8%; overflow: visible; }
  .twine-cord { fill: none; stroke: var(--cc-twig); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .twine-fibre { fill: none; stroke: var(--paper); stroke-width: 2.6; stroke-linecap: butt; stroke-dasharray: 1.1 2.6; opacity: 0.38; }

  /* ---- offerings: recipe cards ---- */
  .offerings {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem clamp(2rem, 5vw, 4rem);
    align-items: start;
    padding-block: 1rem clamp(3rem, 7vw, 5rem);
  }
  .recipe { padding: 2.6rem clamp(1.5rem, 3vw, 2.8rem) 3rem; }
  .recipe:nth-child(1) { --tilt: -0.9deg; }
  .recipe:nth-child(2) { --tilt: 1deg; margin-top: 3rem; }
  .recipe .cc-tape { top: -0.85rem; left: calc(50% - var(--tape-w) / 2); --tape-tilt: -4deg; --tape-w: 7.5rem; }
  .recipe:nth-child(2) .cc-tape { --tape-tilt: 3deg; --tape-w: 6.5rem; }
  .no {
    position: absolute; top: 1.4rem; right: 1.6rem;
    font-family: var(--font-hand); font-size: 1.5rem;
  }
  .recipe h2 { font-size: clamp(2rem, 3.2vw, 2.6rem); padding-right: 2.6rem; }
  .card-rule {
    height: 5px; margin-block: 0.9rem 0.6rem;
    border-top: 1.5px solid var(--margin-line);
    border-bottom: 1px solid var(--margin-line);
  }
  .body p { color: var(--mark-muted); }
  .body p + p { margin-top: var(--lh); }
  .recipe :global(.corner) { position: absolute; right: -0.8rem; bottom: -1.4rem; width: 4.4rem; rotate: 24deg; }

  /* ---- method ---- */
  .method { position: relative; display: grid; justify-items: center; padding-bottom: clamp(3rem, 7vw, 5rem); }
  .method-lift { --tilt: -0.4deg; width: 100%; }
  .method-sheet {
    --torn-x: -45px;
    background: var(--note);
    padding: clamp(2.6rem, 5vw, 3.8rem) clamp(1.5rem, 5vw, 4rem) clamp(2.8rem, 5vw, 4rem);
  }
  .method-sheet > h2 { font-size: clamp(2.2rem, 4vw, 3.2rem); }
  .steps {
    list-style: none; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.2rem clamp(2rem, 5vw, 4rem);
    margin-top: 2.2rem;
  }
  .steps li { display: grid; grid-template-columns: 3.4rem 1fr; gap: 1.1rem; align-items: start; }
  /* Numerals written by hand inside a stitched ring. */
  .num {
    display: grid; place-items: center;
    width: 3.4rem; height: 3.4rem;
    border: 2px dashed var(--stitch-rose);
    border-radius: 50%;
    font-family: var(--font-hand); font-size: 2rem; line-height: 1;
    padding-bottom: 0.15rem;
  }
  .steps h3 { font-size: 1.65rem; margin-top: 0.35rem; }
  .steps p { margin-top: 0.5rem; color: var(--mark-muted); }
  .method-tape { top: -0.9rem; left: calc(50% - var(--tape-w) / 2); --tape-tilt: 2deg; --tape-w: 8rem; }

  /* ---- the ask ---- */
  .ask {
    position: relative;
    display: grid; justify-items: center; text-align: center; gap: 1.8rem;
    padding-block: clamp(1rem, 3vw, 2rem) 0;
    --lamp-inset: -40% 10% -20%;
  }
  .pull {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 450;
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    line-height: 1.1;
    max-width: 20ch;
    text-wrap: balance;
  }
  .ask :global(.a-left) { position: absolute; width: 6rem; left: calc(50% - 26rem); top: -1rem; rotate: -32deg; }

  @media (max-width: 820px) {
    .intro { grid-template-columns: 1fr; }
    .posy { height: 17rem; max-width: 14rem; }
    .steps { grid-template-columns: 1fr; }
    .ask :global(.a-left) { display: none; }
  }
  @media (max-width: 1000px) {
    .recipe .body { padding-bottom: 2rem; }
  }
  @media (max-width: 700px) {
    .offerings { grid-template-columns: 1fr; }
    .recipe { width: min(100%, 32rem); }
    .recipe:nth-child(1) { justify-self: start; }
    .recipe:nth-child(2) { justify-self: end; margin-top: 0; }
  }
  @media (max-width: 640px) {
    .steps li { grid-template-columns: 2.8rem 1fr; gap: 0.9rem; }
    .num { width: 2.8rem; height: 2.8rem; font-size: 1.7rem; }
    .recipe :global(.corner) { width: 3.4rem; }
  }
</style>
