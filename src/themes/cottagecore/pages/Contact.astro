---
/** Cottagecore contact: a letter written on ruled stationery (the form, with
    handwritten labels and lines to write on), and beside it a postcard for
    anyone who would rather just email, stamped and postmarked. The form keeps
    the fixed contract (src/themes/README.md, Contact). */
import ContactHidden from '../../portal/ContactHidden.astro';
import type { CopyData } from '../../../lib/copy';
import Pressed from '../assets/Pressed.astro';
import Stamp from '../assets/Stamp.astro';
import Postmark from '../assets/Postmark.astro';

interface Props { copy: CopyData<'contact'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
---
<section class="contact cc-wrap">
  <div class="stationery cc-paper">
    <header class="intro">
      <p class="cc-hand kicker"><span class="cc-scribble">{copy.kicker}</span></p>
      <h1>{copy.heading}</h1>
      <p class="subline">{copy.subline}</p>
    </header>
    <form method="post" action="/api/contact" data-astro-reload>
      <div class="field">
        <label for="cf-name">{copy.labels.name}</label>
        <input id="cf-name" name="name" type="text" required maxlength="200" autocomplete="name" />
      </div>
      <div class="field">
        <label for="cf-email">{copy.labels.email}</label>
        <input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" />
      </div>
      <div class="field">
        <label for="cf-message">{copy.labels.message}</label>
        <textarea id="cf-message" name="message" required maxlength="5000" rows="7"></textarea>
      </div>
      <ContactHidden theme={theme} label={copy.labels.honeypot} />
      <button class="cc-label" type="submit">{copy.submit}</button>
    </form>
    <p class="trust">{copy.trust.map((part, i) => <>{i > 0 && <> <span class="sep" aria-hidden="true">&#10047;</span> </>}<span class="tp">{part}</span></>)}</p>
    <Pressed kind="lavender" seed={101} class="st-lav" />
  </div>

  <div class="post">
    <div class="postcard cc-paper">
      <span class="cc-tape cc-tape--rose cc-tape--half pc-tape" aria-hidden="true"></span>
      <Stamp class="stamp" seed={102} />
      <Postmark class="postmark" arcId="pm-arc-contact" />
      <p class="invite">{copy.invite}</p>
      <div class="address">
        <a class="mail" href={`mailto:${copy.email}`}>{copy.email}</a>
        <span class="addr-line" aria-hidden="true"></span>
        <span class="addr-line short" aria-hidden="true"></span>
      </div>
      <p class="fine">{copy.fine}</p>
    </div>
    <div class="post-posy" aria-hidden="true">
      <Pressed kind="myrtle" seed={103} class="pp-myrtle" />
      <div class="pp-card cc-paper">
        <span class="cc-tape cc-tape--rose cc-tape--half pp-tape" aria-hidden="true"></span>
        <Pressed kind="rose" seed={104} class="pp-rose" />
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: 3rem clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    padding-block: clamp(2rem, 5vw, 4rem) 0;
  }
  /* Both columns end together: the postcard column stretches to the
     stationery and the loose posy fills what the postcard leaves. */
  .stationery { align-self: start; }

  /* ---- the stationery ---- */
  .stationery {
    --tilt: -0.5deg;
    padding: clamp(2rem, 5vw, 3.6rem) clamp(1.4rem, 5vw, 3.6rem) clamp(2.4rem, 5vw, 3.6rem);
  }
  .kicker { font-size: clamp(2.2rem, 3.4vw, 2.7rem); }
  /* Capped so 'Start a conversation' sets on one line at desktop instead of
     stranding 'Start a' above a heavy second line. */
  h1 { font-size: clamp(2.6rem, 4.6vw, 3.6rem); margin-top: 0.7rem; }
  .subline { margin-top: 1rem; font-size: 1.14rem; color: var(--mark-muted); max-width: 34rem; }
  form { display: grid; gap: 1.6rem; margin-top: 2.4rem; }
  .field { display: grid; gap: 0.25rem; }
  /* Weight, ink and upright tilt come from the label hand (theme.css). */
  .field label {
    font-family: var(--font-hand);
    line-height: 1.2;
  }
  .field input, .field textarea {
    font: inherit;
    font-size: 1.1rem;
    color: var(--mark);
    background-color: transparent;
    border: 0;
    border-radius: 0;
    width: 100%;
  }
  /* Lines to write on: each input is one ruled line, the same pitch and rule
     as the textarea below it, so the form reads as one sheet of ruled
     stationery. The input rule and the textarea edge are --field-line (3:1); focus adds an outline. */
  .field input {
    box-sizing: border-box;
    height: 26px;
    line-height: 25px;
    padding: 0 0.25rem;
    border-bottom: 1px solid var(--field-line);
  }
  /* Writing on the lines (brief item 4): a 30px pitch, the first line 4px
     below the top edge and 6px under the last (less than a rule's reach), so every line of text
     sits on its rule (1px at --rule-y, about 0.2em under the baseline; the
     rules scroll with the text). The rules are the textarea's own background,
     so they tilt with the stationery. */
  .field textarea {
    --lh: 30px;
    --rule-y: 24px;
    --pad-top: 4px;
    line-height: var(--lh);
    padding: var(--pad-top) 0.6rem 6px;
    min-height: calc(var(--lh) * 6 + var(--pad-top) + 6px);
    resize: vertical;
    /* The last rule is the sheet's edge, drawn at --field-line (3:1) so the
       box stays findable; the inner rules stay faint. */
    border-bottom: 1px solid var(--field-line);
    background-image: linear-gradient(to top, var(--rule) 1px, transparent 1px);
    background-size: 100% var(--lh);
    background-position: 0 calc(var(--pad-top) + var(--rule-y) + 1px - var(--lh));
    background-attachment: local;
  }
  .field input:focus-visible, .field textarea:focus-visible {
    outline: 2px solid var(--field-line);
    outline-offset: 3px;
    border-radius: 2px;
    background-color: color-mix(in srgb, var(--note) 55%, transparent);
  }
  form .cc-label { justify-self: start; margin-top: 0.4rem; }
  .trust { margin-top: 1.6rem; padding-right: 2.5rem; color: var(--mark-muted); font-size: 0.98rem; }
  .sep { color: var(--accent); margin-inline: 0.25em; }
  .stationery :global(.st-lav) { position: absolute; width: 4.6rem; right: -1.2rem; bottom: -1.6rem; rotate: 28deg; }
  [data-theme='cottagecore'][data-scheme='dark'] .stationery,
  [data-theme='cottagecore'][data-scheme='dark'] .postcard {
    background-image: linear-gradient(165deg, rgba(255, 200, 120, 0.16), transparent 55%);
  }

  /* ---- the postcard ---- */
  .post { padding-top: clamp(0rem, 6vw, 5rem); align-self: stretch; display: flex; flex-direction: column; }
  .postcard {
    --tilt: 2deg;
    position: relative; z-index: 1;
    display: grid;
    padding: 1.8rem 1.6rem 1.8rem;
  }
  .pc-tape { top: -0.8rem; left: 1.4rem; --tape-tilt: -7deg; --tape-w: 5.5rem; }
  /* A loose posy on the table under the postcard, where the form runs long. */
  .post-posy { position: relative; flex: 1 1 auto; min-height: 9rem; margin-top: -1.2rem; }
  .post-posy :global(.pressed) { position: absolute; bottom: 0; }
  .post-posy :global(.pp-myrtle) { width: 7.6rem; left: 10%; top: -1.6rem; bottom: auto; rotate: -22deg; }
  /* The rose is mounted on a small card with a gum strip (dossier item 7),
     bottom-aligned so the columns end together and nothing floats on cloth. */
  .pp-card { --tilt: -3deg; position: absolute; right: 8%; bottom: 0; width: 9.5rem; height: 10.5rem; padding: 0.6rem; }
  .pp-tape { top: -0.7rem; left: 1.6rem; --tape-tilt: 6deg; --tape-w: 4.2rem; }
  .post-posy :global(.pp-rose) { position: absolute; width: 7.4rem; left: 1rem; bottom: 0.7rem; rotate: 12deg; }
  /* The stamp's look (perforations, face, the value 3) is assets/Stamp.astro. */
  .postcard :global(.stamp) {
    position: absolute; top: 1.2rem; right: 1.2rem;
    width: 5.6rem; height: 6.6rem;
    rotate: 4deg;
  }
  /* The cancel: a real postmark overlaps the stamp's lower-left corner. */
  /* In the flow after the heading (never on top of it), raised into the
     stamp's lower-left corner like a real cancel; the room below is left for
     the lettering Task 4 adds. */
  .postcard :global(.postmark) {
    order: 1;
    justify-self: end;
    margin: -1rem 2.2rem 0 0;
    width: 8.6rem;
    opacity: 0.72;
    rotate: -8deg;
  }
  .invite {
    margin-top: 0.2rem;
    /* Cleared to the stamp's own width, not the stamp plus the postmark, so
       the heading sets in two lines instead of a narrow four-line stack. */
    padding-right: 5.6rem;
    min-height: 5.9rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 460;
    font-size: clamp(1.45rem, 2.3vw, 1.8rem);
    line-height: 1.15;
  }
  .address, .fine { order: 2; }
  .address { display: grid; gap: 1.1rem; margin-top: 1.2rem; }
  .mail {
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: clamp(1.5rem, 5.4vw, 1.9rem);
    line-height: 1.1;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.25rem;
    overflow-wrap: anywhere;
  }
  .mail:hover { text-decoration: underline wavy var(--accent) 1px; text-underline-offset: 0.15em; }
  .addr-line { height: 1px; background: var(--rule); }
  .addr-line.short { width: 62%; }
  .fine { margin-top: 1.6rem; font-size: 0.98rem; color: var(--mark-muted); }

  /* In the narrow two-column band the heading sets in three lines, so the
     raised ring would sit on its last line: drop the ring clear of it. */
  @media (min-width: 861px) and (max-width: 980px) {
    .postcard :global(.postmark) { margin-top: 0.7rem; }
  }
  @media (max-width: 860px) {
    .contact { grid-template-columns: 1fr; }
    .post { padding-top: 0; max-width: 30rem; width: 100%; justify-self: center; }
    .post-posy { display: none; }
  }
  @media (max-width: 640px) {
    /* The trust line breaks at the flower, never inside 'A reply within...'. */
    .trust .tp { white-space: nowrap; }
    /* Below the trust line, not on top of it: it sat on 'A reply within'. */
    .stationery :global(.st-lav) { width: 2.6rem; right: 0.4rem; bottom: -2.4rem; }
    /* The stamp and postmark keep their own row (stamp bottom lands at
       ~7.8rem); the invite starts clear of both instead of wrapping beside
       a narrow column. */
    .postcard { padding-top: 8.6rem; }
    .invite { padding-right: 0; min-height: 0; }
    .postcard :global(.postmark) { position: absolute; margin: 0; right: 2.4rem; top: 4.8rem; width: 7.6rem; }
  }
</style>
