---
/** Cottagecore contact: a letter written on ruled stationery (the form, with
    handwritten labels and lines to write on), and beside it a postcard for
    anyone who would rather just email, stamped and postmarked. The form keeps
    the fixed contract (src/themes/README.md, Contact). */
import ContactHidden from '../../portal/ContactHidden.astro';
import type { CopyData } from '../../../lib/copy';
import Pressed from '../assets/Pressed.astro';

interface Props { copy: CopyData<'contact'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
---
<section class="contact cc-wrap">
  <div class="stationery cc-paper">
    <header class="intro">
      <p class="cc-hand kicker"><span class="cc-scribble">{copy.kicker}</span></p>
      <h1>{copy.heading}</h1>
      <p class="subline">{copy.subline}</p>
    </header>
    <form method="post" action="/api/contact" data-astro-reload>
      <div class="field">
        <label for="cf-name">{copy.labels.name}</label>
        <input id="cf-name" name="name" type="text" required maxlength="200" autocomplete="name" />
      </div>
      <div class="field">
        <label for="cf-email">{copy.labels.email}</label>
        <input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" />
      </div>
      <div class="field">
        <label for="cf-message">{copy.labels.message}</label>
        <textarea id="cf-message" name="message" required maxlength="5000" rows="7"></textarea>
      </div>
      <ContactHidden theme={theme} label={copy.labels.honeypot} />
      <button class="cc-label" type="submit">{copy.submit}</button>
    </form>
    <p class="trust">{copy.trust.map((part, i) => <>{i > 0 && <> <span class="sep" aria-hidden="true">&#10047;</span> </>}{part}</>)}</p>
    <Pressed kind="lavender" seed={101} class="st-lav" />
  </div>

  <div class="post">
    <div class="postcard cc-paper">
      <span class="cc-tape cc-tape--rose pc-tape" aria-hidden="true"></span>
      <div class="stamp" aria-hidden="true">
        <div class="stamp-face"><Pressed kind="daisy" seed={102} class="stamp-flower" /></div>
      </div>
      <svg class="postmark" viewBox="0 0 150 70" aria-hidden="true" focusable="false">
        <circle cx="35" cy="35" r="30" />
        <circle cx="35" cy="35" r="22" />
        <path d="M70 18c10-6 18 6 28 0s18 6 28 0 14 4 22 0M70 30c10-6 18 6 28 0s18 6 28 0 14 4 22 0M70 42c10-6 18 6 28 0s18 6 28 0 14 4 22 0M70 54c10-6 18 6 28 0s18 6 28 0 14 4 22 0" />
      </svg>
      <p class="invite">{copy.invite}</p>
      <div class="address">
        <a class="mail" href={`mailto:${copy.email}`}>{copy.email}</a>
        <span class="addr-line" aria-hidden="true"></span>
        <span class="addr-line short" aria-hidden="true"></span>
      </div>
      <p class="fine">{copy.fine}</p>
    </div>
    <div class="post-posy" aria-hidden="true">
      <Pressed kind="fern" seed={103} class="pp-fern" />
      <Pressed kind="rose" seed={104} class="pp-rose" />
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: 3rem clamp(2rem, 5vw, 4.5rem);
    align-items: start;
    padding-block: clamp(2rem, 5vw, 4rem) 0;
  }

  /* ---- the stationery ---- */
  .stationery {
    --tilt: -0.5deg;
    padding: clamp(2rem, 5vw, 3.6rem) clamp(1.4rem, 5vw, 3.6rem) clamp(2.4rem, 5vw, 3.6rem);
  }
  .kicker { font-size: clamp(1.9rem, 3vw, 2.3rem); }
  /* Capped so 'Start a conversation' sets on one line at desktop instead of
     stranding 'Start a' above a heavy second line. */
  h1 { font-size: clamp(2.6rem, 4.6vw, 3.6rem); margin-top: 0.7rem; }
  .subline { margin-top: 1rem; font-size: 1.14rem; color: var(--mark-muted); max-width: 34rem; }
  form { display: grid; gap: 1.6rem; margin-top: 2.4rem; }
  .field { display: grid; gap: 0.15rem; }
  .field label {
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: 1.55rem;
    line-height: 1.2;
    color: var(--accent);
  }
  .field input, .field textarea {
    font: inherit;
    font-size: 1.1rem;
    color: var(--mark);
    background-color: transparent;
    border: 0;
    border-radius: 0;
    width: 100%;
  }
  /* Lines to write on: a dashed line under each field, in --field-line
     (not the decorative --stitch) so the boundary clears 3:1. */
  .field input {
    border-bottom: 2px dashed var(--field-line);
    padding: 0.45rem 0.25rem;
  }
  .field textarea {
    --lh: 1.9rem;
    line-height: var(--lh);
    padding: 0.2rem 0.6rem 0.4rem;
    min-height: calc(var(--lh) * 6 + 0.6rem);
    resize: vertical;
    border: 2px dashed var(--field-line);
    border-radius: 4px;
    background-image: linear-gradient(to top, var(--rule) 1px, transparent 1px);
    background-size: 100% var(--lh);
    background-position: 0 0.2rem;
    background-attachment: local;
  }
  .field input:focus-visible, .field textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-color: var(--accent);
    border-style: solid;
    background-color: color-mix(in srgb, var(--note) 55%, transparent);
  }
  form .cc-label { justify-self: start; margin-top: 0.4rem; }
  .trust { margin-top: 1.6rem; padding-right: 2.5rem; color: var(--mark-muted); font-size: 0.98rem; }
  .sep { color: var(--accent); margin-inline: 0.25em; }
  .stationery :global(.st-lav) { position: absolute; width: 4.6rem; right: -1.2rem; bottom: -1.6rem; rotate: 28deg; }
  [data-theme='cottagecore'][data-scheme='dark'] .stationery,
  [data-theme='cottagecore'][data-scheme='dark'] .postcard {
    background-image: linear-gradient(165deg, rgba(255, 200, 120, 0.16), transparent 55%);
  }

  /* ---- the postcard ---- */
  .post { padding-top: clamp(0rem, 6vw, 5rem); }
  .postcard {
    --tilt: 2deg;
    display: grid;
    padding: 1.8rem 1.6rem 1.8rem;
  }
  .pc-tape { top: -0.8rem; left: 1.4rem; --tape-tilt: -7deg; --tape-w: 5.5rem; }
  /* A loose posy on the table under the postcard, where the form runs long. */
  .post-posy { position: relative; height: 16rem; margin-top: 2rem; }
  .post-posy :global(.pressed) { position: absolute; bottom: 0; }
  .post-posy :global(.pp-fern) { width: 7.5rem; left: 18%; rotate: -28deg; }
  .post-posy :global(.pp-rose) { width: 8.5rem; left: 42%; rotate: 16deg; }
  .stamp {
    position: absolute; top: 1.2rem; right: 1.2rem;
    width: 5.6rem; height: 6.6rem;
    padding: 0.5rem;
    /* A stock that contrasts with the postcard under it, in both schemes, so
       the perforated edge stays visible rather than reading as a flat square. */
    background: var(--cc-stamp-stock);
    rotate: 4deg;
    filter: drop-shadow(0 1px 2px rgba(var(--shadow), 0.35)) drop-shadow(0 0 0 1px rgba(var(--shadow), 0.08));
    /* Perforations: a grid of holes, kept only around the edge by a solid
       inner rectangle laid over it. */
    -webkit-mask:
      radial-gradient(circle 4px at 5px 5px, #0000 96%, #000) -5px -5px / 10px 10px,
      linear-gradient(#000 0 0) center / calc(100% - 10px) calc(100% - 10px) no-repeat;
    mask:
      radial-gradient(circle 4px at 5px 5px, #0000 96%, #000) -5px -5px / 10px 10px,
      linear-gradient(#000 0 0) center / calc(100% - 10px) calc(100% - 10px) no-repeat;
  }
  .stamp-face {
    height: 100%;
    display: grid; place-items: center;
    background: var(--cc-stamp-face);
    outline: 1px solid rgba(58, 42, 31, 0.25);
    outline-offset: -3px;
    overflow: hidden;
  }
  :global([data-theme='cottagecore'][data-scheme='dark']) .stamp-face { filter: brightness(0.82) sepia(0.15); }
  .stamp :global(.stamp-flower) { width: 82%; translate: 0 18%; }
  /* The cancel: a real postmark overlaps the stamp's lower-left corner. */
  .postmark {
    position: absolute; top: 5.4rem; right: 4.4rem;
    width: 7.2rem;
    fill: none; stroke: var(--mark-muted); stroke-width: 1.6; opacity: 0.55;
    rotate: -8deg;
  }
  .invite {
    margin-top: 0.2rem;
    /* Cleared to the stamp's own width, not the stamp plus the postmark, so
       the heading sets in two lines instead of a narrow four-line stack. */
    padding-right: 5.6rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 460;
    font-size: clamp(1.45rem, 2.3vw, 1.8rem);
    line-height: 1.15;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
  }
  .address { display: grid; gap: 1.1rem; margin-top: 1.8rem; }
  .mail {
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: clamp(1.5rem, 5.4vw, 1.9rem);
    line-height: 1.1;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.25rem;
    overflow-wrap: anywhere;
  }
  .mail:hover { text-decoration: underline wavy var(--accent) 1px; text-underline-offset: 0.15em; }
  .addr-line { height: 1px; background: var(--rule); }
  .addr-line.short { width: 62%; }
  .fine { margin-top: 1.6rem; font-size: 0.98rem; color: var(--mark-muted); }

  @media (max-width: 860px) {
    .contact { grid-template-columns: 1fr; }
    .post { padding-top: 0; max-width: 30rem; width: 100%; justify-self: center; }
    .post-posy { display: none; }
  }
  @media (max-width: 640px) {
    /* Below the trust line, not on top of it: it sat on 'A reply within'. */
    .stationery :global(.st-lav) { width: 2.6rem; right: 0.4rem; bottom: -2.4rem; }
    /* The stamp and postmark keep their own row (stamp bottom lands at
       ~7.8rem); the invite starts clear of both instead of wrapping beside
       a narrow column. */
    .postcard { padding-top: 8.6rem; }
    .invite { padding-right: 0; }
    .postmark { right: 3.2rem; top: 5rem; width: 6.2rem; }
  }
</style>
