---
/** Cottagecore home: the kitchen table. The name set large with a pen stroke
    under it beside a sheet of pressed flowers; the two things we build as
    recipe cards taped to the linen; the Lab on a butter note laid over a
    gingham cloth; and a sewn label to start a project. */
import { featuredSpecimens, specimenLink, type CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';
import Pressed from '../assets/Pressed.astro';
import Arrow from '../assets/Arrow.astro';

interface Props { copy: CopyData<'home'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, chrome, theme } = Astro.props;
const featured = (await featuredSpecimens()).map((entry) => ({ entry, link: specimenLink(entry, theme) }));
const [nameFirst, ...nameRest] = chrome.name.split(' ');
---
<section class="hero cc-wrap">
  <div class="hero-copy">
    <h1 class="billboard">
      <span class="b1 cc-scribble">{nameFirst}</span> <span class="b2">{nameRest.join(' ')}</span>
    </h1>
    <p class="lead">{copy.opener.lead}</p>
    <p class="subline">{copy.opener.subline}</p>
  </div>
  <div class="specimen cc-lamp" aria-hidden="true">
    <div class="sheet cc-paper cc-board">
      <span class="cc-tape t1"></span>
      <span class="cc-tape cc-tape--indigo cc-tape--cut t2"></span>
      <Pressed kind="fern" seed={3} class="p-fern" />
      <Pressed kind="lavender" seed={5} class="p-lav" />
      <Pressed kind="rose" seed={9} class="p-rose" />
      <Pressed kind="daisy" seed={4} class="p-daisy" />
      <svg class="pressed gum" viewBox="0 0 34 12" aria-hidden="true" focusable="false" style="left: 30.7%; top: 59.1%; rotate: -19.1deg"><path class="gum-strip" d="M1.2 .6L33 0L32.6 11.4L0 12Z" /></svg>
      <svg class="pressed gum" viewBox="0 0 34 12" aria-hidden="true" focusable="false" style="left: 20.4%; top: 30.5%; rotate: -14.1deg"><path class="gum-strip" d="M1.2 .6L33 0L32.6 11.4L0 12Z" /></svg>
      <svg class="pressed gum" viewBox="0 0 34 12" aria-hidden="true" focusable="false" style="left: 75.5%; top: 52.9%; rotate: 194deg"><path class="gum-strip" d="M1.2 .6L33 0L32.6 11.4L0 12Z" /></svg>
      <svg class="pressed gum" viewBox="0 0 34 12" aria-hidden="true" focusable="false" style="left: 72.1%; top: 63.2%; rotate: 195deg"><path class="gum-strip" d="M1.2 .6L33 0L32.6 11.4L0 12Z" /></svg>
      <svg class="pressed gum" viewBox="0 0 34 12" aria-hidden="true" focusable="false" style="left: 39.4%; top: 64.8%; rotate: 177.4deg"><path class="gum-strip" d="M1.2 .6L33 0L32.6 11.4L0 12Z" /></svg>
      <svg class="pressed gum" viewBox="0 0 34 12" aria-hidden="true" focusable="false" style="left: 41.5%; top: 76%; rotate: 167.6deg"><path class="gum-strip" d="M1.2 .6L33 0L32.6 11.4L0 12Z" /></svg>
      <span class="herb-label" aria-hidden="true">
        <svg class="hl-text" viewBox="0 0 130 66" focusable="false">
          <text class="hl-t1" x="2" y="14">Garden flowers, pressed</text>
          <path class="hl-rule" d="M2 19.5h126" />
          <text class="hl-t2" x="2" y="32">Mississippi Gulf Coast</text>
          <text class="hl-t2" x="2" y="45">23 Sept. 2026</text>
          <text class="hl-t3" x="2" y="59">coll. Birch Design Lab</text>
        </svg>
      </span>
    </div>
    <Pressed kind="leaf" seed={2} class="stray s1" />
    <Pressed kind="leaf" seed={8} class="stray s2" />
  </div>
</section>

<section class="doors cc-wrap">
  <h2 class="cc-hand kicker"><span class="cc-scribble">{copy.doors.kicker}</span></h2>
  <div class="cards">
    {copy.doors.items.map((door, i) => (
      <article class="card cc-paper">
        <span class:list={['cc-tape', i % 2 === 1 ? 'cc-tape--butter cc-tape--pinked' : 'cc-tape--half']} aria-hidden="true"></span>
        <p class="no" aria-hidden="true">&#8470; {i + 1}</p>
        <h3>{door.title}</h3>
        <div class="card-rule" aria-hidden="true"></div>
        <p class="cc-ruled">{door.body}</p>
        <Pressed kind={i % 2 ? 'rose' : 'fern'} seed={20 + i} class="corner" />
      </article>
    ))}
  </div>
  <a class="cc-note-link more" href={hrefFor('services', theme)}>{copy.doors.more} <Arrow /></a>
</section>

{featured.length > 0 && (
  <section class="lab cc-gingham">
    <div class="cc-wrap lab-inner">
      <div class="note-lift cc-torn-lift">
        <div class="note cc-torn">
          <p class="cc-hand">{copy.lab.kicker}</p>
          <p class="pull">{copy.lab.pull}</p>
          <div class="clipping">
            <span class="cc-tape cc-tape--cut clip-tape" aria-hidden="true"></span>
            <ul class="specimens" role="list" data-parity-skip>
              {featured.map(({ entry, link }, i) => (
                <li>
                  <Pressed kind="leaf" seed={40 + i} class="bullet" />
                  <a class="des" href={link.href} data-astro-reload={link.leaves ? '' : undefined} aria-label={`${entry.data.designation}, ${entry.data.title}`}>{entry.data.designation}</a>
                  <span class="sum">{entry.data.summary}</span>
                </li>
              ))}
            </ul>
          </div>
          <a class="cc-note-link" href={hrefFor('lab', theme)} data-astro-reload>{copy.lab.more} <Arrow /></a>
        </div>
      </div>
      <span class="cc-tape cc-tape--butter cc-tape--ragged lab-tape" aria-hidden="true"></span>
    </div>
  </section>
)}

<section class="closer cc-wrap cc-lamp">
  <Pressed kind="lavender" seed={51} class="c-left" />
  <Pressed kind="rose" seed={52} class="c-right" />
  <p class="closer-lead">{copy.closer.lead}</p>
  <a class="cc-label" href={hrefFor('contact', theme)}>{copy.closer.cta}</a>
</section>

<style>
  /* ---- hero: the name, and a sheet of pressed flowers ---- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
    gap: 2rem 4rem;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem);
  }
  .billboard { font-weight: 600; line-height: 0.9; }
  .b1 {
    display: inline-block;
    font-size: clamp(4.6rem, 12.4vw, 10.5rem);
    letter-spacing: -0.03em;
    padding-bottom: 0.1em;
  }
  .b1.cc-scribble::after { height: 0.15em; bottom: -0.03em; left: 2%; right: -4%; }
  .b2 {
    display: block;
    font-style: italic;
    font-weight: 380;
    font-size: clamp(2.7rem, 6.4vw, 5.4rem);
    color: var(--link);
    letter-spacing: -0.015em;
    margin-top: 0.12em;
    padding-left: 0.08em;
  }
  /* Weight, ink and tilt come from the kicker hand (theme.css). */
  .lead {
    font-family: var(--font-hand);
    font-size: clamp(2.3rem, 3.6vw, 3.05rem);
    line-height: 1.05;
    margin-top: 1.9rem;
  }
  /* The one sentence that explains the business: full ink, a step larger. */
  .subline {
    max-width: 33rem;
    margin-top: 1.1rem;
    font-size: 1.3rem;
    line-height: 1.65;
    color: var(--mark);
  }

  .specimen { position: relative; justify-self: end; width: min(100%, 26rem); --lamp-inset: -18%; }
  .sheet {
    --tilt: 2.4deg;
    aspect-ratio: 4 / 5;
    width: 100%;
  }
  .t1 { top: -0.8rem; left: 16%; --tape-tilt: -9deg; --tape-w: 8.5rem; }
  .t2 { bottom: -0.7rem; right: 12%; --tape-tilt: 7deg; --tape-w: 6.25rem; }
  .sheet :global(.pressed) { position: absolute; }
  /* The gum strips that hold the hero sprigs: a gummed parallelogram laid
     across each stem (the About twig's drawing), placed on bare stem and
     never over a bloom (the a5 hit test, 1440 / 820 / 390). Positions are
     percent of the sheet, so they hold at every size. */
  .sheet :global(.gum) { width: 9.5%; height: auto; translate: -50% -50%; pointer-events: none; }
  .sheet :global(.p-fern) { left: 3%; top: 6%; width: 44%; rotate: -16deg; }
  .sheet :global(.p-lav) { left: 32%; top: 2%; width: 32%; rotate: 9deg; }
  .sheet :global(.p-rose) { right: 1%; top: 26%; width: 46%; rotate: 14deg; }
  .sheet :global(.p-daisy) { left: 18%; top: 30%; width: 44%; rotate: -8deg; }
  /* A herbarium label in the RHS style, filled in by hand (Stage 5 D1): the
     sprig and where it grew, the day it was pressed, who collected it. The
     lettering is decorative aria-hidden SVG text in the label hand. */
  .herb-label {
    position: absolute; right: 6%; bottom: 6%;
    width: 46%; padding: 0.5rem 0.55rem 0.4rem;
    border: 1px solid var(--rule);
    outline: 1px solid var(--rule); outline-offset: 2px;
    background: var(--paper);
    display: grid;
  }
  .herb-label .hl-text { width: 100%; height: auto; overflow: visible; }
  .hl-text text { font-family: var(--font-hand); fill: var(--mark-muted); }
  .hl-text .hl-t1 { font-size: 13px; font-weight: 700; fill: var(--mark); }
  .hl-text .hl-t2 { font-size: 11.5px; font-weight: 600; }
  .hl-text .hl-t3 { font-size: 10.5px; font-weight: 500; }
  .hl-text .hl-rule { fill: none; stroke: var(--mark-muted); stroke-width: 0.7; opacity: 0.8; }
  .specimen :global(.stray) { position: absolute; width: 1.6rem; }
  .specimen :global(.s1) { left: -2.2rem; bottom: 18%; rotate: -30deg; }
  .specimen :global(.s2) { right: -1.2rem; top: -1.6rem; rotate: 50deg; width: 1.2rem; }

  /* ---- what we build: two recipe cards ---- */
  .doors { padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 7vw, 5rem); }
  .kicker { text-align: center; font-size: clamp(2.5rem, 4vw, 3.3rem); }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem clamp(2rem, 5vw, 4.5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }
  .card {
    padding: 2.4rem clamp(1.5rem, 3vw, 2.6rem) 2.6rem;
  }
  .card:nth-child(1) { --tilt: -1.4deg; }
  .card:nth-child(2) { --tilt: 1.1deg; margin-top: 2.2rem; }
  .card .cc-tape { top: -0.85rem; left: calc(50% - var(--tape-w) / 2); --tape-tilt: -3deg; --tape-w: 7rem; }
  .card:nth-child(2) .cc-tape { --tape-tilt: 4deg; --tape-w: 8.25rem; }
  .no {
    position: absolute; top: 1.3rem; right: 1.5rem;
    font-family: var(--font-hand); font-size: 1.5rem;
  }
  .card h3 { font-size: clamp(2rem, 3vw, 2.5rem); padding-right: 2.6rem; }
  .card-rule {
    height: 5px; margin-block: 0.9rem 0.6rem;
    border-top: 1.5px solid var(--margin-line);
    border-bottom: 1px solid var(--margin-line);
  }
  .card p.cc-ruled { color: var(--mark-muted); font-size: 1.06rem; padding-right: 3.2rem; }
  .card :global(.corner) {
    position: absolute; right: -0.4rem; bottom: -0.6rem;
    width: 4.6rem; rotate: 18deg;
  }
  .more { display: flex; width: fit-content; margin: clamp(2.5rem, 5vw, 3.5rem) auto 0; }

  /* ---- from the lab: a butter note on the gingham cloth ---- */
  .lab { padding-block: clamp(3rem, 7vw, 5.5rem); }
  .lab-inner { position: relative; display: grid; justify-items: center; }
  .note-lift { --tilt: -0.8deg; width: min(100%, 44rem); }
  .note {
    --torn-x: -310px;
    background: var(--note);
    padding: clamp(2.2rem, 4vw, 3rem) clamp(1.5rem, 4vw, 3rem) clamp(2.4rem, 4vw, 3rem);
  }
  .pull {
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    line-height: 1.15;
    margin-top: 0.5rem;
  }
  /* The one printed clipping (Stage 5 item 11): the lab list as a trimmed slip
     pasted on the butter note. A whiter, greyer paper than the note, straight
     edges, a printed hairline frame, a slight counter-tilt to the note, and
     one corner held by a small tape. */
  .clipping {
    position: relative;
    margin: 1.6rem 0 1.5rem;
    padding: 1.15rem 1.3rem 1.25rem;
    background: var(--clip-paper);
    color: var(--clip-ink);
    rotate: 1.5deg;
    box-shadow: 0 1px 1px rgba(var(--shadow), 0.22), 0 7px 12px -9px rgba(var(--shadow), 0.55);
    outline: 1px solid var(--clip-rule);
    outline-offset: -6px;
  }
  .clip-tape { top: -0.8rem; right: -1.1rem; --tape-tilt: 36deg; --tape-w: 4.2rem; }
  .specimens {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 0.9rem;
  }
  .specimens li {
    display: grid; grid-template-columns: 1.3rem auto 1fr;
    align-items: baseline; gap: 0.2rem 0.8rem;
  }
  .specimens :global(.bullet) { width: 1.1rem; translate: 0 0.2rem; }
  .des {
    font-variant-caps: all-small-caps;
    font-weight: 650; letter-spacing: 0.09em; font-size: 1.04rem;
    color: var(--clip-accent);
    text-decoration: none;
  }
  /* The designation links to its entry: plain ink at rest, the theme's wavy
     hand-drawn underline on hover and on focus. */
  .des:hover, .des:focus-visible {
    text-decoration: underline wavy var(--clip-accent);
    text-decoration-thickness: 1px;
  }
  .sum { color: var(--clip-ink-muted); }
  .lab-tape { top: -0.9rem; left: calc(50% - var(--tape-w) / 2); --tape-tilt: -2deg; --tape-w: 9rem; }

  /* ---- closer ---- */
  .closer {
    position: relative;
    display: grid; justify-items: center; text-align: center;
    padding-block: clamp(4rem, 9vw, 7rem) 0;
    --lamp-inset: 0 10% -30%;
  }
  .closer-lead {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 450;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.05;
    margin-bottom: 1.8rem;
  }
  .closer :global(.c-left), .closer :global(.c-right) { position: absolute; bottom: -1rem; width: 6.5rem; }
  /* Clamped so the offset never goes negative and lands on the centred
     headline as the viewport narrows toward the breakpoint below. */
  .closer :global(.c-left) { left: max(0px, calc(50% - 25rem)); rotate: -24deg; }
  .closer :global(.c-right) { right: max(0px, calc(50% - 25rem)); rotate: 20deg; }

  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; }
    .specimen { justify-self: center; width: min(82%, 22rem); margin-top: 1.5rem; }
  }
  /* Tablet: two columns hold down to about 700px; the corner sprig gets room
     below the last line so it never crosses text. */
  @media (max-width: 1000px) {
    .card p.cc-ruled { padding-bottom: 2.4rem; }
  }
  /* Stacked: capped at 32rem and dealt left then right, keeping their tilts. */
  @media (max-width: 700px) {
    .cards { grid-template-columns: 1fr; gap: 3.2rem; }
    .card { width: min(100%, 32rem); }
    .card:nth-child(1) { justify-self: start; }
    .card:nth-child(2) { justify-self: end; margin-top: 0; }
  }
  /* The closer sprigs move to the gutter treatment a full breakpoint sooner
     than the rest of the page: the calc offset they use otherwise lands on
     the centred headline between 820 and 1000px. */
  @media (max-width: 1000px) {
    .closer :global(.c-left), .closer :global(.c-right) { width: 4rem; bottom: 4.2rem; }
    .closer :global(.c-left) { left: 0; }
    .closer :global(.c-right) { right: 0; }
  }
  @media (max-width: 640px) {
    /* SOFT 0 sets the line narrower than the soft cut did, so it fits one
       line and runs under the gutter sprigs. Hold two lines, clear of them. */
    .closer-lead { max-inline-size: 9em; text-wrap: balance; }
    .card p.cc-ruled { padding-right: 0; padding-bottom: 2.4rem; }
    .card :global(.corner) { width: 3.6rem; }
    .specimens li { grid-template-columns: 1.3rem 1fr; }
    .sum { grid-column: 2; }
  }
</style>
