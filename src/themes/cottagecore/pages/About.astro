---
/** Cottagecore about: a herbarium sheet for the shining tree (a pressed birch
    twig, the etymology on its specimen label), the founder's words as a
    letter on ruled paper, and the manifesto stitched into an embroidery
    hoop. */
import { rich, type CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';
import Pressed from '../assets/Pressed.astro';
import Sampler from '../assets/Sampler.astro';

interface Props { copy: CopyData<'about'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
const [etymLead, ...etymRest] = copy.etymology;
---
<section class="herbarium cc-wrap">
  <div class="sheet cc-paper">
    <div class="specimen" aria-hidden="true">
      <Pressed kind="birch" seed={7} class="twig" />
    </div>
    <div class="text">
      <h1>{copy.heading}</h1>
      <div class="label">
        <p set:html={rich(etymLead)} />
      </div>
      {etymRest.map((para) => <p class="etym-more" set:html={rich(para)} />)}
    </div>
  </div>
</section>

<section class="letter-sec cc-wrap">
  <div class="letter-lift cc-torn-lift">
    <article class="letter cc-torn">
      <h2>{copy.founder.heading}</h2>
      {copy.founder.body.map((para) => <p>{para}</p>)}
    </article>
  </div>
  <span class="cc-tape cc-tape--rose letter-tape" aria-hidden="true"></span>
  <Pressed kind="rose" seed={61} class="letter-rose" />
  <Pressed kind="fern" seed={62} class="letter-fern" />
</section>

<section class="sampler-sec cc-wrap cc-lamp">
  <div class="hoop">
    <div class="cloth">
      <p class="manifesto">{copy.manifesto}</p>
      <Sampler class="motif" />
    </div>
  </div>
  <a class="cc-label" href={hrefFor('contact', theme)}>{copy.cta}</a>
</section>

<style>
  /* ---- the herbarium sheet ---- */
  .herbarium { padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem); }
  .sheet {
    --tilt: -0.6deg;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 2rem clamp(2rem, 5vw, 4.5rem);
    padding: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .specimen { position: relative; }
  /* The gummed mounting strips are drawn inside the twig SVG itself
     (Pressed.astro), so they scale and rotate with it in both schemes. */
  .specimen :global(.twig) { width: 100%; max-width: 26rem; margin-inline: auto; rotate: -4deg; }
  h1 { font-size: clamp(3rem, 6.2vw, 5rem); line-height: 0.98; }
  /* The specimen label: double-ruled, the etymology written on it. */
  .label {
    margin-top: 1.8rem;
    padding: 1.2rem 1.4rem;
    border: 1px solid var(--mark-muted);
    outline: 1px solid var(--mark-muted);
    outline-offset: 3px;
    font-size: 1.14rem;
    line-height: 1.7;
  }
  .label :global(em) { font-family: var(--font-display); font-weight: 500; font-variation-settings: 'SOFT' 100, 'WONK' 1; }
  .label :global(strong) { color: var(--accent); }
  .etym-more { margin-top: 1.4rem; color: var(--mark-muted); max-width: var(--measure); }

  /* ---- the letter ---- */
  .letter-sec {
    position: relative;
    display: grid; justify-items: center;
    padding-block: clamp(1rem, 3vw, 2rem) clamp(3rem, 7vw, 5rem);
  }
  .letter-lift { --tilt: 0.7deg; width: min(100%, 44rem); }
  /* Lined writing paper with a double margin rule; every line of text sits
     on a ruled line because the heading and paragraphs share one rhythm. */
  .letter {
    --lh: 1.9rem;
    background-color: var(--paper);
    background-image:
      linear-gradient(90deg, transparent 3.1rem, var(--margin-line) 3.1rem 3.2rem, transparent 3.2rem 3.45rem, var(--margin-line) 3.45rem 3.55rem, transparent 3.55rem),
      linear-gradient(to top, var(--rule) 1px, transparent 1px);
    background-size: 100% 100%, 100% var(--lh);
    background-position: 0 0, 0 calc(var(--lh) * 0.72);
    /* One line of empty rule above the heading, not two: the sheet read as
       unfinished with a full blank line before any writing started. */
    padding: var(--lh) clamp(1.5rem, 5vw, 3.5rem) calc(var(--lh) * 2) clamp(4.4rem, 8vw, 5.6rem);
    line-height: var(--lh);
  }
  [data-theme='cottagecore'][data-scheme='dark'] .letter {
    background-image:
      linear-gradient(90deg, transparent 3.1rem, var(--margin-line) 3.1rem 3.2rem, transparent 3.2rem 3.45rem, var(--margin-line) 3.45rem 3.55rem, transparent 3.55rem),
      linear-gradient(to top, var(--rule) 1px, transparent 1px),
      linear-gradient(165deg, rgba(255, 200, 120, 0.14), transparent 60%);
    background-size: 100% 100%, 100% var(--lh), 100% 100%;
    background-position: 0 0, 0 calc(var(--lh) * 0.72), 0 0;
  }
  .letter h2 {
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: 2.6rem;
    line-height: calc(var(--lh) * 2);
    color: var(--accent);
    letter-spacing: 0;
    rotate: -1.5deg;
  }
  .letter p { margin-top: var(--lh); color: var(--mark); }
  .letter p:first-of-type { margin-top: 0; }
  .letter-tape { top: calc(clamp(1rem, 3vw, 2rem) - 0.9rem); left: calc(50% - 3.75rem); --tape-tilt: 3deg; }
  .letter-sec :global(.letter-rose) {
    position: absolute; width: 8.5rem;
    right: calc(50% - 30rem); top: 14%; rotate: 24deg;
  }
  .letter-sec :global(.letter-fern) {
    position: absolute; width: 7rem;
    left: calc(50% - 30rem); bottom: 12%; rotate: -20deg;
  }

  /* ---- the embroidery hoop ---- */
  .sampler-sec {
    display: grid; justify-items: center; gap: 2.4rem;
    padding-block: clamp(1rem, 3vw, 2rem) 0;
    --lamp-inset: -6% 10%;
  }
  .hoop {
    position: relative;
    width: min(100%, 32rem);
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 0.9rem;
    background:
      radial-gradient(circle, transparent 66%, rgba(0, 0, 0, 0.12) 70%, transparent 71%),
      linear-gradient(135deg, var(--wood), var(--wood-dark));
    box-shadow:
      0 0 0 2px var(--wood-dark),
      0 22px 40px -22px rgba(var(--shadow), 0.6);
  }
  /* The brass screw at the top of the hoop. */
  .hoop::before, .hoop::after {
    content: '';
    position: absolute; left: 50%; translate: -50% 0;
    background: var(--wood-dark);
    border-radius: 3px;
  }
  .hoop::before { top: -1.1rem; width: 2.8rem; height: 1.5rem; }
  .hoop::after { top: -1.9rem; width: 0.9rem; height: 1rem; background: #b79a5b; border-radius: 2px 2px 4px 4px; }
  .cloth {
    position: relative;
    height: 100%;
    border-radius: 50%;
    display: grid; place-items: center; align-content: center; gap: 1.2rem;
    background-color: var(--hoop-cloth);
    /* Aida cloth: the even weave cross-stitch is worked on. */
    background-image:
      repeating-linear-gradient(0deg, rgba(var(--shadow), 0.05) 0 1px, transparent 1px 5px),
      repeating-linear-gradient(90deg, rgba(var(--shadow), 0.05) 0 1px, transparent 1px 5px);
    box-shadow: inset 0 0 0 2px rgba(var(--shadow), 0.18), inset 0 6px 18px rgba(var(--shadow), 0.12);
  }
  .cloth::after {
    content: '';
    position: absolute; inset: 7%;
    border: 2px dashed var(--stitch-rose);
    border-radius: 50%;
    pointer-events: none;
  }
  .manifesto {
    max-width: 72%;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 460;
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    line-height: 1.3;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    color: var(--mark);
    text-wrap: balance;
  }
  .cloth :global(.motif) { width: 5.5rem; }

  @media (max-width: 820px) {
    .sheet { grid-template-columns: 1fr; }
    .specimen :global(.twig) { max-width: 17rem; }
    .letter-sec :global(.letter-rose), .letter-sec :global(.letter-fern) { display: none; }
  }
  @media (max-width: 640px) {
    .letter { --lh: 1.8rem; font-size: 1rem; }
    .letter h2 { font-size: 2.3rem; }
    .hoop { padding: 0.65rem; }
    .cloth { gap: 0.6rem; }
    .cloth :global(.motif) { width: 4rem; }
    .manifesto { max-width: 76%; }
  }
</style>
