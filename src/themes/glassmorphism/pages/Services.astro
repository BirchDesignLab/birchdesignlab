---
/** Glassmorphism services: a header card, the two offerings as app cards,
    the process as four numbered tiles, and the ask. */
import Orbs from '../Orbs.astro';
import type { CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';

interface Props { copy: CopyData<'services'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
const offerHues = ['violet', 'cyan'];
const stepHues = ['violet', 'cyan', 'peach', 'pink'];
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="head wrap">
  <Orbs orbs={[
    { hue: 'violet', x: '80%', y: '34%', mx: '90%', my: '6%', size: 'clamp(200px, 27vw, 400px)', drift: 1 },
    { hue: 'peach', x: '12%', y: '12%', mx: '6%', my: '96%', size: 'clamp(100px, 13vw, 190px)', drift: 2 },
  ]} />
  <div class="head-card glass thin">
    <p class="chip">{copy.kicker}</p>
    <h1>{copy.heading}</h1>
    <div class="sublines">
      {copy.sublines.map((line) => <p>{line}</p>)}
    </div>
  </div>
</section>

<section class="offers wrap">
  <Orbs orbs={[
    { hue: 'cyan', x: '48%', y: '28%', mx: '92%', my: '48%', size: 'clamp(170px, 22vw, 330px)', drift: 2 },
    /* B1 fix round 2, item 1: was x6%/y88%, only clipping the left offer
       card's bottom corner (3% coverage at 25% scroll, "useless"). Moved up
       to straddle the card's bottom edge properly. */
    { hue: 'pink', x: '13%', y: '76%', mx: '8%', my: '99%', size: 'clamp(120px, 15vw, 230px)', drift: 3 },
  ]} />
  {copy.offerings.map((offering, i) => (
    <article class="offer glass">
      <span class={`app-icon ${offerHues[i % offerHues.length]}`} aria-hidden="true">{num(i)}</span>
      <h2>{offering.heading}</h2>
      {offering.body.map((para) => <p>{para}</p>)}
    </article>
  ))}
</section>

<section class="process wrap">
  <Orbs orbs={[
    { hue: 'violet', x: '20%', y: '66%', mx: '90%', my: '4%', size: 'clamp(160px, 21vw, 310px)', drift: 1 },
    { hue: 'peach', x: '88%', y: '44%', mx: '6%', my: '56%', size: 'clamp(140px, 18vw, 270px)', drift: 2 },
  ]} />
  {/* Item 7: bare-wallpaper text. The section heading sat directly on the
      field with nothing behind it (palette.md's flagged case); it now sits
      on its own small opaque plate, the same solid-surface recipe as
      .step below it. */}
  <h2 class="process-head surface-solid">{copy.process.heading}</h2>
  {/* B2 item 1: the four steps become ONE settings-style grouped pane (an
      iOS Settings list: grouped rows on one pane) instead of four separate
      surface-solid tiles, per the brief's E1 material for this role (a
      single solid pane holding hairline-divided columns, not four glass or
      solid cards). Each row keeps B1's one-baseline win at desktop/tablet
      (the four columns share one top edge, divided by a hairline instead of
      a gap); at 600px and under, the same one pane becomes a true vertical
      Settings list, one row per step. A decorative switch and stepper sit
      beside each step's copy: inert per the README's rule (aria-hidden,
      plain elements, nothing focusable, no visible label added, so word
      parity is untouched), there only because "more interactable details,
      not fewer" applies even where a control does nothing. */}
  <div class="settings-pane surface-solid">
    <ol class="settings-list" role="list">
      {copy.process.steps.map((step, i) => (
        <li class="settings-row">
          <span class={`app-icon ${stepHues[i % stepHues.length]}`} aria-hidden="true">{num(i)}</span>
          <div class="settings-text">
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
          <div class="settings-controls" aria-hidden="true">
            <span class={`mini-switch${i % 2 === 0 ? ' is-on' : ''}`}><i class="mini-switch-thumb"></i></span>
            <span class="mini-stepper">
              <i class="mini-stepper-btn mini-stepper-minus"></i>
              <i class="mini-stepper-val">{i + 1}</i>
              <i class="mini-stepper-btn mini-stepper-plus"></i>
            </span>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="ask-row wrap">
  <Orbs orbs={[
    /* B1 fix round 2, item 1: was x26%/y50%, clear of the ask pane (0%
       coverage at 75% scroll). Moved onto its left edge. */
    { hue: 'cyan', x: '41%', y: '64%', mx: '10%', my: '10%', size: 'clamp(130px, 17vw, 250px)', drift: 3 },
    { hue: 'pink', x: '74%', y: '56%', mx: '90%', my: '90%', size: 'clamp(120px, 15vw, 220px)', drift: 1 },
  ]} />
  <div class="ask glass">
    <p class="pull">{copy.pull}</p>
    <a class="btn" href={hrefFor('contact', theme)}>{copy.cta} <span class="arw" aria-hidden="true">&rarr;</span></a>
  </div>
</section>

<style>
  section { position: relative; }

  .head { padding-block: clamp(3rem, 8vw, 6rem) clamp(2rem, 4vw, 3rem); }
  .head-card {
    display: grid; justify-items: start; gap: 1.25rem;
    width: min(100%, 900px);
    padding: clamp(1.5rem, 4.5vw, 3.75rem);
  }
  /* D8: weight/tracking come from the global h1,h2,h3 rule; this pre-D8
     override never got reconciled. */
  .head-card h1 {
    font-size: clamp(2.6rem, 7vw, 5.5rem);
    line-height: 0.95;
  }
  .sublines {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1rem 2rem;
    margin-top: 0.5rem;
  }
  .sublines p { color: var(--mark); font-size: 1.125rem; }

  .offers {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    align-items: start;
    padding-block: clamp(1rem, 3vw, 2rem);
  }
  .offer {
    display: grid; gap: 1rem;
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  /* The second card rides lower: floating panels, not a table. */
  .offer + .offer { margin-top: clamp(2rem, 6vw, 5rem); }
  .offer .app-icon { margin-bottom: 0.5rem; }
  .offer h2 { font-size: clamp(1.8rem, 3.4vw, 2.5rem); }
  .offer p { color: var(--mark); }

  .process { padding-block: clamp(3rem, 7vw, 5rem) clamp(1rem, 3vw, 2rem); }
  /* D8: weight/tracking come from the global h1,h2,h3 rule. */
  .process-head {
    position: relative; z-index: 1;
    display: inline-block;
    padding: clamp(0.5rem, 1.6vw, 0.9rem) clamp(1rem, 2.5vw, 1.75rem);
    border-radius: var(--r-lg);
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }
  /* B2 item 1: one settings-style grouped pane (surface-solid, the same
     recipe .process-head already uses) holding the four steps as hairline-
     divided rows, not four separate tiles. */
  .settings-pane {
    padding: 0;
    border-radius: var(--r-xl);
    overflow: hidden;
  }
  .settings-list { list-style: none; padding: 0; display: grid; }
  /* E5: the stagger (every other tile riding lower) had no visible reason
     once the steps are one grouped, evenly-baselined pane (E1); dropped so
     all four sit on one baseline, now as one pane's columns rather than
     four separate cards. */
  .settings-list {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .settings-row {
    display: grid; align-content: start; gap: 0.6rem;
    padding: clamp(1.1rem, 2.2vw, 1.6rem);
    border-left: 1px solid var(--line);
  }
  .settings-row:first-child { border-left: 0; }
  .settings-row .app-icon { width: 3rem; height: 3rem; font-size: 0.95rem; margin-bottom: 0.35rem; }
  .settings-text h3 { font-size: 1.45rem; }
  .settings-text p { font-size: 0.975rem; line-height: 1.6; color: var(--mark); }
  /* The decorative switch and stepper: aria-hidden, inert, sitting beside
     each step's own copy at the row's foot rather than crowding the icon. */
  .settings-controls {
    display: flex; align-items: center; justify-content: space-between; gap: 0.6rem;
    margin-top: 0.35rem;
  }
  .mini-switch {
    display: block;
    width: 34px; height: 20px; padding: 2px;
    border-radius: 999px;
    background: var(--well);
    box-shadow: inset 0 1px 2px rgb(20 10 60 / 0.1);
  }
  .mini-switch-thumb {
    display: block;
    width: 16px; height: 16px;
    border-radius: 50%;
    background: var(--field-raised);
    box-shadow: var(--shadow-sm);
    transition: transform 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .mini-switch.is-on { background: linear-gradient(145deg, var(--blob-cyan-hi), var(--blob-cyan)); }
  .mini-switch.is-on .mini-switch-thumb { transform: translateX(14px); }
  .mini-stepper {
    display: flex; align-items: center; gap: 0.45em;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-family: var(--font-label);
    font-size: 0.75rem; font-weight: 650;
    color: var(--mark-muted);
  }
  .mini-stepper-btn { position: relative; width: 0.7em; height: 0.7em; }
  .mini-stepper-btn::before, .mini-stepper-btn::after {
    content: ''; position: absolute; background: currentColor;
  }
  .mini-stepper-btn::before { inset-inline: 0; top: 50%; height: 1.5px; transform: translateY(-50%); }
  .mini-stepper-plus::after { inset-block: 0; left: 50%; width: 1.5px; transform: translateX(-50%); }

  /* E5: the negative margin was meant to ride the ask up over the last
     step's corner, but landed flush against the step row with an ~8px seam
     instead (a mistake, not a deliberate overlap). Given the full section
     gap now, so the ending reads as a clean break instead of a near-miss. */
  .ask-row {
    display: grid; justify-items: end;
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 7vw, 5rem);
  }
  .ask {
    display: grid; justify-items: center; gap: 1.6rem;
    width: min(100%, 680px);
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.25rem, 4vw, 3rem);
    text-align: center;
  }
  .pull {
    font-family: var(--font-head);
    font-size: clamp(1.7rem, 3.6vw, 2.6rem);
    font-weight: 780;
    letter-spacing: -0.04em;
    word-spacing: 0.07em;
    line-height: 1.08;
    text-wrap: balance;
  }

  @media (max-width: 860px) {
    .offers { grid-template-columns: 1fr; }
    .offer + .offer { margin-top: 0; }
  }
  /* Two columns: each row now needs a hairline above it too (the wrap
     creates a new "left edge" every other item that no longer sits against
     the pane's real left edge, and a new top row that needs its own top
     hairline instead of the row above it). */
  @media (max-width: 1000px) {
    .settings-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .settings-row:nth-child(2) { border-left: 0; }
    .settings-row:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 720px) {
    .ask-row { justify-items: center; margin-top: 0; }
  }
  /* One column: the pane is now a true iOS Settings list, one row per step,
     divided by top hairlines instead of side ones. */
  @media (max-width: 600px) {
    .settings-list { grid-template-columns: 1fr; }
    .settings-row { border-left: 0; }
    .settings-row + .settings-row { border-top: 1px solid var(--line); }
  }
</style>
