---
/** Glassmorphism home: a Big Sur window over three orbs, two app cards, a
    grouped list from the lab, and a last card that asks. */
import Orbs from '../Orbs.astro';
import { featuredSpecimens, specimenLink, type CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';

interface Props { copy: CopyData<'home'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, chrome, theme } = Astro.props;
const featured = (await featuredSpecimens()).map((entry) => ({ entry, link: specimenLink(entry, theme) }));
const [first, ...rest] = chrome.name.split(' ');
const icons = ['violet', 'cyan'];
---
<section class="hero wrap">
  <Orbs orbs={[
    { hue: 'violet', x: '22%', y: '34%', mx: '16%', my: '7%', size: 'clamp(230px, 34vw, 480px)', drift: 1 },
    { hue: 'cyan', x: '86%', y: '22%', mx: '94%', my: '16%', size: 'clamp(150px, 22vw, 330px)', drift: 2 },
    { hue: 'peach', x: '74%', y: '92%', mx: '80%', my: '96%', size: 'clamp(130px, 17vw, 250px)', drift: 3 },
    /* B1 fix round 2, item 1: was x6%/y90%, fully clear of the window (0%
       coverage, "useless" at scroll 0). Moved onto the window's own
       bottom-left corner so the pane frosts roughly half the disc. */
    { hue: 'pink', x: '17%', y: '80%', mx: '8%', my: '94%', size: 'clamp(70px, 9vw, 130px)', drift: 2 },
  ]} />
  <div class="window glass thin">
    {/* The lights and the switch share one bar, both real desktop-window
        chrome, so the switch reads as part of the window instead of a
        clip-art widget bolted to its corner. */}
    <div class="window-bar" aria-hidden="true">
      <span class="lights"><i></i><i></i><i></i></span>
      <span class="switch"><i></i></span>
    </div>
    <h1 class="billboard"><span class="b1">{first}</span> <span class="b2">{rest.join(' ')}</span></h1>
    <p class="lead">{copy.opener.lead}</p>
    <p class="sub">{copy.opener.subline}</p>
  </div>
  {/* The window's empty right third is the cyan orb's ground: a small glass
      pill of the studio's own location, not filler, floats over it. */}
  <div class="widget locale glass" aria-hidden="true">
    <span class="dot"></span>{chrome.location}
  </div>
  {/* Item 10: a static stand-in for B2's draggable lens, not the lens
      itself (no WebGL in B1). Fixed to the wallpaper plane, under the
      content (z-index -1, same plane as main::before, painted after it in
      DOM order so it sits above the wallpaper and below everything else),
      in the hero's empty right half, across the cyan orb's edge. */}
  <div class="lens-poster" aria-hidden="true"></div>
</section>

<section class="doors wrap">
  <Orbs orbs={[
    { hue: 'pink', x: '50%', y: '55%', mx: '90%', my: '50%', size: 'clamp(160px, 22vw, 320px)', drift: 3 },
    { hue: 'cyan', x: '38%', y: '94%', mx: '86%', my: '97%', size: 'clamp(110px, 14vw, 200px)', drift: 1 },
    /* B1 fix round 2, item 1: was x2%/y30%, clear of both door cards
       (0% coverage at 25% scroll). Nudged onto the left door's top-left
       corner. */
    { hue: 'violet', x: '7%', y: '42%', mx: '88%', my: '2%', size: 'clamp(90px, 11vw, 160px)', drift: 2 },
  ]} />
  <div class="doors-head">
    <h2 class="chip">{copy.doors.kicker}</h2>
    <a class="btn btn-glass more" href={hrefFor('services', theme)}>{copy.doors.more} <span class="arw" aria-hidden="true">&rarr;</span></a>
  </div>
  <div class="door-grid">
    {copy.doors.items.map((door, i) => (
      <article class="door glass">
        <span class={`app-icon ${icons[i % icons.length]}`} aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3>{door.title}</h3>
        <p>{door.body}</p>
      </article>
    ))}
  </div>
</section>

{featured.length > 0 && (
  <section class="lab wrap">
    <Orbs orbs={[
      { hue: 'violet', x: '92%', y: '16%', mx: '94%', my: '58%', size: 'clamp(150px, 20vw, 300px)', drift: 2 },
      { hue: 'peach', x: '12%', y: '86%', mx: '8%', my: '99%', size: 'clamp(120px, 15vw, 230px)', drift: 1 },
    ]} />
    <div class="lab-panel glass">
      <div class="lab-copy">
        <h2 class="chip">{copy.lab.kicker}</h2>
        <p class="pull">{copy.lab.pull}</p>
        <a class="btn" href={hrefFor('lab', theme)} data-astro-reload>{copy.lab.more} <span class="arw" aria-hidden="true">&rarr;</span></a>
      </div>
      <ul class="cells" role="list" data-parity-skip>
        {featured.map(({ entry, link }) => (
          <li class="cell">
            <a class="designation" href={link.href} data-astro-reload={link.leaves ? '' : undefined} aria-label={`${entry.data.designation}, ${entry.data.title}`}>{entry.data.designation}</a>
            <span class="summary">{entry.data.summary}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

{/* The closer sits off to one side with a large orb showing in the space
    beside it, rather than centred between two orbs like every other page's
    ending. */}
<section class="closer wrap">
  <Orbs orbs={[
    { hue: 'cyan', x: '76%', y: '46%', mx: '80%', my: '10%', size: 'clamp(220px, 30vw, 420px)', drift: 3 },
    { hue: 'violet', x: '94%', y: '88%', mx: '92%', my: '92%', size: 'clamp(120px, 16vw, 220px)', drift: 1 },
  ]} />
  <div class="ask glass">
    <p class="ask-lead">{copy.closer.lead}</p>
    <a class="btn" href={hrefFor('contact', theme)}>{copy.closer.cta} <span class="arw" aria-hidden="true">&rarr;</span></a>
  </div>
</section>

<style>
  section { position: relative; }

  /* ---- hero: the window ---- */
  .hero {
    display: grid; place-items: center;
    min-height: min(86vh, 860px);
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .window {
    width: min(100%, 880px);
    padding: clamp(1.5rem, 5vw, 4rem) clamp(1.25rem, 5vw, 4.25rem) clamp(2rem, 5vw, 4rem);
    border-radius: 40px;
  }
  .window-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: clamp(1.5rem, 4vw, 2.75rem); }
  .lights { display: flex; gap: 8px; }
  .lights i {
    width: 13px; height: 13px; border-radius: 50%;
    background: #ff5f57; box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.15);
  }
  .lights i:nth-child(2) { background: #febc2e; }
  .lights i:nth-child(3) { background: #28c840; }
  /* The switch now rides in the window bar, glass on glass at one depth
     instead of floating loose over the corner. */
  .switch {
    display: block;
    width: 60px; height: 34px; padding: 4px;
    border-radius: 999px;
    background: var(--well);
    box-shadow: inset 0 1px 2px rgb(20 10 60 / 0.1);
  }
  .switch i {
    display: block; width: 26px; height: 26px; margin-left: auto;
    border-radius: 50%;
    background: linear-gradient(145deg, var(--blob-cyan-hi), var(--blob-cyan));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.6), var(--shadow-sm);
  }
  /* D8: weight and tracking come from the global h1,h2,h3 rule (740,
     -0.022em); this used to pin its own 800/-0.048em, from before D8
     landed, and never got reconciled. */
  .billboard {
    font-size: clamp(3rem, 9.5vw, 7.25rem);
    line-height: 0.92;
  }
  .billboard span { display: block; }
  /* D4 = C, vibrancy: the one coloured text in the room, its colour drawn
     from the wallpaper behind the glass (--vibrant-a/-b), not a fixed
     brand gradient. */
  .b2 {
    padding-bottom: 0.06em;
    background: linear-gradient(100deg, var(--vibrant-a) 10%, var(--vibrant-b) 90%);
    -webkit-background-clip: text; background-clip: text;
    color: transparent;
  }
  .lead {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    font-family: var(--font-head);
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  /* E14: body copy on panes uses --mark, not --mark-muted (reserved for
     meta: location, fine print), and reads a size up from the base. */
  .sub {
    margin-top: 0.85rem;
    max-width: 52ch;
    color: var(--mark);
    font-size: clamp(1.125rem, 1.6vw, 1.2rem);
  }

  /* Item 10: the lens's future poster, a plain frosted disc (no WebGL in
     B1). position: fixed so it never scrolls with the page, matching where
     B2's real lens will sit; z-index -1 keeps it on the wallpaper's own
     plane, under every pane and orb. Hidden once the layout stacks
     (min-width matches where the locale pill also drops, .hero's empty
     half stops existing once the window is full width).
     Safari 17's literal blur sits in its own @supports block ahead of the
     rule, as theme.css does for every pane: beside the var() declaration
     the build's minifier drops it (PR #91 review). */
  @supports (-webkit-backdrop-filter: none) {
    .lens-poster { -webkit-backdrop-filter: blur(20px) saturate(2.1) brightness(1.12); }
  }
  .lens-poster {
    position: fixed;
    z-index: -1;
    right: clamp(4%, 9vw, 12%);
    /* Nudged down past the cyan orb's own placement (--y: 22% in the hero's
       Orbs list): at the old 16-26% top the disc sat directly behind it and
       read as a stray crescent rather than its own frosted shape. */
    top: clamp(34%, 40vh, 48%);
    width: clamp(160px, 19vw, 260px);
    aspect-ratio: 1;
    border-radius: 50%;
    pointer-events: none;
    background: var(--mat-thin);
    backdrop-filter: var(--blur-thin);
    border: 1px solid var(--edge-hi);
    box-shadow: inset 0 1px 0 var(--edge-hi), var(--shadow-sm);
  }
  @media (max-width: 1140px) {
    .lens-poster { display: none; }
  }

  .widget { position: absolute; z-index: 2; border-radius: 999px; }
  .locale {
    right: max(2%, calc(50% - 470px)); bottom: 14%;
    display: flex; align-items: center; gap: 0.6em;
    padding: 0.7em 1.2em;
    font-family: var(--font-label);
    font-size: 0.8125rem; font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--mark-muted);
    white-space: nowrap;
  }
  .locale .dot {
    width: 0.6em; height: 0.6em; border-radius: 50%;
    background: linear-gradient(135deg, var(--blob-cyan), var(--blob-violet) 55%, var(--blob-pink));
  }

  /* ---- doors: two app cards ---- */
  .doors { padding-block: clamp(2rem, 5vw, 4rem); }
  .doors-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .door-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    /* E5: at least 2 to 3rem between the two doors, not a thin seam. */
    gap: clamp(2rem, 3.5vw, 3rem);
    margin-top: 1.25rem;
  }
  .door {
    display: flex; flex-direction: column; gap: 0.9rem;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }
  .door .app-icon { margin-bottom: 0.6rem; }
  .door h3 { font-size: clamp(1.6rem, 3vw, 2.1rem); }
  .door p { color: var(--mark); max-width: 48ch; }

  /* ---- lab: a grouped list ---- */
  .lab { padding-block: clamp(2rem, 5vw, 4rem); }
  .lab-panel {
    display: grid; grid-template-columns: 1fr 1.1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3.5rem);
  }
  .lab-copy { display: grid; justify-items: start; gap: 1.25rem; }
  .pull {
    font-family: var(--font-head);
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    font-weight: 760;
    letter-spacing: -0.035em;
    word-spacing: 0.06em;
    line-height: 1.08;
    text-wrap: balance;
  }
  /* E7: no glass on glass. A hairline-divided list, not a second translucent
     well fill nested inside the lab panel's own blur. */
  .cells {
    list-style: none; padding: 0;
    border-radius: var(--r-lg);
    background: transparent;
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .cell { display: grid; gap: 0.2rem; padding: 1.05rem 1.35rem; }
  .cell + .cell { border-top: 1px solid var(--line); }
  /* E9: neutral text on glass. BDL designations use neutral secondary ink;
     colour lives in the orbs and the D4 headline, not in every label. */
  .designation {
    display: inline-flex; align-items: center; min-height: 44px;
    font-family: var(--font-label);
    font-size: 0.8125rem; font-weight: 650;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--mark-muted);
    justify-self: start;
    text-decoration: none;
    border-radius: 6px;
  }
  /* The designation links to its entry: a clean underline on hover and on
     focus, the theme's ring rounded to match the soft glass corners. */
  .designation:hover, .designation:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.25em;
  }
  .summary { font-size: 0.975rem; line-height: 1.5; }

  /* ---- closer: off to one side, the orb fills the space beside it ---- */
  .closer {
    display: grid;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(1rem, 3vw, 2rem);
  }
  /* E5: was a half-width card beside an empty half (the cyan orb showed
     through the gap but nothing else did). Widened to a full-width strip,
     so the same orb now sits mostly under the pane's own right edge
     instead of beside it. */
  .ask {
    display: grid; justify-items: start; gap: 1.6rem;
    width: 100%;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 6vw, 4.5rem);
    text-align: left;
  }
  .ask-lead {
    font-family: var(--font-head);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    word-spacing: 0.08em;
    line-height: 1;
  }

  /* The locale pill sits in the margin beside the window; below this width
     that margin is gone and it would cover the subline. */
  @media (max-width: 1140px) {
    .locale { display: none; }
  }
  @media (max-width: 860px) {
    .lab-panel { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .hero { min-height: 0; padding-block: 3.5rem 4.5rem; }
    .window { border-radius: 30px; }
    .switch { width: 48px; height: 28px; }
    .switch i { width: 20px; height: 20px; }
    .ask { justify-items: center; text-align: center; }
  }
</style>
