---
/** Glassmorphism home: a Big Sur window over three orbs, two app cards, a
    grouped list from the lab, and a last card that asks. */
import Orbs from '../Orbs.astro';
import { featuredSpecimens, specimenLink, type CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';

interface Props { copy: CopyData<'home'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, chrome, theme } = Astro.props;
const featured = (await featuredSpecimens()).map((entry) => ({ entry, link: specimenLink(entry, theme) }));
const [first, ...rest] = chrome.name.split(' ');
const icons = ['violet', 'cyan'];
---
<section class="hero wrap">
  <Orbs jsDriven orbs={[
    { hue: 'violet', x: '22%', y: '34%', mx: '16%', my: '7%', size: 'clamp(230px, 34vw, 480px)', drift: 1 },
    { hue: 'cyan', x: '86%', y: '22%', mx: '94%', my: '16%', size: 'clamp(150px, 22vw, 330px)', drift: 2 },
    { hue: 'peach', x: '74%', y: '92%', mx: '80%', my: '96%', size: 'clamp(130px, 17vw, 250px)', drift: 3 },
    /* B1 fix round 2, item 1: was x6%/y90%, fully clear of the window (0%
       coverage, "useless" at scroll 0). Moved onto the window's own
       bottom-left corner so the pane frosts roughly half the disc. */
    { hue: 'pink', x: '17%', y: '80%', mx: '8%', my: '94%', size: 'clamp(70px, 9vw, 130px)', drift: 2 },
  ]} />
  <div class="window glass thin">
    {/* The lights are decoration; the switch is now a real control (B2, item
        3): Clear/Tinted, holding for the whole session and reaching every
        pane and the lens, not only this window. */}
    <div class="window-bar">
      <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
      {/* B2 item 4: the button itself is the 44px+ hit target at every
          width; the visible pill track (its own size, unchanged) is a
          separate inner span so growing the tap area on phones never grows
          the track's look. */}
      <button type="button" class="switch" role="switch" aria-checked="false" aria-label="Tinted glass">
        <span class="switch-track" aria-hidden="true">
          <i class="switch-thumb"></i>
        </span>
      </button>
    </div>
    <h1 class="billboard"><span class="b1">{first}</span> <span class="b2">{rest.join(' ')}</span></h1>
    <p class="lead">{copy.opener.lead}</p>
    <p class="sub">{copy.opener.subline}</p>
  </div>
  {/* The Control Centre (B2 fix round, item 4): a macOS/iOS-style compact
      tile cluster in place of the old long pill, four rounded-square
      modules in one row (a 2x2 grid on phones). Clear/Tinted rides in the
      hero window bar (its own control, above) AND repeats here as its own
      tile, the way a real Control Centre repeats a menu-bar toggle -- the
      tile is a plain forwarding control (cc-tint-tile.ts) that clicks the
      real switch and mirrors its state back, so there is exactly one source
      of truth (session-hold.ts) and one place (home-boot.ts, lens/) that
      ever calls updateSettings for tint. Frost and time-of-day are the same
      live controls B2 already had, just re-homed into tiles; their class
      names (.cc-frost, .cc-seg) are unchanged, so home-boot.ts's existing
      queries keep working untouched (that file is lens/ territory, off
      limits to this seat). The fourth tile carries the location pill's own
      content: the standalone floating widget it replaces used to hide
      behind the portal switcher at 1440x900; a tile in normal flow cannot.
      Visible labels sit under aria-hidden spans and are named again as each
      control's aria-label (README's rule: a new visible word would fail
      copy parity with quiet; an aria-hidden one is exempt). Normal document
      flow, not fixed: the portal's switcher already owns the fixed bottom
      edge (phone: the whole width; desktop: the bottom-right corner), and
      this stays out of both. */}
  <div class="control-centre glass" data-control-centre>
    {/* Studio (location) goes first, not last: the desktop portal switcher
        anchors to the viewport's bottom-right corner (README/PortalLayout),
        and the cluster itself is centred, so its LAST tile is the one whose
        corner can coincide with the switcher's at the page's initial,
        unscrolled position. This tile is the one item 4 requires to stay
        visible (the pill it replaces hid behind the switcher for the same
        geometric reason), so it takes the leftmost slot instead. */}
    <div class="cc-tile cc-tile-locale" aria-hidden="true">
      <span class="cc-tile-label" aria-hidden="true">Studio</span>
      <span class="cc-locale-value"><span class="dot"></span>{chrome.location}</span>
    </div>
    <div class="cc-tile cc-tile-tint">
      <span class="cc-tile-label" aria-hidden="true">Glass</span>
      {/* cc-switch, not switch: `.hero .switch` is a live selector in the
          B2 critic/verify scripts (b2-glass-critic-probe.mjs and others),
          written when there was only one .switch under .hero. Reusing that
          exact class name on this second control would make every such
          selector match two elements and throw under Playwright's
          strict-mode click. cc-switch gets the identical CSS (theme.css's
          :is(.switch, .cc-switch) rules) without that collision. */}
      <button type="button" class="cc-switch cc-tint-switch" role="switch" aria-checked="false" aria-label="Tinted glass">
        <span class="switch-track" aria-hidden="true">
          <i class="switch-thumb"></i>
        </span>
      </button>
    </div>
    <div class="cc-tile cc-tile-frost">
      <span class="cc-tile-label" aria-hidden="true">Frost</span>
      <input type="range" class="cc-frost" min="0" max="100" step="1" value="50" aria-label="Frost amount" />
    </div>
    <div class="cc-tile cc-tile-tod" role="radiogroup" aria-label="Time of day">
      <span class="cc-tile-label" aria-hidden="true">Time</span>
      <div class="cc-seg-row">
        <button type="button" class="cc-seg" data-tod="dawn" role="radio" aria-checked="false" aria-label="Dawn">
          <span aria-hidden="true">Dawn</span>
        </button>
        <button type="button" class="cc-seg" data-tod="day" role="radio" aria-checked="true" aria-label="Day">
          <span aria-hidden="true">Day</span>
        </button>
        <button type="button" class="cc-seg" data-tod="dusk" role="radio" aria-checked="false" aria-label="Dusk">
          <span aria-hidden="true">Dusk</span>
        </button>
      </div>
    </div>
  </div>
  {/* The lens's poster (plain CSS, no script dependency): visible until the
      real lens's first WebGL frame, again on context loss, and permanently
      when WebGL is unavailable, with reduced transparency, or in the
      portal's drawn-ahead copy (which strips every script, so lens.ts never
      runs there at all). .lens-host is where lens.ts appends the canvas, the
      hit control and the shadows once it mounts; empty and inert without
      JS. Both sit on the wallpaper plane, above the orbs and under the
      content (z-index -1). The poster's CSS spot and size are the lens's
      own start (fix round 3; see the .lens-poster rule below). */}
  <div class="lens-poster" aria-hidden="true"></div>
  {/* Not aria-hidden: lens.ts mounts a real, focusable, aria-labelled
      button inside this container (the README forbids focusable content
      under aria-hidden). The container itself draws nothing on its own. */}
  <div class="lens-host" id="glass-lens-host"></div>
</section>

<section class="doors wrap">
  <Orbs jsDriven orbs={[
    { hue: 'pink', x: '50%', y: '55%', mx: '90%', my: '50%', size: 'clamp(160px, 22vw, 320px)', drift: 3 },
    { hue: 'cyan', x: '38%', y: '94%', mx: '86%', my: '97%', size: 'clamp(110px, 14vw, 200px)', drift: 1 },
    /* B1 fix round 2, item 1: was x2%/y30%, clear of both door cards
       (0% coverage at 25% scroll). Nudged onto the left door's top-left
       corner. */
    { hue: 'violet', x: '7%', y: '42%', mx: '88%', my: '2%', size: 'clamp(90px, 11vw, 160px)', drift: 2 },
  ]} />
  <div class="doors-head">
    <h2 class="chip">{copy.doors.kicker}</h2>
    <a class="btn btn-glass more" href={hrefFor('services', theme)}>{copy.doors.more} <span class="arw" aria-hidden="true">&rarr;</span></a>
  </div>
  <div class="door-grid">
    {copy.doors.items.map((door, i) => (
      <article class="door glass">
        <span class={`app-icon ${icons[i % icons.length]}`} aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3>{door.title}</h3>
        <p>{door.body}</p>
      </article>
    ))}
  </div>
</section>

{featured.length > 0 && (
  <section class="lab wrap">
    <Orbs jsDriven orbs={[
      { hue: 'violet', x: '92%', y: '16%', mx: '94%', my: '58%', size: 'clamp(150px, 20vw, 300px)', drift: 2 },
      { hue: 'peach', x: '12%', y: '86%', mx: '8%', my: '99%', size: 'clamp(120px, 15vw, 230px)', drift: 1 },
    ]} />
    <div class="lab-panel glass">
      <div class="lab-copy">
        <h2 class="chip">{copy.lab.kicker}</h2>
        <p class="pull">{copy.lab.pull}</p>
        <a class="btn" href={hrefFor('lab', theme)} data-astro-reload>{copy.lab.more} <span class="arw" aria-hidden="true">&rarr;</span></a>
      </div>
      <ul class="cells" role="list" data-parity-skip>
        {featured.map(({ entry, link }) => (
          <li class="cell">
            <a class="designation" href={link.href} data-astro-reload={link.leaves ? '' : undefined} aria-label={`${entry.data.designation}, ${entry.data.title}`}>{entry.data.designation}</a>
            <span class="summary">{entry.data.summary}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

{/* The closer sits off to one side with a large orb showing in the space
    beside it, rather than centred between two orbs like every other page's
    ending. */}
<section class="closer wrap">
  <Orbs jsDriven orbs={[
    { hue: 'cyan', x: '76%', y: '46%', mx: '80%', my: '10%', size: 'clamp(220px, 30vw, 420px)', drift: 3 },
    { hue: 'violet', x: '94%', y: '88%', mx: '92%', my: '92%', size: 'clamp(120px, 16vw, 220px)', drift: 1 },
  ]} />
  <div class="ask glass">
    <p class="ask-lead">{copy.closer.lead}</p>
    <a class="btn" href={hrefFor('contact', theme)}>{copy.closer.cta} <span class="arw" aria-hidden="true">&rarr;</span></a>
  </div>
</section>

<script>
  import { onMount } from '../../../lib/lifecycle';
  import { mountHomeGlass } from '../lens/home-boot';
  import { mountCcTintTile } from '../cc-tint-tile';

  onMount(mountHomeGlass);
  onMount(mountCcTintTile);
</script>

<style>
  /* Glass fix round 3 (the re-critic's grab blocker): the lens and its hit
     button sit at z-index -1, under the page's content, and a section box
     is transparent but still takes the pointer above them, so a drag on the
     visible lens used to select the headline and a phone could not grab it
     at all. Section boxes pass the pointer through; the panes, chips and
     buttons in them take it back, so text, links and controls still win
     wherever they cover the lens (theme.css's .lens-hit turns its own back
     on). */
  section { position: relative; pointer-events: none; }
  section :is(.glass, .chip, .btn) { pointer-events: auto; }

  /* ---- hero: the window ---- */
  .hero {
    display: grid; place-items: center;
    min-height: min(86vh, 860px);
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .window {
    width: min(100%, 880px);
    padding: clamp(1.5rem, 5vw, 4rem) clamp(1.25rem, 5vw, 4.25rem) clamp(2rem, 5vw, 4rem);
    border-radius: 40px;
  }
  .window-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: clamp(1.5rem, 4vw, 2.75rem); }
  .lights { display: flex; gap: 8px; }
  .lights i {
    width: 13px; height: 13px; border-radius: 50%;
    background: #ff5f57; box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.15);
  }
  .lights i:nth-child(2) { background: #febc2e; }
  .lights i:nth-child(3) { background: #28c840; }
  /* The switch now rides in the window bar, glass on glass at one depth
     instead of floating loose over the corner. B2 item 4: the button
     (.switch) is the real hit target and stays unsized here (it takes the
     track's own size by default); .switch-track carries the track's look,
     so a phone-width min-height on the button alone cannot stretch it.
     .cc-switch (the Control Centre's own Clear/Tinted tile, cc-tint-tile.ts)
     shares this and every other .switch rule below by class list, never by
     class name reuse -- see the tile's own markup comment for why. */
  :is(.switch, .cc-switch) {
    display: flex; align-items: center; justify-content: center;
  }
  .switch-track {
    display: block;
    width: 60px; height: 34px; padding: 4px;
    border-radius: 999px;
    background: var(--well);
    box-shadow: inset 0 1px 2px rgb(20 10 60 / 0.1);
  }
  :is(.switch, .cc-switch) i {
    /* B2: no longer margin-left: auto (a fixed right anchor). The thumb now
       rests at the track's left end by default and theme.css's
       .switch[aria-checked='true'] rule slides it to the right, so Clear and
       Tinted read as two different, opposite positions instead of both
       looking like the same right-parked dot. */
    display: block; width: 26px; height: 26px;
    border-radius: 50%;
    background: linear-gradient(145deg, var(--blob-cyan-hi), var(--blob-cyan));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.6), var(--shadow-sm);
  }
  /* D8: weight and tracking come from the global h1,h2,h3 rule (740,
     -0.022em); this used to pin its own 800/-0.048em, from before D8
     landed, and never got reconciled. */
  .billboard {
    font-size: clamp(3rem, 9.5vw, 7.25rem);
    line-height: 0.92;
  }
  .billboard span { display: block; }
  /* D4 = C, vibrancy: the one coloured text in the room, its colour drawn
     from the wallpaper behind the glass (--vibrant-a/-b), not a fixed
     brand gradient. */
  .b2 {
    padding-bottom: 0.06em;
    background: linear-gradient(100deg, var(--vibrant-a) 10%, var(--vibrant-b) 90%);
    -webkit-background-clip: text; background-clip: text;
    color: transparent;
  }
  .lead {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    font-family: var(--font-head);
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  /* E14: body copy on panes uses --mark, not --mark-muted (reserved for
     meta: location, fine print), and reads a size up from the base. */
  .sub {
    margin-top: 0.85rem;
    max-width: 52ch;
    color: var(--mark);
    font-size: clamp(1.125rem, 1.6vw, 1.2rem);
  }

  /* Item 10: the lens's future poster, a plain frosted disc (no WebGL in
     B1). position: fixed so it never scrolls with the page, matching where
     B2's real lens will sit; z-index -1 keeps it on the wallpaper's own
     plane, under every pane and orb. Hidden once the layout stacks
     (min-width matches where the locale pill also drops, .hero's empty
     half stops existing once the window is full width).
     Safari 17's literal blur sits in its own @supports block ahead of the
     rule, as theme.css does for every pane: beside the var() declaration
     the build's minifier drops it (PR #91 review). */
  @supports (-webkit-backdrop-filter: none) {
    .lens-poster { -webkit-backdrop-filter: blur(20px) saturate(2.1) brightness(1.12); }
  }
  /* Glass fix round 3 (the re-critic's arrival jump): this spot and width
     ARE the lens's start and size now, not a rough stand-in. lens.ts reads
     the poster's rect (planLensStart) and keeps it whenever it is open
     wallpaper, or the least-covered spot when none is open; only otherwise
     does it move the poster and the lens together, once, at mount. So these
     values are tuned per size: 1280px and up, the left gutter beside the
     hero window, across the violet orb's edge (x is the gutter's middle,
     never less than the lens's wall stop, 105px); 721 to 1279px landscape,
     the least-covered corner under the header at the lens's smaller size
     (no open spot exists at 1024 x 768); portrait tablets, open wallpaper
     right of the Control Centre; phones, the gap reserved under the window
     (the hero rule below), just above the portal switcher. */
  .lens-poster {
    position: fixed;
    z-index: -1;
    left: calc(max(105px, (100% - 880px) / 4) - 92px);
    top: calc(46vh - 92px);
    width: 184px;
    aspect-ratio: 1;
    border-radius: 50%;
    pointer-events: none;
    background: var(--mat-thin);
    backdrop-filter: var(--blur-thin);
    border: 1px solid var(--edge-hi);
    box-shadow: inset 0 1px 0 var(--edge-hi), var(--shadow-sm);
  }
  /* 64 + 11.4 = the smaller lens's wall stop; 162 = the header's bottom
     (86) + 8 + 64 + 4, the lens's top stop. */
  @media (max-width: 1279px) {
    .lens-poster { width: 128px; left: 12px; top: 98px; }
  }
  /* Round 4 (G2): portrait tablets start half under the window's lower-left
     corner, across the pink orb (lens.ts cornerStart; home-boot.ts moves the
     poster onto the real corner at mount). This is the stand-in, tuned to
     820 x 1180. */
  @media (min-width: 721px) and (max-width: 1279px) and (orientation: portrait) {
    .lens-poster { left: calc(4vw + 32px); top: calc(51% - 64px); }
  }
  /* Round 4 (G2): phones start the lens half under the hero window's lower
     right corner, where B1's orbs cluster. The window's bottom depends on
     how its copy wraps, so home-boot.ts places the poster on the real
     corner at mount (planLensStart); this CSS spot is only the no-script
     and drawn-ahead stand-in, tuned to 390 x 844 (the window's bottom at
     about 60svh, its right edge 16px in). */
  @media (max-width: 720px) {
    .lens-poster { left: calc(100% - 144px); top: calc(60svh - 64px); bottom: auto; }
  }

  /* B2 fix round, item 4: the floating .widget.locale pill (absolute,
     right-anchored beside the window) is retired -- it hid behind the
     portal switcher at 1440x900 (the orchestrator's own finding), and its
     content now lives in the Control Centre's own location tile below, in
     normal document flow where nothing else can sit on top of it. .dot's
     recipe is reused there under .cc-locale-value. */

  /* ---- the Control Centre: a compact tile cluster (B2 fix round, item 4)
     ---- */
  .cc-seg-row { display: flex; gap: 2px; padding: 4px; border-radius: 999px; border: 1px solid var(--line); }
  .cc-locale-value {
    display: flex; align-items: center; gap: 0.5em;
    font-family: var(--font-label);
    font-size: 0.75rem; font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--mark-muted);
    white-space: nowrap;
  }
  .cc-locale-value .dot {
    width: 0.6em; height: 0.6em; border-radius: 50%; flex: none;
    background: linear-gradient(135deg, var(--blob-cyan), var(--blob-violet) 55%, var(--blob-pink));
  }

  /* ---- doors: two app cards ---- */
  .doors { padding-block: clamp(2rem, 5vw, 4rem); }
  .doors-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .door-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    /* E5: at least 2 to 3rem between the two doors, not a thin seam. */
    gap: clamp(2rem, 3.5vw, 3rem);
    margin-top: 1.25rem;
  }
  .door {
    display: flex; flex-direction: column; gap: 0.9rem;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }
  .door .app-icon { margin-bottom: 0.6rem; }
  .door h3 { font-size: clamp(1.6rem, 3vw, 2.1rem); }
  .door p { color: var(--mark); max-width: 48ch; }

  /* ---- lab: a grouped list ---- */
  .lab { padding-block: clamp(2rem, 5vw, 4rem); }
  .lab-panel {
    display: grid; grid-template-columns: 1fr 1.1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3.5rem);
  }
  .lab-copy { display: grid; justify-items: start; gap: 1.25rem; }
  .pull {
    font-family: var(--font-head);
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    font-weight: 760;
    letter-spacing: -0.035em;
    word-spacing: 0.06em;
    line-height: 1.08;
    text-wrap: balance;
  }
  /* E7: no glass on glass. A hairline-divided list, not a second translucent
     well fill nested inside the lab panel's own blur. */
  .cells {
    list-style: none; padding: 0;
    border-radius: var(--r-lg);
    background: transparent;
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .cell { display: grid; gap: 0.2rem; padding: 1.05rem 1.35rem; }
  .cell + .cell { border-top: 1px solid var(--line); }
  /* E9: neutral text on glass. BDL designations use neutral secondary ink;
     colour lives in the orbs and the D4 headline, not in every label. */
  .designation {
    display: inline-flex; align-items: center; min-height: 44px;
    font-family: var(--font-label);
    font-size: 0.8125rem; font-weight: 650;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--mark-muted);
    justify-self: start;
    text-decoration: none;
    border-radius: 6px;
  }
  /* The designation links to its entry: a clean underline on hover and on
     focus, the theme's ring rounded to match the soft glass corners. */
  .designation:hover, .designation:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.25em;
  }
  .summary { font-size: 0.975rem; line-height: 1.5; }

  /* ---- closer: off to one side, the orb fills the space beside it ---- */
  .closer {
    display: grid;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(1rem, 3vw, 2rem);
  }
  /* E5: was a half-width card beside an empty half (the cyan orb showed
     through the gap but nothing else did). Widened to a full-width strip,
     so the same orb now sits mostly under the pane's own right edge
     instead of beside it. */
  .ask {
    display: grid; justify-items: start; gap: 1.6rem;
    width: 100%;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 6vw, 4.5rem);
    text-align: left;
  }
  .ask-lead {
    font-family: var(--font-head);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    word-spacing: 0.08em;
    line-height: 1;
  }

  @media (max-width: 860px) {
    .lab-panel { grid-template-columns: 1fr; }
  }
  /* Tablet widths: the window runs almost edge to edge while the portal
     switcher keeps its desktop width (about 290px left of it at 820), so
     the time segments stack and the location wraps, keeping the 2 x 2
     cluster near 235px wide (glass fix round 3). */
  /* Round 4 (G2): portrait tablets start the lens half under the window's
     lower corner too (lens.ts CORNER_START_MQ), so the Control Centre drops
     far enough under the window (5rem) to clear the disc's visible lower
     half; at the default 2rem it sat on the lower-left corner, where the
     pink orb is. The hero's bottom padding gives back exactly what the
     margin adds, so the hero keeps its height and its orbs (placed in % of
     the hero) stay where they were. */
  @media (min-width: 721px) and (max-width: 1279px) and (orientation: portrait) {
    .control-centre { margin-top: 5rem; }
    .hero { padding-bottom: max(0.5rem, calc(clamp(3rem, 8vw, 6rem) - 5rem + clamp(1.25rem, 3vw, 2rem))); }
  }
  @media (min-width: 721px) and (max-width: 943px) {
