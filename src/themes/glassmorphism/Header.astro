---
/** Glassmorphism header: a floating glass bar that stays with the reader,
    the nav drawn as a segmented control whose raised thumb marks the current
    page. */
import { hrefFor, isCurrent } from '../paths';
import type { CopyData } from '../../lib/copy';

interface Props { chrome: CopyData<'chrome'>; theme: string }
const { chrome, theme } = Astro.props;
const [first, ...rest] = chrome.wordmark;
---
<header class="site-header">
  <a class="skip" href="#main">{chrome.skip}</a>
  <div class="bar glass glass-strong">
    <a class="wordmark" href={hrefFor('home', theme)} transition:name="wordmark">
      <span class="wm-orb" aria-hidden="true"></span>
      <span class="wm-a">{first}</span>{rest.map((part) => <> <span class="wm-b">{part}</span></>)}
    </a>
    <nav class="seg" aria-label="Main">
      {chrome.nav.map(({ to, label }) => (
        <a
          href={hrefFor(to, theme)}
          aria-current={isCurrent(to, Astro.url.pathname) ? 'page' : undefined}
          data-astro-reload={to === 'lab' ? '' : undefined}
        >{label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 14px; z-index: 20;
    width: min(1180px, 100% - 2 * var(--gutter));
    margin: 14px auto 0;
  }
  .bar {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 8px 8px 8px 18px;
    border-radius: 999px;
  }
  /* E16: a cheap adaptive shadow (Liquid Glass's own), deepening once the
     reader has scrolled content beneath the bar. A drop-shadow filter, not
     an animated box-shadow: .bar's box-shadow already comes from .glass/
     .glass-strong (theme.css) and differs between schemes (dark layers in
     extra inset edge light), so animating box-shadow directly here would
     replace that scheme-aware value for the whole scroll range (fill-mode
     both holds the keyframe's own from/to outside 0-80px too) instead of
     adding to it. filter is untouched by .bar otherwise, so this only adds
     depth, never overrides the pane's own shadow. Guarded by @supports; S1
     dropped the reduced-motion requirement for the portal. */
  @supports (animation-timeline: scroll(root)) {
    .bar {
      animation: glass-header-shadow linear both;
      animation-timeline: scroll(root);
      animation-range: 0 80px;
    }
    @keyframes glass-header-shadow {
      from { filter: drop-shadow(0 0 0 transparent); }
      to { filter: drop-shadow(0 18px 26px rgb(20 10 40 / 0.28)); }
    }
  }
  .wordmark {
    display: inline-flex; align-items: center; gap: 0.3em;
    min-height: 44px;
    font-family: var(--font-head);
    font-size: 1.125rem;
    letter-spacing: -0.025em;
    color: var(--mark);
    text-decoration: none;
    white-space: nowrap;
  }
  .wm-a { font-weight: 800; }
  .wm-b { font-weight: 500; color: var(--mark-muted); }
  .wm-orb {
    width: 1.35em; height: 1.35em; margin-right: 0.3em;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 28%, rgb(255 255 255 / 0.85), transparent 42%),
      conic-gradient(from 200deg, var(--blob-cyan), var(--blob-violet), var(--blob-pink), var(--blob-peach), var(--blob-cyan));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.4), var(--shadow-sm);
  }

  /* E7: no glass on glass. The track used to be its own translucent well
     nested inside the bar's blur, a second frosted layer stacked on the
     first; it is now a hairline-outlined track with no fill of its own. The
     thumb (below) stays the one solid element that lifts out of it. */
  .seg {
    display: flex; gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: transparent;
    border: 1px solid var(--line);
  }
  .seg a {
    display: flex; align-items: center; justify-content: center;
    min-height: 44px;
    padding: 0.5rem 1.05rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 550;
    color: var(--mark-muted);
    text-decoration: none;
    transition: color 160ms ease, background-color 160ms ease;
  }
  .seg a:hover { color: var(--mark); }
  .seg a[aria-current='page'] {
    color: var(--mark);
    background: var(--thumb);
    box-shadow: inset 0 1px 0 var(--edge-hi), 0 4px 12px -4px rgb(40 20 110 / 0.28);
  }

  @media (max-width: 720px) {
    /* Phone: still a floating glass bar, compact, one row. E13: "Birch"
       (wm-a) stays visible beside the orb, so the wordmark has letters to
       land on (Motion 3: the old squash-into-the-orb read as a defect, not
       a morph). "Design Lab" (wm-b) is the part that stops competing with
       the segments for width, kept accessible with the offscreen technique
       (not display:none, which would drop it from the accessible name). */
    .site-header { top: 8px; margin-top: 8px; }
    .bar { padding: 6px 6px 6px 14px; }
    .wordmark { font-size: 1rem; gap: 0.22em; }
    .wm-orb { width: 1.2em; height: 1.2em; margin-right: 0.22em; }
    .wm-b {
      position: absolute; width: 1px; height: 1px;
      overflow: hidden; clip-path: inset(50%); white-space: nowrap;
    }
    .seg { gap: 1px; padding: 3px; }
    .seg a { min-width: 44px; padding-inline: 0.55rem; font-size: 0.875rem; }
  }
  @media (max-width: 400px) {
    /* The tightest width the guard checks (390px): one more notch off the
       segment padding and type, never the wordmark or the 44px targets. */
    .wordmark { font-size: 0.9375rem; }
    .seg a { padding-inline: 0.4rem; font-size: 0.8125rem; }
  }
</style>
