---
/** Glassmorphism footer: a slim thick-glass dock that bookends the header
    bar (E6). One row on desktop (identity, pills, fine print together, not
    stacked into a second band); 2x2 pills on phones. No orbs of its own: the
    fixed wallpaper (E3) already gives it colour to frost, and E2 named the
    footer's corner orbs as gutter colour that frosts nothing. */
import { hrefFor } from '../paths';
import type { CopyData } from '../../lib/copy';

interface Props { chrome: CopyData<'chrome'>; theme: string }
const { chrome, theme } = Astro.props;
const year = new Date().getFullYear();
const leaves = (to: string) => (to === 'lab' || to === 'privacy' ? '' : undefined);
---
<footer class="site-footer">
  <div class="card glass thick wrap">
    <div class="ident">
      <p class="name">{chrome.name}</p>
      <p class="loc">{chrome.location}</p>
    </div>
    <nav class="pills" aria-label="Footer">
      {chrome.nav.map(({ to, label }) => (
        <a href={hrefFor(to, theme)} data-astro-reload={leaves(to)}>{label}</a>
      ))}
    </nav>
    <p class="fine">&copy; {year} {chrome.name} <span aria-hidden="true">&middot;</span> <a href={hrefFor('privacy', theme)} data-astro-reload={leaves('privacy')}>{chrome.privacy}</a></p>
  </div>
</footer>

<script>
  import { onMount } from '../../lib/lifecycle';
  import { mountOrbs, mountPanes } from './fx';
  import { mountReveal } from './reveal';
  import { registerBeforeSwap, applySettingsNow } from './lens/session-hold';

  /* mountOrbs pauses every .orbs group's animation off-screen: this is the
     one place on every page that mounts it (Footer renders everywhere), so
     it still has to run even though the footer itself carries no orbs of
     its own now. mountPanes is the Liquid pane recipe (item 8): the SVG
     bevel behind the Blink gate, and the adaptive tint, for every .glass
     pane on the page, footer's own thick dock included. */
  onMount(mountOrbs);
  onMount(mountPanes);
  /* E12: one mount point for every page (Footer ships everywhere), same as
     mountOrbs/mountPanes above. */
  onMount(mountReveal);

  /* The Control Centre's session hold (settings.ts): registerBeforeSwap runs
     once, at module scope, and keeps working across every later navigation
     for the rest of the session, glass or not; applySettingsNow is the
     per-body safety net behind it and behind the route's inline head script
     (hard load). Footer ships on all five pages, so every glass page gets
     both, not only Home, where the Control Centre's own controls live. */
  registerBeforeSwap();
  onMount(applySettingsNow);
</script>

<style>
  .site-footer {
    position: relative;
    overflow-x: clip;
    padding-block: clamp(2rem, 4vw, 3rem) 1.5rem;
  }
  /* One row: identity, pills and fine print share a single thick-glass
     strip, the same slim dock language as the header bar, instead of a
     tall card with an empty band before a second row of fine print. */
  .card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.25rem 1.75rem;
    align-items: center;
    padding: clamp(0.85rem, 2vw, 1.15rem) clamp(1.1rem, 2.5vw, 1.75rem);
    border-radius: 999px;
  }
  .ident { display: flex; align-items: baseline; gap: 0.6em; white-space: nowrap; }
  .name {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
  }
  .loc {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    color: var(--mark-muted);
  }
  .pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem; }
  /* E7: no glass on glass. A solid tinted pill inside the dock's own glass,
     not a second translucent well nested in the first. */
  .pills a {
    display: flex; align-items: center; justify-content: center;
    min-height: 44px;
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    background: var(--surface-solid);
    border: 1px solid var(--line);
    color: var(--mark);
    font-size: 0.875rem;
    font-weight: 550;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 160ms ease, transform 83ms linear;
  }
  /* E11: hover only under a real pointer; a tap on touch never leaves this
     state stuck after navigation. */
  @media (hover: hover) and (pointer: fine) {
    .pills a:hover { background: var(--field); }
  }
  .pills a:active {
    background: var(--thumb);
    transform: scale(0.97);
    transition: background-color 83ms linear, transform 83ms linear;
  }
  .fine {
    justify-self: end;
    white-space: nowrap;
    font-size: 0.8125rem;
    color: var(--mark-muted);
  }
  /* Inline in the fine-print sentence, but still a real 44px tap target
     (house rule, phone width): sized with inline-flex rather than line-
     height, so the surrounding "&copy; year Name &middot;" text does not
     also grow. */
  .fine a {
    display: inline-flex; align-items: center; min-height: 44px;
    color: var(--mark-muted);
    -webkit-tap-highlight-color: transparent;
  }
  @media (hover: hover) and (pointer: fine) {
    .fine a:hover { color: var(--mark); }
  }
  .fine a:active { color: var(--mark); }

  @media (max-width: 860px) {
    .card { grid-template-columns: 1fr; border-radius: var(--r-xl); justify-items: center; text-align: center; }
    .pills { display: grid; grid-template-columns: 1fr 1fr; width: 100%; }
    .pills a { text-align: center; }
    .fine { justify-self: center; white-space: normal; }
  }
</style>
