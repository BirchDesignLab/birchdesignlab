---
/** The grid key: a small square key at the foot of the sheet. Held (pointer,
    touch, or Space or Enter on focus), it lays the column guides over the
    page, 12 on a desktop, 6 on a tablet, 4 on a phone; released, they go.
    The resting page stays undrawn. A real button with an aria-label and no
    visible text, so the page's words are unchanged. */
---
<button class="grid-key" type="button" aria-label="Show the column grid while held" data-sw-grid-key></button>
<div class="guides" aria-hidden="true" data-sw-guides hidden>
  {Array.from({ length: 12 }, () => <span />)}
</div>

<script>
  import { onMount } from '../../lib/lifecycle';

  onMount(() => {
    const key = document.querySelector<HTMLButtonElement>('[data-sw-grid-key]');
    const guides = document.querySelector<HTMLElement>('[data-sw-guides]');
    if (!key || !guides) return;
    const show = () => { guides.hidden = false; key.dataset.held = ''; };
    const hide = () => { guides.hidden = true; delete key.dataset.held; };
    const down = (e: PointerEvent) => {
      if (e.button !== 0) return;
      try { key.setPointerCapture(e.pointerId); } catch { /* not capturable */ }
      show();
    };
    const keydown = (e: KeyboardEvent) => {
      if (e.key !== ' ' && e.key !== 'Enter') return;
      e.preventDefault();
      show();
    };
    const keyup = (e: KeyboardEvent) => {
      if (e.key !== ' ' && e.key !== 'Enter') return;
      e.preventDefault();
      hide();
    };
    const noMenu = (e: Event) => e.preventDefault();
    key.addEventListener('pointerdown', down);
    key.addEventListener('pointerup', hide);
    key.addEventListener('pointercancel', hide);
    key.addEventListener('lostpointercapture', hide);
    key.addEventListener('keydown', keydown);
    key.addEventListener('keyup', keyup);
    key.addEventListener('blur', hide);
    key.addEventListener('contextmenu', noMenu);
    return () => {
      hide();
      key.removeEventListener('pointerdown', down);
      key.removeEventListener('pointerup', hide);
      key.removeEventListener('pointercancel', hide);
      key.removeEventListener('lostpointercapture', hide);
      key.removeEventListener('keydown', keydown);
      key.removeEventListener('keyup', keyup);
      key.removeEventListener('blur', hide);
      key.removeEventListener('contextmenu', noMenu);
    };
  });
</script>

<style>
  /* The key: a 44px square on the frame's left margin line, bottom left, in
     the strip the portal keeps free below the footer (the switcher is at the
     bottom centre or right). Its face is three ink columns; held, it is an
     ink block with paper columns (the school's inversion). */
  .grid-key {
    position: fixed;
    z-index: 6;
    left: var(--margin);
    bottom: max(16px, env(safe-area-inset-bottom));
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--mark);
    border-radius: 0;
    background: var(--field);
    cursor: pointer;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  .grid-key::before {
    content: '';
    position: absolute;
    inset: 10px;
    background: repeating-linear-gradient(90deg, var(--mark) 0 4px, transparent 4px 7px);
    width: 18px;
    height: 22px;
  }
  .grid-key[data-held] { background: var(--mark); }
  .grid-key[data-held]::before {
    background: repeating-linear-gradient(90deg, var(--field) 0 4px, transparent 4px 7px);
  }

  /* The guides: the same columns every band hangs from (--cols, --gutter and
     --frame are the school's own), as white bars blended by difference so
     they read on paper, on black and on red alike. */
  .guides {
    position: fixed;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gutter);
    width: var(--frame);
    margin-inline: auto;
    mix-blend-mode: difference;
  }
  .guides[hidden] { display: none; }
  .guides span { background: rgb(255 255 255 / 0.14); }
  @media (max-width: 1023.98px) { .guides span:nth-child(n + 7) { display: none; } }
  @media (max-width: 639.98px) { .guides span:nth-child(n + 5) { display: none; } }
</style>
