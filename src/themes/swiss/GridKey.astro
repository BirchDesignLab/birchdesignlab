---
/** The grid key: a one-line square key in the header, on the wordmark's line.
    Held (pointer, touch, Space or Enter on focus, or G held anywhere on a
    keyboard), it lays the page's programme over the sheet the way a layout
    is drawn: a hairline at each edge of every column (12 on a desktop, 6 on
    a tablet, 4 on a phone) and a faint line on every 24px line of the
    rhythm. Released, it all goes; the resting page stays undrawn. A real
    button with an aria-label and no visible text, so the page's words are
    unchanged (founder, 10-03-26: in the header, hold G, hairlines and
    baselines). */
---
<button class="grid-key" type="button" aria-label="Show the column grid while held" data-sw-grid-key></button>
<div class="guides" aria-hidden="true" data-sw-guides hidden>
  {Array.from({ length: 12 }, () => <span />)}
</div>

<script>
  import { onMount } from '../../lib/lifecycle';

  onMount(() => {
    const key = document.querySelector<HTMLButtonElement>('[data-sw-grid-key]');
    const guides = document.querySelector<HTMLElement>('[data-sw-guides]');
    if (!key || !guides) return;
    // The baselines belong to the page, so their phase follows the scroll.
    const phase = () => {
      const u = parseFloat(getComputedStyle(guides).getPropertyValue('--line')) || 24;
      guides.style.setProperty('--phase', `${-(window.scrollY % u)}px`);
    };
    const show = () => { phase(); guides.hidden = false; key.dataset.held = ''; window.addEventListener('scroll', phase, { passive: true }); };
    const hide = () => { guides.hidden = true; delete key.dataset.held; window.removeEventListener('scroll', phase); };
    const down = (e: PointerEvent) => {
      if (e.button !== 0) return;
      try { key.setPointerCapture(e.pointerId); } catch { /* not capturable */ }
      show();
    };
    const keydown = (e: KeyboardEvent) => {
      if (e.key !== ' ' && e.key !== 'Enter') return;
      e.preventDefault();
      show();
    };
    const keyup = (e: KeyboardEvent) => {
      if (e.key !== ' ' && e.key !== 'Enter') return;
      e.preventDefault();
      hide();
    };
    // G held anywhere shows the grid, unless the visitor is typing.
    const typing = (t: EventTarget | null) => t instanceof HTMLElement && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName));
    const isG = (e: KeyboardEvent) => (e.key === 'g' || e.key === 'G') && !e.ctrlKey && !e.metaKey && !e.altKey;
    const gDown = (e: KeyboardEvent) => { if (isG(e) && !e.repeat && !typing(e.target)) show(); };
    const gUp = (e: KeyboardEvent) => { if (isG(e)) hide(); };
    const noMenu = (e: Event) => e.preventDefault();
    key.addEventListener('pointerdown', down);
    key.addEventListener('pointerup', hide);
    key.addEventListener('pointercancel', hide);
    key.addEventListener('lostpointercapture', hide);
    key.addEventListener('keydown', keydown);
    key.addEventListener('keyup', keyup);
    key.addEventListener('blur', hide);
    key.addEventListener('contextmenu', noMenu);
    document.addEventListener('keydown', gDown);
    document.addEventListener('keyup', gUp);
    window.addEventListener('blur', hide);
    return () => {
      hide();
      key.removeEventListener('pointerdown', down);
      key.removeEventListener('pointerup', hide);
      key.removeEventListener('pointercancel', hide);
      key.removeEventListener('lostpointercapture', hide);
      key.removeEventListener('keydown', keydown);
      key.removeEventListener('keyup', keyup);
      key.removeEventListener('blur', hide);
      key.removeEventListener('contextmenu', noMenu);
      document.removeEventListener('keydown', gDown);
      document.removeEventListener('keyup', gUp);
      window.removeEventListener('blur', hide);
    };
  });
</script>

<style>
  /* The key: one line (24px) square, on the wordmark's line in the header's
     grid; an invisible pad takes its touch target to 44px without changing
     the header's height. Its face is three ink columns; held, it is an ink
     block with paper columns (the school's inversion).
     Phones: the last column of the wordmark's row. Tablet: the right end of
     the wordmark's two columns, a gutter clear of the nav. Desktop: the first
     free column after the wordmark. */
  .grid-key {
    position: relative;
    grid-row: 1;
    grid-column: -2 / -1;
    justify-self: end;
    align-self: start;
    width: var(--u);
    height: var(--u);
    padding: 0;
    border: 1px solid var(--mark);
    border-radius: 0;
    background: var(--field);
    cursor: pointer;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  .grid-key::after { content: ''; position: absolute; inset: -10px; }
  .grid-key::before {
    content: '';
    position: absolute;
    inset: 5px 4px;
    background: repeating-linear-gradient(90deg, var(--mark) 0 3px, transparent 3px 5.5px);
  }
  .grid-key[data-held] { background: var(--mark); }
  .grid-key[data-held]::before {
    background: repeating-linear-gradient(90deg, var(--field) 0 3px, transparent 3px 5.5px);
  }
  @media (min-width: 640px) {
    .grid-key { grid-column: 1 / 3; margin-right: var(--gutter); }
  }
  @media (min-width: 1024px) {
    .grid-key { grid-column: 4 / 5; justify-self: start; margin-right: 0; }
  }

  /* The guides: the same columns every band hangs from (--cols, --gutter and
     --frame are the school's own). Each column is a pair of hairlines and the
     rhythm a faint line every 24px, in the school's one red, the way a
     layout is drawn over the printed sheet. (A difference blend was tried:
     column edges on fractional pixels came out grey beside red.) */
  .guides {
    --line: var(--u);
    --phase: 0px;
    position: fixed;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gutter);
    width: var(--frame);
    margin-inline: auto;
  }
  .guides::before {
    content: '';
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(180deg, transparent 0 calc(var(--line) - 1px), rgb(218 0 22 / 0.22) calc(var(--line) - 1px) var(--line));
    background-position: 0 var(--phase);
  }
  .guides[hidden] { display: none; }
  .guides span { border-inline: 1px solid var(--red-field); }
  @media (max-width: 1023.98px) { .guides span:nth-child(n + 7) { display: none; } }
  @media (max-width: 639.98px) { .guides span:nth-child(n + 5) { display: none; } }
</style>
