---
/** Swiss footer: the colophon of the sheet, three blocks of small type hung
    on the same column lines as everything above it, their last baselines on
    one line (the legal line sits on the baseline of the last nav link). */
import { hrefFor } from '../paths';
import type { CopyData } from '../../lib/copy';

interface Props { chrome: CopyData<'chrome'>; theme: string }
const { chrome, theme } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="sw-row foot">
    <div class="ident">
      <p class="name">{chrome.name}</p>
      <p class="sw-muted">{chrome.location}</p>
    </div>
    <nav aria-label="Footer">
      {chrome.nav.map(({ to, label }) => (
        <a href={hrefFor(to, theme)} data-astro-reload={to === 'lab' ? '' : undefined}>{label}</a>
      ))}
    </nav>
    <p class="legal sw-meta sw-muted">&copy; {year} {chrome.name} <span aria-hidden="true">/</span> <a href={hrefFor('privacy', theme)} data-astro-reload>{chrome.privacy}</a></p>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--mark);
    padding-block: var(--u) calc(var(--u) * 3);
    row-gap: var(--u);
    font-size: var(--fs-meta);
    line-height: var(--u);
    align-items: start;
  }
  /* Side by side, the three blocks end on one baseline: the name block's
     location line, the last link and the legal line. */
  @media (min-width: 640px) {
    .foot { align-items: last baseline; }
  }
  .ident { grid-column: 1 / 3; }
  .name { font-family: var(--font-display); font-weight: 700; letter-spacing: -0.01em; }
  nav { grid-column: 3 / -1; display: grid; justify-items: start; }
  nav a, .legal a { color: var(--mark); text-decoration: none; }
  nav a:active, .legal a:active { background: var(--press-bg); color: var(--press-fg); }
  @media (hover: hover) and (pointer: fine) {
    nav a:hover, .legal a:hover { text-decoration: underline; text-decoration-thickness: 0.16em; text-underline-offset: 0.2em; }
  }
  .legal { grid-column: 1 / -1; }
  .legal a { font-family: var(--font-body); font-weight: 400; }

  /* Same touch-target growth as the header nav: two lines tall each. */
  @media (pointer: coarse), (max-width: 639px) {
    nav a {
      display: flex;
      align-items: center;
      min-height: calc(var(--u) * 2);
    }
    .foot {
      padding-block: calc(var(--u) * 0.5) calc(var(--u) * 2);
    }
  }

  @media (min-width: 640px) {
    .ident { grid-column: 1 / 3; }
    nav { grid-column: 3 / 5; }
    .legal { grid-column: 5 / -1; }
  }
  @media (min-width: 1024px) {
    .ident { grid-column: 1 / 4; }
    nav { grid-column: 7 / 9; }
    .legal { grid-column: 9 / -1; }
  }
</style>
