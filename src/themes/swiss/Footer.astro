---
/** Swiss footer: the colophon of the sheet, three blocks of small type on
    the same columns as everything above it. */
import { hrefFor } from '../paths';
import type { CopyData } from '../../lib/copy';

interface Props { chrome: CopyData<'chrome'>; theme: string }
const { chrome, theme } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="sw-row foot">
    <div class="ident">
      <p class="name">{chrome.name}</p>
      <p class="sw-muted">{chrome.location}</p>
    </div>
    <nav aria-label="Footer">
      {chrome.nav.map(({ to, label }) => (
        <a href={hrefFor(to, theme)} data-astro-reload={to === 'lab' ? '' : undefined}>{label}</a>
      ))}
    </nav>
    <p class="legal sw-muted">&copy; {year} {chrome.name} <span aria-hidden="true">/</span> <a href={hrefFor('privacy', theme)} data-astro-reload>{chrome.privacy}</a></p>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--mark);
    padding-block: calc(var(--u) * 2) calc(var(--u) * 6);
    row-gap: calc(var(--u) * 3);
    font-size: 0.875rem;
    line-height: 1.35;
    align-items: start;
  }
  .ident { grid-column: 1 / 3; }
  .name { font-family: var(--font-display); font-weight: 700; letter-spacing: -0.01em; }
  nav { grid-column: 3 / -1; display: grid; justify-items: start; row-gap: calc(var(--u) * 0.5); }
  nav a, .legal a { color: var(--mark); text-decoration: none; }
  nav a:hover, .legal a:hover { color: var(--accent); text-decoration: underline; }
  .legal { grid-column: 1 / -1; font-family: var(--font-mono); font-size: 0.75rem; }
  .legal a { font-family: var(--font-body); font-size: 0.875rem; }

  /* Same touch-target growth as the header nav, with the footer's own
     padding pulled in to hold the rhythm. */
  @media (pointer: coarse), (max-width: 639px) {
    nav a {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding-block: calc(var(--u) * 1);
    }
    .foot {
      padding-block: calc(var(--u) * 1.25) calc(var(--u) * 5);
    }
  }

  @media (min-width: 640px) {
    .ident { grid-column: 1 / 3; }
    nav { grid-column: 3 / 5; }
    .legal { grid-column: 5 / -1; }
  }
  @media (min-width: 1024px) {
    .ident { grid-column: 1 / 4; }
    nav { grid-column: 7 / 9; }
    .legal { grid-column: 10 / -1; }
  }
</style>
