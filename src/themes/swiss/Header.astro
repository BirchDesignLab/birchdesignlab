---
/** Swiss header: the wordmark and the nav set on the column grid, one link
    per column, over the hairline guides that run the whole sheet. */
import { hrefFor, isCurrent } from '../paths';
import type { CopyData } from '../../lib/copy';

interface Props { chrome: CopyData<'chrome'>; theme: string }
const { chrome, theme } = Astro.props;
---
<div class="sw-guides" aria-hidden="true">
  <div class="sw-row">{Array.from({ length: 12 }, () => <span></span>)}</div>
</div>
<header class="site-header">
  <a class="skip" href="#main">{chrome.skip}</a>
  <div class="sw-row bar">
    <a class="wordmark" href={hrefFor('home', theme)} transition:name="wordmark">{chrome.wordmark.map((part, i) => <>{i > 0 && ' '}<span>{part}</span></>)}</a>
    <nav aria-label="Main">
      {chrome.nav.map(({ to, label }) => (
        <a
          href={hrefFor(to, theme)}
          aria-current={isCurrent(to, Astro.url.pathname) ? 'page' : undefined}
          data-astro-reload={to === 'lab' ? '' : undefined}
        >{label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .bar {
    padding-block: calc(var(--u) * 2) calc(var(--u) * 2.5);
    border-bottom: 1px solid var(--mark);
    align-items: start;
  }
  .wordmark {
    grid-column: 1 / 3;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--mark);
    text-decoration: none;
  }
  .wordmark span { display: block; white-space: nowrap; }
  .wordmark:hover { color: var(--accent); }

  /* The nav borrows the page's own columns (subgrid), so each link starts on
     a guide line: two by two on a phone, one per column from tablet up. */
  nav {
    grid-column: 3 / -1;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: calc(var(--u) * 0.5);
  }
  nav a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--mark);
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover { color: var(--accent); }
  nav a[aria-current='page'] { color: var(--accent); }

  /* Touch targets: a 15px link in a tight 2x2 cluster is fiddly to tap.
     Grow the row, and pull the bar's own padding in by the same amount so
     the header's visual height barely moves. */
  @media (pointer: coarse), (max-width: 639px) {
    nav a {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding-block: calc(var(--u) * 1.25);
    }
    .bar {
      padding-block: calc(var(--u) * 0.75) calc(var(--u) * 1.25);
    }
  }

  @media (min-width: 1024px) {
    .wordmark { grid-column: 1 / 4; }
    nav { grid-column: 9 / -1; }
  }
</style>
