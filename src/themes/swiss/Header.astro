---
/** Swiss header: the wordmark and the nav set on the column grid, one link
    per column. */
import { hrefFor, isCurrent } from '../paths';
import type { CopyData } from '../../lib/copy';

interface Props { chrome: CopyData<'chrome'>; theme: string }
const { chrome, theme } = Astro.props;
---
<header class="site-header">
  <a class="skip" href="#main">{chrome.skip}</a>
  <div class="sw-row bar">
    <a class="wordmark" href={hrefFor('home', theme)} transition:name="wordmark">{chrome.wordmark.map((part, i) => <>{i > 0 && ' '}<span>{part}</span></>)}</a>
    <nav aria-label="Main">
      {chrome.nav.map(({ to, label }) => (
        <a
          href={hrefFor(to, theme)}
          aria-current={isCurrent(to, Astro.url.pathname) ? 'page' : undefined}
          data-astro-reload={to === 'lab' ? '' : undefined}
        >{label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  /* The bar: a line above, a line and a half below (the wordmark's two
     lines are a line and a half), so the bar is a whole number of lines. */
  .bar {
    padding-block: var(--u) calc(var(--u) * 1.5);
    border-bottom: 1px solid var(--mark);
    align-items: start;
  }
  .wordmark {
    grid-column: 1 / 3;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-body);
    line-height: calc(var(--u) * 0.75);
    letter-spacing: -0.02em;
    color: var(--mark);
    text-decoration: none;
  }
  .wordmark span { display: block; white-space: nowrap; }
  /* Hover thickens the underline; the current page is an ink field (below).
     The two never look alike. */
  @media (hover: hover) and (pointer: fine) {
    .wordmark:hover { text-decoration-line: underline; text-decoration-thickness: 0.16em; text-underline-offset: 0.2em; }
  }
  .wordmark:active { background: var(--mark); color: var(--field); }

  /* The nav borrows the page's own columns (subgrid), so each link starts on
     a column line: two by two on a phone, one per column from tablet up. */
  nav {
    grid-column: 3 / -1;
    display: grid;
    grid-template-columns: subgrid;
  }
  nav a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-body);
    line-height: var(--u);
    letter-spacing: -0.01em;
    color: var(--mark);
    text-decoration: none;
    white-space: nowrap;
    justify-self: start;
    /* A small inline pad that the negative margin takes back, so the text
       still starts on its column line when the ink field is drawn. */
    padding-inline: 0.4em;
    margin-inline: -0.4em;
  }
  @media (hover: hover) and (pointer: fine) {
    nav a:hover { text-decoration-line: underline; text-decoration-thickness: 0.16em; text-underline-offset: 0.2em; }
  }
  /* The current page, and a link while it is pressed: a one-line ink field
     behind the text, centred in the link's box (which is taller than a line
     on touch). */
  nav a[aria-current='page'],
  nav a:active {
    color: var(--field);
    background: linear-gradient(var(--mark), var(--mark)) center / 100% var(--u) no-repeat;
  }

  /* Touch targets: a link in a tight 2x2 cluster is fiddly to tap. Each
     link is two lines (48px) tall, and the bar's padding is pulled in to
     half a line so the header's height stays a whole number of lines. */
  @media (pointer: coarse), (max-width: 639px) {
    nav a {
      display: flex;
      align-items: center;
      min-height: calc(var(--u) * 2);
    }
    .bar {
      padding-block: calc(var(--u) * 0.5);
    }
  }

  @media (min-width: 1024px) {
    .wordmark { grid-column: 1 / 4; }
    nav { grid-column: 9 / -1; }
  }
</style>
