---
/** Swiss home: the name as a poster, set flush left at the full width of the
    sheet, its lead and subline hung as one block from a single column line on
    the baseline of its last word; then two equal door fields, the lab as a
    black sheet and the ask. The name is the page's one giant; nothing below
    it is larger than lead. */
import { featuredSpecimens, specimenLink, type CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';
import WidthDial from '../WidthDial.astro';
/* The lab band's photograph: a hard threshold of birch bark, one colour in
   the alpha channel (black marks on clear). Made by
   scripts/themes/stage6/w1-t6-photos.mjs; sources in
   src/assets/swiss-photos-SOURCE.md. It is decorative, so it has no alt. */
import bandAvif1200 from '../../../assets/swiss-lab-band-1200.avif';
import bandAvif2000 from '../../../assets/swiss-lab-band-2000.avif';
import bandWebp1200 from '../../../assets/swiss-lab-band-1200.webp';
import bandWebp2000 from '../../../assets/swiss-lab-band-2000.webp';

interface Props { copy: CopyData<'home'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, chrome, theme } = Astro.props;
const featured = (await featuredSpecimens()).map((entry) => ({ entry, link: specimenLink(entry, theme) }));
---
<div class="hero-sheet">
  <section class="sw-row hero">
    <h1 class="sw-display billboard">
      {chrome.name.split(' ').map((word, i) => <>{i > 0 && ' '}<span class="ln">{word}</span></>)}
    </h1>
    <div class="lede">
      <p class="sw-lead lead">{copy.opener.lead}</p>
      <p class="subline">{copy.opener.subline}</p>
    </div>
    <WidthDial />
  </section>
</div>

<section class="sw-row sw-sec doors">
  <h2 class="sw-kicker kicker">{copy.doors.kicker}</h2>
  <div class="door-list">
    {copy.doors.items.map((door) => (
      <article class="door">
        <h3 class="sw-lead door-title">{door.title}</h3>
        <p class="door-body">{door.body}</p>
      </article>
    ))}
  </div>
  <a class="more" href={hrefFor('services', theme)}>{copy.doors.more}</a>
</section>

{featured.length > 0 && (
  <section class="sw-row lab-wrap">
    <div class="sw-sheet sw-white lab sw-bleed">
      <div class="lab-head">
        <picture class="lab-photo" aria-hidden="true">
          <source type="image/avif" srcset={`${bandAvif1200.src} 1200w, ${bandAvif2000.src} 2000w`} sizes="100vw" />
          <source type="image/webp" srcset={`${bandWebp1200.src} 1200w, ${bandWebp2000.src} 2000w`} sizes="100vw" />
          <img src={bandWebp2000.src} width="2000" height="1125" alt="" loading="lazy" decoding="async" />
        </picture>
        <p class="sw-kicker lab-kicker"><span class="cut">{copy.lab.kicker}</span></p>
        <p class="sw-lead pull"><span class="cut">{copy.lab.pull}</span></p>
      </div>
      <ul class="specimens" data-parity-skip>
        {featured.map(({ entry, link }) => (
          <li>
            <a class="sw-meta designation" href={link.href} data-astro-reload={link.leaves ? '' : undefined} aria-label={`${entry.data.designation}, ${entry.data.title}`}>{entry.data.designation}</a>
            <span class="summary">{entry.data.summary}</span>
          </li>
        ))}
      </ul>
      <a class="sw-btn lab-more" href={hrefFor('lab', theme)} data-astro-reload>{copy.lab.more}</a>
    </div>
  </section>
)}

<section class="sw-row closer-wrap">
  <div class="sw-red closer sw-bleed">
    <p class="sw-lead closer-lead">{copy.closer.lead}</p>
    <a class="sw-btn closer-cta" href={hrefFor('contact', theme)}>{copy.closer.cta}</a>
  </div>
</section>

<style>
  /* The poster. The billboard size is one variable. cqw is the hero row's
     own width, which is the frame (the sheet between its margins), not the
     viewport. */
  .hero-sheet { overflow-x: clip; }
  .hero {
    --bb: min(29.4cqw, 17.5rem);
    position: relative;
    padding-block: calc(var(--u) * 0.5) calc(var(--u) * 4);
    row-gap: var(--u);
    align-items: start;
  }
  /* The width dial's word. --sw-s is the billboard's own width (theme.css
     keeps the ink flush to the column from it); "Design" is the word the dial
     moves: --sw-d is its width, --sw-rest where it sits at rest (the widest
     cut on a desktop, the line's own width on a tablet and a phone), and it
     steps left by the extra bearing the wider cut carries. WidthDial.astro
     sets --sw-d while the word is moved and clears it at rest. */
  .billboard {
    --sw-rest: 100;
    grid-row: 1;
    font-size: var(--bb);
    margin-top: calc(var(--u) * 4);
  }
  .billboard .ln:nth-child(2) {
    --sw-d: var(--sw-rest);
    font-stretch: calc(var(--sw-d) * 1%);
    margin-inline-start: calc(-1em * 0.000675 * (var(--sw-d) - var(--sw-s)));
  }
  /* The lead and the subline are one block, so they share one column line. */
  .lede {
    grid-row: 2;
    grid-column: 2 / -1;
    display: grid;
    row-gap: var(--u);
  }
  .lead { max-width: 14em; }
  .subline { max-width: 30em; }

  /* Phones: the first screen is a poster. The name is cut condensed (the
     width axis) to fill the measure; the lead has its own row under it and
     is as tall as the rest of the first screen (the screen less the header,
     the hero's half-line of padding, the billboard's margin and its three
     lines, and the row gaps), so the subline (body type) starts at the fold.
     The lead sits at the foot of that block, lifted clear of the portal
     switcher bar; on a short screen the block just stops shrinking and the
     rows stack, so billboard and lead can never overlap. */
  @media (max-width: 639.98px) {
    .hero {
      --bb: calc(37.5cqw);
      grid-template-rows: auto auto auto;
      padding-bottom: calc(var(--u) * 4);
    }
    .billboard { --sw-s: 85; --sw-rest: 85; margin-top: calc(var(--u) * 2); }
    .lede { display: contents; }
    .lead {
      grid-row: 2;
      grid-column: 2 / -1;
      display: grid;
      align-content: end;
      min-height: max(0px, calc(100svh - var(--u) * 8.5 - 1px - var(--bb) * 2.58));
      padding-bottom: calc(var(--u) * 2.5);
    }
    .subline { grid-row: 3; grid-column: 2 / -1; }
  }
  @media (min-width: 640px) {
    /* The tablet sheet: "Design" spans the frame (about 32cqw), the lead and
       subline hung from column 4. */
    .hero { --bb: min(32.4cqw, 17.5rem); }
    .lede { grid-column: 4 / -1; }
  }
  @media (min-width: 1024px) {
    /* Name flush left, the block hung from column 8 on the baseline of the
       name's last word ("Lab"): last baselines align across the two items. */
    .hero { --bb: min(20.2cqw, 21rem); padding-bottom: calc(var(--u) * 5); }
    .billboard { grid-row: 1; grid-column: 1 / -1; align-self: last baseline; margin-top: calc(var(--u) * 2); }
    .lede { grid-row: 1; grid-column: 8 / -1; align-self: last baseline; }
  }
  /* Poster scale (1.2x the old billboard, "Design" at the widest cut): from
     1280 the widest cut clears the lede at every width; between 1024 and
     1279 it rests at the old width until the dial has measured how wide the
     word may go. */
  @media (min-width: 1280px) {
    .billboard { --sw-rest: 125; }
  }

  /* 02: the doors, two equal fields side by side, each with its title at
     lead size above its body. "How we build" hangs directly under the right
     body, on its column line. The wrapper steps aside so the doors place on
     the section's own columns; the left door spans the link's row too, so the
     right body and the link stay together whichever body is taller. */
  .kicker { grid-column: 1 / -1; }
  .door-list { display: contents; }
  .door {
    display: grid;
    grid-column: 1 / -1;
    row-gap: calc(var(--u) * 0.5);
    align-content: start;
    padding-block: 0 calc(var(--u) * 2);
  }
  /* Stacked (phones): ruled between. Scoped to phones so it cannot outrank
     the side-by-side reset below. */
  @media (max-width: 639.98px) {
    .door + .door { border-top: 1px solid var(--mark); padding-top: calc(var(--u) * 0.5); }
    /* The last door gives up its bottom padding so "How we build" hangs one
       row gap under its body, as it does side by side. */
    .door:last-child { padding-bottom: 0; }
  }
  .door-body { max-width: 32em; }
  .more { grid-column: 1 / -1; font-family: var(--font-display); font-weight: 700; justify-self: start; }

  @media (min-width: 640px) {
    .doors { grid-template-rows: auto auto 1fr; }
    .door:nth-child(1) { grid-column: 1 / 4; grid-row: 2 / 4; }
    .door:nth-child(2) { grid-column: 4 / -1; grid-row: 2; padding-block: 0; }
    .more { grid-column: 4 / -1; grid-row: 3; align-self: start; }
  }
  @media (min-width: 1024px) {
    .door:nth-child(1) { grid-column: 1 / 7; }
    .door:nth-child(2) { grid-column: 7 / -1; }
    .more { grid-column: 7 / -1; }
  }

  /* 03: the lab, a full-bleed black sheet with paper type (a white field
     with black type in dark, Stage 6 call 9: the red close below is then the
     page's one red field). The block sits on the frame; its fill runs to the
     viewport edges. */
  .lab-wrap { padding-bottom: calc(var(--u) * 4); }
  .lab {
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--u);
    padding-block: calc(var(--u) * 0.5) calc(var(--u) * 2);
  }
  :where(.lab) > *, :where(.lab-head) > * { grid-column: 1 / -1; min-width: 0; }
  /* The band's photograph (Stage 6, P4, typophoto): a hard threshold of birch
     bark across the head of the sheet, running to the viewport edges and cut
     by them, the kicker and the pull set over it. One colour in the alpha
     channel, printed as it is made: black marks on a white band, in both
     schemes (the brief's reading, the marks echoing the site's bark dashes).
     In light the band is a white field at the head of the black sheet, ruled
     off at the first specimen line; in dark the sheet is itself the white
     field, so the same marks sit on it with no edge. Each line of type carries
     the sheet's ground behind it (black in light, white in dark) and a clear
     zone after it (1em, never under 40px, painted outside the line box), so no
     mark sits under a letter or lands against a line's end like punctuation:
     a reversed label. */
  .lab { --ground: var(--black); }
  :global([data-theme='swiss'][data-scheme='dark']) .lab { --ground: var(--white-field); }
  .lab-head {
    position: relative;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--u);
    align-content: space-between;
  }
  .lab-head > :not(.lab-photo) { position: relative; z-index: 1; }
  .lab-photo {
    position: absolute;
    z-index: 0;
    top: calc(var(--u) * -0.5);
    bottom: calc(var(--u) * -2);
    left: calc(50% - 50vw);
    width: 100vw;
    max-width: none;
    overflow: hidden;
    pointer-events: none;
    background: var(--white-field);
  }
  .lab-photo img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 80% 50%;
  }
  .cut {
    background: var(--ground);
    /* The clear zone is a shadow, not padding: padding sits inside the line box,
       so it widens the last line past the pull's measure (a widow) and hangs
       past the column on every other line (sideways scroll on a phone); a
       shadow takes no room and adds no scrollable overflow. */
    box-shadow: max(1em, 2.5rem) 0 0 var(--ground);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .pull {
    margin-top: calc(var(--u) * 2);
    max-width: 20em;
  }
  .specimens { margin-top: var(--u); display: grid; grid-template-columns: subgrid; }
  .specimens li {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    border-top: 1px solid var(--mark-muted);
    padding-block: calc(var(--u) * 0.5);
  }
  .designation {
    grid-column: 1 / -1;
    justify-self: start;
    align-self: start;
    text-decoration-line: none;
  }
  /* The designation links to its entry: bare at rest, underlined on hover
     (thickened by the global rule) and on keyboard focus. */
  .specimens .designation:focus-visible { text-decoration-line: underline; }
  .summary { grid-column: 1 / -1; color: var(--mark-muted); }
  .lab-more { grid-column: 1 / -1; }

  @media (min-width: 640px) {
    /* The photograph's band has height of its own, the kicker at the head of
       it and the pull at its foot. */
    .lab-head { min-height: clamp(260px, 30vw, 520px); }
    .designation { grid-column: 1 / 3; }
    .summary { grid-column: 3 / -1; }
    .lab-more { grid-column: 4 / -1; }
  }
  @media (min-width: 1024px) {
    .lab-kicker { grid-column: 1 / 7; }
    .designation { grid-column: 1 / 3; }
    .summary { grid-column: 3 / 9; }
    .lab-more { grid-column: 10 / -1; }
  }

  /* 04: the ask, at lead size inside a full-bleed red field, the button the
     field's one block (black inside red), as on Services. */
  .closer-wrap { padding-bottom: calc(var(--u) * 4); }
  .closer {
    display: grid;
    grid-template-columns: subgrid;
    row-gap: calc(var(--u) * 2);
    padding-block: var(--u);
  }
  :where(.closer) > * { grid-column: 1 / -1; }
  .closer-lead { max-width: 18em; }
  @media (min-width: 640px) {
    .closer-cta { grid-column: 4 / -1; }
  }
  @media (min-width: 1024px) {
    .closer-lead { grid-row: 1; grid-column: 1 / 10; }
    .closer-cta { grid-row: 1; grid-column: 10 / -1; align-self: end; }
  }
</style>
