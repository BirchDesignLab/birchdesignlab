---
/** Swiss home: the name as a poster, set flush left at the full width of the
    sheet, its lead and subline hung as one block from a single column line on
    the baseline of its last word; then two equal door fields, the lab as a
    black sheet and the ask. The name is the page's one giant; nothing below
    it is larger than lead. */
import { featuredSpecimens, specimenLink, type CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';

interface Props { copy: CopyData<'home'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, chrome, theme } = Astro.props;
const featured = (await featuredSpecimens()).map((entry) => ({ entry, link: specimenLink(entry, theme) }));
---
<section class="sw-row hero">
  <h1 class="sw-display billboard">
    {chrome.name.split(' ').map((word, i) => <>{i > 0 && ' '}<span class="ln">{word}</span></>)}
  </h1>
  <div class="lede">
    <p class="sw-lead lead">{copy.opener.lead}</p>
    <p class="subline">{copy.opener.subline}</p>
  </div>
</section>

<section class="sw-row sw-sec doors">
  <h2 class="sw-kicker kicker">{copy.doors.kicker}</h2>
  <div class="door-list">
    {copy.doors.items.map((door) => (
      <article class="door">
        <h3 class="sw-lead door-title">{door.title}</h3>
        <p class="door-body">{door.body}</p>
      </article>
    ))}
  </div>
  <a class="more" href={hrefFor('services', theme)}>{copy.doors.more}</a>
</section>

{featured.length > 0 && (
  <section class="sw-row lab-wrap">
    <div class="sw-sheet lab sw-bleed">
      <p class="sw-kicker lab-kicker">{copy.lab.kicker}</p>
      <p class="sw-lead pull">{copy.lab.pull}</p>
      <ul class="specimens" data-parity-skip>
        {featured.map(({ entry, link }) => (
          <li>
            <a class="sw-meta designation" href={link.href} data-astro-reload={link.leaves ? '' : undefined} aria-label={`${entry.data.designation}, ${entry.data.title}`}>{entry.data.designation}</a>
            <span class="summary">{entry.data.summary}</span>
          </li>
        ))}
      </ul>
      <a class="sw-btn lab-more" href={hrefFor('lab', theme)} data-astro-reload>{copy.lab.more}</a>
    </div>
  </section>
)}

<section class="sw-row sw-sec closer">
  <p class="sw-lead closer-lead">{copy.closer.lead}</p>
  <a class="sw-btn closer-cta" href={hrefFor('contact', theme)}>{copy.closer.cta}</a>
</section>

<style>
  /* The poster. The billboard size is one variable. cqw is the hero row's
     own width, which is the frame (the sheet between its margins), not the
     viewport. */
  .hero {
    --bb: min(29.4cqw, 17.5rem);
    padding-block: calc(var(--u) * 0.5) calc(var(--u) * 4);
    row-gap: var(--u);
    align-items: start;
  }
  .billboard {
    grid-row: 1;
    font-size: var(--bb);
    margin-top: calc(var(--u) * 4);
  }
  /* The lead and the subline are one block, so they share one column line. */
  .lede {
    grid-row: 2;
    grid-column: 2 / -1;
    display: grid;
    row-gap: var(--u);
  }
  .lead { max-width: 14em; }
  .subline { max-width: 30em; }

  @media (min-width: 640px) {
    .hero { --bb: min(20.6cqw, 17.5rem); }
    .lede { grid-column: 4 / -1; }
  }
  @media (min-width: 1024px) {
    /* Name flush left, the block hung from column 8 on the baseline of the
       name's last word ("Lab"): last baselines align across the two items. */
    .hero { --bb: min(16.8cqw, 17.5rem); padding-bottom: calc(var(--u) * 5); }
    .billboard { grid-row: 1; grid-column: 1 / -1; align-self: last baseline; }
    .lede { grid-row: 1; grid-column: 8 / -1; align-self: last baseline; }
  }

  /* 02: the doors, two equal fields side by side, each with its title at
     lead size above its body. "How we build" hangs directly under the right
     body, on its column line. The wrapper steps aside so the doors place on
     the section's own columns; the left door spans the link's row too, so the
     right body and the link stay together whichever body is taller. */
  .kicker { grid-column: 1 / -1; }
  .door-list { display: contents; }
  .door {
    display: grid;
    grid-column: 1 / -1;
    row-gap: calc(var(--u) * 0.5);
    align-content: start;
    padding-block: 0 calc(var(--u) * 2);
  }
  /* Stacked (phones): ruled between. */
  .door + .door { border-top: 1px solid var(--mark); padding-top: calc(var(--u) * 0.5); }
  .door-body { max-width: 32em; }
  .more { grid-column: 1 / -1; font-family: var(--font-display); font-weight: 700; justify-self: start; }

  @media (min-width: 640px) {
    .doors { grid-template-rows: auto auto 1fr; }
    .door:nth-child(1) { grid-column: 1 / 4; grid-row: 2 / 4; }
    .door:nth-child(2) { grid-column: 4 / -1; grid-row: 2; border-top: 0; padding-block: 0; }
    .more { grid-column: 4 / -1; grid-row: 3; align-self: start; }
  }
  @media (min-width: 1024px) {
    .door:nth-child(1) { grid-column: 1 / 7; }
    .door:nth-child(2) { grid-column: 7 / -1; }
    .more { grid-column: 7 / -1; }
  }

  /* 03: the lab, a full-bleed black sheet with paper type (red with white
     type in dark). The block sits on the frame; its fill runs to the
     viewport edges. */
  .lab-wrap { padding-bottom: calc(var(--u) * 4); }
  .lab {
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--u);
    padding-block: calc(var(--u) * 0.5) calc(var(--u) * 2);
  }
  :where(.lab) > * { grid-column: 1 / -1; min-width: 0; }
  .pull {
    margin-top: calc(var(--u) * 2);
    max-width: 20em;
  }
  .specimens { margin-top: var(--u); display: grid; grid-template-columns: subgrid; }
  .specimens li {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    border-top: 1px solid var(--mark-muted);
    padding-block: calc(var(--u) * 0.5);
  }
  .designation {
    grid-column: 1 / -1;
    justify-self: start;
    align-self: start;
    text-decoration-line: none;
  }
  /* The designation links to its entry: bare at rest, underlined on hover
     (thickened by the global rule) and on keyboard focus. */
  .specimens .designation:focus-visible { text-decoration-line: underline; }
  .summary { grid-column: 1 / -1; color: var(--mark-muted); }
  .lab-more { justify-self: start; padding-inline: var(--u); min-width: 50%; }

  @media (min-width: 640px) {
    .designation { grid-column: 1 / 3; }
    .summary { grid-column: 3 / -1; }
  }
  @media (min-width: 1024px) {
    .lab-kicker { grid-row: 1; grid-column: 1 / 7; }
    .designation { grid-column: 1 / 3; }
    .summary { grid-column: 3 / 9; }
    .lab-more { grid-column: 10 / -1; min-width: 0; justify-self: stretch; }
  }

  /* 04: the ask, at lead size. */
  .closer-lead { max-width: 18em; }
  .closer-cta { justify-self: stretch; }
  @media (min-width: 640px) {
    .closer-cta { grid-column: 4 / -1; }
  }
  @media (min-width: 1024px) {
    .closer-lead { grid-row: 1; grid-column: 1 / 10; }
    .closer-cta { grid-row: 1; grid-column: 10 / -1; align-self: end; }
  }
</style>
