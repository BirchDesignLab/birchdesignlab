---
/** Swiss home: the name as a poster, set flush left at the full width of the
    sheet with one red block in the free corner, then the sections on the
    same twelve columns. The name is the page's one giant; nothing below it
    is larger than lead. */
import { featuredSpecimens, specimenLink, type CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';

interface Props { copy: CopyData<'home'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, chrome, theme } = Astro.props;
const featured = (await featuredSpecimens()).map((entry) => ({ entry, link: specimenLink(entry, theme) }));
---
<section class="sw-row hero">
  <h1 class="sw-display billboard">
    {chrome.name.split(' ').map((word, i) => <>{i > 0 && ' '}<span class="ln">{word}</span></>)}
  </h1>
  <div class="sw-red block">
    <p class="sw-lead lead">{copy.opener.lead}</p>
  </div>
  <p class="subline">{copy.opener.subline}</p>
</section>

<section class="sw-row sw-sec doors">
  <h2 class="sw-kicker kicker">{copy.doors.kicker}</h2>
  <div class="door-list">
    {copy.doors.items.map((door) => (
      <article class="door">
        <h3 class="sw-lead door-title">{door.title}</h3>
        <p class="door-body">{door.body}</p>
      </article>
    ))}
  </div>
  <a class="more" href={hrefFor('services', theme)}>{copy.doors.more}</a>
</section>

{featured.length > 0 && (
  <section class="sw-row lab-wrap">
    <div class="sw-ink lab sw-bleed">
      <p class="sw-kicker lab-kicker">{copy.lab.kicker}</p>
      <p class="sw-lead pull">{copy.lab.pull}</p>
      <ul class="specimens" data-parity-skip>
        {featured.map(({ entry, link }) => (
          <li>
            <a class="sw-meta designation" href={link.href} data-astro-reload={link.leaves ? '' : undefined} aria-label={`${entry.data.designation}, ${entry.data.title}`}>{entry.data.designation}</a>
            <span class="summary">{entry.data.summary}</span>
          </li>
        ))}
      </ul>
      <a class="sw-btn lab-more" href={hrefFor('lab', theme)} data-astro-reload>{copy.lab.more}</a>
    </div>
  </section>
)}

<section class="sw-row sw-sec closer">
  <p class="sw-lead closer-lead">{copy.closer.lead}</p>
  <a class="sw-btn closer-cta" href={hrefFor('contact', theme)}>{copy.closer.cta}</a>
</section>

<style>
  /* The poster. The billboard size is one variable so the red block can be
     cut to exactly two lines of it. cqw is the hero row's own width, which
     is the frame (the sheet between its margins), not the viewport. */
  .hero {
    --bb: min(29.4cqw, 17.5rem);
    padding-block: calc(var(--u) * 0.5) calc(var(--u) * 4);
    row-gap: var(--u);
    align-items: start;
  }
  .billboard {
    grid-row: 1;
    font-size: var(--bb);
    margin-top: calc(var(--u) * 4);
  }
  .block {
    grid-row: 2;
    grid-column: 2 / -1;
    display: flex;
    align-items: flex-end;
    min-height: calc(var(--u) * 7);
    padding: calc(var(--u) * 0.5) var(--gutter) var(--u);
  }
  .lead { max-width: 14em; }
  .subline { grid-row: 3; grid-column: 2 / -1; max-width: 30em; }

  @media (min-width: 640px) {
    .hero { --bb: min(20.6cqw, 17.5rem); }
    .block { grid-column: 4 / -1; }
    .subline { grid-column: 4 / -1; }
  }
  @media (min-width: 1024px) {
    /* Name bottom left, red block top right, the reading text tucked beside
       the short last line: one asymmetric sheet, nothing centred. */
    .hero { --bb: min(16.8cqw, 17.5rem); padding-bottom: calc(var(--u) * 5); }
    .billboard { grid-row: 1 / 3; }
    /* Aligned to the billboard's own cap height and baseline, not just two
       line boxes of it: the half-leading plus ascender gap pushed down,
       one line plus a cap height tall. */
    .block {
      grid-row: 1;
      grid-column: 9 / -1;
      height: calc(var(--bb) * (0.86 + 0.72));
      margin-top: calc(var(--u) * 4 + var(--bb) * 0.12);
    }
    .subline { grid-row: 2; grid-column: 7 / 11; align-self: end; }
  }

  /* 02: the two doors as rows of a table, title against text. */
  .kicker { grid-column: 1 / -1; }
  .door-list { display: grid; grid-template-columns: subgrid; }
  .door {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    row-gap: calc(var(--u) * 0.5);
    padding-block: calc(var(--u) * 0.5) calc(var(--u) * 2);
  }
  /* The section rule opens the first door; the rest are ruled between. */
  .door + .door { border-top: 1px solid var(--mark); }
  .door:first-child { padding-top: 0; }
  .door-title { grid-column: 1 / -1; }
  .door-body { grid-column: 1 / -1; max-width: 32em; }
  .more { grid-column: 1 / -1; font-family: var(--font-display); font-weight: 700; justify-self: start; }

  @media (min-width: 640px) {
    .door-body { grid-column: 3 / -1; }
    .more { grid-column: 3 / -1; }
  }
  @media (min-width: 1024px) {
    .kicker { grid-column: 1 / 3; grid-row: 1; }
    .door-list { grid-column: 3 / -1; grid-row: 1; }
    .door-title { grid-column: 1 / 6; }
    .door-body { grid-column: 7 / -1; }
    .more { grid-column: 9 / -1; grid-row: 2; }
  }

  /* 03: the lab, printed in negative as a block inside the frame. */
  .lab-wrap { padding-bottom: calc(var(--u) * 4); }
  .lab {
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--u);
    padding-block: calc(var(--u) * 0.5) calc(var(--u) * 2);
  }
  :where(.lab) > * { grid-column: 1 / -1; min-width: 0; }
  .pull {
    margin-top: calc(var(--u) * 2);
    max-width: 20em;
  }
  .specimens { margin-top: var(--u); display: grid; grid-template-columns: subgrid; }
  .specimens li {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    border-top: 1px solid var(--ink-muted);
    padding-block: calc(var(--u) * 0.5);
  }
  .designation {
    grid-column: 1 / -1;
    justify-self: start;
    align-self: start;
    text-decoration-line: none;
  }
  /* The designation links to its entry: bare at rest, the theme's rule
     underline on hover and focus, in the red lifted to pass on the ink. */
  .specimens .designation:hover, .specimens .designation:focus-visible { text-decoration-line: underline; color: var(--red-on-ink); }
  .specimens .designation:focus-visible { outline-color: var(--red-on-ink); }
  .summary { grid-column: 1 / -1; color: var(--mark-muted); }
  .lab-more { justify-self: start; padding-inline: var(--u); min-width: 50%; }

  @media (min-width: 640px) {
    .designation { grid-column: 1 / 3; }
    .summary { grid-column: 3 / -1; }
  }
  @media (min-width: 1024px) {
    .lab-kicker { grid-row: 1; grid-column: 1 / 7; }
    .designation { grid-column: 1 / 3; }
    .summary { grid-column: 3 / 9; }
    .lab-more { grid-column: 10 / -1; min-width: 0; justify-self: stretch; }
  }

  /* 04: the ask, at lead size. */
  .closer-lead { max-width: 18em; }
  .closer-cta { justify-self: stretch; }
  @media (min-width: 640px) {
    .closer-cta { grid-column: 4 / -1; }
  }
  @media (min-width: 1024px) {
    .closer-lead { grid-row: 1; grid-column: 1 / 10; }
    .closer-cta { grid-row: 1; grid-column: 10 / -1; align-self: end; }
  }
</style>
