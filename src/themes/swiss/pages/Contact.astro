---
/** Swiss contact: the invitation at poster scale, the form as a ruled table
    on the left columns, the direct address in the red on the right. */
import ContactHidden from '../../portal/ContactHidden.astro';
import type { CopyData } from '../../../lib/copy';

interface Props { copy: CopyData<'contact'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
---
<section class="sw-row hero">
  <p class="sw-kicker hero-kicker">{copy.kicker}</p>
  <h1 class="sw-display title">{copy.heading}</h1>
  <p class="sw-lead subline">{copy.subline}</p>
</section>

<section class="sw-row sw-sec body">
  <div class="form-col">
    <form method="post" action="/api/contact" data-astro-reload>
      <div class="field">
        <label for="cf-name">{copy.labels.name}</label>
        <input id="cf-name" name="name" type="text" required maxlength="200" autocomplete="name" />
      </div>
      <div class="field">
        <label for="cf-email">{copy.labels.email}</label>
        <input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" />
      </div>
      <div class="field">
        <label for="cf-message">{copy.labels.message}</label>
        <textarea id="cf-message" name="message" required maxlength="5000" rows="7"></textarea>
      </div>
      <ContactHidden theme={theme} label={copy.labels.honeypot} />
      <button class="sw-btn submit" type="submit">{copy.submit}</button>
    </form>
    <p class="sw-meta trust">{copy.trust.map((part, i) => <>{i > 0 && <> <span aria-hidden="true">/</span> </>}{part}</>)}</p>
  </div>
  <aside class="sw-red direct sw-bleed">
    <p class="sw-lead invite">{copy.invite}</p>
    <a class="mail" href={`mailto:${copy.email}`}>{copy.email}</a>
    <p class="sw-meta fine">{copy.fine}</p>
  </aside>
</section>

<style>
  .hero {
    padding-block: calc(var(--u) * 0.5) calc(var(--u) * 4);
    row-gap: var(--u);
    align-items: start;
  }
  .hero-kicker { margin-top: calc(var(--u) * 3); }
  /* Sized so "conversation" holds one line of the frame at every width;
     cqw is the hero row's own width, the frame. */
  .title {
    font-size: min(16.9cqw, 12.5rem);
    margin-bottom: var(--u);
    max-width: 7em;
  }
  .subline { max-width: 18em; }
  @media (min-width: 640px) {
    .subline { grid-column: 3 / -1; }
  }
  @media (min-width: 1024px) {
    .title { font-size: min(15.2cqw, 12.5rem); }
    .subline { grid-column: 7 / -1; }
  }

  .body { align-items: start; }
  form { display: grid; row-gap: var(--u); }
  .field { display: grid; row-gap: calc(var(--u) * 0.5); }
  label {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.005em;
  }
  input, textarea {
    font: inherit;
    color: var(--mark);
    background: var(--field-raised);
    border: 1px solid var(--mark);
    border-radius: 0;
    padding: calc(var(--u) * 0.5);
    width: 100%;
  }
  textarea { resize: vertical; min-height: calc(var(--u) * 8); }
  .submit { justify-self: start; min-width: 50%; margin-top: calc(var(--u) * 0.5); }
  .trust {
    margin-top: var(--u);
    color: var(--mark-muted);
  }

  .direct {
    display: grid;
    align-content: start;
    row-gap: var(--u);
    padding-block: var(--u);
    margin-top: calc(var(--u) * 2);
  }
  .mail {
    font-family: var(--font-display);
    font-weight: 700;
    overflow-wrap: anywhere;
    justify-self: start;
  }
  .fine { max-width: 22em; font-weight: 400; letter-spacing: 0; }

  @media (min-width: 640px) {
    .form-col { grid-column: 1 / 5; }
    .direct { grid-column: 3 / -1; }
  }
  @media (min-width: 1024px) {
    .form-col { grid-column: 3 / 9; grid-row: 1; }
    /* A full-bleed right field: from column 10 out to the viewport edge, its
       top exactly on the section's rule (the section's half-line padding
       pulled back), its text a gutter inside the field's edge. The fill runs
       right only: a left spread would cover the form. */
    .sw-bleed.direct {
      grid-column: 10 / -1;
      grid-row: 1;
      margin-top: calc(var(--u) * -0.5);
      padding-inline: var(--gutter);
      box-shadow: 100vw 0 0 100vw var(--bleed-fill);
      clip-path: inset(0 -200vw 0 0);
    }
  }
</style>
