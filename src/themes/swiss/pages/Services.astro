---
/** Swiss services: the claim at poster scale, the two offerings as equal
    fields side by side, the process as a timetable (each step a full-width
    row, its numeral a giant on the left, a departures board and not four
    equal columns), and the ask in the red. */
import type { CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';

interface Props { copy: CopyData<'services'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
---
<section class="sw-row hero">
  <p class="sw-kicker hero-kicker">{copy.kicker}</p>
  <h1 class="sw-display title">{copy.heading}</h1>
  {copy.sublines.map((line, i) => <p class={`subline subline${i + 1}`}>{line}</p>)}
</section>

<section class="sw-row sw-sec offerings">
  {copy.offerings.map((offering) => (
    <div class="offering">
      <h2 class="sw-lead offering-title">{offering.heading}</h2>
      <div class="sw-body offering-body">
        {offering.body.map((para) => <p>{para}</p>)}
      </div>
    </div>
  ))}
</section>

<section class="sw-row sw-sec process">
  <h2 class="sw-kicker kicker">{copy.process.heading}</h2>
  <ol class="steps">
    {copy.process.steps.map((step, i) => (
      <li class="step">
        <p class="num" aria-hidden="true">{i + 1}</p>
        <h3 class="step-title">{step.title}</h3>
        <p class="step-body">{step.body}</p>
      </li>
    ))}
  </ol>
</section>

<section class="sw-row close-wrap">
  <div class="sw-red close sw-bleed">
    <p class="sw-lead pull">{copy.pull}</p>
    <a class="sw-btn cta" href={hrefFor('contact', theme)}>{copy.cta}</a>
  </div>
</section>

<script>
  import { onMount } from '../../../lib/lifecycle';
  import { initNumeralHold } from '../toys';

  // Hold a numeral and its weight travels 100 to 900 (toys.ts, wave 3 task 21, P2).
  // The landmark is Services' own process list: the router runs every loaded
  // page's mount on each body, and only this page's body has it.
  onMount(() => initNumeralHold(document.querySelector('section.process')));
</script>

<style>
  .hero {
    padding-block: calc(var(--u) * 0.5) calc(var(--u) * 4);
    row-gap: var(--u);
    align-items: start;
  }
  .hero-kicker { margin-top: calc(var(--u) * 3); }
  /* Sized so "properly." holds one line of the frame at every width; cqw is
     the hero row's own width, the frame. */
  .title {
    font-size: min(18.5cqw, 13rem);
    max-width: 6.2em;
    margin-bottom: var(--u);
    /* Optical flush-left (S3): the first letter is a T (measured 0.0265em at
       width 100, 0.0215em at the phones' 85). */
    margin-inline-start: -0.0265em;
  }
  /* The title is not set flush line by line (Stage 6 wave 2, T4 C5). It wraps
     by measure ("Two things," over "done properly." from 640, a word a line
     on a phone), so the first letter of a line is the copy's, not the
     markup's, and a per-line step would hard-code today's breaks (the brief
     leaves copy-dependent breaks to the copy pass). The cost, measured from
     pixels: at most 2.1px at 1440 to 820 and 3.7px on "properly." at 390,
     against the 0 to 0.3px of the first line. */
  .subline { max-width: 26em; }
  /* Phones: "properly." fills the measure, cut condensed. */
  @media (max-width: 639.98px) {
    .title { font-size: calc(30.6cqw); --sw-s: 85; max-width: none; margin-inline-start: -0.0215em; }
  }
  @media (min-width: 640px) {
    .title { font-size: min(15.2cqw, 13rem); }
    .subline { grid-column: 3 / -1; }
  }
  @media (min-width: 1024px) {
    .title { font-size: min(12.5cqw, 13rem); }
    .subline1 { grid-column: 7 / 10; grid-row: 3; }
    .subline2 { grid-column: 10 / -1; grid-row: 3; }
  }

  /* The offerings: two equal fields, each a title at lead size over its body.
     Stacked on a phone, side by side from 640 on three columns each (six
     from 1024). */
  .offering { grid-column: 1 / -1; display: grid; row-gap: var(--u); align-content: start; }
  .offering-title { max-width: 14em; }
  @media (min-width: 640px) {
    .offering:nth-child(1) { grid-column: 1 / 4; }
    .offering:nth-child(2) { grid-column: 4 / -1; }
  }
  @media (min-width: 1024px) {
    .offering:nth-child(1) { grid-column: 1 / 7; }
    .offering:nth-child(2) { grid-column: 7 / -1; }
  }

  /* The process, a timetable (Stage 6, S8): four rows, each the full measure
     on the page's own columns, ruled between like the lines of a departures
     board. The numeral is the left-hand giant (the page's second, about one
     and a half times the title so the title stays the first, founder
     10-03-26); the title and the text hang from column lines to its right.
     Every row is whole lines tall (the numeral's line box rounds up to the
     line, the padding is a line in all), so the rules sit on the baseline
     grid. cqw is the process row's own width, the frame. */
  .process { container-type: inline-size; }
  .kicker { grid-column: 1 / -1; }
  .steps { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; }
  .step {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: start;
    grid-template-rows: auto auto 1fr;
    padding-block: calc(var(--u) * 0.5);
  }
  /* The rule is a pixel of the line above it, so the row gives that pixel up. */
  .step + .step { border-top: 1px solid var(--mark); padding-top: calc(var(--u) * 0.5 - 1px); }
  .num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: min(19cqw, 17rem);
    /* The line box is the digit's height (0.69em of ink) rounded up to the
       line, so each row is a whole number of lines; the glyph sits in it by
       half-leading, and the translate (no layout) puts the ink's top on the
       title's cap line: 3.8px is where the title's ink starts in its line
       (the round digits 2 and 3 land on the cap line, a pixel or less low,
       where a face overshoots), 0.369em is where this face's digit ink
       starts, measured from pixels, below the middle of a line box. The 1 has
       a flat top: it sits 0.0108em lower than the round digits (measured at
       1440, 1280, 1024 and 820: 2.7, 2.3, 2.0, 2.6px lower), so --sw-flat
       lifts it (Stage 6 wave 2, T6 C5). */
    --sw-l: round(up, 0.72em, var(--u));
    line-height: var(--sw-l);
    translate: 0 calc(3.8px - var(--sw-l) / 2 + 0.369em - var(--sw-flat, 0em));
    letter-spacing: -0.05em;
    grid-column: 1 / 4;
    grid-row: 1 / 4;
  }
  /* Optical flush-left (Stage 6, S3): each digit keeps its own left bearing
     (measured from pixels: 1 is 0.100em, 2 0.053, 3 0.045, 4 0.031 at width
     100), so each steps left by its own, and the ink starts on the column
     line the way the title's does. */
  /* Hold a numeral (toys.ts): once the script has it, the digit is a thing to
     press, and a long press on a phone is not a text selection or a menu. The
     weight is the script's, inline. On a mouse the pointer and a rule under the
     digit (the school's hover is an underline, as on its links) belong to the
     digit and a few pixels round it (toys.ts sets data-hot there), never to the
     three-column box it sits in. The rule is paint only and leaves the weight
     alone, so a press from a hover starts from the weight it sees. */
  .num[data-live] {
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  @media (hover: hover) and (pointer: fine) {
    .num[data-hot] { cursor: pointer; text-decoration: underline; text-decoration-thickness: 0.03em; text-underline-offset: 0.07em; }
  }
  .step:nth-child(1) .num { margin-inline-start: -0.1em; --sw-flat: 0.0108em; }
  .step:nth-child(2) .num { margin-inline-start: -0.053em; }
  .step:nth-child(3) .num { margin-inline-start: -0.045em; }
  .step:nth-child(4) .num { margin-inline-start: -0.031em; }
  .step-title {
    font-size: var(--fs-body);
    line-height: var(--u);
    letter-spacing: -0.01em;
    grid-column: 4 / 7;
    grid-row: 1;
  }
  .step-body { max-width: 24em; grid-column: 7 / -1; grid-row: 1; }

  /* Tablet, six columns: the numeral takes half the row; the title and the
     text stack on the other half. */
  @media (max-width: 1023.98px) {
    .num { font-size: min(34cqw, 15rem); grid-column: 1 / 4; }
    .step-title { grid-column: 4 / -1; grid-row: 1; }
    .step-body { grid-column: 4 / -1; grid-row: 2; margin-top: calc(var(--u) * 0.5); }
  }
  /* Phones, four columns: the numeral is a condensed giant on columns 1 and 2,
     five lines tall; the title sits beside it, and the text runs the full
     measure under both. */
  @media (max-width: 639.98px) {
    /* The bearings at the condensed cut (measured: 0.026em, 0.029, 0.018,
       0.010 at width 62). */
    .step:nth-child(1) .num { margin-inline-start: -0.026em; }
    .step:nth-child(2) .num { margin-inline-start: -0.029em; }
    .step:nth-child(3) .num { margin-inline-start: -0.018em; }
    .step:nth-child(4) .num { margin-inline-start: -0.010em; }
    .num {
      --sw-n: 62;
      font-stretch: calc(var(--sw-n) * 1%);
      font-size: calc(var(--u) * 5 / 0.687);
      --sw-l: calc(var(--u) * 5);
      translate: 0 calc(4.2px - var(--sw-l) / 2 + 0.369em - var(--sw-flat, 0em));
      grid-column: 1 / 3;
      grid-row: 1;
    }
    .step-title { grid-column: 3 / -1; grid-row: 1; }
    /* A whole line between the numeral and the text, so every row is a whole
       number of lines (it was half a line: 10.5, 11.5, 10.5, 9.5, and the
       rules fell between baselines; Stage 6 wave 2, T6 C6). */
    .step-body { grid-column: 1 / -1; grid-row: 2; max-width: none; margin-top: var(--u); }
  }

  .close-wrap { padding-bottom: calc(var(--u) * 4); }
  .close {
    display: grid;
    grid-template-columns: subgrid;
    row-gap: calc(var(--u) * 2);
    padding-block: var(--u);
  }
  :where(.close) > * { grid-column: 1 / -1; }
  .pull { max-width: 20em; }
  @media (min-width: 640px) {
    .cta { grid-column: 4 / -1; }
  }
  @media (min-width: 1024px) {
    .pull { grid-column: 1 / 10; }
    .cta { grid-column: 10 / -1; align-self: end; }
  }
</style>
