---
/** Swiss services: the claim at poster scale, the two offerings as equal
    fields side by side, the process as four numerals cut as wide as their
    columns (the page's second giant), and the ask in the red. */
import type { CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';

interface Props { copy: CopyData<'services'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
---
<section class="sw-row hero">
  <p class="sw-kicker hero-kicker">{copy.kicker}</p>
  <h1 class="sw-display title">{copy.heading}</h1>
  {copy.sublines.map((line, i) => <p class={`subline subline${i + 1}`}>{line}</p>)}
</section>

<section class="sw-row sw-sec offerings">
  {copy.offerings.map((offering) => (
    <div class="offering">
      <h2 class="sw-lead offering-title">{offering.heading}</h2>
      <div class="sw-body offering-body">
        {offering.body.map((para) => <p>{para}</p>)}
      </div>
    </div>
  ))}
</section>

<section class="sw-row sw-sec process">
  <h2 class="sw-kicker kicker">{copy.process.heading}</h2>
  <ol class="steps">
    {copy.process.steps.map((step, i) => (
      <li class="step">
        <p class="num" aria-hidden="true">{i + 1}</p>
        <h3 class="step-title">{step.title}</h3>
        <p class="step-body">{step.body}</p>
      </li>
    ))}
  </ol>
</section>

<section class="sw-row close-wrap">
  <div class="sw-red close sw-bleed">
    <p class="sw-lead pull">{copy.pull}</p>
    <a class="sw-btn cta" href={hrefFor('contact', theme)}>{copy.cta}</a>
  </div>
</section>

<style>
  .hero {
    padding-block: calc(var(--u) * 0.5) calc(var(--u) * 4);
    row-gap: var(--u);
    align-items: start;
  }
  .hero-kicker { margin-top: calc(var(--u) * 3); }
  /* Sized so "properly." holds one line of the frame at every width; cqw is
     the hero row's own width, the frame. */
  .title {
    font-size: min(18.5cqw, 13rem);
    max-width: 6.2em;
    margin-bottom: var(--u);
  }
  .subline { max-width: 26em; }
  /* Phones: "properly." fills the measure, cut condensed. */
  @media (max-width: 639.98px) {
    .title { font-size: calc(30.6cqw); font-stretch: 85%; max-width: none; }
  }
  @media (min-width: 640px) {
    .title { font-size: min(15.2cqw, 13rem); }
    .subline { grid-column: 3 / -1; }
  }
  @media (min-width: 1024px) {
    .title { font-size: min(12.5cqw, 13rem); }
    .subline1 { grid-column: 7 / 10; grid-row: 3; }
    .subline2 { grid-column: 10 / -1; grid-row: 3; }
  }

  /* The offerings: two equal fields, each a title at lead size over its body.
     Stacked on a phone, side by side from 640 on three columns each (six
     from 1024). */
  .offering { grid-column: 1 / -1; display: grid; row-gap: var(--u); align-content: start; }
  .offering-title { max-width: 14em; }
  @media (min-width: 640px) {
    .offering:nth-child(1) { grid-column: 1 / 4; }
    .offering:nth-child(2) { grid-column: 4 / -1; }
  }
  @media (min-width: 1024px) {
    .offering:nth-child(1) { grid-column: 1 / 7; }
    .offering:nth-child(2) { grid-column: 7 / -1; }
  }

  /* The process: the second giant, about one and a half times the title so
     the title stays the page's first giant (founder, 10-03-26). Sized from
     the step (a size container, so cqw is the field's own width); the title
     and text hang from the same column line beneath it. The kicker sits
     level above the row. */
  .kicker { grid-column: 1 / -1; }
  .steps { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; row-gap: calc(var(--u) * 2); }
  .step { grid-column: 1 / -1; container-type: inline-size; }
  .step + .step { border-top: 1px solid var(--mark); padding-top: calc(var(--u) * 0.5); }
  .num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(6rem, 10vw, 9rem);
    line-height: calc(var(--u) * 5);
    letter-spacing: -0.05em;
    margin-bottom: var(--u);
  }
  .step-title { font-size: var(--fs-body); line-height: var(--u); letter-spacing: -0.01em; margin-bottom: calc(var(--u) * 0.5); }
  .step-body { max-width: 24em; }
  @media (min-width: 640px) {
    /* Two to a row here, so every step carries its own rule. */
    .step { grid-column: span 3; }
    .step, .step + .step { border-top: 1px solid var(--mark); padding-top: calc(var(--u) * 0.5); }
    .num {
      font-size: min(48cqw, 16rem);
      line-height: 0.8;
      line-height: round(up, 0.8em, var(--u));
    }
  }
  @media (min-width: 1024px) {
    .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--gutter); }
    .step { grid-column: auto; }
    .step, .step + .step { border-top: 0; padding-top: 0; }
    .num { font-size: min(80cqw, 19.5rem); }
  }

  .close-wrap { padding-bottom: calc(var(--u) * 4); }
  .close {
    display: grid;
    grid-template-columns: subgrid;
    row-gap: calc(var(--u) * 2);
    padding-block: var(--u);
  }
  :where(.close) > * { grid-column: 1 / -1; }
  .pull { max-width: 20em; }
  @media (min-width: 640px) {
    .cta { grid-column: 4 / -1; }
  }
  @media (min-width: 1024px) {
    .pull { grid-column: 1 / 10; }
    .cta { grid-column: 10 / -1; align-self: end; }
  }
</style>
