---
/** Swiss services: the claim at poster scale, each offering as a row of a
    table (title against text), the process as four numbered columns. */
import type { CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';

interface Props { copy: CopyData<'services'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
---
<section class="sw-row hero">
  <p class="sw-idx" aria-hidden="true">01</p>
  <p class="sw-kicker hero-kicker">{copy.kicker}</p>
  <h1 class="sw-display title">{copy.heading}</h1>
  {copy.sublines.map((line, i) => <p class={`subline subline${i + 1}`}>{line}</p>)}
</section>

{copy.offerings.map((offering, i) => (
  <section class="sw-row sw-sec offering">
    <p class="sw-idx" aria-hidden="true">{`0${i + 2}`}</p>
    <h2 class="sw-display offering-title">{offering.heading}</h2>
    <div class="sw-body offering-body">
      {offering.body.map((para) => <p>{para}</p>)}
    </div>
  </section>
))}

<section class="sw-row sw-sec process">
  <p class="sw-idx" aria-hidden="true">{`0${copy.offerings.length + 2}`}</p>
  <h2 class="sw-kicker sw-vert kicker">{copy.process.heading}</h2>
  <ol class="steps">
    {copy.process.steps.map((step, i) => (
      <li class="step">
        <p class="num" aria-hidden="true">{i + 1}</p>
        <h3 class="step-title">{step.title}</h3>
        <p class="step-body">{step.body}</p>
      </li>
    ))}
  </ol>
</section>

<section class="sw-row close-wrap">
  <div class="sw-red close sw-bleed">
    <p class="sw-idx" aria-hidden="true">{`0${copy.offerings.length + 3}`}</p>
    <p class="sw-display pull">{copy.pull}</p>
    <a class="sw-btn cta" href={hrefFor('contact', theme)}>{copy.cta}</a>
  </div>
</section>

<style>
  .hero {
    padding-block: calc(var(--u) * 1.5) calc(var(--u) * 12);
    row-gap: calc(var(--u) * 3);
    align-items: start;
  }
  .hero-kicker { margin-top: calc(var(--u) * 8); }
  /* Sized so "properly." holds one line of the frame at every width. */
  .title {
    font-size: min(17vw, 13rem);
    max-width: 6.2em;
    margin-bottom: calc(var(--u) * 4);
  }
  .subline { max-width: 26em; }
  @media (min-width: 640px) {
    .title { font-size: min(14vw, 13rem); }
    .subline { grid-column: 3 / -1; }
  }
  @media (min-width: 1024px) {
    .title { font-size: min(11.5vw, 13rem); }
    .subline1 { grid-column: 7 / 10; grid-row: 4; }
    .subline2 { grid-column: 10 / -1; grid-row: 4; }
  }

  .offering-title {
    font-size: clamp(2.75rem, 6.4vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    max-width: 5em;
  }
  @media (min-width: 640px) {
    .offering-body { grid-column: 3 / -1; }
  }
  @media (min-width: 1024px) {
    .offering > .sw-idx { grid-column: 1 / 2; grid-row: 1; }
    .offering-title { grid-column: 2 / 7; grid-row: 1; }
    .offering-body { grid-column: 8 / -1; grid-row: 1; padding-top: 0.5em; }
  }

  /* The process: one numeral per column, cut large; the title and text hang
     from the same column line beneath it. */
  .steps { display: grid; grid-template-columns: subgrid; row-gap: calc(var(--u) * 5); }
  .step { grid-column: 1 / -1; }
  .step + .step { border-top: 1px solid var(--mark); padding-top: calc(var(--u) * 1.5); }
  .num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(6rem, 12vw, 11rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    margin-bottom: calc(var(--u) * 3);
  }
  .step-title { font-size: 1.375rem; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: calc(var(--u) * 1); }
  .step-body { max-width: 24em; }
  @media (min-width: 640px) {
    /* Two to a row here, so every step carries its own rule. */
    .step { grid-column: span 3; }
    .step, .step + .step { border-top: 1px solid var(--mark); padding-top: calc(var(--u) * 1.5); }
  }
  @media (min-width: 1024px) {
    .process > .sw-idx { grid-row: 1; }
    .kicker { grid-column: 1 / 2; grid-row: 2; }
    .steps { grid-column: 2 / -1; grid-row: 1 / 3; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--gutter); }
    .step { grid-column: auto; }
    .step, .step + .step { border-top: 0; padding-top: 0; }
  }

  .close-wrap { padding-bottom: calc(var(--u) * 12); }
  .close {
    display: grid;
    grid-template-columns: subgrid;
    row-gap: calc(var(--u) * 6);
    padding-block: calc(var(--u) * 3) var(--gutter);
  }
  :where(.close) > * { grid-column: 1 / -1; }
  .pull {
    font-size: clamp(2.5rem, 6.4vw, 7rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
    max-width: 10em;
  }
  .cta { padding-inline: calc(var(--u) * 2); }
  @media (min-width: 640px) {
    .cta { grid-column: 4 / -1; }
  }
  @media (min-width: 1024px) {
    .pull { grid-column: 1 / 11; }
    .cta { grid-column: 10 / -1; }
  }
</style>
