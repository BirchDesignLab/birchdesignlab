---
/** Swiss sent: one word at the full width of the sheet, its full stop in the
    red, and the reading text hung from a column line beneath it. */
import type { CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';

interface Props { copy: CopyData<'sent'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
const stop = copy.heading.endsWith('.');
const word = stop ? copy.heading.slice(0, -1) : copy.heading;
---
<section class="sw-row hero sent">
  <h1 class="sw-display title">{word}{stop && <span class="stop">.</span>}</h1>
  <p class="sw-lead body">{copy.body}</p>
  <a class="back" href={hrefFor('home', theme)}>{copy.back}</a>
</section>

<script>
  import { onMount } from '../../../lib/lifecycle';
  import { initStopDrag } from '../toys';

  // Drag the red full stop along the baseline (toys.ts, wave 3 task 21, P2).
  onMount(() => initStopDrag(document.querySelector<HTMLElement>('.sent .stop')));
</script>

<style>
  .sent {
    padding-block: calc(var(--u) * 0.5) calc(var(--u) * 5);
    row-gap: var(--u);
    align-items: start;
  }
  /* Sized so the word fills the frame without ever passing it; cqw is the
     row's own width, the frame. */
  .title {
    font-size: min(41.3cqw, 36rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    margin-top: calc(var(--u) * 3);
    margin-bottom: var(--u);
    /* Optical flush-left (S3): the S's measured bearing at this size. */
    margin-left: -0.0462em;
  }
  /* The page's one typographic mark, in the red field (never remapped).
     Drag the stop (toys.ts): an inline-block so it can carry a translate, with
     the same advance and baseline as the inline it was (always, so nothing
     moves when the script arrives). The hit area is a square round the dot (a
     dot is 17px at 390: under a fingertip), a pseudo-element out of flow, so
     it widens nothing. A vertical swipe that starts on it still scrolls
     (pan-y). */
  .stop { color: var(--red-field); display: inline-block; position: relative; }
  .stop[data-live] {
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  .stop[data-live]::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.02em;
    width: max(0.34em, 44px);
    height: max(0.34em, 44px);
    translate: -50% 0;
  }
  .stop[data-held] { cursor: grabbing; }
  .body { max-width: 20em; }
  .back { font-family: var(--font-display); font-weight: 700; justify-self: start; }
  @media (min-width: 640px) {
    .body, .back { grid-column: 3 / -1; }
  }
  @media (min-width: 1024px) {
    .body { grid-column: 8 / -1; }
    .back { grid-column: 8 / -1; }
  }
</style>
