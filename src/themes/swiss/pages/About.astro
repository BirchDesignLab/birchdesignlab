---
/** Swiss about: the name's meaning set beside the title at poster scale, the
    founder as a lead and two columns of text with the page's own capital
    turned up the frame edge, the manifesto in the red field that holds the
    Shining Tree. */
import { Image } from 'astro:assets';
import { rich, type CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';
/* The field's one image, and the only place it is named. To use another logo
   or photograph, swap this file (or this import) and set --fld-ratio on
   .manifesto to the new image's height over width. It is decorative, so it
   has no alt. Made by scripts/themes/swiss/make-field-image.mjs. */
import fieldImage from '../../../assets/swiss-field.webp';

interface Props { copy: CopyData<'about'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
const [founderLead, ...founderRest] = copy.founder.body;
---
<section class="sw-row hero">
  <h1 class="sw-display title">
    {copy.heading.split(' ').map((word, i) => <>{i > 0 && ' '}<span class="ln">{word}</span></>)}
  </h1>
  <div class="etym sw-body">
    {copy.etymology.map((para) => <p set:html={rich(para)} />)}
  </div>
</section>

<section class="sw-row sw-sec founder">
  <h2 class="sw-kicker kicker">{copy.founder.heading}</h2>
  <p class="sw-lead founder-lead">{founderLead}</p>
  {founderRest.map((para, i) => <p class={`founder-p founder-p${i + 1}`}>{para}</p>)}
  <span class="sw-birch" aria-hidden="true">Birch</span>
</section>

<section class="sw-row manifesto-wrap">
  <div class="sw-red manifesto">
    <Image
      class="field-img"
      src={fieldImage}
      alt=""
      widths={[480, 760, 1120, 1597]}
      sizes="(min-width: 1280px) 560px, (min-width: 1024px) 400px, min(72vw, 380px)"
      quality={82}
      loading="lazy"
      decoding="async"
    />
    <p class="sw-lead manifesto-text">{copy.manifesto}</p>
    <a class="sw-btn cta" href={hrefFor('contact', theme)}>{copy.cta}</a>
  </div>
</section>

<script>
  import { onMount } from '../../../lib/lifecycle';

  /* The rotated word runs the height of the founder section, and that height
     is set by the text, which reflows. Measure it and write it to --sw-sec-h;
     the word is absolutely positioned, so it never feeds back into the
     height. The clamp in the CSS is the no-script fallback. */
  onMount(() => {
    if (document.documentElement.dataset.theme !== 'swiss') return;
    const sec = document.querySelector<HTMLElement>('.founder');
    if (!sec || !sec.querySelector('.sw-birch')) return;
    const fit = () => sec.style.setProperty('--sw-sec-h', `${sec.getBoundingClientRect().height}px`);
    const ro = new ResizeObserver(fit);
    ro.observe(sec);
    fit();
    return () => ro.disconnect();
  });
</script>

<style>
  .hero {
    padding-block: calc(var(--u) * 0.5) calc(var(--u) * 4);
    row-gap: calc(var(--u) * 2);
    align-items: start;
  }
  .title {
    font-size: min(28.3cqw, 16rem);
    margin-top: calc(var(--u) * 3);
  }
  /* Phones: the title is cut condensed to fill the measure (cqw is the hero
     row's own width, the frame). */
  @media (max-width: 639.98px) {
    .title { font-size: calc(36.3cqw); font-stretch: 85%; }
  }
  /* The one strong phrase in the etymology ("to shine") is bold ink. */
  .etym :global(strong) { font-weight: 700; }
  .etym :global(p:first-child) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-lead);
    line-height: calc(var(--u) * 1.5);
    letter-spacing: -0.02em;
  }
  .etym :global(p + p) { margin-top: var(--u); }

  @media (min-width: 640px) {
    .etym { grid-column: 3 / -1; }
  }
  @media (min-width: 1024px) {
    /* 'shining' is ~3.17em wide: sized to hold cols 1-8, clear of the etymology. */
    .title { grid-row: 1; grid-column: 1 / 9; font-size: min(20.5cqw, 16rem); }
    .etym { grid-row: 1; grid-column: 9 / -1; align-self: end; }
  }

  /* 02: the founder. A level kicker, the lead, and two columns of text that
     run out to the frame edge. From 1024 the first two columns belong to the
     rotated word. */
  .founder { position: relative; }
  .founder-lead { max-width: 24em; }
  .founder-p { max-width: 32em; }
  @media (min-width: 640px) {
    .kicker, .founder-lead, .founder-p { grid-column: 2 / -1; }
  }
  @media (min-width: 1024px) {
    .kicker { grid-column: 3 / -1; grid-row: 1; }
    .founder-lead { grid-column: 3 / -1; grid-row: 2; }
    .founder-p1 { grid-column: 3 / 8; grid-row: 3; }
    .founder-p2 { grid-column: 8 / -1; grid-row: 3; }
  }

  /* The rotated word: the page's own capital, set heavy and turned up the
     frame edge so it runs the height of section 02. Decorative. Its size is
     height over (advance x ink ratio), both per width cut, from the proof
     (proofs/swiss-rotated.md); --sw-ty drops it and --sw-tx shifts it right by the
     measured left bearing (scripts/themes/swiss/measure-birch-ink.mjs), so the ink, not the
     bearing, sits on the section's edges. Dropped under 640, where a spine
     is a stub, not a word that runs the height of anything. */
  .sw-birch {
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    /* Vertical writing mode plus a half turn: bottom to top, the way a spine
       label runs up a poster's edge. */
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: calc(var(--sw-bwdth) * 1%);
    line-height: 0.74;
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: var(--mark);
    pointer-events: none;
    user-select: none;
    overflow: visible;
    font-size: calc(var(--sw-sec-h) / (var(--sw-birch-r) * var(--sw-k)));
    translate: var(--sw-tx) var(--sw-ty);
  }
  /* Width cuts of the axis (weight 900): r is the advance of "Birch" in ems,
     k the ink over advance, ty the drop. */
  .founder { --sw-sec-h: clamp(430px, 575px - 9vw, 500px); }
  .sw-birch { --sw-bwdth: 105; --sw-birch-r: 2.816; --sw-k: 0.9622; --sw-ty: 0.0777em; --sw-tx: 0.032em; }
  @media (min-width: 640px) and (max-width: 1023.98px) {
    /* Column 1 is too narrow for the word: it gets a gutter of its own, the
       widest cut, and the text steps right by --sw-tab-shift. */
    .sw-birch { display: block; --sw-bwdth: 125; --sw-birch-r: 3.2211; --sw-k: 0.9677; --sw-ty: 0.073em; --sw-tx: 0.025em; }
    .founder { --sw-tab-shift: max(0px, 162px - 15.43vw); }
    .kicker, .founder-lead, .founder-p { margin-left: var(--sw-tab-shift); }
  }
  @media (min-width: 1024px) {
    .sw-birch { display: block; }
  }
  @media (min-width: 1280px) {
    .sw-birch { --sw-bwdth: 75; --sw-birch-r: 2.064; --sw-k: 0.9683; --sw-ty: 0.0564em; --sw-tx: 0.030em; }
  }
  @media (min-width: 1440px) {
    .sw-birch { --sw-bwdth: 62; --sw-birch-r: 1.725; --sw-k: 0.9775; --sw-ty: 0.039em; --sw-tx: 0.028em; }
  }

  /* The manifesto: a true viewport-bleed red field. Its content keeps to the
     frame's columns (the padding gives back what the negative margin takes);
     the tree is the field's image, an <img> so the browser can load it late.
     Phone and tablet: the tree is a band across the top, the type on flat
     red below it. */
  .manifesto-wrap { padding-bottom: calc(var(--u) * 4); }
  .manifesto {
    /* Height over width of the field image. */
    --fld-ratio: 1.7244;
    --fld-w: min(72vw, 380px);
    position: relative;
    overflow: clip;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: calc(var(--u) * 2);
    margin-inline: calc(50% - 50vw);
    padding-inline: calc(50vw - 50%);
    padding-block: calc(var(--fld-w) * var(--fld-ratio) + var(--u)) var(--u);
  }
  :where(.manifesto) > * { grid-column: 1 / -1; }
  .manifesto > :not(.field-img) { position: relative; z-index: 1; }
  .manifesto :global(.field-img) {
    position: absolute;
    z-index: 0;
    grid-column: auto;
    top: 0;
    left: calc((100% - var(--fld-w)) * 0.62);
    width: var(--fld-w);
    height: auto;
    max-width: none;
    pointer-events: none;
  }
  .manifesto-text { max-width: 20em; }
  @media (min-width: 640px) {
    .manifesto :global(.field-img) { left: calc((100% - var(--fld-w)) * 0.78); }
    .cta { grid-column: 4 / -1; }
  }
  @media (min-width: 1024px) {
    /* The tree stands on the right, cropped by the sheet edge; the manifesto
       keeps to the left columns on flat red. The extra height is free space
       under the stack, not stretched rows. */
    .manifesto {
      padding-block: calc(var(--u) * 1.5) var(--u);
      min-height: clamp(640px, 54vw, 1000px);
      align-content: start;
    }
    .manifesto :global(.field-img) {
      left: auto;
      right: 3vw;
      width: auto;
      height: 100%;
    }
    .manifesto-text {
      grid-column: 1 / 7;
    }
    .cta { grid-column: 1 / 4; }
  }
  @media (min-width: 1280px) {
    .manifesto :global(.field-img) { top: -2%; height: 108%; }
    .manifesto-text {
      grid-column: 1 / 8;
    }
  }
</style>
