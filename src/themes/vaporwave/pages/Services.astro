---
/** Vaporwave services: a desktop. The two offerings are two applications,
    a program and a web browser, open and overlapping; the process is a setup
    wizard with its progress bar; the ask sits on a lobby floor (F1(b): the
    sunset stays the Home hero's alone). */
import type { CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';
import Win from '../parts/Win.astro';
import Lobby from '../parts/Lobby.astro';

interface Props { copy: CopyData<'services'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
const apps = [
  { title: 'custom_software.exe', menu: ['File', 'Edit', 'View', 'Tools', 'Help'] },
  { title: 'web_design.htm', address: 'http://www.your-business.example/' },
];
const steps = copy.process.steps.length;
---
<section class="intro vw-wrap">
  <p class="vw-kicker">{copy.kicker}</p>
  <h1>{copy.heading}</h1>
  <div class="sublines">
    {copy.sublines.map((line) => <p>{line}</p>)}
  </div>
  <p class="intro-kana" aria-hidden="true">サービス</p>
</section>

<section class="apps vw-wrap">
  {copy.offerings.map((offering, i) => (
    <Win
      tag="article"
      title={apps[i]?.title ?? 'untitled.exe'}
      menu={apps[i]?.menu}
      address={apps[i]?.address}
      class={`app app-${i}`}
      inactive={i === 0}
    >
      <h2>{offering.heading}</h2>
      <div class="app-body">
        {offering.body.map((para) => <p>{para}</p>)}
      </div>
    </Win>
  ))}
</section>

<section class="wizard vw-wrap">
  {/* E14: one mixed-script decorative title bar. */}
  <Win title="サービス setup.exe" class="wizard-win">
    <h2>{copy.process.heading}</h2>
    <ol class="steps">
      {copy.process.steps.map((step, i) => (
        <li class="step">
          <p class="step-count" aria-hidden="true">{`STEP ${i + 1}/${steps}`}</p>
          <div class="meter" aria-hidden="true">
            {Array.from({ length: 12 }, (_, s) => <span class={s < Math.round(((i + 1) / steps) * 12) ? 'on' : undefined}></span>)}
          </div>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </Win>
</section>

<section class="ask">
  <div class="ask-inner vw-wrap">
    <p class="pull">{copy.pull}</p>
    <a class="vw-btn" href={hrefFor('contact', theme)}>{copy.cta}</a>
  </div>
  <div class="ask-band"><Lobby class="ask-lobby" /></div>
</section>

<script>
  import { onMount } from '../../../lib/lifecycle';
  import { mountWindowDrag } from '../windows';

  onMount(mountWindowDrag);
</script>

<style>
  /* ---------- intro ---------- */
  .intro {
    position: relative;
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(3rem, 6vw, 4.5rem);
  }
  /* E10: the chromatic split scales with the type instead of a flat 3px. */
  h1 {
    position: relative; z-index: 1;
    margin-top: 1.2rem; max-width: 12ch;
    --chroma: clamp(1px, 0.03em, 3px);
    font-family: var(--font-display); font-size: clamp(3rem, 8vw, 6.4rem); line-height: 0.98;
    text-shadow: calc(-1 * var(--chroma)) 0 0 color-mix(in srgb, var(--neon-cyan) 55%, transparent), var(--chroma) 0 0 color-mix(in srgb, var(--neon-pink) 55%, transparent);
  }
  @media (max-width: 700px) {
    h1 { text-shadow: calc(-1 * var(--chroma)) 0 0 color-mix(in srgb, var(--neon-cyan) 30%, transparent), var(--chroma) 0 0 color-mix(in srgb, var(--neon-pink) 30%, transparent); }
  }
  .sublines {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem 3rem;
    margin-top: 2.2rem; max-width: 60rem;
  }
  .sublines p { font-size: 1.12rem; color: var(--mark-muted); padding-left: 1rem; border-left: 3px solid var(--accent); }
  .sublines p + p { border-left-color: var(--link); }
  .intro-kana {
    position: absolute; right: var(--gutter); top: clamp(2.5rem, 6vw, 4.5rem);
    writing-mode: vertical-rl;
    /* E5: var(--font-kana), not the literal family name (kana-font-not-dela
       / fallback-injection corruption in this component <style> block).
       Weight stays 900: outlined display kana (transparent fill, stroke),
       not filled text. */
    font-family: var(--font-kana); font-weight: 900;
    font-size: clamp(3rem, 9vw, 7.5rem); line-height: 1; letter-spacing: 0.06em;
    color: transparent; -webkit-text-stroke: 1.5px var(--accent); opacity: 0.7;
  }

  /* ---------- the two applications, overlapping ---------- */
  .apps {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr));
    padding-block: 1rem clamp(4rem, 8vw, 6rem);
  }
  .apps :global(.app-0) { grid-column: 1 / span 7; grid-row: 1; z-index: 1; }
  /* E4: custom_software.exe sizes to its own content (no reserved slab).
     The overlap is kept inside app-0's own bottom padding (.vw-win-body's
     clamp tops out at 2.25rem), so the front window covers only that
     whitespace, never text, and the back window is exactly as tall as its
     copy needs. */
  .apps :global(.app-1) { grid-column: 5 / span 8; grid-row: 2; margin-top: -2.1rem; z-index: 2; }
  .apps h2 {
    font-family: var(--font-display); font-size: clamp(2.1rem, 4vw, 3.2rem); line-height: 1.05;
    margin-bottom: 1.2rem;
  }
  .app-body { display: grid; gap: 1rem; }
  .app-body p { color: var(--mark-muted); }
  .app-body p:first-child { color: var(--mark); }

  /* ---------- setup wizard ---------- */
  .wizard { padding-bottom: clamp(4rem, 8vw, 6rem); }
  .wizard h2 {
    font-family: var(--font-display); font-size: clamp(2.1rem, 4vw, 3.2rem); line-height: 1.05;
    margin-bottom: 2rem;
  }
  .steps {
    list-style: none; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem;
  }
  .step-count { font-family: var(--font-mono); font-size: 1.3rem; line-height: 1; color: var(--accent); letter-spacing: 0.1em; }
  /* A blocky progress bar that fills a quarter more with each step. */
  .meter {
    display: grid; grid-template-columns: repeat(12, 1fr); gap: 2px;
    margin-block: 0.6rem 1.1rem; padding: 3px;
    background: var(--field-sunk);
    border: 2px solid; border-color: var(--bevel-lo) var(--field-bevel-hi) var(--field-bevel-hi) var(--bevel-lo);
  }
  .meter span { height: 12px; }
  .meter .on { background: linear-gradient(180deg, var(--neon-pink), var(--neon-lav)); }
  .step:last-child .meter .on { background: linear-gradient(180deg, var(--neon-mint), var(--neon-cyan)); }
  .step h3 {
    font-size: 1rem; font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .step p:last-child { color: var(--mark-muted); font-size: 1rem; }

  /* ---------- the ask ---------- */
  .ask { position: relative; overflow: hidden; }
  /* F1(b): a lobby closer, not a second sunset; Home keeps the one sunset. */
  .ask-band { position: relative; height: clamp(240px, 28vw, 380px); margin-top: 1.5rem; }
  .ask-inner {
    position: relative; z-index: 1;
    display: grid; justify-items: center; gap: 2rem; text-align: center;
    padding-top: clamp(2rem, 5vw, 4rem);
  }
  .pull { max-width: 20ch; font-family: var(--font-display); font-size: clamp(2.2rem, 5vw, 4rem); line-height: 1.08; }

  @media (max-width: 960px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .sublines { grid-template-columns: 1fr; }
    .intro-kana { display: none; }
    /* minmax(0, 1fr): a bare 1fr track keeps the grid item's default
       min-width:auto, so custom_software.exe's own menu bar (an unbreakable
       min-content row) could push the page past a narrow viewport. */
    .apps { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .apps :global(.app-0), .apps :global(.app-1) { grid-column: 1; grid-row: auto; margin-top: 0; }
    .steps { grid-template-columns: 1fr; }
  }
</style>
