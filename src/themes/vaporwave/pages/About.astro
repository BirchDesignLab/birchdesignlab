---
/** Vaporwave about: a small temple. Marble columns flank the heading, the
    birch rune is cut into a tablet beside its own etymology, the founder's
    note is a text file, and the manifesto is an inscription on a plinth. */
import { rich, type CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';
import Win from '../parts/Win.astro';
import Column from '../parts/Column.astro';
import Marble from '../parts/Marble.astro';
import Meander from '../parts/Meander.astro';
import Rune from '../parts/Rune.astro';
import Still from '../parts/Still.astro';
import bustAvif from '../stills/venus-1024.avif?url';
import bustWebp from '../stills/venus-1024.webp?url';

interface Props { copy: CopyData<'about'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
const [etymLead, ...etymRest] = copy.etymology;
const [founderLead, ...founderRest] = copy.founder.body;
---
<header class="temple">
  <div class="sky" aria-hidden="true"><div class="vw-sun temple-sun"></div></div>
  <Column id="col-l" class="col col-l" seed={5} />
  <Column id="col-r" class="col col-r" seed={23} />
  <div class="temple-title">
    <p class="vw-kana kana" aria-hidden="true">シャイニング・ツリー</p>
    <h1>{copy.heading}</h1>
  </div>
  {/* F3 staging (B2). The Venus is rendered live-quality by the shared scene
      module (src/themes/vaporwave/marble/scene.js) at the exact
      camera/yaw/lighting the live bust's first frame uses (seat vw-4a). The
      <picture> in .centerpiece-stage is that pose's poster: what a no-JS
      visitor, the drawn-ahead copy, and a blank/lost canvas all show.
      data-marble-canvas is where the live bust mounts (seat vw-4b,
      marble/live-bust.ts, loaded only once the centrepiece nears the
      viewport): it sits behind the poster in the identical box, already
      drawing the identical pose, before the poster fades to reveal it, so
      there is no visible jump. */}
  {/* B2 fix round, item 4 (a11y): aria-hidden used to sit on this whole
      .centerpiece wrapper, which hides everything under it from assistive
      tech regardless of any descendant's own aria-hidden="false" -- so the
      live canvas, once marble/live-bust.ts gives it a role, label and
      tabindex 0, was a focusable control permanently hidden from AT (an
      aria-hidden-focus fault; the W1 critic caught it). aria-hidden now sits
      only on the decorative children (the poster, the stepped tiers); the
      canvas keeps its OWN aria-hidden="true" + tabindex="-1" (set below,
      live-bust.ts's setLiveA11y removes both once it takes over the canvas
      itself) and is never inside an aria-hidden ancestor either way. */}
  <div class="centerpiece">
    <div class="centerpiece-stage" data-marble-stage>
      <canvas class="centerpiece-canvas" data-marble-canvas aria-hidden="true" tabindex="-1"></canvas>
      <div class="centerpiece-poster" data-marble-poster aria-hidden="true">
        <Still class="centerpiece-prop" avif={bustAvif} webp={bustWebp} size={1024} />
      </div>
    </div>
    <div class="centerpiece-steps" aria-hidden="true">
      <div class="tier tier-top"><Marble id="cp-tier-top" seed={31} /><div class="tier-gloss"></div></div>
      <div class="tier tier-mid"><Marble id="cp-tier-mid" seed={37} /><div class="tier-gloss"></div></div>
      <div class="tier tier-base"><Marble id="cp-tier-base" seed={43} /><div class="tier-gloss"></div></div>
    </div>
  </div>
  <Meander id="meander-top" class="frieze" />
</header>

<section class="etym vw-wrap">
  <p class="etym-lead" set:html={rich(etymLead)} />
  <div class="etym-grid">
    <Rune class="rune" />
    <Win title="beorc.txt" class="etym-win">
      {etymRest.map((para) => <p set:html={rich(para)} />)}
    </Win>
  </div>
</section>

<section class="founder vw-wrap">
  <Win tag="article" title="founder.txt" menu={['File', 'Edit', 'Search', 'Help']}>
    <h2>{copy.founder.heading}</h2>
    <p class="founder-lead">{founderLead}</p>
    <div class="founder-body">
      {founderRest.map((para) => <p>{para}</p>)}
    </div>
  </Win>
</section>

<section class="plinth-wrap vw-wrap">
  <div class="plinth">
    <Marble id="plinth" seed={41} />
    <Meander id="meander-plinth" class="plinth-frieze" />
    <p class="manifesto">{copy.manifesto}</p>
  </div>
  <div class="plinth-base" aria-hidden="true">
    <div class="tier tier-1"></div>
    <div class="tier tier-2"></div>
  </div>
  <a class="vw-btn" href={hrefFor('contact', theme)}>{copy.cta}</a>
</section>

<style>
  /* ---------- the temple header ---------- */
  .temple {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: clamp(460px, 62vh, 640px);
    display: grid; justify-items: center;
    padding: clamp(3rem, 8vh, 5rem) var(--gutter) 3.5rem;
  }
  .sky {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, var(--hz-sky-top) 0, var(--hz-sky-mid) 62%, var(--hz-horizon) 100%);
  }
  /* The sun sets between the columns, behind the frieze. */
  .temple-sun {
    position: absolute; left: 50%; bottom: 0; width: min(60vw, 420px);
    translate: -50% 34%;
  }
  .temple :global(.col) { position: absolute; bottom: 28px; height: calc(100% - 6rem); width: auto; max-width: none; }
  .temple :global(.col-l) { left: max(2%, calc(50% - 560px)); }
  .temple :global(.col-r) { right: max(2%, calc(50% - 560px)); }
  .temple-title { position: relative; align-self: start; text-align: center; max-width: min(100%, 52rem); }
  .kana { font-size: 0.85rem; letter-spacing: 0.8em; margin-right: -0.8em; color: var(--neon-pink); }
  :global([data-scheme='light']) .kana { color: var(--accent); }
  /* E10: the chromatic split scales with the type instead of a flat 3px, so
     it never triples a phone's smaller heading; the alpha drops under 700px
     too, so the fringe stays a hint rather than a third colour. */
  h1 {
    margin-top: 1rem;
    --chroma: clamp(1px, 0.03em, 3px);
    font-family: var(--font-display); font-size: clamp(3rem, 8.5vw, 7rem); line-height: 0.98;
    color: var(--bb-plain);
    text-shadow: calc(-1 * var(--chroma)) 0 0 color-mix(in srgb, var(--neon-cyan) 70%, transparent), var(--chroma) 0 0 color-mix(in srgb, var(--neon-pink) 70%, transparent);
  }
  @media (max-width: 700px) {
    h1 { text-shadow: calc(-1 * var(--chroma)) 0 0 color-mix(in srgb, var(--neon-cyan) 40%, transparent), var(--chroma) 0 0 color-mix(in srgb, var(--neon-pink) 40%, transparent); }
  }
  .temple :global(.frieze) { position: absolute; left: 0; right: 0; bottom: 0; color: var(--neon-pink); background: var(--field-top); }

  /* The centrepiece: a stepped museum plinth between the columns, holding
     the Venus (B2, seat vw-4a; a Tier A stand-in sphere held the spot before
     this). */
  .centerpiece {
    position: absolute; left: 50%; bottom: 34px; translate: -50% 0; z-index: 1;
    display: grid; justify-items: center; width: clamp(160px, 20vw, 260px);
  }
  /* Re-measured for the Venus poster (B2): measure-still-bbox.mjs --solid
     (alpha >= 200/255, the opaque silhouette alone, not the still's own
     baked contact shadow - the method the sphere stand-in's own
     about-sphere-floats fix round 2 established) puts the Venus's own
     plinth-cut base 18.1% up from the canvas's bottom (venus-1024), against
     25.7% for the old stand-in sphere. That measured figure still left a
     hairline gap once composited against the plinth's own rendered
     perspective (checked by eye, per fix round 2's own method); nudged to
     22% closes it with no overlap at desktop, 820 and 390. translateY moves
     the box (paint only, not layout) down by that fraction, so the bust's
     own cut base - not the shadow's fading tail - lands flush on the tier
     below. z-index keeps the stage (and its shadow) painting over the tiers
     where they now overlap.
     .centerpiece-stage carries the box the poster used to carry alone
     (width, translateY, an aspect-ratio square to replace the height a
     lone <picture> got for free from its own image); the live bust's
     <canvas> (vw-4b, marble/live-bust.ts) and the poster now share it
     exactly, canvas underneath, so the first live frame and the poster's
     pixels sit in the identical box with no reflow between them. */
  /* The drop shadow lives here now, not on .centerpiece-prop (fix round,
     item 3): it used to sit on the poster image alone, so the handoff to the
     live canvas -- which carries no filter of its own -- dropped it outright,
     one of the two causes behind the ~11% pixel change the W1 critic
     measured. One filter on the wrapper both layers share gives the poster
     and the live canvas the identical shadow at every moment, including
     mid-fade when both are visible together. */
  .centerpiece-stage {
    width: 84%; position: relative; z-index: 2; aspect-ratio: 1 / 1;
    transform: translateY(22%);
    filter: drop-shadow(0 10px 8px rgba(0, 0, 0, 0.3));
  }
  .centerpiece-canvas {
    position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1;
    /* Decorative until marble/live-bust.ts hands it a live role (see its
       setLiveA11y): plain elements only, no focusable content, per the
       README's "a control that does nothing" rule. cursor stays the
       platform default until then (fix round, item 5: no grab cursor before
       the bust is live) -- setLiveA11y's own aria-hidden toggle is the one
       signal already available in CSS, so it doubles as the "is live" flag
       here instead of a second class. */
    cursor: default; touch-action: pan-y; user-select: none;
  }
  .centerpiece-canvas:not([aria-hidden='true']) { cursor: grab; }
  .centerpiece-canvas.is-dragging { cursor: grabbing; }
  .centerpiece-poster {
    position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2;
    pointer-events: none;
  }
  :global(.centerpiece-prop) {
    width: 100%; height: 100%;
  }
  /* A real stepped plinth: three tiers of the same procedural, pastel-tinted
     marble the rune plaque is cut from (Marble.astro: SVG turbulence stone
     with the pink/cyan corner tint), each with a diagonal glossy sheen. */
  .centerpiece-steps { position: relative; width: 100%; }
  .centerpiece-steps .tier {
    position: relative; overflow: hidden; margin-inline: auto;
    border: 1px solid; border-color: var(--bevel-hi) var(--bevel-lo) var(--bevel-lo) var(--bevel-hi);
  }
  .centerpiece-steps .tier-gloss {
    position: absolute; inset: 0; pointer-events: none; mix-blend-mode: screen;
    background: linear-gradient(115deg, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0.1) 42%, transparent 64%);
  }
  .centerpiece-steps .tier-top { width: 70%; height: 20px; }
  .centerpiece-steps .tier-mid { width: 86%; height: 18px; margin-top: -1px; }
  .centerpiece-steps .tier-base {
    width: 100%; height: 20px; margin-top: -1px;
    box-shadow: 0 16px 20px -10px rgba(0, 0, 0, 0.4);
  }

  /* ---------- etymology ---------- */
  .etym { padding-block: clamp(3.5rem, 8vw, 6rem) clamp(3rem, 6vw, 4.5rem); }
  .etym-lead {
    max-width: 30ch; margin-inline: auto; text-align: center;
    font-family: var(--font-display); font-size: clamp(1.7rem, 3.4vw, 2.6rem); line-height: 1.25;
  }
  /* Caslon Display has no italic, so emphasis changes colour instead of
     slanting into a faux oblique. */
  .etym-lead :global(em) { font-style: normal; color: var(--link); }
  .etym-lead :global(strong) { font-weight: 400; color: var(--accent); }
  .etym-grid {
    display: grid; grid-template-columns: minmax(180px, 280px) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem);
    align-items: center; margin-top: clamp(3rem, 7vw, 5rem);
  }
  .etym-grid p { font-size: 1.1rem; }
  .etym-grid p :global(em) { color: var(--link); }
  .etym-grid p :global(strong) { color: var(--accent); }

  /* ---------- founder ---------- */
  .founder { padding-block: clamp(1rem, 4vw, 3rem) clamp(4rem, 8vw, 6rem); }
  .founder h2 {
    font-family: var(--font-display); font-size: clamp(2.2rem, 4.5vw, 3.4rem); line-height: 1.05;
    margin-bottom: 1.5rem;
  }
  /* A .txt file's lead line, full width, then the rest flowing in balanced
     columns instead of one long column and one short one. */
  .founder-lead { max-width: 60ch; font-size: 1.35rem; color: var(--mark); margin-bottom: 1.5rem; }
  .founder-body { columns: 2 22rem; column-fill: balance; column-gap: 3rem; }
  .founder-body p { break-inside: avoid; margin-bottom: 1.1rem; color: var(--mark-muted); }

  /* ---------- the plinth (E12) ---------- */
  .plinth-wrap { display: grid; justify-items: center; padding-bottom: 2rem; }
  /* Marble is statuary, not a window: no offset drop shadow on the slab
     itself (that read moved to the stepped base below it instead). */
  .plinth {
    position: relative; overflow: hidden; width: 100%; max-width: 980px;
    padding: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 6vw, 5rem);
    border: 2px solid; border-color: #ffffff #7d6aa2 #7d6aa2 #ffffff;
  }
  .plinth :global(.plinth-frieze) { position: absolute; left: 0; right: 0; top: 0.9rem; color: color-mix(in srgb, var(--inscription) 55%, transparent); }
  /* Cut into the stone: deep ink with a pale lower lip, like a chiselled
     groove. Balanced into two lines rather than one ragged block. */
  .manifesto {
    position: relative; text-align: center;
    text-wrap: balance;
    /* Sized to land this copy's length in two balanced lines within the
       plinth (E12), rather than the four short ones the old, larger size
       wrapped into. */
    font-family: var(--font-display); font-size: clamp(1.3rem, 2.3vw, 1.75rem); line-height: 1.35;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--inscription);
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.85);
  }
  /* A deliberate stepped base: two tiers, each wider than the plaque above
     it by about 12px a side, instead of one flat neon bar. An explicit width
     here (matching .plinth's own track) gives the tiers' percentage widths
     something definite to resolve against; without it an auto-width grid
     item collapses to its content's own size and the percentages below
     resolve against nothing, not the wide base the steps need. */
  .plinth-base {
    display: grid; justify-items: center; margin-bottom: 3rem;
    width: 100%; max-width: calc(980px + 2.5rem);
  }
  .plinth-base .tier {
    height: 16px;
    background: linear-gradient(90deg, var(--neon-pink), var(--neon-lav), var(--neon-cyan));
    border: 1px solid; border-color: var(--bevel-hi) var(--bevel-lo) var(--bevel-lo) var(--bevel-hi);
  }
  /* The overhang is capped at twice the page gutter, so a narrow phone
     (where the gutter floors at 16px) never lets the base run past the
     viewport - found while checking the "no horizontal scroll" requirement
     at 390px, where the flat 2.5rem step overhung it by 4px a side. */
  .plinth-base .tier-1 { width: calc(min(100%, 980px) + min(1rem, 2 * var(--gutter))); }
  .plinth-base .tier-2 { width: calc(min(100%, 980px) + min(2.5rem, 2 * var(--gutter))); margin-top: -1px; }

  @media (max-width: 760px) {
    /* Scaled down and pulled fully on-screen: a whole column each side, not
       a sliced half read as a rendering accident. */
    .temple :global(.col) { height: 46%; opacity: 0.9; }
    .temple :global(.col-l) { left: 6px; }
    .temple :global(.col-r) { right: 6px; }
    .etym-grid { grid-template-columns: 1fr; }
    .etym-grid :global(.rune) { width: min(220px, 70%); margin-inline: auto; }
    .centerpiece { width: clamp(120px, 34vw, 180px); bottom: 24px; }
  }
</style>

<script>
  // Mounts the live Venus bust (marble/live-bust.ts) only once the
  // centrepiece nears the viewport and the main thread is idle, so three.js
  // and the GLB never ship on Home, Services or Contact -- this file itself
  // imports neither. onMount from src/lib/lifecycle.ts: on a plain load this
  // runs once; under the /t/ portal's ClientRouter it also runs for every
  // new body the router swaps in, and its teardown runs before that body is
  // replaced (so five in-school swaps must never accumulate five live
  // stages or five WebGL contexts).
  import { onMount } from '../../../lib/lifecycle';
  import type { LiveBustHandle } from '../marble/live-bust';

  onMount(() => {
    if (document.documentElement.dataset.theme !== 'vaporwave') return;

    const stageEl = document.querySelector<HTMLElement>('[data-marble-stage]');
    const canvas = document.querySelector<HTMLCanvasElement>('[data-marble-canvas]');
    const poster = document.querySelector<HTMLElement>('[data-marble-poster]');
    if (!stageEl || !canvas || !poster) return;

    let torn = false;
    let handle: LiveBustHandle | undefined;
    let started = false;

    const start = () => {
      if (started || torn) return;
      started = true;
      io.disconnect();
      const load = () => {
        void import('../marble/live-bust')
          .then(({ mountLiveBust }) => {
            if (torn) return;
            handle = mountLiveBust({ canvas, poster });
            // The IntersectionObserver above already disconnected once it
            // fired; this second one hands the live module its own
            // on/off-screen signal so it can fully stop its render loop
            // (not just skip starting) once mounted.
            visibility.observe(canvas);
            // Reconcile against whatever pageVisible/canvasInView already
            // are (a tab backgrounded, or the canvas already scrolled back
            // out, in the time it took the chunk to load) rather than
            // trusting the module's own optimistic "visible" default.
            syncVisible();
          })
          .catch((err) => {
            // A rejected dynamic import (a stale chunk hash after a deploy)
            // leaves the poster up; the page still reads fine without it.
            console.error('[vaporwave] failed to load the live bust', err);
          });
      };
      // Idle, not immediate: a visitor scrolling straight past the
      // centrepiece should not have three.js competing with that scroll's
      // own paint work.
      if ('requestIdleCallback' in window) window.requestIdleCallback(load, { timeout: 2000 });
      else setTimeout(load, 1);
    };

    const io = new IntersectionObserver(
      (entries) => { if (entries[0].isIntersecting) start(); },
      { rootMargin: '200px' },
    );
    io.observe(stageEl);

    let pageVisible = !document.hidden;
    let canvasInView = true;
    const syncVisible = () => handle?.setVisible(pageVisible && canvasInView);
    const visibility = new IntersectionObserver((entries) => {
      canvasInView = entries[0].isIntersecting;
      syncVisible();
    });
    const onVisibilityChange = () => { pageVisible = !document.hidden; syncVisible(); };
    document.addEventListener('visibilitychange', onVisibilityChange);

    return () => {
      torn = true;
      io.disconnect();
      visibility.disconnect();
      document.removeEventListener('visibilitychange', onVisibilityChange);
      handle?.dispose();
      handle = undefined;
    };
  });
</script>
