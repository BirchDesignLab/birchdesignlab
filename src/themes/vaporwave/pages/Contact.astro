---
/** Vaporwave contact: a mail client. The form is a new-message window with
    sunken fields; the plain email address waits in a second window. The form
    contract is fixed (src/themes/README.md, Contact). */
import ContactHidden from '../../portal/ContactHidden.astro';
import type { CopyData } from '../../../lib/copy';
import Win from '../parts/Win.astro';
import Horizon from '../parts/Horizon.astro';

interface Props { copy: CopyData<'contact'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
---
<section class="intro vw-wrap">
  <p class="vw-kicker">{copy.kicker}</p>
  <h1>{copy.heading}</h1>
  <p class="subline">{copy.subline}</p>
</section>

<section class="desk vw-wrap">
  {/* E14: one mixed-script decorative title bar. */}
  <Win title="メール new_message.eml" menu={['File', 'Edit', 'Insert', 'Format']} class="compose">
    <form method="post" action="/api/contact" data-astro-reload>
      <div class="field">
        <label for="cf-name">{copy.labels.name}</label>
        <input id="cf-name" name="name" type="text" required maxlength="200" autocomplete="name" />
      </div>
      <div class="field">
        <label for="cf-email">{copy.labels.email}</label>
        <input id="cf-email" name="email" type="email" required maxlength="254" autocomplete="email" />
      </div>
      <div class="field">
        <label for="cf-message">{copy.labels.message}</label>
        <textarea id="cf-message" name="message" required maxlength="5000" rows="8"></textarea>
      </div>
      <ContactHidden theme={theme} label={copy.labels.honeypot} />
      <button class="vw-btn" type="submit">{copy.submit}</button>
    </form>
  </Win>

  <div class="side">
    <p class="trust">{copy.trust.map((part, i) => <>{i > 0 && <span class="sep" aria-hidden="true">&#9670;</span>}<span class="trust-part">{part}</span></>)}</p>
    <Win title="mail.txt" class="mail">
      <p class="invite">{copy.invite}</p>
      <a class="address" href={`mailto:${copy.email}`}>{copy.email}</a>
      <p class="fine">{copy.fine}</p>
    </Win>
    {/* F1(b)/B2 vw-3 item 3: the resort sunset survives here inside a
        Display Properties screensaver window. Settings and Preview are real
        buttons (README: a live control's visible label sits in an
        aria-hidden span, and the button carries an aria-label starting with
        the words the visitor sees); screensaver.ts wires the loop cycle and
        the full-window preview. */}
    <div class="side-scene">
      <Win title="screensaver.scr" class="screensaver">
        <div class="screensaver-preview">
          <div data-scr-sunset><Horizon class="side-horizon" /></div>
          <canvas class="scr-canvas" data-scr-canvas aria-hidden="true"></canvas>
        </div>
        <div class="screensaver-controls">
          <button type="button" class="scr-btn" data-scr-settings aria-label="Settings: cycle the screensaver loop, now resort sunset">
            <span aria-hidden="true">Settings</span>
          </button>
          <button type="button" class="scr-btn" data-scr-preview-btn aria-label="Preview: run the screensaver full screen">
            <span aria-hidden="true">Preview</span>
          </button>
        </div>
      </Win>
    </div>
  </div>
</section>

{/* B2 vw-3 item 3: Preview's full-window layer, a fixed overlay like Win95's
    own Display Properties preview. Decoration (the loop itself carries no
    information); it closes on a click anywhere in it, any key, or Escape,
    and screensaver.ts returns focus to Preview. */}
<div class="scr-fullscreen" data-scr-fullscreen hidden aria-hidden="true">
  <div class="scr-fullscreen-inner">
    <div data-scr-fs-sunset><Horizon class="fs-horizon" /></div>
    <canvas class="scr-fs-canvas" data-scr-fs-canvas></canvas>
  </div>
</div>

<script>
  import { onMount } from '../../../lib/lifecycle';
  import { mountWindowDrag } from '../windows';
  import { mountScreensaver } from '../screensaver';

  /** E15: pause the CSS floor's infinite animation while it is off-screen
      (the screensaver preview, scrolled past). One shared observer for every
      `.vw-floor` this page carries. */
  onMount(() => {
    if (document.documentElement.dataset.theme !== 'vaporwave') return;
    const floors = document.querySelectorAll<HTMLElement>('.vw-floor');
    if (!floors.length) return;
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) entry.target.classList.toggle('vw-floor-paused', !entry.isIntersecting);
    });
    floors.forEach((el) => io.observe(el));
    return () => io.disconnect();
  });

  onMount(mountWindowDrag);
  onMount(mountScreensaver);
</script>

<style>
  .intro { padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2rem, 5vw, 3.5rem); }
  /* E10: the chromatic split scales with the type instead of a flat 3px. */
  h1 {
    margin-top: 1.2rem; max-width: 14ch;
    --chroma: clamp(1px, 0.03em, 3px);
    font-family: var(--font-display); font-size: clamp(3rem, 8vw, 6.2rem); line-height: 0.98;
    text-shadow: calc(-1 * var(--chroma)) 0 0 color-mix(in srgb, var(--neon-cyan) 55%, transparent), var(--chroma) 0 0 color-mix(in srgb, var(--neon-pink) 55%, transparent);
  }
  @media (max-width: 700px) {
    h1 { text-shadow: calc(-1 * var(--chroma)) 0 0 color-mix(in srgb, var(--neon-cyan) 30%, transparent), var(--chroma) 0 0 color-mix(in srgb, var(--neon-pink) 30%, transparent); }
  }
  .subline { margin-top: 1.6rem; max-width: 48ch; font-size: 1.15rem; color: var(--mark-muted); }

  .desk {
    display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem);
    align-items: start; padding-bottom: 2rem;
  }

  form { display: grid; gap: 1.3rem; }
  .field { display: grid; gap: 0.4rem; }
  label {
    font-family: var(--font-mono); font-size: 1.35rem; line-height: 1; color: var(--accent);
    text-transform: uppercase; letter-spacing: 0.08em;
  }
  input, textarea {
    width: 100%; font: inherit; font-size: 1.05rem; color: var(--mark);
    padding: 0.7rem 0.8rem;
    background: var(--field-sunk);
    border: 2px solid; border-color: var(--bevel-lo) var(--field-bevel-hi) var(--field-bevel-hi) var(--bevel-lo);
    border-radius: 0;
  }
  textarea { resize: vertical; min-height: 10rem; }
  input:focus-visible, textarea:focus-visible {
    outline: 2px solid var(--link); outline-offset: 2px;
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--neon-pink) 35%, transparent);
  }
  button { justify-self: start; margin-top: 0.4rem; }

  /* min-width 0 and a minmax track: nothing inside the side column may widen
     it past its share of the desk (the trust line once pushed mail.txt 31px
     past a 1440 viewport). */
  .side { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; min-width: 0; }
  /* The trust parts are terminal lines at every width, one part per line,
     each free to wrap inside itself: no width where a part runs out of the
     box, and no separator to strand. */
  .trust {
    display: grid; gap: 0.3rem;
    font-family: var(--font-mono); font-size: 1.4rem; line-height: 1.3; color: var(--mark);
    text-transform: uppercase; letter-spacing: 0.06em;
    padding: 0.9rem 1rem;
    border: 2px dashed color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .trust .sep { display: none; }
  .trust-part { min-width: 0; overflow-wrap: anywhere; text-wrap: pretty; }
  .invite { font-family: var(--font-display); font-size: clamp(1.4rem, 2.4vw, 1.8rem); line-height: 1.2; }
  .address {
    display: inline-block; margin-block: 1.1rem;
    font-weight: 600; font-size: clamp(1rem, 1.9vw, 1.2rem); letter-spacing: 0.04em;
    overflow-wrap: anywhere;
  }
  .fine { color: var(--mark-muted); font-size: 0.98rem; }

  /* F1(b): the resort sunset lives inside a Display Properties screensaver
     window, an OS frame around the loop rather than a scene of its own. */
  .side-scene :global(.screensaver .vw-win-body) {
    padding: 0.7rem; display: grid; gap: 0.7rem;
  }
  .screensaver-preview {
    position: relative; height: 160px; overflow: hidden;
    background: var(--field-sunk);
    border: 2px solid; border-color: var(--bevel-lo) var(--field-bevel-hi) var(--field-bevel-hi) var(--bevel-lo);
  }
  /* item 6 nit: the preview box is a few dozen px tall, where the full-size
     64px grid tile only ever shows its converging verticals - a smaller
     --vw-floor-cell (theme.css .vw-floor::before) gets enough horizontal
     rungs into the box to read as a floor instead of radiating spikes. */
  .screensaver-preview :global(.side-horizon) { --hz-line: 66%; --hz-sun-w: 160px; --vw-floor-cell: 22px; }
  /* B2 vw-3 item 3: the sunset and the canvas loops occupy the same box;
     screensaver.ts toggles which one is visible. */
  [data-scr-sunset] { position: absolute; inset: 0; transition: opacity 120ms ease; }
  [data-scr-sunset].scr-hidden { opacity: 0; pointer-events: none; }
  .scr-canvas {
    position: absolute; inset: 0; width: 100%; height: 100%;
    opacity: 0; pointer-events: none; transition: opacity 120ms ease;
  }
  .scr-canvas.on { opacity: 1; }
  .screensaver-controls { display: flex; gap: 0.6rem; justify-content: flex-end; }
  /* B2 vw-3 item 3: real buttons now, reset to the same look the decorative
     spans had. */
  .scr-btn {
    appearance: none; cursor: pointer;
    padding: 0.35rem 0.9rem;
    font: 600 0.8rem/1.1 var(--font-body); letter-spacing: 0.03em;
    background: var(--field-raised); color: var(--mark);
    border: 2px solid; border-color: var(--bevel-hi) var(--bevel-lo) var(--bevel-lo) var(--bevel-hi);
  }
  .scr-btn:active { border-color: var(--bevel-lo) var(--bevel-hi) var(--bevel-hi) var(--bevel-lo); }
  .scr-btn:focus-visible {
    outline: 2px dotted currentColor; outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--link);
  }

  /* B2 vw-3 item 3: Preview's full-window layer. */
  .scr-fullscreen {
    position: fixed; inset: 0; z-index: 200;
    background: var(--field);
    cursor: pointer;
  }
  .scr-fullscreen[hidden] { display: none; }
  .scr-fullscreen-inner { position: absolute; inset: 0; }
  .scr-fullscreen-inner [data-scr-fs-sunset] { position: absolute; inset: 0; transition: opacity 120ms ease; }
  .scr-fullscreen-inner [data-scr-fs-sunset].scr-hidden { opacity: 0; }
  .scr-fs-canvas {
    position: absolute; inset: 0; width: 100%; height: 100%;
    opacity: 0; transition: opacity 120ms ease;
  }
  .scr-fs-canvas.on { opacity: 1; }

  @media (max-width: 860px) {
    /* minmax(0, 1fr), not a bare 1fr: a bare track keeps the grid item's
       default min-width:auto, so the compose window's own unbreakable
       min-content (its Notepad menu bar) could push the page past a narrow
       viewport instead of shrinking with it. */
    .desk { grid-template-columns: minmax(0, 1fr); }
    /* The screensaver window shows on phones too (founder, 09-25-26): the
       old full scene was hidden here, but the window is compact enough to
       stack under mail.txt. */
  }
</style>
