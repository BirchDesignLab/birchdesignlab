---
/** Vaporwave home. The hero is the screensaver: a WebGL sunset over a neon
    grid (../fx.ts) between two palms, a chrome billboard in the sky. Below it
    the studio pitches from retro OS windows and a CRT. Every word comes from
    the copy collection. */
import { featuredSpecimens, specimenLink, type CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';
import Win from '../parts/Win.astro';
import Palm from '../parts/Palm.astro';
import Lobby from '../parts/Lobby.astro';
import Still from '../parts/Still.astro';
import sphereAvif from '../stills/sphere-white-512.avif?url';
import sphereWebp from '../stills/sphere-white-512.webp?url';
import venusKioskAvif from '../stills/venus-kiosk-512.avif?url';
import venusKioskWebp from '../stills/venus-kiosk-512.webp?url';

interface Props { copy: CopyData<'home'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, chrome, theme } = Astro.props;
const featured = (await featuredSpecimens()).map((entry) => ({ entry, link: specimenLink(entry, theme) }));
const [first, ...rest] = chrome.name.split(' ');
const doorFiles = ['software.exe', 'web_design.htm'];
---
<section class="hero">
  <canvas class="hero-canvas" data-vw-horizon aria-hidden="true"></canvas>
  <Palm class="palm palm-l" />
  <Palm class="palm palm-r" flip />
  <div class="vw-scan" aria-hidden="true"></div>
  <p class="osd osd-l" aria-hidden="true"><span class="play"></span>PLAY</p>
  <p class="osd osd-r" aria-hidden="true">SP 0:19:85</p>
  <div class="hero-title">
    <p class="vw-kana kana" aria-hidden="true">バーチ・デザイン・ラボ</p>
    <h1 class="billboard">
      <span class="bb-first">{first}</span>
      {' '}
      <span class="bb-rest">{rest.join(' ')}</span>
    </h1>
  </div>
</section>

<section class="opener vw-wrap">
  <p class="lead">{copy.opener.lead}</p>
  <p class="subline">{copy.opener.subline}</p>
  <p class="opener-kana" aria-hidden="true">デザイン</p>
</section>

<section class="doors vw-wrap">
  <h2 class="vw-kicker">{copy.doors.kicker}</h2>
  <div class="door-grid">
    {copy.doors.items.map((door, i) => (
      <Win tag="article" title={doorFiles[i] ?? 'untitled.txt'} class={`door door-${i}`} inactive={i === 0}>
        <h3>{door.title}</h3>
        <p>{door.body}</p>
      </Win>
    ))}
  </div>
  <a class="vw-more" href={hrefFor('services', theme)}>{copy.doors.more}</a>
</section>

{featured.length > 0 && (
  <section class="lab vw-wrap">
    {/* E3: the CRT reads as a free-standing information kiosk, not a desk
        monitor, so a mall lobby has a plaza centre. The header strip, the
        touch prompt and the directory plaque are decoration; the CRT badge
        and LEDs are unchanged. A stand-in marble sphere (B2 swaps in the
        Venus stills once the pipeline moves) dresses the kiosk's foot. B2
        item 14: the Venus kiosk still (vw-4a's white bust on its own drum)
        joins it on the opposite side, mirroring the sphere's own anchor. */}
    <div class="kiosk">
      <p class="kiosk-header" aria-hidden="true">
        <span class="kiosk-kana">インフォメーション</span> INFORMATION DESK
      </p>
      <div class="crt">
        <div class="screen">
          <p class="crt-kicker">{copy.lab.kicker}</p>
          <p class="pull">{copy.lab.pull}</p>
          <ul class="specimens" role="list" data-parity-skip>
            {featured.map(({ entry, link }) => (
              <li>
                <a class="designation" href={link.href} data-astro-reload={link.leaves ? '' : undefined} aria-label={`${entry.data.designation}, ${entry.data.title}`}>{entry.data.designation}</a>
                <span class="summary">{entry.data.summary}</span>
              </li>
            ))}
          </ul>
          <a class="crt-more" href={hrefFor('lab', theme)} data-astro-reload>{copy.lab.more}</a>
          <div class="vw-scan" aria-hidden="true"></div>
          {/* B2 vw-3, item 4: the kiosk's attract loop. Decoration only
              (aria-hidden, not focusable): it plays over the CRT's real
              content for a few seconds without ever detaching that content
              from the keyboard/AT tree, so the specimens links and the
              lab link above stay reachable throughout. */}
          <div class="crt-attract" aria-hidden="true" data-kiosk-attract-screen>
            <div class="attract-content">
              <p class="attract-marquee" data-kiosk-marquee>
                <span>インフォメーション・INFORMATION・B1 SOFTWARE・1F WEB・2F LAB・バーチ・デザイン・ラボ・</span>
                <span>インフォメーション・INFORMATION・B1 SOFTWARE・1F WEB・2F LAB・バーチ・デザイン・ラボ・</span>
              </p>
              <p class="attract-kana">デザイン</p>
            </div>
            <div class="attract-scan"></div>
          </div>
        </div>
        <div class="crt-chin" aria-hidden="true">
          {/* E14: one mixed-script decorative badge, the canon's own move
              ("外ギン Aviation"); the visible copy is unaffected. */}
          <span class="badge">VW-1985 ビデオ</span>
          <span class="knobs"><span></span><span></span></span>
          <span class="led"></span>
        </div>
      </div>
      {/* fix round 2, item 3: a pedestal body under the bezel, reaching a
          floor-contact foot, so the housing reads as free-standing kiosk
          furniture rather than a CRT set on a desk. The neck tapers from the
          bezel's own width down to the body; the body carries the touch
          prompt and the directory plaque as one mounted panel; the foot
          widens again and grounds the whole stand with a cast shadow. */}
      <div class="kiosk-stand">
        <div class="stand-neck" aria-hidden="true"></div>
        <div class="stand-body">
          {/* B2 vw-3, item 4: a real button. The visible label sits in an
              aria-hidden span (README: "letter a live control's visible
              label inside an aria-hidden span and name the control with
              aria-label, starting with the words the visitor sees"); the CRT
              content it plays over is untouched and stays reachable. */}
          <button
            type="button"
            class="kiosk-touch"
            aria-label="Touch screen to begin: play the kiosk's attract loop"
            data-kiosk-attract-btn
          >
            <span aria-hidden="true">TOUCH SCREEN TO BEGIN</span>
          </button>
          <div class="stand-plaque" aria-hidden="true">
            <p class="kiosk-directory">B1 SOFTWARE / 1F WEB / 2F LAB</p>
          </div>
        </div>
        <div class="stand-foot" aria-hidden="true"></div>
      </div>
      <Still class="kiosk-prop" avif={sphereAvif} webp={sphereWebp} size={512} />
      <Still class="kiosk-prop kiosk-prop-venus" avif={venusKioskAvif} webp={venusKioskWebp} size={512} />
    </div>
  </section>
)}

<section class="closer">
  <div class="closer-inner vw-wrap">
    <p class="closer-lead">{copy.closer.lead}</p>
    <a class="vw-btn" href={hrefFor('contact', theme)}>{copy.closer.cta}</a>
  </div>
  <div class="closer-band"><Lobby class="closer-lobby" /></div>
</section>

<script>
  import { onMount } from '../../../lib/lifecycle';
  import { mountHorizon } from '../fx';
  import { mountWindowDrag } from '../windows';
  import { mountKioskAttract } from '../kiosk';

  onMount(mountHorizon);
  onMount(mountWindowDrag);
  onMount(mountKioskAttract);
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    height: clamp(560px, calc(100svh - 64px), 980px);
    /* The same sky in CSS, so the hero reads before (or without) WebGL. */
    background: linear-gradient(180deg, var(--hz-sky-top) 0, var(--hz-sky-mid) 50%, var(--hz-horizon) 68%, var(--hz-ground) 68.2%, var(--hz-ground));
  }
  .hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; }
  .hero :global(.palm) { position: absolute; bottom: -2%; height: 66%; width: auto; max-width: none; z-index: 1; }
  .hero :global(.palm-l) { left: max(-4%, calc(50% - 780px)); }
  .hero :global(.palm-r) { right: max(-8%, calc(50% - 820px)); height: 78%; }
  .hero .vw-scan { z-index: 2; opacity: var(--scan-alpha); }
  .hero::after {
    content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: radial-gradient(ellipse at 50% 45%, transparent 55%, var(--vignette));
  }

  .osd {
    position: absolute; z-index: 3; top: 1.1rem;
    font-family: var(--font-mono); font-size: 1.7rem; line-height: 1; letter-spacing: 0.06em;
    color: #ffffff; text-shadow: 2px 0 0 var(--neon-pink), -2px 0 0 var(--neon-cyan);
  }
  :global([data-scheme='light']) .osd { color: var(--bb-plain); text-shadow: 2px 0 0 #ffffff; }
  .osd-l { left: 1.4rem; display: flex; align-items: center; gap: 0.4em; }
  .osd-r { right: 1.4rem; }
  .play { width: 0; height: 0; border-left: 0.55em solid currentColor; border-block: 0.34em solid transparent; }

  .hero-title {
    position: absolute; z-index: 3; left: 0; right: 0; top: clamp(3.5rem, 8vh, 5.5rem);
    text-align: center; padding-inline: var(--gutter);
  }
  .kana { font-size: clamp(0.75rem, 1.4vw, 0.95rem); letter-spacing: 0.9em; margin-right: -0.9em; color: var(--neon-pink); }
  :global([data-scheme='light']) .kana { color: var(--accent); }
  .billboard { display: flex; flex-direction: column; align-items: center; margin-top: 0.6rem; }
  /* Chrome: a cheap 80s logo gradient with a hard horizon line through the
     middle, extruded by a dark drop and split by chromatic aberration. */
  .bb-first {
    font-family: var(--font-chunk); text-transform: uppercase;
    font-size: clamp(4.2rem, 13vw, 9.25rem); line-height: 0.95; letter-spacing: 0.03em;
    background: var(--bb-chrome);
    -webkit-background-clip: text; background-clip: text;
    color: transparent; -webkit-text-fill-color: transparent;
    filter:
      drop-shadow(0 0.06em 0 var(--bb-depth))
      drop-shadow(-0.035em 0 0 color-mix(in srgb, var(--neon-cyan) 85%, transparent))
      drop-shadow(0.035em 0 0 color-mix(in srgb, var(--neon-pink) 85%, transparent));
  }
  .bb-rest {
    margin-top: 0.9rem; margin-right: -0.62em;
    font-family: var(--font-display); text-transform: uppercase;
    font-size: clamp(1.05rem, 2.6vw, 2rem); line-height: 1; letter-spacing: 0.62em;
    color: var(--bb-plain);
    text-shadow: 0 0 18px color-mix(in srgb, var(--neon-pink) 70%, transparent);
  }

  /* ---------- opener ---------- */
  /* E13: one composition, not a floating kana column with a hole beside it.
     The kana sits in its own grid track, top-aligned to the lead's cap
     height and stretched to the subline's foot, right-aligned at the same
     edge the door windows below use (the section's own gutter). */
  .opener {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 1fr) auto;
    align-items: start; column-gap: clamp(1.5rem, 4vw, 3rem); row-gap: 1.6rem;
    padding-block: clamp(4rem, 9vw, 7.5rem) clamp(3rem, 7vw, 5rem);
  }
  .lead {
    grid-column: 1; grid-row: 1;
    max-width: 40rem;
    font-family: var(--font-display); font-size: clamp(2.8rem, 7vw, 5.6rem); line-height: 1.02;
    background: linear-gradient(100deg, var(--mark) 55%, var(--accent));
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  /* Brought to the lead's own measure (a shared pixel width, not a shared
     "ch": the two elements' font sizes differ far too much for the same
     character count to mean the same line length), so the left column reads
     as one block instead of a wide headline over a ragged little paragraph. */
  .subline { grid-column: 1; grid-row: 2; max-width: 40rem; font-size: 1.15rem; color: var(--mark-muted); }
  .opener-kana {
    grid-column: 2; grid-row: 1 / span 2; align-self: stretch; justify-self: end;
    display: flex; align-items: flex-start; justify-content: center;
    writing-mode: vertical-rl;
    /* E5: var(--font-kana) avoids the fallback-injection corruption this
       literal family name hits inside a component <style> block
       (kana-font-not-dela). Weight stays 900: this is the outlined
       (transparent-fill, stroke-only) display kana, not filled text, so a
       synthesized bold does not blob it the way sent-kanji-blobs did. */
    font-family: var(--font-kana); font-weight: 900;
    font-size: clamp(3rem, 8vw, 6.5rem); line-height: 1; letter-spacing: 0.08em;
    color: transparent; -webkit-text-stroke: 1.5px var(--accent);
    opacity: 0.8;
  }

  /* ---------- doors ---------- */
  .doors { padding-block: 0 clamp(2.5rem, 5vw, 3.5rem); }
  /* E4: a real cascade (the Services pattern), not a same-row stagger. The
     back window (software.exe) sits statically inactive under the front one
     (web_design.htm), overlapping only its own bottom padding, never its
     text, so the pair reads as two open windows, one behind the other. */
  .door-grid {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr));
    margin-top: 1.8rem; margin-bottom: 3rem;
  }
  .door-grid :global(.door-0) { grid-column: 1 / span 7; grid-row: 1; z-index: 1; }
  .door-grid :global(.door-1) { grid-column: 5 / span 8; grid-row: 2; margin-top: -2.25rem; z-index: 2; }
  .door-grid h3 {
    font-family: var(--font-display); font-size: clamp(2rem, 3.6vw, 2.8rem); line-height: 1.05;
    margin-bottom: 0.9rem;
  }
  .door-grid p { color: var(--mark-muted); max-width: 44ch; }

  /* ---------- lab: a free-standing information kiosk (E3) ---------- */
  .lab { padding-block: 0 clamp(4rem, 8vw, 6rem); }
  .kiosk { position: relative; max-width: 980px; margin-inline: auto; }
  .kiosk-header {
    display: flex; align-items: baseline; gap: 0.6em; justify-content: center;
    margin-bottom: 0.6rem;
    font-family: var(--font-mono); font-size: 1.15rem; line-height: 1; letter-spacing: 0.16em;
    color: var(--crt-kick); text-transform: uppercase;
  }
  .kiosk-kana {
    /* E5/sent-kanji-blobs: var(--font-kana) (fallback-injection corrupts the
       literal name here) at weight 400 (Dela Gothic One's only weight; 700
       synthesizes a bold that fills the kanji solid). */
    font-family: var(--font-kana);
    font-weight: 400; letter-spacing: 0.2em;
  }
  .crt {
    padding: clamp(0.9rem, 2.5vw, 1.8rem) clamp(0.9rem, 2.5vw, 1.8rem) 0;
    border-radius: 26px 26px 18px 18px;
    background: linear-gradient(160deg, var(--crt-case-a), var(--crt-case-b));
    border: 2px solid; border-color: var(--bevel-hi) var(--bevel-lo) var(--bevel-lo) var(--bevel-hi);
    box-shadow: 16px 16px 0 var(--win-drop);
  }
  .screen {
    position: relative; overflow: hidden;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border-radius: 22px / 30px;
    background: radial-gradient(ellipse at 50% 40%, color-mix(in srgb, var(--crt-bg) 80%, #2c0b58), var(--crt-bg) 75%);
    box-shadow: inset 0 0 0 3px #000, inset 0 0 50px rgba(0, 0, 0, 0.9), inset 0 0 120px color-mix(in srgb, var(--neon-lav) 25%, transparent);
    color: var(--crt-ink);
  }
  .screen .vw-scan { opacity: 1; mix-blend-mode: normal; background: repeating-linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0 1px, transparent 1px 3px); }
  .crt-kicker {
    font-family: var(--font-mono); font-size: 1.55rem; line-height: 1; color: var(--crt-kick);
    text-transform: uppercase; letter-spacing: 0.12em;
    text-shadow: 0 0 10px color-mix(in srgb, var(--crt-kick) 70%, transparent);
  }
  .pull {
    margin-top: 1.2rem; max-width: 22ch;
    font-family: var(--font-display); font-size: clamp(2rem, 4.6vw, 3.4rem); line-height: 1.08;
    text-shadow: -2px 0 0 color-mix(in srgb, var(--neon-cyan) 55%, transparent), 2px 0 0 color-mix(in srgb, var(--neon-pink) 55%, transparent);
  }
  .specimens { list-style: none; padding: 0; margin-top: 2rem; display: grid; gap: 0.7rem; }
  .specimens li {
    display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 1rem; align-items: baseline;
    padding-top: 0.7rem; border-top: 1px dashed color-mix(in srgb, var(--crt-phos) 35%, transparent);
  }
  .designation {
    font-family: var(--font-mono); font-size: 1.45rem; line-height: 1; color: var(--crt-phos);
    text-shadow: 0 0 8px color-mix(in srgb, var(--crt-phos) 60%, transparent);
  }
  .designation::before { content: '>' / ''; margin-right: 0.4em; }
  /* The designation is a link to its entry. On the CRT a live line answers in
     inverse video, the terminal's own highlight, on hover and on focus. */
  .designation { justify-self: start; padding-inline: 0.15em; margin-inline: -0.15em; text-decoration: none; }
  .designation:hover, .designation:focus-visible {
    color: var(--crt-bg); background: var(--crt-phos); text-shadow: none;
  }
  .designation:focus-visible { outline-color: var(--crt-phos); }
  .summary { color: var(--crt-ink); font-size: 1rem; }
  /* Phone touch targets (12): padding-block grows the tap area to 44px; the
     compensating margin keeps the gap above and below this link the same as
     before the padding was added. */
  .crt-more {
    display: inline-block;
    margin-top: calc(2rem - 0.65rem); margin-bottom: -0.65rem;
    padding-block: 0.65rem;
    font-family: var(--font-mono); font-size: 1.5rem; line-height: 1; color: var(--crt-link);
    text-transform: uppercase; letter-spacing: 0.1em;
  }
  .crt-more::before { content: '[ ' / ''; }
  .crt-more::after { content: ' ]' / ''; }
  .crt-chin {
    display: flex; align-items: center; gap: 1rem; padding: 0.8rem 0.4rem 0.9rem;
    font-family: var(--font-mono); font-size: 1.1rem; line-height: 1; color: var(--mark-muted);
  }
  .badge { letter-spacing: 0.3em; margin-right: auto; }
  .knobs { display: flex; gap: 0.5rem; }
  .knobs span { width: 18px; height: 18px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, var(--bevel-hi), var(--bevel-lo)); }
  .led { width: 9px; height: 9px; border-radius: 50%; background: var(--neon-mint); box-shadow: 0 0 8px var(--neon-mint); }

  /* The kiosk housing (fix round 2, item 3): a pedestal body under the
     bezel, reaching a floor-contact foot, in the CRT's own Win95 plastic
     (the case gradient), so the whole thing reads as free-standing
     information furniture, not a monitor set on a desk. TOUCH SCREEN TO
     BEGIN and the directory plaque are unchanged strings, remounted onto the
     stand instead of floating loose beneath the bezel. */
  .kiosk-stand { position: relative; margin-inline: auto; width: min(100%, 640px); }
  .stand-neck {
    width: 32%; height: 16px; margin-inline: auto;
    background: linear-gradient(160deg, var(--crt-case-a), var(--crt-case-b));
    border: 2px solid; border-color: var(--bevel-hi) var(--bevel-lo) var(--bevel-lo) var(--bevel-hi);
    border-bottom: none;
    clip-path: polygon(6% 0, 94% 0, 100% 100%, 0 100%);
  }
  .stand-body {
    padding: 0.9rem clamp(1rem, 4vw, 2.2rem) 1.1rem;
    display: grid; justify-items: center; gap: 0.9rem;
    background: linear-gradient(160deg, var(--crt-case-a), var(--crt-case-b));
    border: 2px solid; border-color: var(--bevel-hi) var(--bevel-lo) var(--bevel-lo) var(--bevel-hi);
    box-shadow: 10px 10px 0 var(--win-drop);
  }
  /* B2 vw-3, item 4: a real button, reset to the same look the decorative
     <p> had. animation: none on :active keeps the tap feedback instant. */
  .kiosk-touch {
    appearance: none; background: none; border: none; padding: 0.2em 0.1em; margin: 0;
    text-align: center; font: inherit; cursor: pointer;
    font-family: var(--font-mono); font-size: 1rem; line-height: 1; letter-spacing: 0.3em;
    color: var(--crt-link); text-transform: uppercase;
  }
  .kiosk-touch:active { translate: 0 1px; }
  .kiosk-touch:focus-visible {
    outline: 2px dotted currentColor; outline-offset: 4px;
    box-shadow: 0 0 0 2px var(--link);
  }
  /* item 6 nit: cyan reads near-invisibly on the light pastel field. The
     button is a real control (B2 vw-3 item 4); only its visible label sits
     in an aria-hidden span (README), so recolouring it here does not touch
     word parity. --accent is the light scheme's deep magenta, already
     contrast-checked against the page field elsewhere in meta.ts. */
  :global([data-scheme='light']) .kiosk-touch { color: var(--accent); }

  /* B2 vw-3, item 4: the attract loop overlay. Covers the screen's real
     content visually only (pointer-events: none), so the specimens links
     and the lab link stay reachable by keyboard and screen reader while it
     plays; JS toggles `.on` for a few seconds and removes it. */
  .crt-attract {
    position: absolute; inset: 0; z-index: 2; overflow: hidden;
    background: var(--crt-bg);
    opacity: 0; pointer-events: none;
    transition: opacity 160ms ease;
  }
  .crt-attract.on { opacity: 1; }
  /* Fix round 4 (founder: no scroll on the phone attract tap): the content
     used to centre with `align-content: center` on this element's own full
     (often off-screen-tall) box. It now lives in its own absolutely
     positioned group, vertically placed at `--attract-top` (a LOCAL,
     screen-relative offset kiosk.ts computes from the actual visible
     viewport intersection on tap) instead of the box's geometric middle,
     falling back to 50% -- the same true centre as before -- whenever the
     variable is unset (desktop, or before any tap). See kiosk.ts. */
  .attract-content {
    position: absolute; inset-inline: 0;
    top: var(--attract-top, 50%); transform: translateY(-50%);
    /* fix round 3: an explicit, capped column. Left as an implicit grid, the
       track grew to the marquee's own max-content width (the nowrap
       scroller's two copies, about 2008px in a 918px screen), so the loop's
       centrepiece kana sat off-screen at the far right of that track and the
       screen read as black. minmax(0, 1fr) ties the track to the available
       width instead of the marquee's content. */
    display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; gap: 1.4rem;
  }
  .attract-marquee {
    /* min-width: 0 and overflow: hidden clip the nowrap scroller to the
       screen's own width instead of letting its intrinsic content width
       (the grid item's default min-width: auto) push the column wider. */
    display: flex; gap: 0; white-space: nowrap; width: 100%; min-width: 0; overflow: hidden; margin: 0;
    font-family: var(--font-mono); font-size: 1.3rem; letter-spacing: 0.14em;
    color: var(--crt-phos); text-shadow: 0 0 8px color-mix(in srgb, var(--crt-phos) 60%, transparent);
  }
  .attract-marquee span { flex: none; padding-inline-end: 1ch; }
  .crt-attract.on .attract-marquee { animation: vw-attract-scroll 6s linear infinite; }
