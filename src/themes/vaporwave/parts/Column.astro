---
/** An Ionic column in procedural marble, lit pink from one side and cyan from
    the other the way vaporwave lights its statuary. Decoration only. `id`
    keeps the filter and clip ids unique when a page shows several. */
import MarbleFilter from './MarbleFilter.astro';

interface Props { id: string; class?: string; seed?: number }
const { id, class: className, seed = 7 } = Astro.props;

// Flutes run the height of the tapering shaft (22..98 at the top, 26..94 at the foot).
const flutes = [31, 40, 49, 58, 67, 76, 85].map((x) => {
  const foot = 60 + (x - 60) * (68 / 76);
  return `M${x + 2} 46L${foot + 2} 548`;
});
---
<svg class:list={['vw-column', className]} viewBox="0 0 120 600" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
  <defs>
    <MarbleFilter id={`${id}-marble`} seed={seed} frequency="0.02 0.006" />
    <clipPath id={`${id}-shape`}>
      <rect x="2" y="0" width="116" height="10" />
      <path d="M8 10H112Q118 21 108 30H12Q2 21 8 10Z" />
      <circle cx="15" cy="27" r="13" />
      <circle cx="105" cy="27" r="13" />
      <rect x="20" y="34" width="80" height="10" />
      <path d="M22 44H98L94 550H26Z" />
      <rect x="16" y="550" width="88" height="13" rx="6.5" />
      <rect x="10" y="563" width="100" height="15" rx="5" />
      <rect x="3" y="578" width="114" height="22" />
    </clipPath>
    <linearGradient id={`${id}-light`} x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#ff71ce" stop-opacity="0.85" />
      <stop offset="0.42" stop-color="#ffffff" stop-opacity="0" />
      <stop offset="0.6" stop-color="#ffffff" stop-opacity="0" />
      <stop offset="1" stop-color="#01cdfe" stop-opacity="0.8" />
    </linearGradient>
  </defs>
  <g clip-path={`url(#${id}-shape)`}>
    <rect width="120" height="600" filter={`url(#${id}-marble)`} />
    <rect width="120" height="600" fill={`url(#${id}-light)`} style="mix-blend-mode: multiply" />
    <g stroke="#2a0a4a" stroke-opacity="0.22" stroke-width="2.2" fill="none">
      {flutes.map((d) => <path d={d} />)}
      <circle cx="15" cy="27" r="8" />
      <circle cx="15" cy="27" r="3.5" />
      <circle cx="105" cy="27" r="8" />
      <circle cx="105" cy="27" r="3.5" />
      <path d="M2 10H118M20 34H100M22 44H98M16 550H104M10 563H110M3 578H117" />
    </g>
  </g>
</svg>
