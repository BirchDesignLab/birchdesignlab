---
/** F1(b): the resort framing every page but Home gets once the sunset stays
    the hero's alone. A flattened, glossy atrium tile (E3's floor, a higher
    camera and less vanishing than a road to the horizon), a skylight glow
    from directly above instead of a horizon glow, a potted palm and a
    marble column stand-in (the Tier A render; B2 moves the pipeline into
    src/ and swaps in the Venus). Decoration only, fills its positioned
    parent.

    `variant` (Stage 6 wave 2, V12): the same tile floor, two rooms. 'plaza'
    (default, Home's closer) keeps the palm, the column and the skylight.
    'mall' (Services' closer) is its own room: a fountain basin, a Venus on
    her drum and an escalator rail, lit by pools on the floor instead of an
    overhead skylight. Stills and drawing only, no words. */
import Palm from './Palm.astro';
import Still from './Still.astro';
import columnAvif from '../stills/column-pink-512.avif?url';
import columnWebp from '../stills/column-pink-512.webp?url';
import venusAvif from '../stills/venus-kiosk-512.avif?url';
import venusWebp from '../stills/venus-kiosk-512.webp?url';

interface Props { class?: string; variant?: 'plaza' | 'mall' }
const { class: className, variant = 'plaza' } = Astro.props;
---
<div class:list={['vw-lobby', `lobby-${variant}`, className]} aria-hidden="true">
  {variant === 'plaza' && <div class="lobby-sky"></div>}
  <div class="lobby-floor">
    <div class="tile"></div>
    <div class="sheen"></div>
  </div>
  {variant === 'plaza' && (
    <>
      <div class="lobby-planter">
        <Palm class="lobby-palm" />
        <div class="lobby-pot"></div>
      </div>
      <Still class="lobby-column" avif={columnAvif} webp={columnWebp} size={512} />
    </>
  )}
  {variant === 'mall' && (
    <>
      <div class="mall-pool mall-pool-a"></div>
      <div class="mall-pool mall-pool-b"></div>
      <svg class="mall-rail" viewBox="0 0 320 170" preserveAspectRatio="xMinYMax meet" focusable="false">
        <path class="rail-truss" d="M0 150 L34 150 L270 92 L320 92 L320 170 L0 170 Z" />
        <path class="rail-glass" d="M34 98 L270 22 L270 92 L34 150 Z" />
        <g class="rail-posts">
          <path d="M34 98V150M93 79V135M152 60V121M211 41V106M270 22V92" />
        </g>
        <g class="rail-treads">
          <path d="M34 150L270 92M34 158L270 100M0 150H34M270 92H320" />
        </g>
        <path class="rail-hand" d="M0 98 H34 L270 22 H320" />
        <path class="rail-hand-hi" d="M0 95.5 H34 L270 19.5 H320" />
      </svg>
      <div class="mall-fountain">
        <div class="fn-jets">
          <span class="fn-jet fn-jet-c"></span>
          <span class="fn-jet fn-jet-l"></span>
          <span class="fn-jet fn-jet-r"></span>
        </div>
        <div class="fn-bowl"></div>
        <div class="fn-basin"><div class="fn-water"></div></div>
      </div>
      <Still class="lobby-venus" avif={venusAvif} webp={venusWebp} size={512} />
    </>
  )}
</div>

<style>
  .vw-lobby {
    --lobby-glow: color-mix(in srgb, var(--bb-plain) 22%, transparent);
    position: absolute; inset: 0; overflow: hidden; pointer-events: none;
  }
  /* V4: in light the skylight is light, mixed from white and the sun's own
     highlight. It used to mix near-black --bb-plain at 22%, which painted a
     dark mauve smudge across the pastel floor. */
  :global([data-scheme='light']) .vw-lobby {
    --lobby-glow: color-mix(in srgb, color-mix(in srgb, #ffffff 65%, var(--hz-sun-a)) 78%, transparent);
  }

  /* A skylight glow from directly overhead, not a sunset's horizon glow.
     V4: the ellipse is centred above the top edge (-10%) and the top 12% of
     the layer is masked away, so the glow comes in from nowhere instead of
     starting on a hard line where the closer's band begins, in both schemes. */
  .lobby-sky {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 60% 70% at 50% -10%, var(--lobby-glow), transparent 72%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 12%);
    mask-image: linear-gradient(180deg, transparent 0, #000 12%);
  }

  /* Flattened atrium tile: a higher camera (a shallower rotateX, a longer
     perspective) than the footer's own floor, so it reads as polished floor
     underfoot rather than a road running to a vanishing point. A soft sheen
     band stands in for the reflective gloss the brief asks for. */
  .lobby-floor {
    position: absolute; left: -40%; right: -40%; bottom: 0; height: 62%;
    overflow: hidden; perspective: 900px; perspective-origin: 50% 0%;
  }
  .tile {
    position: absolute; inset: 0 0 -20% 0;
    background: conic-gradient(var(--chk-a) 25%, var(--chk-b) 0 50%, var(--chk-a) 0 75%, var(--chk-b) 0) 0 0 / 88px 88px;
    opacity: 0.5;
    transform: rotateX(52deg); transform-origin: 50% 0;
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 22%);
    mask-image: linear-gradient(180deg, transparent 0, #000 22%);
  }
  /* fix round 3, item 4: a 28%-tall, blur(6px) grey wash (bb-plain, which is
     near-black in light) read as a blurred smear laid over the tile rather
     than gloss on it, worst in light and on phone where the wash covers
     more of a shorter floor. Gloss on a hard, reflective surface is a thin,
     bright streak, not a soft grey cloud: shrunk to a narrow band, tinted
     from the neon palette (the same hues the checker squares and grid
     already carry) instead of the flat plain-ink mix, and nearly unblurred
     so the streak's edge stays crisp. screen against the dark floor lifts
     it without washing the tile out; light's floor is pale already, so
     normal blending there keeps the same streak from turning into a white
     blob. */
  .sheen {
    position: absolute; left: 14%; right: 14%; top: 36%; height: 9%;
    background: linear-gradient(90deg,
      transparent,
      color-mix(in srgb, var(--neon-cyan) 55%, transparent) 30%,
      color-mix(in srgb, var(--bb-plain) 65%, transparent) 50%,
      color-mix(in srgb, var(--neon-pink) 55%, transparent) 70%,
      transparent);
    opacity: 0.4; filter: blur(1.5px); mix-blend-mode: screen;
    transform: rotateX(52deg); transform-origin: 50% 0;
  }
  :global([data-scheme='light']) .sheen { opacity: 0.22; mix-blend-mode: normal; }

  .lobby-planter {
    position: absolute; left: 6%; bottom: 6%; width: clamp(70px, 12vw, 120px);
  }
  .lobby-planter :global(.lobby-palm) { position: relative; z-index: 1; width: 100%; height: auto; }
  /* height:20% on .lobby-planter (an auto-height, absolutely positioned
     parent) resolved to 0, so the pot never painted (nit: only a 4px border
     hairline showed). Footer's own planter-pot uses a fixed px height for
     the same reason; matched here, scaled up for the lobby's larger planter. */
  .lobby-pot {
    width: 62%; height: 22px; margin-inline: auto; margin-top: -8px;
    background: linear-gradient(180deg, var(--field-raised), var(--field));
    border: 2px solid; border-color: var(--bevel-hi) var(--bevel-lo) var(--bevel-lo) var(--bevel-hi);
    clip-path: polygon(8% 0, 92% 0, 100% 100%, 0 100%);
  }

  .lobby-floor + .lobby-planter { z-index: 1; }
  :global(.vw-lobby .lobby-column) {
    position: absolute; right: 8%; bottom: 4%; width: clamp(90px, 15vw, 160px); height: auto;
    filter: drop-shadow(0 14px 10px rgba(0, 0, 0, 0.25));
  }

  /* ---------- the mall (V12): Services' own room ---------- */

  /* Light on the floor instead of a skylight: two soft pools, one under the
     fountain and one under the Venus, from the same warm-white mix as the
     plaza's glow. */
  .mall-pool {
    position: absolute; bottom: 2%; height: 34%; border-radius: 50%;
    background: radial-gradient(ellipse, var(--lobby-glow), transparent 70%);
    opacity: 0.9;
  }
  .mall-pool-a { left: 28%; width: 36%; }
  .mall-pool-b { right: 2%; width: 28%; }

  /* An escalator seen side-on: a glass balustrade under a chrome handrail
     that bends flat at both landings, treads under it, a dark truss below. */
  .mall-rail {
    position: absolute; left: 0; bottom: 5%; width: clamp(180px, 25vw, 330px); height: auto;
    overflow: visible;
  }
  .rail-truss { fill: var(--crt-case-b); stroke: var(--bevel-hi); stroke-width: 1.5; }
  .rail-glass {
    fill: color-mix(in srgb, var(--neon-cyan) 20%, transparent);
    stroke: color-mix(in srgb, var(--neon-cyan) 70%, transparent); stroke-width: 1.5;
  }
  .rail-posts path { stroke: color-mix(in srgb, var(--neon-cyan) 55%, transparent); stroke-width: 1.5; fill: none; }
  .rail-treads path { stroke: var(--neon-lav); stroke-width: 2; fill: none; stroke-dasharray: 5 4; }
  .rail-hand { stroke: var(--neon-pink); stroke-width: 7; fill: none; stroke-linejoin: round; stroke-linecap: round; }
  .rail-hand-hi { stroke: #ffffff; stroke-opacity: 0.8; stroke-width: 1.8; fill: none; stroke-linejoin: round; stroke-linecap: round; }

  /* A fountain basin: a marble ring seen from above, water in it, a stem
     and a bowl, three arcs of spray. */
  .mall-fountain {
    position: absolute; left: 36%; bottom: 7%;
    width: clamp(140px, 22vw, 280px); aspect-ratio: 1 / 0.8;
  }
  .fn-basin {
    position: absolute; left: 0; right: 0; bottom: 0; height: 46%;
    border-radius: 50%;
    background: linear-gradient(180deg, #ffffff, var(--marble));
    border: 2px solid; border-color: var(--bevel-hi) var(--bevel-lo) var(--bevel-lo) var(--bevel-hi);
    box-shadow: 0 9px 0 var(--marble-vein), 0 18px 14px -6px rgba(0, 0, 0, 0.35);
  }
  .fn-water {
    position: absolute; inset: 14% 7%; border-radius: 50%;
    background:
      radial-gradient(ellipse 30% 36% at 50% 46%, rgba(255, 255, 255, 0.85), transparent 70%),
      repeating-radial-gradient(ellipse at 50% 46%, transparent 0 7px, rgba(255, 255, 255, 0.45) 7px 8.5px),
      linear-gradient(180deg, color-mix(in srgb, var(--neon-cyan) 75%, #ffffff), color-mix(in srgb, var(--neon-lav) 65%, #ffffff));
    box-shadow: inset 0 3px 0 rgba(20, 8, 50, 0.25);
  }
  .fn-bowl {
    position: absolute; left: 41%; width: 18%; bottom: 31%; height: 20%;
    background: linear-gradient(180deg, #ffffff, var(--marble));
    border: 2px solid; border-color: var(--bevel-hi) var(--bevel-lo) var(--bevel-lo) var(--bevel-hi);
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
    z-index: 1;
  }
  .fn-jets { position: absolute; left: 50%; bottom: 46%; width: 0; height: 0; z-index: 0; }
  .fn-jet {
    position: absolute; bottom: 0; left: -2.5%; width: 5%;
    background: linear-gradient(0deg, color-mix(in srgb, var(--neon-cyan) 80%, #ffffff), rgba(255, 255, 255, 0.9) 70%, transparent);
    border-radius: 999px 999px 0 0;
    transform-origin: 50% 100%;
  }
  .fn-jet-c { height: 96px; width: 8px; left: -4px; }
  .fn-jet-l { height: 72px; width: 6px; left: -3px; rotate: -24deg; }
  .fn-jet-r { height: 72px; width: 6px; left: -3px; rotate: 24deg; }
  .lobby-mall :global(.lobby-venus) {
    position: absolute; right: 9%; bottom: 3%; width: clamp(130px, 21vw, 270px); height: auto;
    transform: translateY(10.9%);
    z-index: 1;
  }

  /* V3: the phone lobby keeps its planter (about 64px, left) and its column
     (right), instead of dropping the planter and centring a lone column. */
  @media (max-width: 620px) {
    .lobby-planter { width: 64px; }
    :global(.vw-lobby .lobby-column) { width: clamp(90px, 26vw, 130px); }
    .mall-rail { display: none; }
    .mall-fountain { left: 7%; width: clamp(120px, 40vw, 170px); }
    .mall-pool-a { left: 0; width: 60%; }
    .mall-pool-b { width: 44%; }
    .lobby-mall :global(.lobby-venus) { right: 7%; width: clamp(110px, 32vw, 150px); }
    .fn-jet-c { height: 70px; }
    .fn-jet-l, .fn-jet-r { height: 52px; }
  }
</style>
