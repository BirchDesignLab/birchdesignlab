---
/** Bauhaus about: the letter B built from a stem and two half circles (the
    rune was the letter, so the letter gets the construction), the founder
    beside an abstract tall pale tree, and the manifesto on a yellow slab. */
import { rich, type CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';

interface Props { copy: CopyData<'about'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
const [lead, ...rest] = copy.founder.body;
---
<section class="wrap grid12 intro">
  <h1>{copy.heading}</h1>
  <svg class="letter-b" viewBox="0 0 320 420" aria-hidden="true" focusable="false">
    <rect class="asm" x="20" y="10" width="84" height="400" fill="var(--mark)" style="--from: scaleY(0); --d: 0ms" />
    <path class="asm" d="M104 10 A96 96 0 0 1 104 202 Z" fill="var(--red)" style="--from: translateX(-40%) rotate(-180deg); --d: 220ms" />
    <path class="asm" d="M104 202 A104 104 0 0 1 104 410 Z" fill="var(--blue)" style="--from: translateX(-40%) rotate(180deg); --d: 360ms" />
    <circle class="asm" cx="272" cy="52" r="42" fill="var(--yellow)" style="--from: scale(0); --d: 560ms" />
  </svg>
  <div class="etymology">
    {copy.etymology.map((para, i) => <p class={`etym etym-${i}`} set:html={rich(para)} />)}
  </div>
</section>

<section class="founder">
  <div class="wrap grid12 founder-grid">
    <div class="founder-side">
      <h2>{copy.founder.heading}</h2>
      <svg class="tree" viewBox="0 0 240 320" aria-hidden="true" focusable="false" data-reveal>
        <rect x="0" y="0" width="240" height="320" fill="var(--blue)" />
        <circle class="asm" cx="178" cy="70" r="38" fill="var(--yellow)" style="--from: scale(0); --d: 200ms" />
        <rect class="asm" x="78" y="36" width="36" height="284" fill="var(--paper)" style="--from: scaleY(0) translateY(40%); --d: 0ms" />
        <rect x="78" y="112" width="18" height="6" fill="var(--ink)" />
        <rect x="96" y="176" width="18" height="6" fill="var(--ink)" />
        <rect x="78" y="244" width="22" height="6" fill="var(--ink)" />
      </svg>
    </div>
    <div class="founder-body">
      <p class="founder-lead">{lead}</p>
      {rest.map((para) => <p>{para}</p>)}
    </div>
  </div>
</section>

<section class="manifesto block-yellow">
  <svg class="manifesto-shapes" viewBox="0 0 300 300" aria-hidden="true" focusable="false" data-reveal>
    <circle class="asm" cx="190" cy="110" r="110" fill="var(--ink)" style="--from: scale(0); --d: 0ms" />
    <rect class="asm" x="30" y="170" width="130" height="130" fill="var(--red)" style="--from: translateX(-120%) rotate(-90deg); --d: 200ms" />
  </svg>
  <div class="wrap grid12 manifesto-grid">
    <p class="manifesto-text">{copy.manifesto}</p>
    <a class="btn" href={hrefFor('contact', theme)}>{copy.cta}</a>
  </div>
</section>

<style>
  .intro { padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 8vw, 7rem); row-gap: clamp(2.5rem, 5vw, 4rem); }
  h1 {
    grid-column: 1 / span 8;
    grid-row: 1;
    align-self: end;
    font-weight: 800;
    font-size: clamp(3.75rem, 11vw, 10.5rem);
    line-height: 0.82;
    letter-spacing: -0.02em;
    text-transform: lowercase;
  }
  .letter-b { grid-column: 9 / span 4; grid-row: 1; width: 100%; max-width: 320px; height: auto; justify-self: end; }
  .etymology {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    padding-top: 1.5rem;
    border-top: var(--rule) solid var(--mark);
  }
  .etym { font-size: 1.1875rem; line-height: 1.6; }
  .etym-0 { grid-column: 1 / span 5; }
  .etym-1 { grid-column: 7 / span 5; }
  .etym::before {
    content: '';
    display: block;
    width: 3rem;
    height: 0.75rem;
    margin-bottom: 1.25rem;
    background: var(--mark);
  }

  .founder { border-top: var(--rule) solid var(--mark); padding-block: clamp(4rem, 8vw, 7rem); }
  .founder-grid { row-gap: 3rem; }
  .founder-side { grid-column: 1 / span 5; display: flex; flex-direction: column; gap: 2.5rem; }
  h2 {
    font-weight: 800;
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 0.85;
    letter-spacing: -0.02em;
    text-transform: lowercase;
  }
  .tree { width: 100%; max-width: 340px; height: auto; }
  .founder-body { grid-column: 7 / span 6; display: flex; flex-direction: column; gap: 1.4rem; font-size: 1.1875rem; }
  .founder-lead {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-transform: lowercase;
    padding-bottom: 1.4rem;
    border-bottom: var(--rule-thin) solid var(--mark);
  }

  .manifesto { position: relative; overflow: hidden; padding-block: clamp(4rem, 9vw, 8rem); }
  .manifesto-shapes {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    translate: 0 -50%;
    width: clamp(220px, 24vw, 360px);
    height: auto;
  }
  .manifesto-grid { position: relative; row-gap: 2.5rem; justify-items: start; }
  .manifesto-text {
    grid-column: 1 / span 8;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: lowercase;
  }
  .manifesto .btn { grid-column: 1 / span 8; }

  @media (max-width: 900px) {
    .founder-side, .founder-body { grid-column: 1 / -1; }
    .founder-side { flex-direction: row; justify-content: space-between; align-items: flex-end; }
    .tree { max-width: 160px; }
    .manifesto { padding-bottom: 0; display: flex; flex-direction: column; }
    /* flex-start plus a margin-bottom keeps this clear of the footer's red
       corner circle below, instead of two red shapes meeting at the seam. */
    .manifesto-shapes { order: 2; position: static; translate: none; align-self: flex-start; width: 220px; margin: 3rem 0 clamp(2rem, 8vw, 3rem) var(--gutter); }
    .manifesto-text, .manifesto .btn { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    h1 { grid-column: 1 / -1; grid-row: 2; font-size: 19vw; }
    .letter-b { grid-column: 1 / -1; grid-row: 1; max-width: 190px; justify-self: end; }
    .etym-0, .etym-1 { grid-column: 1 / -1; }
    .etymology { row-gap: 2.5rem; }
    .founder-side { flex-direction: column; align-items: flex-start; }
    .tree { max-width: 200px; }
  }
</style>
