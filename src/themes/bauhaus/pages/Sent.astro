---
/** Bauhaus sent: one word as big as the page allows, and a circle that has
    rolled down its triangle and come to rest in the square. */
import type { CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';

interface Props { copy: CopyData<'sent'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, theme } = Astro.props;
---
<section class="wrap grid12 sent">
  <h1>{copy.heading}</h1>
  <svg class="landed" viewBox="0 0 520 360" aria-hidden="true" focusable="false">
    <polygon class="asm" points="0,352 250,352 0,110" fill="var(--yellow)" style="--from: scaleX(0); --d: 0ms" />
    <rect class="asm" x="292" y="152" width="200" height="200" fill="var(--red)" style="--from: translateY(40%) scale(0.2); --d: 160ms" />
    <rect x="0" y="352" width="520" height="8" fill="var(--mark)" />
    <circle class="asm" cx="392" cy="252" r="64" fill="var(--blue)" style="--from: translate(-420px, -220px); --d: 420ms" />
  </svg>
  <div class="note">
    <p>{copy.body}</p>
    <a class="more" href={hrefFor('home', theme)}>{copy.back}</a>
  </div>
</section>

<style>
  .sent {
    min-height: min(78vh, 820px);
    padding-block: clamp(3rem, 6vw, 5rem) clamp(4rem, 8vw, 7rem);
    align-content: center;
    row-gap: 3rem;
  }
  h1 {
    grid-column: 1 / span 7;
    align-self: end;
    font-weight: 800;
    font-size: clamp(6rem, 22vw, 20rem);
    line-height: 0.78;
    letter-spacing: -0.02em;
    text-transform: lowercase;
  }
  .landed { grid-column: 8 / span 5; align-self: end; width: 100%; height: auto; }
  .note {
    grid-column: 1 / span 6;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    padding-top: 1.5rem;
    border-top: var(--rule) solid var(--mark);
    font-size: 1.3125rem;
    line-height: 1.5;
  }
  @media (max-width: 760px) {
    .sent { min-height: 0; row-gap: 2rem; }
    h1, .landed, .note { grid-column: 1 / -1; }
    h1 { font-size: 34vw; }
    .landed { max-width: 300px; justify-self: end; }
  }
</style>
