---
/** Bauhaus home: a poster first (the name stacked flush left beside a
    composition that assembles on load), then numbered modules on the grid,
    a red lab band, and a see-saw that balances the closing ask. */
import { featuredSpecimens, type CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';

interface Props { copy: CopyData<'home'>; chrome: CopyData<'chrome'>; theme: string }
const { copy, chrome, theme } = Astro.props;
const featured = await featuredSpecimens();
const doorShape = ['circle', 'square'] as const;
---
<section class="hero">
  <div class="wrap grid12 hero-grid">
    <h1 class="billboard">
      {chrome.name.split(' ').map((word, i) => <>{i > 0 && ' '}<span class={`w w${i}`}>{word}</span></>)}
    </h1>
    <svg class="poster" viewBox="0 0 600 700" aria-hidden="true" focusable="false">
      <rect class="asm" x="0" y="410" width="600" height="22" fill="var(--mark)" style="--from: scaleX(0); --d: 0ms" />
      <circle class="asm" cx="390" cy="215" r="185" fill="var(--blue)" style="--from: translateY(-70%) scale(0.4); --d: 160ms" />
      <rect class="asm" x="20" y="230" width="180" height="180" fill="var(--red)" style="--from: translateX(-120%); --d: 300ms" />
      <polygon class="asm" points="460,460 590,690 330,690" fill="var(--yellow)" style="--from: translateY(60%) rotate(-90deg); --d: 420ms" />
      <rect class="asm" x="286" y="432" width="8" height="268" fill="var(--poster-mark)" style="--from: scaleY(0); --d: 560ms" />
      <circle class="asm" cx="110" cy="118" r="62" fill="var(--poster-mark)" style="--from: scale(0); --d: 640ms" />
      <circle class="asm" cx="110" cy="118" r="20" fill="var(--field)" stroke="var(--yellow)" stroke-width="6" style="--from: scale(0); --d: 760ms" />
    </svg>
  </div>
</section>

<section class="wrap grid12 opener">
  <p class="lead">{copy.opener.lead}</p>
  <p class="sub">{copy.opener.subline}</p>
</section>

<section class="wrap doors">
  <h2 class="kicker">{copy.doors.kicker}</h2>
  <div class="grid12 door-grid">
    {copy.doors.items.map((door, i) => (
      <article class={`door${i % 2 ? ' block-yellow' : ''}`}>
        <div class="door-top" aria-hidden="true">
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <span class={`shape ${doorShape[i % 2]}`}></span>
        </div>
        <h3>{door.title}</h3>
        <p>{door.body}</p>
      </article>
    ))}
  </div>
  <a class="more" href={hrefFor('services', theme)}>{copy.doors.more}</a>
</section>

{featured.length > 0 && (
  <section class="lab block-red">
    <svg class="lab-shapes" viewBox="0 0 600 600" aria-hidden="true" focusable="false" data-reveal>
      <circle class="asm" cx="380" cy="260" r="240" fill="var(--yellow)" style="--from: scale(0); --d: 0ms" />
      <polygon class="asm" points="120,600 300,290 480,600" fill="var(--ink)" style="--from: translateY(70%); --d: 220ms" />
    </svg>
    <div class="wrap grid12 lab-grid">
      <p class="kicker is-triangle lab-kicker">{copy.lab.kicker}</p>
      <div class="lab-body">
        <p class="pull">{copy.lab.pull}</p>
        <ul class="specimens" role="list" data-parity-skip>
          {featured.map((entry) => (
            <li>
              <span class="designation">{entry.data.designation}</span>
              <span class="summary">{entry.data.summary}</span>
            </li>
          ))}
        </ul>
        <a class="more" href={hrefFor('lab', theme)} data-astro-reload>{copy.lab.more}</a>
      </div>
    </div>
  </section>
)}

<section class="wrap grid12 closer">
  <div class="closer-text">
    <p class="lead">{copy.closer.lead}</p>
    <a class="btn" href={hrefFor('contact', theme)}>{copy.closer.cta}</a>
  </div>
  <svg class="seesaw" viewBox="0 0 400 300" aria-hidden="true" focusable="false" data-reveal>
    <rect x="0" y="290" width="400" height="10" fill="var(--mark)" />
    <polygon class="asm" points="200,178 262,290 138,290" fill="var(--yellow)" style="--from: translateY(40%) scale(0.2); --d: 0ms" />
    <rect class="asm" x="20" y="166" width="360" height="12" fill="var(--mark)" style="--from: rotate(-12deg); --d: 180ms" />
    <circle class="asm" cx="78" cy="116" r="50" fill="var(--blue)" style="--from: translateY(-180%); --d: 320ms" />
    <rect class="asm" x="286" y="80" width="86" height="86" fill="var(--red)" style="--from: translateY(-220%) rotate(45deg); --d: 460ms" />
  </svg>
</section>

<style>
  /* ---------- hero ---------- */
  .hero { border-bottom: var(--rule) solid var(--mark); overflow: hidden; }
  .hero-grid {
    min-height: min(calc(100vh - 90px), 860px);
    align-items: end;
    padding-block: clamp(2.5rem, 5vw, 4.5rem) 0;
  }
  .billboard {
    grid-column: 1 / span 7;
    grid-row: 1;
    align-self: end;
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
    font-weight: 800;
    font-size: clamp(4.4rem, 14vw, 13rem);
    line-height: 0.8;
    letter-spacing: -0.02em;
    text-transform: lowercase;
    position: relative;
    z-index: 1;
  }
  .w { display: block; }
  /* The last word steps right, past the descender of the word above, so the
     stack reads as a staircase instead of a centred block. In em so the step
     scales with the type. */
  .w2 { padding-left: 2.3em; }
  .poster {
    grid-column: 7 / span 6;
    grid-row: 1;
    align-self: end;
    width: 100%;
    height: auto;
    max-height: calc(100vh - 150px);
    margin-bottom: calc(-1 * var(--rule));
  }

  /* ---------- opener ---------- */
  .opener { padding-block: clamp(4rem, 9vw, 8rem); row-gap: 2.5rem; align-items: start; }
  .lead {
    grid-column: 1 / span 10;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 6.2vw, 5.75rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-transform: lowercase;
  }
  .sub {
    grid-column: 7 / span 5;
    padding-top: 1.1rem;
    border-top: var(--rule) solid var(--mark);
    font-size: 1.25rem;
    line-height: 1.5;
  }

  /* ---------- doors ---------- */
  .doors { padding-bottom: clamp(4rem, 8vw, 7rem); }
  .doors > .kicker {
    display: flex;
    width: 100%;
    padding-top: 1rem;
    border-top: var(--rule) solid var(--mark);
    font-family: var(--font-body);
  }
  .door-grid { margin-top: 2rem; row-gap: var(--gap); }
  .door {
    grid-column: span 6;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.75rem);
    border: var(--rule) solid var(--mark);
  }
  .door.block-yellow { border-color: var(--yellow); }
  .door-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; }
  .door .num { font-size: clamp(4rem, 7vw, 6.5rem); }
  .shape { width: clamp(56px, 6vw, 84px); aspect-ratio: 1; flex: none; }
  .shape.circle { background: var(--blue); border-radius: 50%; }
  .shape.square { background: var(--red); }
  .door h3 {
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    text-transform: lowercase;
  }
  .door p { max-width: 44ch; font-size: 1.125rem; }
  .doors > .more { margin-top: 2.5rem; }

  /* ---------- lab band ---------- */
  .lab {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .lab-shapes {
    position: absolute;
    right: calc(-1 * clamp(80px, 8vw, 160px));
    bottom: 0;
    width: clamp(320px, 42vw, 640px);
    height: auto;
  }
  .lab-grid { position: relative; }
  .lab-kicker { grid-column: 1 / span 1; align-self: start; writing-mode: vertical-rl; transform: rotate(180deg); justify-self: start; }
  .lab-body { grid-column: 2 / span 6; }
  .pull {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.25rem, 4.6vw, 4.25rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: lowercase;
  }
  .specimens {
    list-style: none;
    padding: 0;
    margin-top: 2.5rem;
    border-top: var(--rule) solid var(--on-red);
  }
  .specimens li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: var(--rule-thin) solid var(--on-red);
  }
  .designation {
    font-family: var(--font-num);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    padding-top: 0.25rem;
  }
  .summary { font-size: 1.0625rem; line-height: 1.5; }
  .lab .more { margin-top: 2.5rem; }

  /* ---------- closer ---------- */
  .closer { padding-block: clamp(4.5rem, 9vw, 8rem); align-items: end; row-gap: 3rem; }
  .closer-text { grid-column: 1 / span 7; display: flex; flex-direction: column; align-items: flex-start; gap: 2.25rem; }
  .closer .lead { font-size: clamp(2.75rem, 7vw, 6.5rem); }
  .seesaw { grid-column: 9 / span 4; width: 100%; height: auto; }

  /* Below 900px the shapes can no longer keep clear of the band's text, so
     they drop beneath it instead of behind it. */
  @media (max-width: 900px) {
    .door { grid-column: 1 / -1; }
    .lab { display: flex; flex-direction: column; padding-bottom: 0; }
    .lab-shapes { order: 2; position: static; width: min(80%, 420px); align-self: flex-end; margin: 3rem -4rem 0 0; }
    .lab-body { grid-column: 2 / -1; }
  }
  @media (max-width: 640px) {
    .hero-grid { min-height: 0; padding-top: 1.5rem; row-gap: 1.5rem; }
    .poster { grid-column: 1 / -1; grid-row: 1; max-height: none; width: 86%; justify-self: end; margin-bottom: 0; }
    .billboard { grid-column: 1 / -1; grid-row: 2; font-size: 25vw; padding-bottom: 1.75rem; }
    .lead, .sub { grid-column: 1 / -1; }
    .lab-kicker { grid-column: 1 / -1; writing-mode: horizontal-tb; transform: none; margin-bottom: 1.5rem; }
    .lab-body { grid-column: 1 / -1; }
    .specimens li { grid-template-columns: 1fr; gap: 0.35rem; }
    .closer-text, .seesaw { grid-column: 1 / -1; }
    .seesaw { width: 78%; justify-self: end; }
  }
</style>
