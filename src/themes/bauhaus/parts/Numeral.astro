---
/** Bauhaus constructed numeral (E3): digits built from bars and rings after
    Albers, drawn as inline SVG so every element can assemble with the .asm
    machinery (a <use> sprite takes no per-element styles). The real digits
    stay in the DOM as clipped text (copy, find in page, word parity); the
    drawn forms are decorative. The root is aria-hidden, as the page's old
    numerals were, and carries data-reveal so the numeral assembles when it
    scrolls into view. The parts come from numerals.ts, generated by
    scripts/themes/bauhaus/build-numerals.mjs. */
import { NUMERAL_PARTS } from './numerals';

interface Props { value: string; step?: number }
const { value, step = 55 } = Astro.props;
let idx = 0;
const digits = [...value].filter((ch) => NUMERAL_PARTS[ch]).map((ch) =>
  NUMERAL_PARTS[ch].map((part) => {
    const from = part.kind === 'bar' ? (part.axis === 'v' ? 'scaleY(0)' : 'scaleX(0)') : 'rotate(-90deg) scale(0)';
    return { ...part, style: `--from: ${from}; --d: ${idx++ * step}ms` };
  }),
);
---
<span class="num" aria-hidden="true" data-reveal>
  <span class="num-t">{value}</span>
  {digits.map((parts) => (
    <svg class="nm" viewBox="0 0 60 100" aria-hidden="true" focusable="false">
      {parts.map((part) => <path class="asm" fill-rule="evenodd" d={part.d} style={part.style} />)}
    </svg>
  ))}
</span>
