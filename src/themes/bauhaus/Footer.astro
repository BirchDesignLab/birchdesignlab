---
/** Bauhaus footer: the inverse band (ink in light, paper in dark), set on
    the twelve-column grid, with a red square and a yellow triangle hung from
    its top rule like the corner of a poster. */
import { hrefFor } from '../paths';
import type { CopyData } from '../../lib/copy';

interface Props { chrome: CopyData<'chrome'>; theme: string }
const { chrome, theme } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <svg class="corner" viewBox="0 0 240 150" aria-hidden="true" focusable="false" data-reveal>
    <rect class="asm" x="30" y="0" width="110" height="110" fill="var(--red)" style="--from: rotate(-90deg) scale(0); --d: 0ms" />
    <polygon class="asm" points="150,0 240,0 195,128" fill="var(--yellow)" style="--from: translateY(-70%) scale(0.2); --d: 220ms" />
  </svg>
  <div class="wrap grid12 cols">
    <div class="ident">
      <p class="name">{chrome.name}</p>
      <p class="loc">{chrome.location}</p>
    </div>
    <nav aria-label="Footer">
      {chrome.nav.map(({ to, label }) => (
        <a href={hrefFor(to, theme)} data-astro-reload={to === 'lab' ? '' : undefined}>{label}</a>
      ))}
    </nav>
  </div>
  <div class="wrap">
    <p class="fine">&copy; {year} {chrome.name} <span class="sep" aria-hidden="true"></span> <a href={hrefFor('privacy', theme)} data-astro-reload>{chrome.privacy}</a></p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--poster);
    color: var(--on-poster);
    /* In dark, --poster no longer flips to paper (see theme.css), so main
       and the footer are both near-black; this rule is what separates
       them instead of a colour change. */
    border-top: var(--rule) solid var(--on-poster);
    padding-block: clamp(3rem, 7vw, 5.5rem) 0.75rem;
  }
  .site-footer a { color: var(--on-poster); }
  .corner {
    position: absolute;
    top: 0;
    right: 0;
    width: clamp(150px, 22vw, 300px);
    height: auto;
  }
  .cols { position: relative; row-gap: 2.5rem; }
  .ident { grid-column: 1 / span 6; }
  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 5vw, 4.25rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-transform: lowercase;
    max-width: 8ch;
  }
  .loc {
    margin-top: 1.25rem;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.95rem;
    text-transform: lowercase;
  }
  nav {
    grid-column: 8 / span 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding-top: 0.4rem;
    border-top: var(--rule) solid var(--on-poster);
  }
  nav a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.2;
    text-transform: lowercase;
    text-decoration: none;
    padding-block: 0.2rem;
  }
  nav a:hover { text-decoration: underline; text-decoration-thickness: 3px; }
  .fine {
    position: relative;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1rem;
    border-top: var(--rule-thin) solid var(--on-poster);
    font-size: 0.875rem;
    text-transform: lowercase;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
  }
  .sep {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--on-poster);
  }
  @media (max-width: 760px) {
    .ident, nav { grid-column: 1 / -1; }
    .corner { width: 120px; }
    nav { flex-direction: row; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  }
</style>
