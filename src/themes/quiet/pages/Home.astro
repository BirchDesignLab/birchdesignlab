---
/** Quiet home body. Rendered by / (inside BaseLayout) and /t/quiet/ (inside
    PortalLayout). Every word comes from the copy collection. */
import BarkField from '../../../components/BarkField.astro';
import BarkCredit from '../../../components/BarkCredit.astro';
import { featuredSpecimens, specimenLink, type CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';

interface Props { copy: CopyData<'home'>; chrome: CopyData<'chrome'>; theme?: string }
const { copy, chrome, theme } = Astro.props;
const leaves = theme ? '' : undefined;

// Keep the 3a6a0d1 auto-feature logic; the loud moment renders the THREE newest
// live specimens as lightweight lines (not SpecimenCard — that's gallery
// furniture). The designation links to the entry; the summary stays text.
const featured = (await featuredSpecimens()).map((entry) => ({ entry, link: specimenLink(entry, theme) }));
---
<section class="hero">
  <BarkField density={170} live />
  <h1 class="billboard">
    {chrome.name.split(' ').map((word, i) => <>{i > 0 && ' '}<span>{word}</span></>)}
  </h1>
  <span class="bark-credit-pin" data-parity-skip><BarkCredit href="/lab/bdl-001" label={chrome.barkCredit} reload={!!theme} /></span>
</section>

<section class="wrap opener">
  <p class="opener-lead">{copy.opener.lead}</p>
  <p class="subline">{copy.opener.subline}</p>
</section>

<section class="wrap doors">
  <h2 class="doors-kicker">{copy.doors.kicker}</h2>
  <div class="door-grid">
    {copy.doors.items.map((door) => (
      <article class="door">
        <h3>{door.title}</h3>
        <p>{door.body}</p>
      </article>
    ))}
  </div>
  <a class="more-link doors-more" href={hrefFor('services', theme)}>{copy.doors.more} <span class="arw" aria-hidden="true">&rarr;</span></a>
</section>

{featured.length > 0 && (
  <section class="loud" data-reveal>
    <div class="wrap loud-inner">
      <p class="smallcaps kicker">{copy.lab.kicker}</p>
      <p class="pull">{copy.lab.pull}</p>
      <ul class="specimens" role="list" data-parity-skip>
        {featured.map(({ entry, link }) => (
          <li class="specimen">
            <a class="designation smallcaps" href={link.href} data-astro-reload={link.leaves ? '' : undefined} aria-label={`${entry.data.designation}, ${entry.data.title}`}>{entry.data.designation}</a>
            <span class="tick" aria-hidden="true"></span>
            <span class="spec-summary">{entry.data.summary}</span>
          </li>
        ))}
      </ul>
      <a class="more-link" href={hrefFor('lab', theme)} data-astro-reload={leaves}>{copy.lab.more} <span class="arw" aria-hidden="true">&rarr;</span></a>
    </div>
  </section>
)}

<section class="wrap closer">
  <p class="closer-lead">{copy.closer.lead}</p>
  <a class="cta-engraved" href={hrefFor('contact', theme)}>
    <span class="fill" aria-hidden="true"></span>
    <span class="lbl">{copy.closer.cta}</span>
  </a>
</section>

<style>
  .hero {
    position: relative; min-height: 88vh;
    display: grid; place-items: center;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    padding-inline: var(--space-4);
  }
  .billboard {
    position: relative;
    color: var(--billboard-color);
    font-family: var(--font-billboard);
    /* Home renders Marcellus, which ships 400 only; --billboard-weight (500)
       stays for styleguide/bdl-002 faces that really have a 500. Override here
       so the largest type on the site isn't faux-bolded. */
    font-weight: 400;
    font-size: clamp(2.8rem, 9vw, 6.5rem);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-align: center;
    line-height: 1.1;
  }
  @media (max-width: 640px) {
    .billboard span { display: block; }
  }
  /* Quiet signature: the hero bark is BDL-001 rendered live, credited by the
     shared BarkCredit component. This only pins the credit low-centre over the
     hero; the type + hover treatment live in BarkCredit.astro. */
  .bark-credit-pin {
    position: absolute;
    left: 50%;
    bottom: var(--space-4);
    transform: translateX(-50%);
    z-index: 1;
  }

  /* Opener — the interior display moment. */
  .opener { padding-block: var(--space-7); }
  .opener-lead {
    font-family: var(--font-display); font-size: var(--text-3xl);
    line-height: 1.15;
  }
  .subline {
    margin-top: var(--space-4); font-size: var(--text-lg);
    color: var(--mark-muted); max-width: var(--measure-wide);
  }

  /* Two doors. */
  .doors { padding-block: 0 var(--space-7); }
  /* Section label, not a second headline -- same eyebrow treatment as the
     "Services"/"FROM THE LAB" kickers elsewhere, so the door titles below
     are the only thing at headline weight. */
  .doors-kicker {
    font-family: var(--font-smallcaps); font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide); text-transform: uppercase;
    color: var(--accent);
  }
  .door-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6); margin-top: var(--space-4);
  }
  .door { display: flex; flex-direction: column; gap: var(--space-2); }
  .door h3 { font-size: var(--text-xl); }
  .door p { color: var(--mark-muted); max-width: var(--measure); }
  /* Single services link below the grid, left-aligned in the flow (the two
     per-door links read as redundant; a lone centered one floated oddly). */
  .doors-more { display: inline-block; margin-top: var(--space-5); }

  /* Loud moment — green Lab preview (.loud primitive in base.css). */
  .kicker { color: var(--accent); }
  .pull {
    font-family: var(--font-display); font-size: var(--text-2xl);
    line-height: 1.2; max-width: 34ch; margin-top: var(--space-3);
  }
  .specimens {
    list-style: none; padding: 0; margin-top: var(--space-5);
    display: flex; flex-direction: column; gap: var(--space-2);
  }
  /* The designation is the line's link: accent and bare at rest, like the
     catalog's classification, underlined on hover and focus in base.css's
     loud hover tone. The outline is the global :focus-visible. */
  .designation { color: var(--accent); text-decoration: none; }
  .designation:hover, .designation:focus-visible { color: var(--gf-link-hover); text-decoration: underline; }
  /* Same working-specimen tick as the Lab catalog. --accent, not --gf-accent:
     .loud remaps --accent to the loud value precisely so children do not have
     to know they sit on green, and the .designation beside it relies on that. */
  .specimen .tick {
    display: inline-block; width: 2px; height: 0.9em;
    background: var(--accent); margin-inline: var(--space-2) var(--space-2);
    vertical-align: middle;
  }
  .loud .more-link { display: inline-block; margin-top: var(--space-5); }

  /* Closing contact CTA — a quiet finish (not the green .loud band), so the Lab
     preview above stays the flex. Every page ends on the ask. */
  .closer {
    padding-block: var(--space-7);
    border-top: 1px solid var(--line);
    display: grid; justify-items: center; text-align: center;
  }
  .closer-lead {
    font-family: var(--font-display); font-size: var(--text-2xl);
    line-height: 1.2; margin-bottom: var(--space-5);
  }
</style>
