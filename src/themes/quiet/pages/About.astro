---
/** Quiet about body. Rendered by /about/ and /t/quiet/about/. */
import BarkField from '../../../components/BarkField.astro';
import BarkCredit from '../../../components/BarkCredit.astro';
import { rich, type CopyData } from '../../../lib/copy';
import { hrefFor } from '../../paths';

interface Props { copy: CopyData<'about'>; chrome: CopyData<'chrome'>; theme?: string }
const { copy, chrome, theme } = Astro.props;
const [etymLead, ...etymRest] = copy.etymology;
---
<header class="hero">
  <BarkField density={170} lockAspect />
  <h1>{copy.heading}</h1>
  <span class="bark-credit-pin" data-parity-skip><BarkCredit href="/lab/bdl-001" label={chrome.barkCredit} reload={!!theme} /></span>
</header>
<section class="wrap prose">
  <article class="epic">
    <p class="etym" set:html={rich(etymLead)} />
    {etymRest.map((para) => <p set:html={rich(para)} />)}
  </article>

  <article class="founder">
    <h2>{copy.founder.heading}</h2>
    {copy.founder.body.map((para) => <p>{para}</p>)}
  </article>
</section>

<section class="loud" data-reveal>
  <div class="wrap loud-inner">
    <p class="manifesto">{copy.manifesto}</p>
    <a class="cta-engraved" href={hrefFor('contact', theme)}>
      <span class="fill" aria-hidden="true"></span>
      <span class="lbl">{copy.cta}</span>
    </a>
  </div>
</section>

<style>
  /* Bark hero — Home's construction at half height: a full-bleed field with the
     H1 overlaid. This is About's material difference from Services. The short
     band only works because the field opts into `lockAspect`; without it the
     engine maps normalized dash width to canvas width and the lenticels smear
     into horizontal streaks. */
  .hero {
    position: relative; min-height: 44vh;
    display: grid; place-items: center;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    padding-inline: var(--space-4);
  }
  .hero h1 {
    position: relative;
    font-size: var(--text-3xl);
    text-align: center;
    /* billboard color (distinct from the bark's --mark hue) so the H1 keeps
       contrast over the brightest lenticels, not just over the field */
    color: var(--billboard-color);
  }
  .bark-credit-pin {
    position: absolute;
    left: 50%;
    bottom: var(--space-4);
    transform: translateX(-50%);
    z-index: 1;
  }

  .prose { display: grid; gap: var(--space-4); padding-block: 0 var(--space-4); }
  .epic, .founder { border-top: 1px solid var(--line); padding-top: var(--space-5); max-width: var(--measure-wide); }
  .etym { font-family: var(--font-display); font-size: var(--text-xl); line-height: 1.4; }
  .epic p + p, .founder p { color: var(--mark-muted); margin-top: var(--space-3); }

  /* Loud moment — manifesto pull-quote + closing CTA (.loud primitive in base.css). */
  .manifesto {
    font-family: var(--font-display); font-size: var(--text-3xl);
    line-height: 1.15; max-width: 20ch;
  }
  .loud .cta-engraved { margin-top: var(--space-5); }
</style>
