---
import '@fontsource/marcellus';
import '@fontsource/spectral/400.css';
import '@fontsource/spectral/400-italic.css';
import '@fontsource/spectral/600.css';
import '../styles/tokens.css';
import '../styles/base.css';
import HeadCommon from '../components/HeadCommon.astro';

/** `title` is the full page title; `heading` is the specimen's own title,
    which is what the h1 says. Keeping them separate stops the heading from
    reading "BDL-006 · BDL-006 The Regulator · Birch Design Lab". */
interface Props {
  title: string;
  description: string;
  designation: string;
  heading: string;
  noindex?: boolean;
}
const { title, description, designation, heading, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en" data-zone="lab">
  <head>
    <HeadCommon title={title} description={description} noindex={noindex} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <a class="hatch smallcaps" href="/lab">&larr; Lab &middot; <span class="hatch-id">{designation}</span></a>
    <main id="main" tabindex="-1">
      {/* The stages are deliberately immersive, so the page's real heading is
          available to screen readers and crawlers without intruding on the
          design. SpecimenPlate renders the title inside a summary element,
          which is not a heading. */}
      <h1 class="visually-hidden">{designation} &middot; {heading}</h1>
      <slot />
    </main>
  </body>
</html>

<style>
  .hatch {
    position: fixed; top: var(--space-3); left: var(--space-3); z-index: 20;
    color: var(--mark-muted); text-decoration: none; font-size: var(--text-sm);
    background: color-mix(in srgb, var(--field) 70%, transparent);
    padding: var(--space-1) var(--space-3); border-radius: 999px;
    backdrop-filter: blur(6px);
  }
  .hatch:hover { color: var(--mark); }
  .hatch-id { color: var(--accent); }

  /* On mobile the fixed hatch pill floats over the top of the page. Reserve
     space below it here, on main, as padding: a first-child margin inside
     main would collapse out and let the hatch overlap the content (this bit
     the WallLabel). Desktop keeps the immersive full-bleed stage. */
  @media (max-width: 720px) {
    /* A floating pill works over the immersive stage but not over the
       in-flow wall label above it: as the page scrolls, the full-width label
       text passes through the pill's band and pokes out beside it. On mobile
       the hatch becomes a solid full-width bar so every scrolled row passes
       cleanly behind it. */
    .hatch {
      top: 0; left: 0; right: 0;
      border-radius: 0;
      padding: var(--space-2) var(--space-3);
      background: var(--field);
      border-bottom: 1px solid var(--line-accent);
      backdrop-filter: none;
    }
    #main { padding-top: 3rem; }
  }
</style>
