---
import '@fontsource/marcellus';
import '@fontsource/spectral/400.css';
import '@fontsource/spectral/400-italic.css';
import '@fontsource/spectral/600.css';
import '../styles/tokens.css';
import '../styles/base.css';
import HeadCommon from '../components/HeadCommon.astro';

/** `title` is the full page title; `heading` is the specimen's own title,
    which is what the h1 says. Keeping them separate stops the heading from
    reading "BDL-006 · BDL-006 The Regulator · Birch Design Lab". */
interface Props {
  title: string;
  description: string;
  designation: string;
  heading: string;
  noindex?: boolean;
}
const { title, description, designation, heading, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en" data-zone="lab">
  <head>
    <HeadCommon title={title} description={description} noindex={noindex} ogImage="lab-experiment" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <a class="hatch smallcaps" href="/lab">&larr; Lab &middot; <span class="hatch-id">{designation}</span></a>
    <main id="main" tabindex="-1">
      {/* The stages are deliberately immersive, so the page's real heading is
          available to screen readers and crawlers without intruding on the
          design. SpecimenPlate renders the title inside a summary element,
          which is not a heading. */}
      <h1 class="visually-hidden">{designation} &middot; {heading}</h1>
      <slot />
    </main>
  </body>
</html>

<style>
  .hatch {
    position: fixed; top: var(--space-3); left: var(--space-3); z-index: 20;
    color: var(--mark-muted); text-decoration: none; font-size: var(--text-sm);
    background: color-mix(in srgb, var(--field) 82%, transparent);
    /* A real edge: --line-accent (accent at 45%) blended into the dark stage.
       This reads as a defined pill instead of a smudge, on the stage and over
       scrolling text alike. */
    border: 1px solid color-mix(in srgb, var(--accent) 60%, transparent);
    padding: var(--space-1) var(--space-3); border-radius: 999px;
    backdrop-filter: blur(6px);
  }
  .hatch:hover { color: var(--mark); border-color: var(--accent); }
  .hatch-id { color: var(--accent); }

  /* The pill floats top-left on every size; the gap around it is deliberate.
     On mobile it also passes over the in-flow wall label, so reserve space
     below it here on main as padding: a first-child margin would collapse out
     through main and let the pill overlap the label at rest (the
     visually-hidden h1 above the label is position:absolute, so the label is
     main's first in-flow child). Padding cannot collapse. */
  @media (max-width: 720px) {
    #main { padding-top: 3.25rem; }
  }
</style>
