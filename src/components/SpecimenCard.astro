---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PortalEntrance from './PortalEntrance.astro';
import { catalogSet, kindLabel } from '../lib/lab-sets';
import { specimenLink } from '../lib/copy';

/**
 * One piece in the List: the picture, the title, the summary, then one quiet
 * meta line (kind and date, "Coming soon" when it is not live, the BDL number
 * last). The whole card opens the piece through the title's link; the look is
 * src/styles/lab-list.css.
 */
interface Props {
  entry: CollectionEntry<'lab'>
  level?: 'h2' | 'h3'
}
const { entry, level = 'h3' } = Astro.props;
const { designation, title, summary, date, status, thumb } = entry.data;
const live = status === 'live';
const { href } = specimenLink(entry);
// The Portal's row links into a school, and its picture is the way in: it
// cycles the schools and re-sets the title to match (PortalEntrance).
const portal = live && !!thumb && href.startsWith('/t/');
const dateLabel = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
const Heading = level;
// The card is full width on a phone (one across, up to 40rem) and about 33rem
// at most with two across.
const widths = [480, 720, 960, 1280];
const sizes = '(min-width: 48rem) 34rem, 100vw';
---
<article class:list={['card', { 'has-thumb': thumb }]} data-type={catalogSet(entry.data)} data-status={status}>
  {/* The picture repeats the title link, so it stays out of the tab order
      and the accessibility tree; the alt text is for the image itself when
      the entry has no page to link to. A piece with no still gets a plain
      frame carrying its number, so the row never has an empty hole. */}
  {portal && thumb && <PortalEntrance href={href} still={thumb.src} />}
  {thumb && !portal && (live
    ? <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
        <Image src={thumb.src} alt="" widths={widths} sizes={sizes} loading="lazy" />
      </a>
    : <div class="thumb">
        <Image src={thumb.src} alt={thumb.alt} widths={widths} sizes={sizes} loading="lazy" />
      </div>)}
  {!thumb && <div class="thumb blank" aria-hidden="true"><span>{designation}</span></div>}
  <div class="text">
    <Heading>
      {portal
        ? <a href={href} class="portal-title" data-portal-title><span>{title}</span></a>
        : live ? <a href={href}>{title}</a> : <span>{title}</span>}
    </Heading>
    <p class="summary">{summary}</p>
    <p class="meta">
      <span class="what"><span class="kind">{kindLabel(entry.data)}</span>, <time datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time></span>
      {!live && <span class="soon">Coming soon</span>}
      <span class="num">{designation}</span>
    </p>
  </div>
</article>
