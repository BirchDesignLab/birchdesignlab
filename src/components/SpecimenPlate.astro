---
interface Props { designation: string; title: string; tech: string[] }
const { designation, title, tech } = Astro.props;
---
<details class="plate">
  <summary>
    <span class="smallcaps">Specimen plate</span>
    <span class="id">{designation} &middot; {title}</span>
    <span class="dash" aria-hidden="true"></span>
    <span class="caret" aria-hidden="true"></span>
  </summary>
  <div class="body">
    <slot />
    <p class="tech">
      {tech.map((t) => <span>{t}</span>)}
    </p>
  </div>
</details>

<style>
  .plate {
    position: fixed; inset: auto 0 0 0; z-index: 20;
    background: color-mix(in srgb, var(--field) 88%, transparent);
    backdrop-filter: blur(8px);
    border-top: 1px solid var(--line-accent);
  }
  /* A plate only ever renders on a live specimen's page, so the dash needs no
     condition: [slug].astro's getStaticPaths filters to status === 'live'.
     Vertical, matching the catalog/billboard tick (founder call 08-18-26:
     horizontal read as an em dash). */
  .dash {
    display: inline-block; width: 2px; height: 0.9em;
    background: var(--accent); vertical-align: middle;
  }
  summary {
    cursor: pointer; list-style: none;
    display: flex; gap: var(--space-3); align-items: center;
    padding: var(--space-3) var(--space-4);
    color: var(--mark-muted); font-size: var(--text-sm);
    transition: color var(--dur-2) var(--ease-weighted),
                background var(--dur-2) var(--ease-weighted);
  }
  summary::-webkit-details-marker { display: none; }
  /* A hover wash plus a brightening label so the whole strip reads as a
     control, not a caption. */
  summary:hover { color: var(--mark); background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .id { color: var(--accent); }
  /* Disclosure caret, pushed to the far edge: the one element that says the
     strip opens. The familiar dropdown convention rather than physical
     direction (the plate lifts up on desktop, down on mobile): chevron down
     means "expand", flipping up when open. */
  .caret {
    margin-left: auto;
    width: 0.5rem; height: 0.5rem;
    border-right: 1.5px solid var(--accent);
    border-bottom: 1.5px solid var(--accent);
    transform: rotate(45deg);
    transition: transform var(--dur-2) var(--ease-weighted);
  }
  .plate[open] .caret { transform: rotate(-135deg); }
  .body {
    max-height: 45vh; overflow-y: auto;
    padding: 0 var(--space-4) var(--space-4);
    max-width: var(--measure);
  }
  .tech { margin-top: var(--space-3); color: var(--mark-muted); font-size: var(--text-sm); }
  .tech span {
    font-family: var(--font-smallcaps);
    letter-spacing: var(--tracking-wide); text-transform: uppercase;
    font-size: 0.68rem; line-height: 1;
    color: var(--accent);
    border: 1px solid var(--line-accent);
    padding: 0.35em 0.8em 0.25em; margin-right: var(--space-2);
  }
</style>
