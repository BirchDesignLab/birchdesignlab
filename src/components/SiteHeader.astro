---
/** The site header on every non-portal page: the quiet school's header with
    the shared chrome copy. The markup and styles live in
    src/themes/quiet/Header.astro so /t/quiet/ renders the same header. */
import Header from '../themes/quiet/Header.astro';
import { getCopy } from '../lib/copy';

const chrome = await getCopy('chrome');
---
<Header chrome={chrome} />
