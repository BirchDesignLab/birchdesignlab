---
// Shared pre-paint scheme bootstrap. Sets `data-scheme` (light|dark) on <html>
// from the stored choice or the system preference, plus the `.js` marker.
// Repeats src/lib/scheme.ts readStoredScheme by hand (an inline script cannot
// import): current key 'scheme', then the pre-09-22-26 key 'theme', migrated
// on first read. It never touches `data-theme`, which names a design school on
// /t/ routes and is set statically by the route.
//
// Under ClientRouter (/t/ routes) this runs on the first load only; the portal
// runtime re-stamps these onto every incoming document (src/themes/portal).
---
<script is:inline>
  (function () {
    var root = document.documentElement;
    root.classList.add('js');
    var stored = null;
    try {
      stored = localStorage.getItem('scheme');
      if (stored !== 'light' && stored !== 'dark') {
        var legacy = localStorage.getItem('theme');
        stored = legacy === 'light' || legacy === 'dark' ? legacy : null;
        if (stored) {
          localStorage.setItem('scheme', stored);
          localStorage.removeItem('theme');
        }
      }
    } catch (e) { /* storage blocked */ }
    root.setAttribute('data-scheme', stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'));
  })();
</script>
