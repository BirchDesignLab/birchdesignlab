---
/**
 * The card landing page, rendered by one thin page file per channel:
 * src/pages/hello.astro (kraft cards), src/pages/showcase.astro (the QR on the
 * Birch Design Lab card in Cheer and Chatter's break screen), and whatever the
 * wood tier is called once its QR is etched.
 *
 * A channel is a page, not a rewrite. The earlier version served every channel
 * from one file behind public/_redirects, which meant a URL existed that
 * nothing explained. Now the path is the file, and the channel label is passed
 * in as a prop rather than read back out of the URL at runtime.
 *
 * Reached by scanning a card, not by search, so every channel page is noindex
 * and excluded from the sitemap (see astro.config.mjs).
 *
 * Deliberately standalone: no BaseLayout, no site CSS, no linked webfonts, no
 * GA4. The critical path is this one HTML document so it is interactive in
 * under 2s on 4G. Colors mirror the dark face of src/styles/tokens.css by
 * value; if the palette shifts, update these too.
 *
 * Marcellus is the exception to "no webfonts", and it is inlined rather than
 * linked. This page is a stranger's first look at the studio, and the brand
 * face arriving a beat late (or not at all) reads as a cheap page. The subset
 * is printable ASCII only, ~8KB of woff2 carried in the document, which is
 * cheaper than the request and the fallback flash a linked font would cost.
 * Regenerate with scripts/ar-card/subset-marcellus.mjs.
 *
 * The AR experience does not exist yet. AR_ENABLED=false renders no AR UI at
 * all; enabling it later means flipping the flag and shipping the module at
 * AR_MODULE_URL (see the mount point marked below). Context and backlog:
 * docs/ar-card/HANDOFF.md.
 */
import { buildVcf } from '../lib/vcard';
import { MARCELLUS_WOFF2_BASE64 } from '../lib/card-font';

interface Props {
  /** Analytics label for the card that led here. Becomes the Analytics Engine
   *  index, so it is the value the per-channel counts group by. Keep it short
   *  and stable: renaming one splits its history in two. */
  channel: string;
  /** Canonical path of the page rendering this, for the canonical link tag. */
  path: string;
  /** Whether this channel has a physical card to point a camera at. AR is a
   *  property of the card, not of the app: /hello is a card someone is holding,
   *  /showcase is a QR on a television across a room, and pointing a phone back
   *  at that television tracks nothing. Off unless a channel says otherwise, so
   *  a new channel cannot inherit AR by accident. */
  ar?: boolean;
}
const { channel, path, ar = false } = Astro.props;

const CONFIG = {
  // Where the AR module will live once it exists. Nothing fetches it until a
  // channel page passes `ar`, and no channel does yet. Loaded by URL rather
  // than imported so that turning AR on for a card never pulls AR's weight
  // into this document's critical path.
  AR_MODULE_URL: '/ar/card-ar.js',

  // Public studio identity only, which is the whole point: this is a company
  // card, and X-ABShowAs:COMPANY keeps it rendering as one rather than as a
  // person with a blank name.
  //
  // Name, title, email and url are real. `phone` is the one gap, and it is
  // empty on purpose rather than by neglect: an empty field is omitted from
  // the vCard entirely, so the card simply has no TEL. Filling it with the
  // personal mobile was considered and declined 08-26-26 (a saved vCard is
  // permanent per scan, and the number would outlive any later swap in git
  // history). It gets a Google Voice number before any card is printed or
  // etched. Reasoning and acceptance: docs/lab-backlog.md, "AR card".
  //
  // Values are RFC-escaped by src/lib/vcard.ts, so commas and semicolons are
  // safe here. Set isOrg false when name becomes a person.
  card: {
    isOrg: true,
    name: 'Birch Design Lab',
    title: 'Independent software engineering and web design studio',
    company: 'Birch Design Lab',
    phone: '',
    email: 'hello@birchdesignlab.com',
    url: 'https://birchdesignlab.com',
  },

  // Where the two "go look at us" buttons land. Same-origin paths, because
  // every channel that reaches this page is already on the site's domain.
  siteUrl: '/',
  labUrl: '/lab/',
};

const vcfText = buildVcf(CONFIG.card);
// data: URI fallback so "Save contact" works even with JavaScript off; the
// client script upgrades it to a Blob URL, which iOS Safari handles better.
const vcfDataHref = 'data:text/vcard;charset=utf-8,' + encodeURIComponent(vcfText);

const title = 'Birch Design Lab';
const description =
  'Independent software engineering and web design studio on the Mississippi Gulf Coast. Save our contact card or see the work.';
const canonical = new URL(path, 'https://birchdesignlab.com').toString();
const ogImage = 'https://birchdesignlab.com/og/home.png';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#1c1a17" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Birch Design Lab" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={title} />
    <style is:inline set:html={`
      /* The brand face, carried in the document rather than fetched. See the
         header comment for why this page pays 8KB to avoid one request.
         font-display is irrelevant to a data: source (nothing is fetched, so
         there is no block or swap period) and is omitted deliberately. */
      @font-face {
        font-family: 'Marcellus';
        font-style: normal;
        font-weight: 400;
        src: url(data:font/woff2;base64,${MARCELLUS_WOFF2_BASE64}) format('woff2');
      }
    `}></style>
    <style is:inline>
      /* Values mirror the dark face in src/styles/tokens.css. */
      :root {
        --field: #1c1a17;
        --mark: #f4f0e6;
        --muted: #a89f8f;
        /* Sage survives as the focus ring only: it is the one green here that
           reads against both the field and the canopy button it can land on. */
        --accent: #a3bd8f;
        --line: rgba(244, 240, 230, 0.24);
        /* The mark's canopy green as it actually appears, which is not the
           #2f6644 in the SVG: that stroke is blended `screen` over the field,
           so what the eye gets is 255-(255-a)(255-b)/255 against #1c1a17. Used
           flat here, it has to be the blended value. The raw stroke colour on
           this field is 2.57:1 and illegible; this is 3.29:1, which clears AA
           for large text but not for body, so it stays on the wordmark and the
           button fill and never lands under 24px. */
        --canopy: #467655;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100svh;
        display: grid;
        place-items: center;
        background: var(--field);
        color: var(--mark);
        /* Marcellus is the whole page, not just the wordmark. The site splits
           display (Marcellus) from body (Spectral), but four lines of text do
           not make a body-copy problem, and mixing two faces here would cost a
           second subset to fix a mismatch nobody asked for. */
        font-family: 'Marcellus', 'Iowan Old Style', Georgia, 'Times New Roman', serif;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      main {
        width: min(100% - 2.5rem, 23rem);
        padding: 2.5rem 0;
        text-align: center;
      }
      /* Sized against the column rather than in fixed pixels: the mark is the
         first thing a scan resolves into, so it should hold the same share of
         the card on a 320px phone as on a wide one. 168px is where it stops
         crowding the wordmark under it.

         The vh term does nothing on a phone held upright (26vh clears 168px
         from a 646px viewport up), and everything on a short one: turned
         sideways, or on the last 568px-tall handsets, a mark sized only
         against the column pushes two of the three actions under the fold. */
      .mark {
        display: block;
        width: min(58%, 168px, 26vh);
        height: auto;
        aspect-ratio: 1;
        margin: 0 auto 2rem;
      }
      h1 {
        margin: 0 0 0.5rem;
        /* Never below 24px: this is the canopy green flat on the field, which
           only clears contrast as large text. See --canopy. */
        font-size: 1.7rem;
        color: var(--canopy);
        font-weight: 400;
        letter-spacing: 0.14em;
        line-height: 1.25;
        text-transform: uppercase;
      }
      .tagline {
        margin: 0 0 2.25rem;
        color: var(--muted);
        font-size: 1.0625rem;
      }
      .actions {
        display: grid;
        gap: 0.75rem;
      }
      .btn {
        display: block;
        padding: 0.95rem 1rem;
        border-radius: 6px;
        text-align: center;
        text-decoration: none;
        font-size: 1.0625rem;
      }
      /* Marcellus ships one weight. Asking for 600 here used to faux-bold the
         primary button; the fill and the tracking carry the emphasis instead.

         The label is warm white rather than the charcoal it was under the old
         sage fill. Canopy is a dark green: charcoal on it is 3.29:1 and fails
         AA at this size, warm white on it is 4.62:1 and passes. */
      .btn-primary {
        background: var(--canopy);
        color: var(--mark);
        letter-spacing: 0.04em;
      }
      .btn-secondary {
        border: 1px solid var(--line);
        color: var(--mark);
      }
      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }
      /* Short viewports, which here means a phone turned sideways or one of the
         last 568px-tall handsets. The page offers three actions and the whole
         point is that a stranger sees all three; without this the mark and its
         breathing room push one or two of them under the fold. */
      @media (max-height: 640px) {
        main {
          padding: 1.5rem 0;
        }
        .mark {
          margin-bottom: 1.4rem;
        }
        .tagline {
          margin-bottom: 1.6rem;
        }
      }
      @media (prefers-reduced-motion: no-preference) {
        main {
          animation: rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
        }
        @keyframes rise {
          from {
            opacity: 0;
            transform: translateY(12px);
          }
        }
        /* 9e-settle's gesture: the canopy stroke arrives out of register and
           settles onto the neutral one. Run once here rather than on the 9s
           loop the source file carries. The loop spends part of every cycle
           travelling back out of register, which is fine on a review sheet and
           wrong on the page a stranger lands on holding the card: it would
           show them a broken mark on a timer. To restore the loop, add
           `infinite` and swap `both` out.

           The offset lives only inside this query, so the no-motion mark is
           simply the registered one with nothing to settle. */
        .mark .settle {
          animation: settle 1.4s cubic-bezier(0.22, 1, 0.36, 1) both;
        }
        @keyframes settle {
          from {
            transform: translate(-26px, 10px);
          }
        }
      }
    </style>
  </head>
  <body>
    <main>
      {/* The locked mark, inlined rather than linked, because at this size a
          copy in the document costs less than the round trip a second request
          would spend. Its plate is the same charcoal as the field, so the
          strokes read as floating on it.

          This is the display cut (assets/brand/logos/files/9e-settle.svg, the
          stroke-width 14 night face), not the favicon cut it used to be. The
          favicon is drawn at 20 so it survives 32px, and that weight at 104px
          reads as a blunt shape rather than the mark.

          The source file's own <style> is not carried over: inlined into a
          document its `.m` hook stops being scoped to the SVG, so the motion
          is restated in the page's stylesheet under a name that cannot collide
          with anything. Geometry, faces and the rest of the set are in
          assets/brand/logos/, with the README there. */}
      <svg class="mark" viewBox="0 0 200 200" role="img" aria-label="Birch Design Lab">
        <rect width="200" height="200" fill="#1c1a17"></rect>
        <g style="mix-blend-mode:screen">
          <path
            d="M58 20 V184 M58 32 L120 64 L58 96 M58 96 L126 132 L58 172"
            fill="none" stroke="#a89f8f" stroke-width="14" stroke-linecap="square" opacity="0.9"></path>
        </g>
        <g class="settle">
          <g style="mix-blend-mode:screen">
            <path
              d="M70 16 V180 M70 28 L132 60 L70 92 M70 92 L138 128 L70 168"
              fill="none" stroke="#2f6644" stroke-width="14" stroke-linecap="square"></path>
          </g>
        </g>
      </svg>
      <h1>Birch Design Lab</h1>
      <p class="tagline">Independent software engineering and web design studio on the Mississippi Gulf Coast.</p>
      <nav class="actions" aria-label="Card actions">
        <a class="btn btn-primary" id="save-contact" href={vcfDataHref} download="birch-design-lab.vcf">
          Save contact
        </a>
        <a class="btn btn-secondary" href={CONFIG.siteUrl}>Visit the site</a>
        <a class="btn btn-secondary" href={CONFIG.labUrl}>Enter the Lab</a>
      </nav>
      {
        /* AR MOUNT POINT. Renders only for a channel that opted in; the client
           script lazy-loads AR_MODULE_URL and calls mount(root, channel). */
        ar && <div id="ar-root"></div>
      }
    </main>
    <script is:inline define:vars={{ CONFIG, vcfText, channel, ar }}>
      // Fire-and-forget scan beacon. Never blocks render, silently no-ops on
      // any failure (endpoint down, blocked, old browser). The channel is
      // baked in by the page that rendered this, so there is nothing to parse.
      try {
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/api/beacon', JSON.stringify({ ts: Date.now(), channel: channel }));
        }
      } catch {
        /* no-op */
      }

      // Upgrade the vCard link from the no-JS data: URI to a Blob URL; iOS
      // Safari is more reliable offering "add contact" from a Blob download.
      try {
        var save = document.getElementById('save-contact');
        var blob = new Blob([vcfText], { type: 'text/vcard;charset=utf-8' });
        save.href = URL.createObjectURL(blob);
      } catch {
        /* keep the data: URI */
      }

      // AR entry. Nothing is fetched unless this channel opted in; when it
      // does, the module owns everything inside #ar-root.
      if (ar) {
        import(CONFIG.AR_MODULE_URL)
          .then(function (mod) {
            mod.mount(document.getElementById('ar-root'), channel);
          })
          .catch(function () {
            /* AR is progressive enhancement; the card still works */
          });
      }
    </script>
  </body>
</html>
