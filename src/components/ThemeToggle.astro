---
<button id="theme-toggle" type="button" aria-label="Switch color theme" aria-pressed="false">
  <span aria-hidden="true" class="dot"></span>
</button>

<style>
  button {
    background: none; border: 1px solid var(--line); border-radius: 0;
    width: 2.5rem; height: 1.5rem; cursor: pointer; position: relative;
    transition: border-color var(--dur-1) var(--ease-weighted);
  }
  button:hover { border-color: var(--mark-muted); }
  .dot {
    position: absolute; top: 50%; translate: 0 -50%;
    left: 0.2rem; width: 1rem; height: 1rem;
    background: var(--mark);
    transition: left var(--dur-1) var(--ease-weighted);
  }
  :global([data-scheme='light']) .dot { left: calc(100% - 1.2rem); }
</style>

<script>
  import { currentScheme, setScheme } from '../lib/scheme';

  const btn = document.getElementById('theme-toggle');

  // Reflect the live theme to assistive tech: aria-pressed = "is light", and the
  // label names the action the press performs. ThemeBootstrap sets data-scheme
  // in <head> before this runs, so the first sync reads the real scheme.
  const sync = () => {
    const light = currentScheme() === 'light';
    btn?.setAttribute('aria-pressed', String(light));
    btn?.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
  };
  sync();

  btn?.addEventListener('click', () => {
    setScheme(currentScheme() === 'light' ? 'dark' : 'light');
    sync();
  });
</script>
