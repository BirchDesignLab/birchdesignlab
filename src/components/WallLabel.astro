---
interface Props { lines: string[] }
const { lines } = Astro.props;
---
<details class="label" open>
  <summary><span class="smallcaps">How to operate</span></summary>
  <ol>
    {lines.map((line, i) => (
      <li>
        <span class="step" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        {line}
      </li>
    ))}
  </ol>
</details>

<script>
  // Mobile drops the label into normal flow (see the max-width: 720px rule
  // below), right where the fixed "back to Lab" hatch pill sits. Starting
  // collapsed there avoids the overlap instead of just hiding it visually.
  if (matchMedia('(max-width: 720px)').matches) {
    document.querySelector('.label')?.removeAttribute('open');
  }
</script>

<style>
  .label {
    /* Bottom-left, resting just above the specimen plate's summary strip. */
    position: fixed; bottom: 4.5rem; left: var(--space-4); z-index: 20;
    max-width: 30ch;
    background: color-mix(in srgb, var(--field) 88%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid var(--line-accent);
  }
  /* Numerals are aria-hidden: the <ol> already conveys order to assistive
     technology, and announcing "01" before every step is noise. */
  .step {
    font-family: var(--font-smallcaps);
    letter-spacing: var(--tracking-wide); text-transform: uppercase;
    color: var(--accent); font-size: 0.75em; margin-right: var(--space-2);
  }
  summary {
    cursor: pointer; list-style: none;
    padding: var(--space-3) var(--space-4);
    color: var(--mark-muted); font-size: var(--text-sm);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--mark); }
  ol {
    margin: 0; padding: 0 var(--space-4) var(--space-3);
    list-style: none;
    display: grid; gap: var(--space-3);
    color: var(--mark-muted); font-size: var(--text-sm);
  }
  @media (max-width: 720px) {
    .label {
      position: static;
      max-width: none;
      border-inline: none;
      /* Clearance for the fixed hatch pill lives on <main> in
         ExperimentLayout, as padding: a margin here is the label's first
         in-flow margin and collapses out through <main>, so the hatch ends
         up overlapping the expanded list (the .visually-hidden h1 before it
         is position:absolute, so the label really is main's first in-flow
         child). Padding on main cannot collapse. */
    }
  }
</style>
