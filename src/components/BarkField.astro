---
interface Props { seed?: number; density?: number; class?: string; live?: boolean; lockAspect?: boolean }
const { seed, density = 140, class: className, live = false, lockAspect = false } = Astro.props;
---
<canvas
  class:list={['bark-field', className]}
  data-bark
  data-seed={seed}
  data-density={density}
  data-live={live ? '' : undefined}
  data-lock-aspect={lockAspect ? '' : undefined}
  aria-hidden="true"></canvas>

<style>
  .bark-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  import { generateBark, resolveSeed, createBarkRenderer, renderBark2D } from '../lib/bark';

  const markColor = () =>
    getComputedStyle(document.documentElement).getPropertyValue('--mark').trim();
  const barkAlphas = (): [number, number] => {
    const cs = getComputedStyle(document.documentElement);
    const lo = parseFloat(cs.getPropertyValue('--bark-alpha-lo')) || 0.05;
    const hi = parseFloat(cs.getPropertyValue('--bark-alpha-hi')) || 0.22;
    return [lo, hi];
  };
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  const cleanups: Array<() => void> = [];

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-bark]')) {
    const seed = canvas.dataset.seed
      ? Number(canvas.dataset.seed)
      : resolveSeed(undefined, location.pathname);
    const dashes = generateBark(seed, { density: Number(canvas.dataset.density) || 140 });

    // short-wide fields opt in so lenticels keep their shape instead of streaking
    const lockAspect = 'lockAspect' in canvas.dataset;
    const gl = createBarkRenderer(canvas, dashes, lockAspect);
    const paint2D = () => renderBark2D(canvas, dashes, markColor(), ...barkAlphas(), lockAspect);

    if (gl) {
      gl.setColors(markColor());
      gl.setAlpha(...barkAlphas());
      // live fields (home) get weather and the daily grow-in; quiet fields don't
      const live = 'live' in canvas.dataset;
      if (live) gl.setGust(true);

      // Pause the loop when the field is off-screen or the tab is hidden. This
      // is a full-viewport WebGL canvas; repainting it behind content the
      // visitor has scrolled past competes with the browser's scroll
      // compositing (the "scroll lags" report) and burns GPU for nothing.
      // Only animate while the field is actually visible. bdl-007 already does
      // this; the bark field did not.
      let inView = true;
      let pageVisible = !document.hidden;
      const shouldAnimate = () => inView && pageVisible && !reducedMotion.matches;
      const sync = () => {
        if (shouldAnimate()) gl.start();
        else { gl.stop(); if (reducedMotion.matches) gl.renderOnce(); }
      };

      if (reducedMotion.matches) gl.renderOnce();
      else {
        gl.start();
        if (live) gl.growTree();
      }

      const intersectionObserver = new IntersectionObserver((entries) => {
        inView = entries[0].isIntersecting;
        sync();
      });
      intersectionObserver.observe(canvas);

      const handleVisibility = () => { pageVisible = !document.hidden; sync(); };
      document.addEventListener('visibilitychange', handleVisibility);

      const resizeObserver = new ResizeObserver(() => {
        gl.resize();
        if (reducedMotion.matches) gl.renderOnce();
      });
      resizeObserver.observe(canvas);

      const mutationObserver = new MutationObserver(() => {
        gl.setColors(markColor());
        gl.setAlpha(...barkAlphas());
        if (reducedMotion.matches) gl.renderOnce();
      });
      mutationObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-scheme'] });

      const handleReducedMotionChange = () => { sync(); };
      reducedMotion.addEventListener('change', handleReducedMotionChange);

      // Retune: BDL-006 regenerates the field at a new grain without a remount.
      // Same seed, so it stays the same tree — only the dash count moves.
      // WebGL only; the 2D fallback has no incremental path and ignores this.
      const handleRetune = (event: Event) => {
        const next = Number((event as CustomEvent<{ density?: number }>).detail?.density);
        if (!Number.isFinite(next) || next <= 0) return;
        gl.setDashes(generateBark(seed, { density: next }));
        if (reducedMotion.matches) gl.renderOnce();
      };
      document.addEventListener('bark:retune', handleRetune);

      // Depth parallax: deeper dashes lag the scroll (uniform read per frame).
      const handleScroll = () => {
        if (reducedMotion.matches) return;
        const rect = canvas.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > innerHeight) return;
        gl.setScroll((-rect.top / innerHeight) * 0.06);
      };
      addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();

      cleanups.push(() => {
        gl.destroy();
        intersectionObserver.disconnect();
        resizeObserver.disconnect();
        mutationObserver.disconnect();
        document.removeEventListener('visibilitychange', handleVisibility);
        reducedMotion.removeEventListener('change', handleReducedMotionChange);
        document.removeEventListener('bark:retune', handleRetune);
        removeEventListener('scroll', handleScroll);
      });
    } else {
      paint2D();

      const resizeObserver = new ResizeObserver(paint2D);
      resizeObserver.observe(canvas);

      const mutationObserver = new MutationObserver(paint2D);
      mutationObserver.observe(document.documentElement, {
        attributes: true, attributeFilter: ['data-scheme'],
      });

      cleanups.push(() => {
        resizeObserver.disconnect();
        mutationObserver.disconnect();
      });
    }
  }

  window.addEventListener('pagehide', (event) => {
    if (event.persisted) return;
    for (const cleanup of cleanups) {
      cleanup();
    }
  });
</script>
