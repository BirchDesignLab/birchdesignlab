---
import type { CollectionEntry } from 'astro:content';
import SpecimenCard from './SpecimenCard.astro';
import { labCountLabel } from '../lib/specimen-count';
import '../styles/lab-texture.css';
import '../styles/lab-list.css';

interface Props {
  entries: CollectionEntry<'lab'>[];
  filterable?: boolean;
}
const { entries, filterable = false } = Astro.props;
const working = entries.filter((e) => e.data.status === 'live').length;
---
<p class="count" aria-live="polite">{labCountLabel(entries.length, working)}</p>
{filterable && (
  <nav class="filter" aria-label="Browse the pieces by kind">
    {/* Real links (crawlable, no-JS navigable) to the dedicated category pages.
        With JS they are hijacked into an in-place filter (see the script), so the
        catalog never reloads. aria-current marks the active set. */}
    <a href="/lab/" data-set="all" aria-current="true">All</a>
    <a href="/lab/experiments/" data-set="experiment">Experiments</a>
    <a href="/lab/studies/" data-set="study">Studies</a>
  </nav>
)}
<div class="catalog" data-filter="all">
  {entries.map((entry) => <SpecimenCard entry={entry} level="h2" />)}
</div>

{/* The Lab's texture and row entrances (src/lib/lab-presentation.ts). At the
    shipped setting of none and still this draws nothing and fetches nothing. */}
<script>
  import { initLabPresentation, refreshEntrances } from '../lib/lab-presentation-client';

  initLabPresentation('.catalog .card');
  // The filter moves rows without a scroll; look again once it has.
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.filter a')) requestAnimationFrame(refreshEntrances);
  });
</script>

{filterable && (
  <script>
    import { labCountLabel } from '../lib/specimen-count';

    for (const group of document.querySelectorAll('.filter')) {
      const catalog = group.nextElementSibling as HTMLElement;
      // The count sits above the filter row, so it is the group's previous
      // sibling. Recounted from the DOM rather than from a passed-in figure:
      // the cards are the source of truth and cannot drift from it.
      const count = group.previousElementSibling as HTMLElement | null;
      group.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest('a[data-set]') as HTMLAnchorElement | null;
        if (!link || !catalog) return;
        // Let modifier / middle clicks fall through to real navigation
        // (open-in-new-tab still reaches the dedicated category page).
        const me = e as MouseEvent;
        if (me.button !== 0 || me.metaKey || me.ctrlKey || me.shiftKey || me.altKey) return;
        e.preventDefault(); // JS present: filter in place instead of navigating.
        const set = link.dataset.set!;
        catalog.dataset.filter = set;
        for (const a of group.querySelectorAll('a[data-set]')) {
          if (a === link) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        }
        if (count) {
          const shown = [...catalog.querySelectorAll<HTMLElement>('.card')]
            .filter((c) => set === 'all' || c.dataset.type === set);
          const live = shown.filter((c) => c.dataset.status === 'live').length;
          count.textContent = labCountLabel(shown.length, live);
        }
      });
    }
  </script>
)}
