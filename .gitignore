docs/refs/
# Founder working docs: prompt packs, harvest packs, copy reviews. Drafting
# material that feeds the tracked docs rather than being one. Listed by name
# rather than by a docs/*.md pattern, because docs/ is also where the real
# tracked documents live (lab-backlog.md, deploy.md, ar-card/HANDOFF.md) and a
# blanket rule there would silently swallow the next one. Add new ones here.
docs/bdl-ar-card-prompt-pack-v3.md
docs/bdl-ar-card-prompt-pack-v4.md
docs/bdl005-refresh-pack-8-26-26.md
docs/birch-design-lab-copy-review.md
.superpowers/
scripts/brand/.cache/
# 3D logo exports: glb only, obj/mtl blow up repo size (60MB+ per asset)
assets/brand/logos/3d/*.obj
assets/brand/logos/3d/*.mtl

# Social asset pipeline outputs: generated video/PNG, regenerable from
# social/calendar.html + the site itself. Never source.
social/out/

# Theme-schools capture/diff outputs (scripts/themes/): regenerable PNGs.
scripts/themes/.out/

# Doc-gen outputs (scripts/docs/): delivered PDFs and the page-check
# screenshots, both regenerable from the .html/.css source with
# check-pages.mjs / build-pdf.mjs. Never source.
docs/**/*.pdf
docs/**/generated/
