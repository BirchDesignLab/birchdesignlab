/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Astro emits content-hashed filenames into /_astro/ (CSS, JS, and the bundled
# @fontsource woff2), so they are safe to cache forever: any change ships under
# a new name. Unhashed /models/* and /draco/* are deliberately NOT covered here
# (see lab-backlog.md); the glb would need a hashed name first.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
